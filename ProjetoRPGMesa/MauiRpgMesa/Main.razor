@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(MauiProgram).Assembly">
    <Found Context="rota">
        <RouteView RouteData="@rota" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>Essa página se perdeu no mapa da aventura.</p>
        </LayoutView>
    </NotFound>
</Router>
