@page "/"
@using System.ComponentModel.DataAnnotations
@inject EstadoMesaService EstadoMesa

@if (telaAtual == Tela.Login)
{
    <div class="tela ativa" id="tela-login">
        <div class="cartao-login">
            <div class="selo-login">⚔️</div>
            <h1>Salão da Mesa</h1>
            <p class="subtitulo-login">Sua campanha, seus dados, seu tabuleiro — conectados.</p>
            <EditForm Model="login" OnValidSubmit="EntrarNaMesa">
                <DataAnnotationsValidator />
                <div class="campo">
                    <label for="nome-login">Nome de usuário</label>
                    <InputText id="nome-login" @bind-Value="login.NomeUsuario" placeholder="ex: cleverson_mestre" />
                </div>
                <div class="campo">
                    <label for="senha-login">Senha</label>
                    <InputText id="senha-login" @bind-Value="login.Senha" type="password" placeholder="••••••••" />
                </div>
                <button class="botao-principal" type="submit">ENTRAR NA MESA</button>
            </EditForm>
            <p class="rodape-login">Ainda não tem conta? <button class="link-formulario botao-link" @onclick="AbrirCadastro">Criar conta</button></p>
        </div>
    </div>
}
else if (telaAtual == Tela.Cadastro)
{
    <div class="tela ativa" id="tela-cadastro">
        <div class="cartao-login">
            <div class="selo-login">🛡️</div>
            <h1>Junte-se à Mesa</h1>
            <p class="subtitulo-login">Crie sua conta e reúna seu grupo para a próxima aventura.</p>
            <EditForm Model="cadastro" OnValidSubmit="CadastrarConta">
                <DataAnnotationsValidator />
                <div class="campo">
                    <label for="nome-cadastro">Nome de usuário</label>
                    <InputText id="nome-cadastro" @bind-Value="cadastro.NomeUsuario" placeholder="ex: cleverson_mestre" />
                </div>
                <div class="campo">
                    <label for="email-cadastro">E-mail</label>
                    <InputText id="email-cadastro" @bind-Value="cadastro.Email" type="email" placeholder="voce@email.com" />
                </div>
                <div class="campo">
                    <label for="senha-cadastro">Senha</label>
                    <InputText id="senha-cadastro" @bind-Value="cadastro.Senha" type="password" placeholder="Crie uma senha" />
                </div>
                <div class="termos">
                    <InputCheckbox id="termos" @bind-Value="cadastro.AceitouTermos" />
                    <label for="termos">Li e aceito os <span class="link-formulario">Termos de Uso e a Política de Privacidade</span>.</label>
                </div>
                <button class="botao-principal" type="submit">CRIAR MINHA CONTA</button>
            </EditForm>
            <p class="rodape-login">Já tem uma conta? <button class="link-formulario botao-link" @onclick="AbrirLogin">Entrar na mesa</button></p>
        </div>
    </div>
}
else
{
    <div class="tela ativa" id="tela-aplicativo">
        <nav class="barra-lateral fundo-couro">
            <div class="marca-barra">🎲</div>
            <button class='aba @(abaSelecionada == "campanhas" ? "ativa" : string.Empty)' @onclick='() => SelecionarAba("campanhas")'>
                <div class="icone-aba">📜</div><div class="rotulo-aba">Campanha</div>
            </button>
            <button class='aba @(abaSelecionada == "mesa" ? "ativa" : string.Empty)' @onclick='() => SelecionarAba("mesa")'>
                <div class="icone-aba">🗺️</div><div class="rotulo-aba">Mesa</div>
            </button>
            <button class='aba @(abaSelecionada == "personagens" ? "ativa" : string.Empty)' @onclick='() => SelecionarAba("personagens")'>
                <div class="icone-aba">🛡️</div><div class="rotulo-aba">Heróis</div>
            </button>
            <button class='aba @(abaSelecionada == "regras" ? "ativa" : string.Empty)' @onclick='() => SelecionarAba("regras")'>
                <div class="icone-aba">📖</div><div class="rotulo-aba">Regras</div>
            </button>
            <div class="espacador-barra"></div>
            <button class="aba aba-saida" @onclick="SairDaMesa">
                <div class="icone-aba">🚪</div><div class="rotulo-aba">Sair</div>
            </button>
        </nav>

        <div class="area-principal fundo-pergaminho">
            @if (abaSelecionada == "campanhas")
            {
                <section class="conteudo-aba visivel">
                    <div class="cabecalho-area"><h1>Campanhas</h1><span class="migalha">4 campanhas ativas</span></div>
                    <div class="corpo-area">
                        <div class="grade-campanhas">
                            <div class="cartao-campanha"><h3>A Cidadela das Salamandras</h3><p>Um general em chamas ameaça o vale de Rhoumed.</p><div class="metadados"><span>👑 Mestre: Nefertyne</span><span>👥 4 jogadores</span></div></div>
                            <div class="cartao-campanha"><h3>Pousada Água Azul</h3><p>Um pouso tranquilo esconde segredos nos porões.</p><div class="metadados"><span>👑 Mestre: Cleverson</span><span>👥 3 jogadores</span></div></div>
                            <div class="cartao-campanha"><h3>Castelo Ravenloft</h3><p>Teias gigantes cobrem a floresta ao redor do castelo.</p><div class="metadados"><span>👑 Mestre: Brando</span><span>👥 5 jogadores</span></div></div>
                            <div class="nova-campanha"><div class="icone-nova-campanha">+</div><div class="rotulo-nova-campanha">Criar nova campanha</div></div>
                        </div>
                    </div>
                </section>
            }
            else if (abaSelecionada == "mesa")
            {
                <section class="conteudo-aba visivel">
                    <div class="cabecalho-area"><h1>Cidadela das Salamandras — Sessão 7</h1><span class="migalha">Rodada 3 · Turno de Arthur</span></div>
                    <div class="corpo-area">
                        <div class="estrutura-mesa">
                            <div class="painel">
                                <h2>Registro da Mesa</h2>
                                <div class="registro">
                                    @foreach (var entrada in registros)
                                    {
                                        <div class="entrada-registro @entrada.Tipo"><span class="autor">@entrada.Autor</span> @entrada.Texto <span class="rolagem">@entrada.Rolagem</span></div>
                                    }
                                </div>
                                <div class="bandeja-dados">
                                    <div class="face-dado">@EstadoMesa.UltimoDado</div>
                                    <button class="botao-arduino" @onclick="RolarDado">⚡ Rolar dado físico</button>
                                    <div class="ponto-conexao"></div><span class="rotulo-conexao">Pronto</span>
                                </div>
                            </div>
                            <div class="coluna-lateral">
                                <div class="painel"><h2>Ordem de Turno</h2><ul class="lista-turnos"><li class="linha-turno atual"><div class="avatar">A</div><div class="envoltorio-nome"><div class="nome">Arthur</div><div class="barra-vida"><div class="preenchimento vida-82"></div></div></div><div class="iniciativa">19</div></li><li class="linha-turno"><div class="avatar">C</div><div class="envoltorio-nome"><div class="nome">Caine</div><div class="barra-vida"><div class="preenchimento vida-64"></div></div></div><div class="iniciativa">16</div></li><li class="linha-turno"><div class="avatar">H</div><div class="envoltorio-nome"><div class="nome">Hurry</div><div class="barra-vida"><div class="preenchimento vida-38"></div></div></div><div class="iniciativa">12</div></li></ul></div>
                                <div class="painel"><h2>Mestre</h2><div class="nota-mestre">Nefertyne está narrando esta cena.</div></div>
                            </div>
                        </div>
                    </div>
                </section>
            }
            else if (abaSelecionada == "personagens")
            {
                <section class="conteudo-aba visivel"><div class="cabecalho-area"><h1>Personagens</h1><span class="migalha">3 fichas nesta campanha</span></div><div class="corpo-area"><div class="grade-personagens"><div class="cartao-personagem"><div class="retrato-personagem">🗡️<span class="etiqueta-classe">Guerreiro</span></div><div class="informacoes-personagem"><h3>Arthur</h3><p>Nível 6 · Humano</p></div></div><div class="cartao-personagem"><div class="retrato-personagem">🏹<span class="etiqueta-classe">Patrulheiro</span></div><div class="informacoes-personagem"><h3>Caine</h3><p>Nível 5 · Elfo</p></div></div><div class="cartao-personagem"><div class="retrato-personagem">🔥<span class="etiqueta-classe">Bárbaro</span></div><div class="informacoes-personagem"><h3>Hurry</h3><p>Nível 6 · Meio-orc</p></div></div></div></div></section>
            }
            else
            {
                <section class="conteudo-aba visivel"><div class="cabecalho-area"><h1>Regras da Casa</h1><span class="migalha">Editável apenas pelo Mestre</span></div><div class="corpo-area"><div class="painel painel-regras"><h2>Combate</h2><div class="texto-regras">Acertos críticos causam dano dobrado apenas nos dados, não nos modificadores.</div></div></div></section>
            }
        </div>
    </div>
}

@code {
    private Tela telaAtual = Tela.Login;
    private string abaSelecionada = "campanhas";
    private ModeloLogin login = new();
    private ModeloCadastro cadastro = new();
    private List<EntradaRegistro> registros = new()
    {
        new("narracao", "Narrador", "O General Salamandra investe com a lança.", ""),
        new("jogador", "Arthur", "mira no devorador de mentes.", "1d20+3 = 19")
    };

    private void EntrarNaMesa()
    {
        // A Marjorye deixou esse passo bem direto: validou, entrou e bora jogar.
        EstadoMesa.Entrar(login.NomeUsuario);
        telaAtual = Tela.Aplicativo;
    }

    private void AbrirCadastro() => telaAtual = Tela.Cadastro;
    private void AbrirLogin() => telaAtual = Tela.Login;

    private void CadastrarConta()
    {
        // Por enquanto a conta fica só no estado da tela; o banco entra numa próxima fase.
        login.NomeUsuario = cadastro.NomeUsuario;
        telaAtual = Tela.Login;
    }

    private void SairDaMesa()
    {
        // Limpando a sessão para ninguém ficar preso na aventura anterior.
        EstadoMesa.Sair();
        telaAtual = Tela.Login;
    }

    private void SelecionarAba(string aba) => abaSelecionada = aba;

    private void RolarDado()
    {
        var resultado = EstadoMesa.RolarDado();
        registros.Add(new("arduino", "⚡ Dado físico", "valor lido na mesa", $"d20 = {resultado}"));
    }

    private enum Tela { Login, Cadastro, Aplicativo }

    private sealed class ModeloLogin
    {
        [Required] public string NomeUsuario { get; set; } = string.Empty;
        [Required] public string Senha { get; set; } = string.Empty;
    }

    private sealed class ModeloCadastro
    {
        [Required] public string NomeUsuario { get; set; } = string.Empty;
        [Required, EmailAddress] public string Email { get; set; } = string.Empty;
        [Required, MinLength(6)] public string Senha { get; set; } = string.Empty;
        [Range(typeof(bool), "true", "true", ErrorMessage = "Você precisa aceitar os termos.")]
        public bool AceitouTermos { get; set; }
    }

    private sealed record EntradaRegistro(string Tipo, string Autor, string Texto, string Rolagem);
}
