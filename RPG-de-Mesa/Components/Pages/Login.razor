@page "/"

<div class="screen active" id="screen-login">
    <div class="login-card">
        <div class="login-seal">⚔️</div>
        <h1>Salão da Mesa</h1>
        <p class="login-sub">
            Sua campanha, seus dados, seu tabuleiro — conectados.
        </p>
        <div class="field">
            <label>Nome de usuário</label>
            <input type="text" placeholder="ex: cleverson_mestre" />
        </div>
        <div class="field">
            <label>Senha</label>
            <input type="password" placeholder="••••••••" />
        </div>
        <button class="btn-primary" onclick="enterApp()">ENTRAR NA MESA</button>
        <p class="login-foot">
            Ainda não tem conta?
            <span style="color: var(--ember); cursor: pointer">Criar conta</span>
        </p>
    </div>
</div>


