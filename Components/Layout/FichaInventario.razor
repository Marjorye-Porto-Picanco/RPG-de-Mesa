@using RPGdeMesa.Models

<div class="visao-ficha visao-inventario" id="visao-inventario" role="tabpanel" aria-labelledby="aba-inventario">
    <form id="form-inventario" class="inventario-aba" @onsubmit="SalvarInventario" @onsubmit:preventDefault="true">
        <div class="corpo-inventario">
            <div class="listas-itens">
                <!-- Seção: Armas -->
                <section class="categoria-itens" aria-labelledby="titulo-armas">
                    <div class="titulo-categoria">
                        <h2 id="titulo-armas"><span aria-hidden="true">⌁</span> Armas</h2>
                        <button class="adicionar-item" type="button" data-adicionar="lista-armas" @onclick='() => AdicionarItem("Armas")' aria-label="Adicionar arma" title="Adicionar arma">
                            <span aria-hidden="true">+</span>
                        </button>
                    </div>
                    <div class="cabecalho-linha" aria-hidden="true">
                        <span>Nome</span>
                        <span>Qtd.</span>
                        <span>Peso</span>
                        <span>Valor</span>
                        <span></span>
                    </div>
                    <div class="lista-linhas" id="lista-armas" data-lista="armas">
                        @foreach (var item in Itens.Where(i => i.Categoria == "Armas"))
                        {
                            <div class="item-linha">
                                <input data-campo="nome" @bind="item.Nome" placeholder="Nome da arma" aria-label="Nome da arma" />
                                <input data-campo="quantidade" type="number" min="0" @bind="item.Quantidade" aria-label="Quantidade de @item.Nome" />
                                <input data-campo="peso" type="number" min="0" step="0.1" @bind="item.Peso" aria-label="Peso de @item.Nome em quilogramas" />
                                <input data-campo="valor" @bind="item.Valor" placeholder="Valor" aria-label="Valor de @item.Nome" />
                                <button class="remover-item" type="button" @onclick="() => RemoverItem(item)" aria-label="Remover @item.Nome">×</button>
                            </div>
                        }
                    </div>
                </section>

                <!-- Seção: Armaduras e escudos -->
                <section class="categoria-itens" aria-labelledby="titulo-armaduras">
                    <div class="titulo-categoria">
                        <h2 id="titulo-armaduras"><span aria-hidden="true">⌁</span> Armaduras e escudos</h2>
                        <button class="adicionar-item" type="button" data-adicionar="lista-armaduras" @onclick='() => AdicionarItem("Armaduras")' aria-label="Adicionar armadura ou escudo" title="Adicionar armadura ou escudo">
                            <span aria-hidden="true">+</span>
                        </button>
                    </div>
                    <div class="cabecalho-linha" aria-hidden="true">
                        <span>Nome</span>
                        <span>Qtd.</span>
                        <span>Peso</span>
                        <span>Valor</span>
                        <span></span>
                    </div>
                    <div class="lista-linhas" id="lista-armaduras" data-lista="armaduras">
                        @foreach (var item in Itens.Where(i => i.Categoria == "Armaduras"))
                        {
                            <div class="item-linha">
                                <input data-campo="nome" @bind="item.Nome" placeholder="Nome da armadura" aria-label="Nome da armadura" />
                                <input data-campo="quantidade" type="number" min="0" @bind="item.Quantidade" aria-label="Quantidade de @item.Nome" />
                                <input data-campo="peso" type="number" min="0" step="0.1" @bind="item.Peso" aria-label="Peso de @item.Nome em quilogramas" />
                                <input data-campo="valor" @bind="item.Valor" placeholder="Valor" aria-label="Valor de @item.Nome" />
                                <button class="remover-item" type="button" @onclick="() => RemoverItem(item)" aria-label="Remover @item.Nome">×</button>
                            </div>
                        }
                    </div>
                </section>

                <!-- Seção: Poções e consumíveis -->
                <section class="categoria-itens" aria-labelledby="titulo-pocoes">
                    <div class="titulo-categoria">
                        <h2 id="titulo-pocoes"><span aria-hidden="true">⌁</span> Poções e consumíveis</h2>
                        <button class="adicionar-item" type="button" data-adicionar="lista-pocoes" @onclick='() => AdicionarItem("Consumiveis")' aria-label="Adicionar poção ou consumível" title="Adicionar poção ou consumível">
                            <span aria-hidden="true">+</span>
                        </button>
                    </div>
                    <div class="cabecalho-linha" aria-hidden="true">
                        <span>Nome</span>
                        <span>Qtd.</span>
                        <span>Peso</span>
                        <span>Valor</span>
                        <span></span>
                    </div>
                    <div class="lista-linhas" id="lista-pocoes" data-lista="pocoes">
                        @foreach (var item in Itens.Where(i => i.Categoria == "Consumiveis"))
                        {
                            <div class="item-linha">
                                <input data-campo="nome" @bind="item.Nome" placeholder="Nome da poção ou consumível" aria-label="Nome da poção" />
                                <input data-campo="quantidade" type="number" min="0" @bind="item.Quantidade" aria-label="Quantidade de @item.Nome" />
                                <input data-campo="peso" type="number" min="0" step="0.1" @bind="item.Peso" aria-label="Peso de @item.Nome em quilogramas" />
                                <input data-campo="valor" @bind="item.Valor" placeholder="Valor" aria-label="Valor de @item.Nome" />
                                <button class="remover-item" type="button" @onclick="() => RemoverItem(item)" aria-label="Remover @item.Nome">×</button>
                            </div>
                        }
                    </div>
                </section>

                <!-- Seção: Materiais e outros -->
                <section class="categoria-itens" aria-labelledby="titulo-outros">
                    <div class="titulo-categoria">
                        <h2 id="titulo-outros"><span aria-hidden="true">⌁</span> Materiais e outros</h2>
                        <button class="adicionar-item" type="button" data-adicionar="lista-outros" @onclick='() => AdicionarItem("Outros")' aria-label="Adicionar material ou item" title="Adicionar material ou item">
                            <span aria-hidden="true">+</span>
                        </button>
                    </div>
                    <div class="cabecalho-linha" aria-hidden="true">
                        <span>Nome</span>
                        <span>Qtd.</span>
                        <span>Peso</span>
                        <span>Valor</span>
                        <span></span>
                    </div>
                    <div class="lista-linhas" id="lista-outros" data-lista="outros">
                        @foreach (var item in Itens.Where(i => i.Categoria == "Outros"))
                        {
                            <div class="item-linha">
                                <input data-campo="nome" @bind="item.Nome" placeholder="Nome do item" aria-label="Nome do item" />
                                <input data-campo="quantidade" type="number" min="0" @bind="item.Quantidade" aria-label="Quantidade de @item.Nome" />
                                <input data-campo="peso" type="number" min="0" step="0.1" @bind="item.Peso" aria-label="Peso de @item.Nome em quilogramas" />
                                <input data-campo="valor" @bind="item.Valor" placeholder="Valor" aria-label="Valor de @item.Nome" />
                                <button class="remover-item" type="button" @onclick="() => RemoverItem(item)" aria-label="Remover @item.Nome">×</button>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <!-- Resumo lateral: Moedas, Carga e Notas -->
            <aside class="resumo-inventario" aria-label="Resumo do inventário">
                <section class="painel-moedas">
                    <h2>Moedas</h2>
                    <div class="moedas-grade">
                        <label class="moeda"><span class="icone-moeda">PC</span><input name="moeda-pc" type="number" min="0" @bind="MoedasPC" aria-label="Quantidade de peças de cobre" /><small>PC</small></label>
                        <label class="moeda"><span class="icone-moeda prata">PP</span><input name="moeda-pp" type="number" min="0" @bind="MoedasPP" aria-label="Quantidade de peças de prata" /><small>PP</small></label>
                        <label class="moeda"><span class="icone-moeda electrum">PE</span><input name="moeda-pe" type="number" min="0" @bind="MoedasPE" aria-label="Quantidade de peças de electrum" /><small>PE</small></label>
                        <label class="moeda"><span class="icone-moeda ouro">PO</span><input name="moeda-po" type="number" min="0" @bind="MoedasPO" aria-label="Quantidade de peças de ouro" /><small>PO</small></label>
                        <label class="moeda"><span class="icone-moeda platina">PL</span><input name="moeda-pl" type="number" min="0" @bind="MoedasPL" aria-label="Quantidade de peças de platina" /><small>PL</small></label>
                    </div>
                    <p class="nota-moedas">Atualize o tesouro conforme a aventura avança.</p>
                </section>

                <section class="painel-carga">
                    <h2>Carga carregada</h2>
                    <p>
                        <strong id="peso-atual-texto">@PesoTotal.ToString("0.0") kg</strong>
                        <span> / @LimiteCarga.ToString("0.0") kg</span>
                    </p>
                    <progress id="barra-carga" max="@LimiteCarga" value="@PesoTotal" aria-label="Carga carregada em relação ao limite"></progress>
                    <small>Limite de carga</small>
                </section>

                <label class="painel-notas" for="notas-inventario">
                    <span>Notas do inventário</span>
                    <textarea id="notas-inventario" name="notas" rows="7" @bind="Notas" placeholder="Anote detalhes, origem ou efeitos dos itens."></textarea>
                </label>
            </aside>
        </div>

        
    </form>
</div>

@code {
    [Parameter]
    public Personagem Personagem { get; set; } = new();

    public class ItemInventario
    {
        public string Nome { get; set; } = "";
        public int Quantidade { get; set; } = 1;
        public double Peso { get; set; } = 0.0;
        public string Valor { get; set; } = "";
        public string Categoria { get; set; } = "Outros";
    }

    private List<ItemInventario> Itens = new()
    {
        new ItemInventario { Nome = "Arco longo", Quantidade = 1, Peso = 1.0, Valor = "50 po", Categoria = "Armas" },
        new ItemInventario { Nome = "Adaga de caça", Quantidade = 2, Peso = 0.5, Valor = "2 po", Categoria = "Armas" },
        new ItemInventario { Nome = "Couro batido", Quantidade = 1, Peso = 6.5, Valor = "45 po", Categoria = "Armaduras" },
        new ItemInventario { Nome = "Poção de cura", Quantidade = 3, Peso = 0.5, Valor = "50 po", Categoria = "Consumiveis" },
        new ItemInventario { Nome = "Ração de viagem", Quantidade = 5, Peso = 1.0, Valor = "5 pp", Categoria = "Consumiveis" },
        new ItemInventario { Nome = "Amuleto de âmbar", Quantidade = 1, Peso = 0.2, Valor = "25 po", Categoria = "Outros" }
    };

    private int MoedasPC = 0;
    private int MoedasPP = 0;
    private int MoedasPE = 0;
    private int MoedasPO = 12;
    private int MoedasPL = 0;

    private double LimiteCarga = 76.3;
    private double PesoTotal => Itens.Sum(i => i.Peso * i.Quantidade);

    private string Notas = "O amuleto de âmbar pertenceu à avó de Lyra.";
    private string StatusMensagem = "As alterações ficam salvas neste dispositivo.";

    private void AdicionarItem(string categoria)
    {
        Itens.Add(new ItemInventario
        {
            Nome = "",
            Quantidade = 1,
            Peso = 0.0,
            Valor = "",
            Categoria = categoria
        });
    }

    private void RemoverItem(ItemInventario item)
    {
        Itens.Remove(item);
    }

    private void SalvarInventario()
    {
        StatusMensagem = "Inventário salvo com sucesso!";
    }
}