<!-- Components/InventarioModal.razor -->
<div class="modal-backdrop" @onclick="FecharModal"></div>

<div class="inventario-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-inventario">
    <header class="inventario-popup-header">
        <div>
            <p>Mochila do Aventureiro</p>
            <h2 id="titulo-inventario">Inventário & Equipamento</h2>
        </div>
        <button class="dice-close" type="button" aria-label="Fechar inventário" @onclick="FecharModal">×</button>
    </header>

    <div class="inventario-popup-corpo">
        <FichaInventario />
    </div>
</div>

@code {
    [Parameter]
    public EventCallback FecharModal { get; set; }
}