@using RPGdeMesa.Models

<div class="visao-ficha visao-personagem" id="visao-personagem" role="tabpanel" aria-labelledby="aba-personagem">
    <div class="dados-pessoais">
        <div class="campo-personagem campo-nome">
            <span>Nome</span>
            <input @bind="Personagem.Nome" placeholder="Nome" style="background:transparent; border:none; border-bottom:1px solid #9c783d; color:inherit; font:inherit; font-weight:bold;" />
        </div>
        <div class="campo-personagem">
            <span>Idade</span>
            <input @bind="Personagem.Idade" placeholder="Ex: 128 anos" style="background:transparent; border:none; border-bottom:1px solid #9c783d; color:inherit; font:inherit; font-weight:bold;" />
        </div>
        <div class="campo-personagem">
            <span>Gênero</span>
            <input @bind="Personagem.Genero" placeholder="Ex: Feminino" style="background:transparent; border:none; border-bottom:1px solid #9c783d; color:inherit; font:inherit; font-weight:bold;" />
        </div>
        <div class="campo-personagem">
            <span>Altura</span>
            <input @bind="Personagem.Altura" placeholder="Ex: 1,72 m" style="background:transparent; border:none; border-bottom:1px solid #9c783d; color:inherit; font:inherit; font-weight:bold;" />
        </div>
        <div class="campo-personagem">
            <span>Peso</span>
            <input @bind="Personagem.Peso" placeholder="Ex: 64 kg" style="background:transparent; border:none; border-bottom:1px solid #9c783d; color:inherit; font:inherit; font-weight:bold;" />
        </div>
    </div>
    
    <div class="historia-grade">
        <section class="painel-personagem aparencia">
            <h2>Aparência</h2>
            <textarea @bind="Personagem.Aparencia" rows="3" placeholder="Descreva a aparência..." style="width:100%; background:rgba(255,255,255,0.4); border:1px solid rgba(156,120,61,0.5); border-radius:4px; padding:6px; font:inherit; color:inherit;"></textarea>
        </section>
        
        <section class="painel-personagem aliados">
            <h2>Aliados e organizações</h2>
            <textarea @bind="Personagem.Aliados" rows="3" placeholder="Descreva aliados e organizações..." style="width:100%; background:rgba(255,255,255,0.4); border:1px solid rgba(156,120,61,0.5); border-radius:4px; padding:6px; font:inherit; color:inherit;"></textarea>
        </section>
        
        <section class="painel-personagem historia">
            <h2>História do personagem</h2>
            <textarea @bind="Personagem.Historia" rows="5" placeholder="De onde veio? O que busca?..." style="width:100%; background:rgba(255,255,255,0.4); border:1px solid rgba(156,120,61,0.5); border-radius:4px; padding:6px; font:inherit; color:inherit;"></textarea>
        </section>
        
        <section class="painel-personagem outras-caracteristicas">
            <h2>Características e habilidades</h2>
            <textarea @bind="Personagem.Caracteristicas" rows="3" placeholder="Características e habilidades..." style="width:100%; background:rgba(255,255,255,0.4); border:1px solid rgba(156,120,61,0.5); border-radius:4px; padding:6px; font:inherit; color:inherit;"></textarea>
        </section>
        
        <section class="painel-personagem tesouro">
            <h2>Tesouro pessoal</h2>
            <textarea @bind="Personagem.Tesouro" rows="3" placeholder="Tesouro pessoal..." style="width:100%; background:rgba(255,255,255,0.4); border:1px solid rgba(156,120,61,0.5); border-radius:4px; padding:6px; font:inherit; color:inherit;"></textarea>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public Personagem Personagem { get; set; } = new();
}