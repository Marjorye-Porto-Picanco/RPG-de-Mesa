@using RPGdeMesa.Models

<div class="visao-ficha visao-personagem" id="visao-personagem" role="tabpanel" aria-labelledby="aba-personagem">
    <div class="dados-pessoais">
        <div class="campo-personagem campo-nome">
            <span>Nome</span>
            <input @bind="Personagem.Nome" placeholder="Nome" />
        </div>
        <div class="campo-personagem">
            <span>Idade</span>
            <input @bind="Personagem.Idade" placeholder="Ex: 128 anos" />
        </div>
        <div class="campo-personagem">
            <span>Gênero</span>
            <input @bind="Personagem.Genero" placeholder="Ex: Feminino" />
        </div>
        <div class="campo-personagem">
            <span>Altura</span>
            <input @bind="Personagem.Altura" placeholder="Ex: 1,72 m" />
        </div>
        <div class="campo-personagem">
            <span>Peso</span>
            <input @bind="Personagem.Peso" placeholder="Ex: 64 kg" />
        </div>
    </div>
    
    <div class="historia-grade">
        <section class="painel-personagem aparencia">
            <h2>Aparência</h2>
            <textarea @bind="Personagem.Aparencia" rows="3" placeholder="Descreva a aparência..."></textarea>
        </section>
        
        <section class="painel-personagem aliados">
            <h2>Aliados e organizações</h2>
            <textarea @bind="Personagem.Aliados" rows="3" placeholder="Descreva aliados e organizações..."></textarea>
        </section>
        
        <section class="painel-personagem historia">
            <h2>História do personagem</h2>
            <textarea @bind="Personagem.Historia" rows="5" placeholder="De onde veio? O que busca?..."></textarea>
        </section>
        
        <section class="painel-personagem outras-caracteristicas">
            <h2>Características e habilidades</h2>
            <textarea @bind="Personagem.Caracteristicas" rows="3" placeholder="Características e habilidades..."></textarea>
        </section>
        
        <section class="painel-personagem tesouro">
            <h2>Tesouro pessoal</h2>
            <textarea @bind="Personagem.Tesouro" rows="3" placeholder="Tesouro pessoal..."></textarea>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public Personagem Personagem { get; set; } = new();
}