@page "/monstro-criar"

    <div class="app-shell page-monstro-criar">
  

    <main class="app-content">
        <a class="text-link" href="monstros-lib">← Voltar à biblioteca</a>
        <div class="page-heading" style="margin-top: 16px">
            <div><p class="page-kicker">Acrescente uma ameaça ao bestiário</p><h1 class="page-title">Cadastrar monstro</h1><p class="page-description">Defina as características e os recursos da criatura.</p></div>
        </div>

        <form id="form-monstro" class="form-layout">
            <section class="form-panel">
                <h2>Descrição e estatísticas</h2>
                <div class="form-grid">
                    <label class="form-field full-width">Nome da criatura<input name="nome" required maxlength="60" placeholder="Ex.: Guardião das raízes" /></label>
                    <label class="form-field">Tipo<select name="tipo" required><option value="outro">Outro</option><option value="dragao">Dragão</option><option value="fera">Fera</option><option value="monstruosidade">Monstruosidade</option><option value="morto-vivo">Morto-vivo</option></select></label>
                    <label class="form-field">Tamanho<select name="tamanho"><option>Pequeno</option><option selected>Médio</option><option>Grande</option><option>Enorme</option><option>Imenso</option></select></label>
                    <label class="form-field">Alinhamento<input name="tendencia" maxlength="40" placeholder="Ex.: Caótico e mau" /></label>
                    <label class="form-field">Nível de desafio<input name="nd" type="number" min="0" max="30" step="0.125" value="1" /></label>
                    <div class="form-divider">Combate e sentidos</div>
                    <label class="form-field">Classe de armadura<input name="ca" type="number" min="0" max="40" value="13" /></label>
                    <label class="form-field">Pontos de vida<input name="pv" type="number" min="1" max="9999" value="24" /></label>
                    <label class="form-field">Deslocamento<input name="deslocamento" maxlength="50" placeholder="9 m, escavação 3 m" /></label>
                    <label class="form-field">Sentidos<input name="sentidos" maxlength="80" placeholder="Visão no escuro 18 m" /></label>
                    <label class="form-field full-width">Resistências e imunidades<input name="resistencias" maxlength="120" placeholder="Ex.: frio, veneno" /></label>
                    <label class="form-field full-width">Habilidades especiais<input name="habilidades" maxlength="160" placeholder="Separe cada habilidade por vírgula" /></label>
                    <label class="form-field full-width">Descrição<textarea name="descricao" maxlength="1000" placeholder="Aparência, comportamento, táticas ou qualquer detalhe útil na sessão."></textarea></label>
                    <label class="form-field full-width">Ilustração<select name="imagem"><option value="img/capacampanha3.png">Ruínas antigas</option><option value="img/capacampanha6.png">Criatura selvagem</option><option value="img/capacampanha7.png">Floresta sombria</option><option value="img/capacampanha8.png">Ameaça infernal</option><option value="img/capacampanha10.png">Dragão ancestral</option></select></label>
                    <div class="form-field full-width upload-imagem">
                        <span>Ou envie uma ilustração</span>
                        <label class="upload-imagem-botao"><span aria-hidden="true">↑</span> Escolher imagem do monstro<input id="arquivo-monstro" type="file" accept="image/*" aria-label="Escolher imagem do monstro" /></label>
                        <p class="upload-imagem-ajuda">Uma imagem enviada substitui a ilustração selecionada acima.</p>
                        <p class="upload-imagem-status" data-upload-status role="status" aria-live="polite"></p>
                    </div>
                </div>
                <div class="form-footer">
                    <p id="status-monstro" class="form-status" role="status" aria-live="polite"></p>
                    <div><a class="action-secondary" href="monstros-lib.html">Cancelar</a> <button class="action-primary" type="submit">Salvar monstro <span aria-hidden="true">→</span></button></div>
                </div>
            </section>

            <aside class="form-aside">
                <div class="aside-portrait"><img id="imagem-previa" src="img/capacampanha3.png" alt="Ilustração selecionada para o monstro" /></div>
                <div class="aside-note"><strong>Seu bestiário, suas regras</strong>As criaturas personalizadas ficam disponíveis na sua biblioteca neste navegador, prontas para consulta e preparação de encontros.</div>
            </aside>
        </form>
    </main>
</div>

