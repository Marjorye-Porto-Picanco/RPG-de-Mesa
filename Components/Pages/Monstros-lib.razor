@page "/monstros-lib"
@using RPGdeMesa.Services
@using RPGdeMesa.Models
@inject MonstroService MonstroService
@inject SessaoUsuarioService SessaoUsuario

<NavMenu />
<div class="app-shell">
    <main class="app-content">
        <div class="page-heading">
            <div>
                <p class="page-kicker">Bestiário da mesa</p>
                <h1 class="page-title">Biblioteca de monstros</h1>
                <p class="page-description">Ameaças conhecidas e criaturas criadas para suas campanhas.</p>
            </div>
            <a class="action-primary" href="/monstro-criar"><span aria-hidden="true">+</span> Cadastrar monstro</a>
        </div>

        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <div style="background: rgba(220, 53, 69, 0.2); border: 1px solid #dc3545; padding: 15px; color: #ff8080; margin-bottom: 20px; border-radius: 4px; font-family: monospace;">
                <strong>Erro capturado:</strong> @mensagemErro
            </div>
        }

        <div class="toolbar-library" role="search">
            <label class="search-field">
                <span aria-hidden="true">⌕</span>
                <input id="busca-monstro" type="search" placeholder="Buscar por nome, tipo ou alinhamento" aria-label="Buscar monstros" @bind="termoBusca" @bind:event="oninput" />
            </label>
            <label>
                <span class="page-kicker" style="display:none">Tipo</span>
                <select class="filter-select" id="filtro-tipo" aria-label="Filtrar por tipo" @bind="filtroTipo">
                    <option value="todos">Todos os tipos</option>
                    <option value="dragao">Dragões</option>
                    <option value="fera">Feras</option>
                    <option value="monstruosidade">Monstruosidades</option>
                    <option value="morto-vivo">Mortos-vivos</option>
                    <option value="outro">Outros</option>
                </select>
            </label>
        </div>

        <div class="monster-grid" id="grade-monstros" aria-live="polite">
            @if (MonstrosFiltrados.Any())
            {
                foreach (var monstro in MonstrosFiltrados)
                {
                    <div class="monster-card" @onclick="() => AbrirModal(monstro)">
                        <div class="monster-art">
                            <img src="@(string.IsNullOrEmpty(monstro.Imagem) ? "img/capacampanha3.png" : monstro.Imagem)" alt="Ilustração do monstro @monstro.Nome" />
                            <span class="monster-cr">ND @(monstro.Nd)</span>
                        </div>
                        <div class="monster-info">
                            <h2>@monstro.Nome</h2>
                            <p>@(monstro.Tipo ?? "Criatura") @(monstro.Tamanho?.ToLower() ?? "médio") · @(monstro.Tendencia ?? "Neutro")</p>
                            @if (!string.IsNullOrEmpty(monstro.Habilidades))
                            {
                                <div class="monster-tags">
                                    @foreach (var hab in monstro.Habilidades.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span>@hab.Trim()</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="mensagem-vazia">Nenhum monstro encontrado na sua biblioteca.</p>
            }
        </div>
    </main>
</div>

<!-- POP-UP / MODAL DE VISUALIZAÇÃO -->
@if (exibirModal && monstroSelecionado != null)
{
    <div class="modal-overlay" @onclick="FecharModal">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="FecharModal">×</button>

            <div class="page-heading cabecalho-modal">
                <div>
                    <p class="page-kicker">Visualizar criatura</p>
                    <h1 class="page-title titulo-modal">@monstroSelecionado.Nome</h1>
                    <p class="page-description">Detalhes e estatísticas registradas no bestiário.</p>
                </div>
            </div>

            <div class="form-layout">
                <section class="form-panel">
                    <h2>Descrição e estatísticas</h2>
                    <div class="form-grid">
                        <div class="form-field full-width">
                            <span class="field-label-title">Nome da criatura</span>
                            <div class="field-value-box">@monstroSelecionado.Nome</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Tipo</span>
                            <div class="field-value-box">@(monstroSelecionado.Tipo ?? "Outro")</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Tamanho</span>
                            <div class="field-value-box">@(monstroSelecionado.Tamanho ?? "Médio")</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Alinhamento</span>
                            <div class="field-value-box">@(string.IsNullOrEmpty(monstroSelecionado.Tendencia) ? "Não informado" : monstroSelecionado.Tendencia)</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Nível de desafio</span>
                            <div class="field-value-box">ND @monstroSelecionado.Nd</div>
                        </div>

                        <div class="form-divider">Combate e sentidos</div>

                        <div class="form-field">
                            <span class="field-label-title">Classe de armadura</span>
                            <div class="field-value-box">@monstroSelecionado.Defesa</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Pontos de vida</span>
                            <div class="field-value-box">@monstroSelecionado.Vida</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Deslocamento</span>
                            <div class="field-value-box">@(string.IsNullOrEmpty(monstroSelecionado.Deslocamento) ? "Não informado" : monstroSelecionado.Deslocamento)</div>
                        </div>

                        <div class="form-field">
                            <span class="field-label-title">Sentidos</span>
                            <div class="field-value-box">@(string.IsNullOrEmpty(monstroSelecionado.Sentidos) ? "Não informado" : monstroSelecionado.Sentidos)</div>
                        </div>

                        <div class="form-field full-width">
                            <span class="field-label-title">Resistências e imunidades</span>
                            <div class="field-value-box">@(string.IsNullOrEmpty(monstroSelecionado.Resistencias) ? "Nenhuma" : monstroSelecionado.Resistencias)</div>
                        </div>

                        <div class="form-field full-width">
                            <span class="field-label-title">Habilidades especiais</span>
                            <div class="field-value-box">@(string.IsNullOrEmpty(monstroSelecionado.Habilidades) ? "Nenhuma" : monstroSelecionado.Habilidades)</div>
                        </div>

                        <div class="form-field full-width">
                            <span class="field-label-title">Descrição</span>
                            <div class="field-value-box caixa-descricao">@(string.IsNullOrEmpty(monstroSelecionado.Descricao) ? "Nenhuma descrição fornecida." : monstroSelecionado.Descricao)</div>
                        </div>
                    </div>

                    <div class="form-footer rodape-modal">
                        <button type="button" class="action-secondary" @onclick="FecharModal">Fechar</button>
                    </div>
                </section>

                <aside class="form-aside">
                    <div class="aside-portrait">
                        <img src="@(string.IsNullOrEmpty(monstroSelecionado.Imagem) ? "img/capacampanha3.png" : monstroSelecionado.Imagem)" alt="Ilustração do monstro" />
                    </div>
                    <div class="aside-note">
                        <strong>Bestiário da mesa</strong>
                        Criatura registrada e pronta para ser utilizada nas suas campanhas e sessões de RPG.
                    </div>
                </aside>
            </div>
        </div>
    </div>
}

@code {
    private List<Monstro> listaMonstros = new();
    private string termoBusca = "";
    private string filtroTipo = "todos";
    private string mensagemErro = "";

    private bool exibirModal = false;
    private Monstro? monstroSelecionado = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            int idUsuario = SessaoUsuario.IdUsuarioLogado;
            if (idUsuario > 0)
            {
                listaMonstros = await MonstroService.ObterMonstrosPorUsuarioAsync(idUsuario);
            }
            else
            {
                mensagemErro = "Aviso: Nenhum usuário logado identificado (IdUsuarioLogado é 0 ou menor).";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
        }
    }

    private void AbrirModal(Monstro monstro)
    {
        monstroSelecionado = monstro;
        exibirModal = true;
    }

    private void FecharModal()
    {
        exibirModal = false;
        monstroSelecionado = null;
    }

    private IEnumerable<Monstro> MonstrosFiltrados
    {
        get
        {
            var resultado = listaMonstros.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(termoBusca))
            {
                resultado = resultado.Where(m => (m.Nome != null && m.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
                                                (m.Tipo != null && m.Tipo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
                                                (m.Tendencia != null && m.Tendencia.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));
            }

            if (filtroTipo != "todos")
            {
                resultado = resultado.Where(m => m.Tipo != null && m.Tipo.Equals(filtroTipo, StringComparison.OrdinalIgnoreCase));
            }

            return resultado;
        }
    }
}