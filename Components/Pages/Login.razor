@page "/"
@page "/login"
@layout Layout.EmptyLayout

@inject NavigationManager Navigation

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<section class="fundo">
    <h1>Login</h1>
    <div class="campos">
        <div class="sla">
            <p>Email ou Usuário</p>
            <input type="text" id="email" autocomplete="username" />
        </div>

        <div class="sla">
            <p>Senha</p>
            <input type="password" id="senha" autocomplete="current-password" />
        </div>

        <button type="button" @onclick="entrar">Entrar</button>

        <div class="icons-login">
            <a href="#" aria-label="Entrar com Google"><i class="bi bi-google"></i></a>
            <a href="#" aria-label="Entrar com Facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" aria-label="Entrar com GitHub"><i class="bi bi-github"></i></a>
        </div>

        <label class="termo">
            <span>Não possui conta? <a href="/cadastro">Cadastre-se</a></span>
        </label>
    </div>
</section>

@code{
    void entrar()
    {
        Navigation.NavigateTo("/sessao");
    }
    }
}
