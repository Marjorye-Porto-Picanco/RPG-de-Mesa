@page "/personagem-criar"
@using RPGdeMesa.ViewModel
@inject PersonagemCriarViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable

<NavMenu />

<div class="app-shell">
    <main class="app-content">
        <a class="text-link" href="/personagem-lib">← Voltar aos personagens</a>
        <div class="page-heading" style="margin-top: 16px">
            <div>
                <p class="page-kicker">Uma nova história começa</p>
                <h1 class="page-title">Criar personagem</h1>
                <p class="page-description">Registre as informações essenciais do seu aventureiro.</p>
            </div>
        </div>

        <form id="form-personagem" class="form-layout" @onsubmit="ViewModel.SalvarPersonagemAsync" @onsubmit:preventDefault="true">
            <section class="form-panel">
                <h2>Identidade e jornada</h2>
                <div class="form-grid">
                    <label class="form-field full-width">
                        Nome do personagem
                        <input @bind="ViewModel.PersonagemAtual.Nome" required maxlength="60" placeholder="Ex.: Lyra Ventobrasa" autocomplete="off" />
                    </label>

                    <label class="form-field">
                        Tipo do personagem
                        <select @bind="tipoPersonagem">
                            <option value="Personagem">Personagem</option>
                            <option value="NPC">NPC</option>
                        </select>
                    </label>

                    <label class="form-field">
                        Raça
                        <select @bind="ViewModel.PersonagemAtual.RacaTexto" required>
                            <option value="">Escolha uma raça</option>
                            <option value="Humano">Humano</option>
                            <option value="Elfo">Elfo</option>
                            <option value="Anão">Anão</option>
                            <option value="Halfling">Halfling</option>
                            <option value="Meio-elfo">Meio-elfo</option>
                            <option value="Tiefling">Tiefling</option>
                            <option value="Orc">Orc</option>
                            <option value="Outra">Outra</option>
                        </select>
                    </label>

                    <label class="form-field">
                        Classe
                        <select @bind="ViewModel.PersonagemAtual.ClasseTexto" required>
                            <option value="">Escolha uma classe</option>
                            <option value="Bárbaro">Bárbaro</option>
                            <option value="Bardo">Bardo</option>
                            <option value="Clérigo">Clérigo</option>
                            <option value="Druida">Druida</option>
                            <option value="Guerreiro">Guerreiro</option>
                            <option value="Ladino">Ladino</option>
                            <option value="Mago">Mago</option>
                            <option value="Paladino">Paladino</option>
                            <option value="Patrulheiro">Patrulheiro</option>
                            <option value="Bruxo">Bruxo</option>
                            <option value="Outra">Outra</option>
                        </select>
                    </label>

                    <label class="form-field">
                        Nível
                        <input @bind="ViewModel.PersonagemAtual.Nivel" type="number" min="1" max="20" required />
                    </label>

                    <label class="form-field">
                        Antecedente
                        <input @bind="ViewModel.PersonagemAtual.AntecedenteTexto" maxlength="50" placeholder="Ex.: Batedora" />
                    </label>

                    <label class="form-field">
                        Tendência
                        <select @bind="ViewModel.PersonagemAtual.Tendencia">
                            <option value="Neutra">Neutra</option>
                            <option value="Leal e boa">Leal e boa</option>
                            <option value="Neutra e boa">Neutra e boa</option>
                            <option value="Caótica e boa">Caótica e boa</option>
                            <option value="Leal e neutra">Leal e neutra</option>
                            <option value="Caótica e neutra">Caótica e neutra</option>
                            <option value="Leal e má">Leal e má</option>
                            <option value="Neutra e má">Neutra e má</option>
                            <option value="Caótica e má">Caótica e má</option>
                        </select>
                    </label>

                    <div class="form-divider">Atributos</div>
                    <div class="stat-fields">
                        <label class="form-field">Força<input @bind="ViewModel.PersonagemAtual.Forca" type="number" min="1" max="30" /></label>
                        <label class="form-field">Destreza<input @bind="ViewModel.PersonagemAtual.Destreza" type="number" min="1" max="30" /></label>
                        <label class="form-field">Constituição<input @bind="ViewModel.PersonagemAtual.Constituicao" type="number" min="1" max="30" /></label>
                        <label class="form-field">Inteligência<input @bind="ViewModel.PersonagemAtual.Inteligencia" type="number" min="1" max="30" /></label>
                        <label class="form-field">Sabedoria<input @bind="ViewModel.PersonagemAtual.Sabedoria" type="number" min="1" max="30" /></label>
                        <label class="form-field">Carisma<input @bind="ViewModel.PersonagemAtual.Carisma" type="number" min="1" max="30" /></label>
                    </div>

                    <label class="form-field full-width">
                        História e anotações
                        <textarea @bind="ViewModel.PersonagemAtual.Historia" maxlength="1200" placeholder="De onde veio? O que busca? O que não consegue esquecer?"></textarea>
                    </label>
                </div>

                <div class="form-footer">
                    @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
                    {
                        <p class="form-status" style="color: @(ViewModel.Sucesso ? "#28a745" : "#dc3545"); font-weight: bold; margin-bottom: 10px;" role="status" aria-live="polite">
                            @ViewModel.MensagemFeedback
                        </p>
                    }
                    <div>
                        <a class="action-secondary" href="/personagem-lib">Cancelar</a>
                        <button class="action-primary" type="submit" disabled="@ViewModel.IsProcessing">
                            @(ViewModel.IsProcessing ? "Criando..." : "Criar personagem") <span aria-hidden="true">→</span>
                        </button>
                    </div>
                </div>
            </section>

            <aside class="form-aside">
                <div class="aside-portrait"><img id="imagem-personagem-preview" src="@(string.IsNullOrEmpty(ViewModel.PersonagemAtual.Imagem) ? "img/armaduraprata.png" : ViewModel.PersonagemAtual.Imagem)" alt="Prévia do retrato do personagem" /></div>
                <div class="upload-imagem">
                    <label class="upload-imagem-botao"><span aria-hidden="true">↑</span> Escolher foto do personagem<input id="imagem-personagem" type="file" accept="image/*" aria-label="Escolher foto do personagem" /></label>
                    <p class="upload-imagem-ajuda">JPG, PNG ou WebP. A imagem é reduzida para armazenamento.</p>
                </div>
                <div class="aside-note"><strong>Uma ficha por vez</strong>Você poderá consultar seus personagens na biblioteca e continuar ajustando os detalhes da aventura depois.</div>
            </aside>
        </form>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ViewModel.LimparFormulario();
        ViewModel.OnChange += StateHasChanged;
    }

    // Campo local apenas para estruturar o select de tipo (Personagem / NPC)
    private string tipoPersonagem = "Personagem";

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}