@page "/cadastro"
@layout TelaCheiaLayout
@inject NavigationManager Navegacao

@* CADASTRO: inserir o campo de ter opção de logar com o Google, Facebook ou outras redes sociais *@
@* Adicionar depois: tela de usuário (editar, estilizar, ver nível/experiência como jogador ou
   mestre); campo de apelido além do nome real (ex: Nome: Cleverson, Apelido: DragãoGuerreiro);
   configurações com termos de uso/privacidade e opções de conta. *@

<div class="tela-cheia tela-autenticacao">
    <div class="cartao-login">
        <div class="selo-login">🛡️</div>
        <h1>Junte-se à Mesa</h1>
        <p class="subtitulo-login">Crie sua conta e reúna seu grupo para a próxima aventura.</p>

        <EditForm Model="this" OnValidSubmit="CriarConta">
            <div class="campo">
                <label for="nome-cadastro">Nome de usuário</label>
                <input id="nome-cadastro" type="text" @bind="NomeUsuario" placeholder="ex: cleverson_mestre" required>
            </div>
            <div class="campo">
                <label for="email-cadastro">E-mail</label>
                <input id="email-cadastro" type="email" @bind="Email" placeholder="voce@email.com" required>
            </div>
            <div class="campo">
                <label for="senha-cadastro">Senha</label>
                <input id="senha-cadastro" type="password" @bind="Senha" placeholder="Crie uma senha" minlength="6" required>
            </div>
            <div class="termos">
                <input id="termos" type="checkbox" @bind="AceitouTermos" required>
                <label for="termos">Li e aceito os <span class="link-formulario">Termos de Uso e a Política de Privacidade</span>.</label>
            </div>
            <button class="botao-principal" type="submit">CRIAR MINHA CONTA</button>
        </EditForm>

        @if (MostrarSucesso)
        {
            <p class="rodape-login">✅ Conta criada com sucesso! Redirecionando para o login…</p>
        }

        <p class="rodape-login">Já tem uma conta? <a class="link-formulario" href="/">Entrar na mesa</a></p>
    </div>
</div>

@code {
    private string NomeUsuario = "";
    private string Email = "";
    private string Senha = "";
    private bool AceitouTermos;
    private bool MostrarSucesso;

    private async Task CriarConta()
    {
        // TODO: gravar o novo usuário (Models/usuario.cs + Services/ConexaoBanco.cs)
        // antes de navegar de volta pro login.
        MostrarSucesso = true;
        StateHasChanged();
        await Task.Delay(1200);
        Navegacao.NavigateTo("/");
    }
}
