@page "/cadastro"

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<section class="fundo">
    <h1>Cadastro</h1>
    <div class="campos">
        <div class="sla">
            <p>Utilizador</p>
            <input type="text" id="usuario" autocomplete="username" />
        </div>

        <div class="sla">
            <p>Email</p>
            <input type="email" id="email" autocomplete="email" />
        </div>

        <div class="sla">
            <p>Senha</p>
            <input type="password" id="senha" autocomplete="new-password" />
        </div>

        <div class="sla">
            <p>Confirmar Senha</p>
            <input type="password" id="confirmar-senha" autocomplete="new-password" />
        </div>

        <button type="button">Cadastrar</button>

        <div class="icons-login">
            <a href="#" aria-label="Entrar com Google"><i class="bi bi-google"></i></a>
            <a href="#" aria-label="Entrar com Facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" aria-label="Entrar com GitHub"><i class="bi bi-github"></i></a>
        </div>

    <label class="termo">
    <input type="checkbox" />
    <span>Concordar com os <a href="#" @onclick="() => ExibirModal = true" @onclick:preventDefault>termos de uso</a></span>
</label>
    </div>
</section>
@if (ExibirModal)
{
    <section class="pop-up-backdrop" @onclick="() => ExibirModal = false">
        <!-- O @onclick:stopPropagation impede de fechar ao clicar dentro do card -->
        <div class="modal-rpg" @onclick:stopPropagation>
            <button type="button" class="fechar-popup" @onclick="() => ExibirModal = false" aria-label="Fechar">&times;</button>
            
            <header class="modal-cabecalho">
                <h3>Termos da Sessão</h3>
                <div class="linha-dourada"></div>
            </header>

            <div class="modal-corpo">
                <p>
                    Ao adentrar a mesa, o aventureiro compromete-se a respeitar o Mestre e os demais jogadores.
                </p>
                <p>
                    Decisões de dados (d20) são absolutas e não passíveis de barganha após roladas. O uso indevido de magias em tavernas resultará em penalidade direta imposta pela guarda local.
                </p>
                <p>
                    Que seus acertos sejam críticos e que a sorte acompanhe sua jornada por Faerong!
                </p>
            </div>

            <footer class="modal-rodape">
                <button type="button" class="btn-rpg-modal" @onclick="() => ExibirModal = false">
                    Entendido
                </button>
            </footer>
        </div>
    </section>
}
@code {
    private bool ExibirModal = false;
}
