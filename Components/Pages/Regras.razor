@page "/regras"
@layout TelaCheiaLayout

@* REGRAS: preencher e especificar melhor as regras do jogo e de como funciona o mundo do RPG.
   As regras de uso do site podem ser implementadas nas configurações, com emoji de ⚙️. *@

<div class="mesa-app">
    <BarraLateral />
    <div class="area-principal fundo-pergaminho">
        <section class="conteudo-pagina">
            <div class="cabecalho-area">
                <h1>Regras da Casa</h1>
                <span class="migalha">Editável apenas pelo Mestre</span>
            </div>
            <div class="corpo-area">
                <div class="painel painel-regras">
                    <h2>Combate</h2>
                    <div class="texto-regras">
                        Acertos críticos causam dano dobrado apenas nos dados, não nos modificadores.
                        Ações lendárias de monstros podem ser usadas entre turnos, conforme descrito
                        na ficha do monstro.
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
