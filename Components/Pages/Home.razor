@page "/home"
<NavMenu />
<div class="app-shell">

    <main class="app-content home-content">
        <div class="home-greeting">
            <h1>Bom jogo, <span data-saudar>Mestre</span>.</h1>
            <time class="home-date" id="data-home"></time>
        </div>

        <section class="home-hero" aria-labelledby="campanha-atual">
            <div class="home-hero-content">
                <p class="page-kicker">Sua próxima aventura começa aqui</p>
                <h2 id="campanha-atual">Crônicas de Eldoria</h2>
                <p>O grupo está reunido. As trilhas antigas aguardam a próxima sessão.</p>
                <div class="home-hero-actions">
                    <a class="action-primary" href="sessao-iniciar.html">Iniciar sessão <span aria-hidden="true">→</span></a>
                    <a class="action-secondary" href="saladojogo.html">Entrar na sala</a>
                </div>
            </div>
        </section>

        <div class="home-layout">
            <div class="home-main-column">
                <section aria-labelledby="atalhos-titulo">
                    <div class="section-heading">
                        <div><h2 id="atalhos-titulo">Acesso rápido</h2><p>Prepare sua mesa sem perder o ritmo.</p></div>
                    </div>
                    <div class="quick-actions">
                        <a class="quick-action" href="personagem-criar"><span class="quick-action-icon" aria-hidden="true">✦</span><span><strong>Novo personagem</strong><small>Crie uma ficha de aventureiro</small></span></a>
                        <a class="quick-action" href="monstro-criar"><span class="quick-action-icon" aria-hidden="true">♜</span><span><strong>Cadastrar monstro</strong><small>Adicione uma criatura à coleção</small></span></a>
                        <a class="quick-action" href="monstros-lib"><span class="quick-action-icon" aria-hidden="true">⌕</span><span><strong>Biblioteca de monstros</strong><small>Consulte ameaças e estatísticas</small></span></a>
                        <a class="quick-action" href="personagem-editar"><span class="quick-action-icon" aria-hidden="true">◇</span><span><strong>Ver inventário</strong><small>Confira itens e moedas do grupo</small></span></a>
                    </div>
                </section>

                <section aria-labelledby="atividade-titulo">
                    <div class="section-heading">
                        <div><h2 id="atividade-titulo">Atividade recente</h2><p>O que está acontecendo nas suas mesas.</p></div>
                        <a class="text-link" href="campanhas">Ver campanhas</a>
                    </div>
                    <div class="activity-list">
                        <a class="activity-row" href="personagem-editar">
                            <span class="activity-avatar">LV</span>
                            <span><h3>Lyra Ventobrasa</h3><p>Ficha atualizada em Crônicas de Eldoria</p></span>
                            <time class="activity-meta">Hoje</time>
                        </a>
                        <a class="activity-row" href="monstros-lib.html">
                            <span class="activity-avatar">DR</span>
                            <span><h3>Bestiário da campanha</h3><p>Consulte as criaturas antes do próximo encontro</p></span>
                            <time class="activity-meta">Ontem</time>
                        </a>
                        <a class="activity-row" href="personagem-editar.html?aba=inventario">
                            <span class="activity-avatar">✧</span>
                            <span><h3>Tesouro do grupo</h3><p>Inventário pronto para receber novas recompensas</p></span>
                            <time class="activity-meta">Esta semana</time>
                        </a>
                    </div>
                </section>
            </div>

            <aside class="home-side-column" aria-label="Resumo das campanhas">
                <section>
                    <div class="section-heading">
                        <div><h2>Suas campanhas</h2><p>Histórias em andamento</p></div>
                        <a class="text-link" href="criar-campanha" aria-label="Criar campanha">+ Nova</a>
                    </div>
                    <div class="home-campaigns">
                        <a class="home-campaign-row" href="sessao-iniciar.html?campanha=Cr%C3%B4nicas%20de%20Eldoria"><img src="img/capacampanha1.png" alt="" /><span><strong>Crônicas de Eldoria</strong><small>Próxima sessão a preparar</small></span><em>Ativa</em></a>
                        <a class="home-campaign-row" href="sessao-iniciar.html?campanha=O%20V%C3%A9u%20de%20Cinzas"><img src="img/capacampanha4.png" alt="" /><span><strong>O Véu de Cinzas</strong><small>Última sessão há 6 dias</small></span><em>Ativa</em></a>
                        <a class="home-campaign-row" href="sessao-iniciar.html?campanha=Erathia"><img src="img/capacampanha7.png" alt="" /><span><strong>Erathia</strong><small>Última sessão há 2 semanas</small></span><em>Pausa</em></a>
                    </div>
                </section>

                <section>
                    <div class="section-heading">
                        <div><h2>Na sua mesa</h2><p>Crônicas de Eldoria</p></div>
                    </div>
                    <div class="activity-list">
                        <div class="activity-row"><span class="activity-avatar">04</span><span><h3>Personagens</h3><p>Aventureiros nesta campanha</p></span></div>
                        <div class="activity-row"><span class="activity-avatar">12</span><span><h3>Encontros</h3><p>Notas e desafios preparados</p></span></div>
                    </div>
                </section>
            </aside>
        </div>
    </main>
</div>


@code {

}
