@page "/campanhas"
<NavMenu />

<div class="tela-rpg tela-campanhas">

    <main class="conteudo-rpg">
        <div class="titulo-pagina">
            <div>
                <p class="sobretitulo-rpg">Sua biblioteca de aventuras</p>
                <h1>Campanhas</h1>
                <p class="texto-apoio">Histórias prontas para continuar.</p>
            </div>
            <a class="botao-dourado" href="/criar-campanha"><span aria-hidden="true">+</span> Nova campanha</a>
        </div>

        <div class="grade-campanhas">
            <a class="cartao-campanha" href="/campanha" aria-label="Abrir campanha A Legião Grotesca">
                <img src="img/capacampanha1.png" alt="Capa da campanha A Legião Grotesca" />
                <span class="estado-campanha">Em andamento</span>
                <div class="info-campanha"><span>2D6 World</span><h2>A Legião Grotesca</h2><small>Última sessão há 2 dias</small></div>
            </a>

            <a class="cartao-adicionar" href="/criar-campanha">
                <span class="mais-adicionar" aria-hidden="true">+</span>
                <strong>Criar campanha</strong>
                <small>Comece uma nova aventura</small>
            </a>
        </div>
    </main>
</div>

