@page "/campanhas"
@using RPGdeMesa.Services
@using RPGdeMesa.Models
@inject CampanhaService CampanhaService
@inject SessaoUsuarioService SessaoUsuario
@inject NavigationManager Navigation

<NavMenu />

<div class="tela-rpg tela-campanhas">
    <main class="conteudo-rpg">
        <div class="titulo-pagina">
            <div>
                <p class="sobretitulo-rpg">Sua biblioteca de aventuras</p>
                <h1>Campanhas</h1>
                <p class="texto-apoio">Histórias prontas para continuar ou participar.</p>
            </div>
            
            <div class="acoes-cabecalho">
                <button type="button" class="botao-secundario-dourado" @onclick="() => exibirModalEntrar = true">
                    <span aria-hidden="true">🔑</span> Inserir convite
                </button>
                <a class="botao-dourado" href="/criar-campanha">
                    <span aria-hidden="true">+</span> Nova campanha
                </a>
            </div>
        </div>

        <div class="abas-navegacao">
            <button type="button" class="botao-aba @(abaAtiva == "mestre" ? "ativo" : "")" @onclick='() => abaAtiva = "mestre"'>
                Como Mestre (@campanhasMestre.Count)
            </button>
            <button type="button" class="botao-aba @(abaAtiva == "jogador" ? "ativo" : "")" @onclick='() => abaAtiva = "jogador"'>
                Como Jogador (@campanhasJogador.Count)
            </button>
        </div>

        @if (abaAtiva == "mestre")
        {
            @if (!campanhasMestre.Any())
            {
                <p class="aviso-vazio">Você ainda não criou nenhuma campanha como Mestre.</p>
            }

            <div class="grade-campanhas">
                <a class="cartao-adicionar" href="/criar-campanha">
                    <span class="mais-adicionar" aria-hidden="true">+</span>
                    <strong>Criar campanha</strong>
                    <small>Comece uma nova aventura</small>
                </a>

                @foreach (var campanha in campanhasMestre)
                {
                    <a class="cartao-campanha" href="/campanha/@campanha.IdCampanha" aria-label="Abrir campanha @campanha.Nome">
                        <img src="img/capacampanha1.png" alt="Capa da campanha @campanha.Nome" />
                        <span class="estado-campanha tag-mestre">Mestre</span>
                        <div class="info-campanha">
                            <span>Código: @campanha.CodigoConvite</span>
                            <h2>@campanha.Nome</h2>
                            <small>Criada em @campanha.DataCriacao.ToString("dd/MM/yyyy")</small>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            @if (!campanhasJogador.Any())
            {
                <p class="aviso-vazio">Você ainda não está participando de nenhuma campanha como jogador.</p>
            }

            <div class="grade-campanhas">
          

                @foreach (var campanha in campanhasJogador)
                {
                    <a class="cartao-campanha" href="/campanha/@campanha.IdCampanha" aria-label="Abrir campanha @campanha.Nome">
                        <img src="img/capacampanha1.png" alt="Capa da campanha @campanha.Nome" />
                        <span class="estado-campanha tag-jogador">Jogador</span>
                        <div class="info-campanha">
                            <span>Aventureiro</span>
                            <h2>@campanha.Nome</h2>
                            <small>Participando</small>
                        </div>
                    </a>
                }
                      <button type="button" class="cartao-adicionar" @onclick="() => exibirModalEntrar = true">
                    <span class="mais-adicionar" aria-hidden="true">🔑</span>
                    <strong>Entrar com código</strong>
                    <small>Insira o convite do Mestre</small>
                </button>
            </div>
        }
    </main>
</div>

@if (exibirModalEntrar)
{
    <ModalEntrar OnFechar="() => exibirModalEntrar = false" 
                 OnCampanhaEntrada="CampanhaEntradaSucesso" />
}

@code {
    private bool exibirModalEntrar = false;
    private List<Campanha> campanhasMestre = new();
    private List<Campanha> campanhasJogador = new();
    private string abaAtiva = "mestre";

    protected override async Task OnInitializedAsync()
    {
        await CarregarCampanhasAsync();
    }

    private async Task CarregarCampanhasAsync()
    {
        int idUsuario = SessaoUsuario.IdUsuarioLogado;
        if (idUsuario > 0)
        {
            campanhasMestre = await CampanhaService.ObterCampanhasPorUsuarioAsync(idUsuario);
            campanhasJogador = await CampanhaService.ObterCampanhasComoJogadorAsync(idUsuario);
        }
    }

    private async Task CampanhaEntradaSucesso()
    {
        exibirModalEntrar = false;
        abaAtiva = "jogador";
        await CarregarCampanhasAsync();
    }
}