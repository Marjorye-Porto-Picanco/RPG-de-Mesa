@page "/monstro-criar"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject MonstroCriarViewModel ViewModel
@implements IDisposable

<NavigationLock OnBeforeInternalNavigation="ViewModel.ConfirmarNavegacao" />

<div class="app-shell criacao-personagem">
    <main class="app-content">
        <button class="exit-prompt-link" type="button" @onclick="ViewModel.AbrirAvisoSaida">
            <span aria-hidden="true">←</span> Voltar ao Bestiário
        </button>

        <header class="top-bar">
            <div class="top-bar-copy">
                <p class="page-kicker">Bestiário e Criaturas</p>
                <h1 class="page-title">Criar Monstro / Criatura</h1>
                <p class="page-description">Preencha os atributos e características para registrar uma nova ameaça para suas campanhas.</p>
            </div>
        </header>

        <form class="wizard-layout" @onsubmit="ViewModel.SalvarMonstroAsync" @onsubmit:preventDefault="true">
            <section class="ficha-pergaminho">
                <div class="step-panel active">
                    <h2 class="section-title">Detalhes da Criatura</h2>

                    <div class="form-grid-2">
                        <label class="campo-ficha full-width">
                            <span>Nome da Criatura</span>
                            <input type="text"
                                   @bind="ViewModel.MonstroAtual.Nome"
                                   @bind:event="oninput"
                                   maxlength="60"
                                   placeholder="Ex.: Guardião das Sombras"
                                   autocomplete="off"
                                   required />
                        </label>

                        <label class="campo-ficha">
                            <span>Tipo</span>
                            <select @bind="ViewModel.MonstroAtual.TipoMonstro">
                                <option value="Outro">Outro</option>
                                <option value="Dragao">Dragão</option>
                                <option value="Fera">Fera</option>
                                <option value="Morto-vivo">Morto-vivo</option>
                                <option value="Aberração">Aberração</option>
                                <option value="Corrupto">Corrupto</option>
                            </select>
                        </label>

                        <label class="campo-ficha">
                            <span>Tamanho</span>
                            <select @bind="ViewModel.MonstroAtual.Tamanho">
                                <option value="Pequeno">Pequeno</option>
                                <option value="Médio">Médio</option>
                                <option value="Grande">Grande</option>
                                <option value="Enorme">Enorme</option>
                                <option value="Imenso">Imenso</option>
                            </select>
                        </label>

                        <label class="campo-ficha">
                            <span>Nível de Desafio (ND)</span>
                            <input type="number" @bind="ViewModel.MonstroAtual.Nd" min="0" max="30" step="0.125" required />
                        </label>

                        <label class="campo-ficha">
                            <span>Classe de Armadura (CA)</span>
                            <input type="number" @bind="ViewModel.MonstroAtual.ClasseArmadura" min="1" max="40" required />
                        </label>

                        <label class="campo-ficha">
                            <span>Pontos de Vida (PV)</span>
                            <input type="number" @bind="ViewModel.MonstroAtual.PvMaximo" min="1" max="9999" required />
                        </label>

                        <label class="campo-ficha">
                            <span>Deslocamento</span>
                            <input type="text" @bind="ViewModel.MonstroAtual.Deslocamento" placeholder="Ex.: 9 m, voo 18 m" />
                        </label>

                        <label class="campo-ficha">
                            <span>Tendência</span>
                            <input type="text" @bind="ViewModel.MonstroAtual.Tendencia" placeholder="Ex.: Neutro e mau" />
                        </label>

                        <label class="campo-ficha full-width">
                            <span>Sentidos</span>
                            <input type="text" @bind="ViewModel.MonstroAtual.Sentidos" placeholder="Ex.: Visão no escuro 18 m, Percepção passiva 13" />
                        </label>

                        <label class="campo-ficha full-width">
                            <span>Resistências / Imunidades</span>
                            <input type="text" @bind="ViewModel.MonstroAtual.Resistencias" placeholder="Ex.: Resistência a dano necrótico, imunidade a veneno" />
                        </label>

                        <label class="campo-ficha full-width">
                            <span>Habilidades Especiais</span>
                            <textarea @bind="ViewModel.MonstroAtual.Habilidades" rows="3" placeholder="Ataques múltiplos, magias inatas, traços especiais..."></textarea>
                        </label>

                        <label class="campo-ficha full-width">
                            <span>Descrição da Criatura</span>
                            <textarea @bind="ViewModel.MonstroAtual.Descricao" rows="3" placeholder="Lore, comportamento ou anotações do Mestre..."></textarea>
                        </label>
                    </div>
                </div>

                <footer class="wizard-footer">
                    <button class="action-secondary" type="button" @onclick="ViewModel.CancelarCriacao" disabled="@ViewModel.IsProcessing">
                        Cancelar
                    </button>
                    <button class="action-primary" type="submit" disabled="@ViewModel.IsProcessing">
                        @(ViewModel.IsProcessing ? "Salvando..." : "✓ Forjar e Salvar Monstro")
                    </button>
                </footer>

                @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
                {
                    <p class="form-status @(ViewModel.Sucesso ? "success" : "error")" role="status" aria-live="polite">
                        @ViewModel.MensagemFeedback
                    </p>
                }
            </section>
        </form>
    </main>
</div>

@if (ViewModel.ExibirAvisoSaida)
{
    <div class="confirm-overlay" role="presentation" @onclick="ViewModel.FecharAvisoSaida">
        <section class="confirm-dialog" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>Sair sem salvar?</h2>
            <p>Tem certeza que deseja cancelar? As alterações feitas no monstro serão perdidas.</p>
            <div class="confirm-actions">
                <button class="confirm-exit" type="button" @onclick="ViewModel.SairDaCriacao">Sim</button>
                <button class="confirm-cancel" type="button" @onclick="ViewModel.FecharAvisoSaida">Não</button>
            </div>
        </section>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ViewModel.LimparFormulario();
        ViewModel.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}