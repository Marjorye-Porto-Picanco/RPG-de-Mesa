@page "/cadastro"
@layout Layout.EmptyLayout
@inject RegisterViewModel viewModel
@inject NavigationManager Navigation

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<section class="login">
    <div class="formes auth-card">
        <div class="auth-emblem" aria-hidden="true"><i class="bi bi-dice-5"></i></div>
        <p class="auth-eyebrow">A sua mesa de aventuras</p>
        <h1>Cadastro</h1>
        <p class="subtitulo-login">Junte-se à mesa e forje sua lenda.</p>

        <label class="campos" for="usuario">
            <span>Utilizador</span>
            <input type="text" id="usuario" @bind="viewModel.Usuario" autocomplete="username" />
        </label>

        <label class="campos" for="email">
            <span>Email</span>
            <input type="email" id="email" @bind="viewModel.Email" autocomplete="email" />
        </label>

        <label class="campos" for="senha">
            <span>Senha</span>
            <input type="password" id="senha" @bind="viewModel.Senha" autocomplete="new-password" />
        </label>

        <label class="campos" for="confirmar-senha">
            <span>Confirmar senha</span>
            <input type="password" id="confirmar-senha" @bind="viewModel.ConfirmarSenha" autocomplete="new-password" />
        </label>

        @if (!string.IsNullOrEmpty(viewModel.MensagemFeedback))
        {
            <p class="auth-feedback @(viewModel.Sucesso ? "is-success" : "is-error")" role="status" aria-live="polite">
                @viewModel.MensagemFeedback
            </p>
        }

        <label class="termo-box">
            <input type="checkbox" @bind="viewModel.AceitouTermos" />
            <span>Concordar com os <a href="#" @onclick="viewModel.AbrirModal" @onclick:preventDefault>termos de uso</a></span>
        </label>

        <button class="auth-submit" type="button" @onclick="viewModel.RealizarCadastroAsync" disabled="@viewModel.IsProcessing">
            @(viewModel.IsProcessing ? "Cadastrando..." : "Cadastrar")
        </button>

        <div class="icons">
            <a class="social-link social-google" href="#" @onclick="viewModel.RegistrarComGoogleAsync" @onclick:preventDefault aria-label="Cadastrar com Google" title="Cadastrar com Google"><i class="bi bi-google" aria-hidden="true"></i></a>
            <a class="social-link social-facebook" href="#" @onclick="viewModel.RegistrarComFacebookAsync" @onclick:preventDefault aria-label="Cadastrar com Facebook" title="Cadastrar com Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
        </div>

        <p class="auth-account-prompt">Já possui conta? <a href="/login" class="auth-create-link">Voltar para o login</a></p>
    </div>
</section>

<!-- SEU POP-UP (Intacto) -->
@if (viewModel.ExibirModal)
{
    <section class="pop-up-backdrop" @onclick="viewModel.FecharModal">
        <div class="modal-rpg" @onclick:stopPropagation>
            <button type="button" class="fechar-popup" @onclick="viewModel.FecharModal" aria-label="Fechar">&times;</button>

            <header class="modal-cabecalho">
                <h3>Termos da Sessão</h3>
                <div class="linha-dourada"></div>
            </header>

            <div class="modal-corpo">
                <p>Ao adentrar a mesa, o aventureiro compromete-se a respeitar o Mestre e os demais jogadores.</p>
                <p>Decisões de dados (d20) são absolutas e não passíveis de barganha após roladas.</p>
            </div>

            <footer class="modal-rodape">
                <button type="button" class="btn-rpg-modal" @onclick="viewModel.AceitarTermosEFechar">
                    Entendido
                </button>
            </footer>
        </div>
    </section>
}

@code {
    protected override void OnInitialized()
    {
        viewModel.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        viewModel.OnChange -= StateHasChanged;
    }
}