@page "/personagem-editar/{Id:int}"
@using RPGdeMesa.Presentation.Components.Layout
@inject PersonagemEditarViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable

<NavMenu />
<NavigationLock OnBeforeInternalNavigation="ConfirmarNavegacao" />

<div class="mesa-edicao">
    <main class="palco">
        <section class="ficha-personagem" aria-labelledby="nome-personagem">
            <div class="ficha-cabecalho">
                <div class="retrato-coluna">
                    <div class="retrato">
                        <img id="imagem-personagem-atual" src="@(string.IsNullOrEmpty(ViewModel.PersonagemAtual.Imagem) ? "img/armaduraprata.png" : ViewModel.PersonagemAtual.Imagem)" alt="Retrato do personagem" />
                    </div>
                    <label class="upload-imagem-botao retrato-upload">
                        <span aria-hidden="true">↑</span> Foto
                        <input id="imagem-personagem-edicao" type="file" accept="image/*" aria-label="Alterar foto do personagem" />
                    </label>
                </div>
                <div class="identidade">
                    <p class="sobretitulo">Ficha de personagem</p>
                    <h1 id="nome-personagem">@ViewModel.PersonagemAtual.Nome</h1>
                    <p class="descricao-personagem">@(ViewModel.PersonagemAtual.RacaTexto ?? "Raça") • @(ViewModel.PersonagemAtual.ClasseTexto ?? "Classe") • Nível @ViewModel.PersonagemAtual.Nivel</p>
                    <div class="dados-personagem">
                        <span><b>Raça</b> @(ViewModel.PersonagemAtual.RacaTexto ?? "Não informada")</span>
                        <span><b>Tendência</b> @(ViewModel.PersonagemAtual.Tendencia ?? "Neutra")</span>
                        <span><b>Antecedente</b> @(ViewModel.PersonagemAtual.AntecedenteTexto ?? "Não informado")</span>
                    </div>
                </div>
                <div class="marcadores">
                    <div class="marcador-classe"><span>Classe</span><b>@(ViewModel.PersonagemAtual.ClasseTexto ?? "N/A")</b></div>
                    <div class="marcador-nivel"><span>XP</span><b>@ViewModel.PersonagemAtual.ExperienciaXp.ToString("N0")</b></div>
                </div>
            </div>

            <!-- Botões de troca de abas -->
            <div class="troca-ficha" role="tablist" aria-label="Visão da ficha">
                <button class="aba-ficha @(ViewModel.AbaAtiva == "atributos" ? "ativa" : "")"
                        @onclick='() => ViewModel.MudarAba("atributos")'
                        type="button" role="tab" aria-selected="@(ViewModel.AbaAtiva == "atributos")">
                    Atributos
                </button>
                <button class="aba-ficha @(ViewModel.AbaAtiva == "personagem" ? "ativa" : "")"
                        @onclick='() => ViewModel.MudarAba("personagem")'
                        type="button" role="tab" aria-selected="@(ViewModel.AbaAtiva == "personagem")">
                    Personagem <span aria-hidden="true">↔</span>
                </button>
                <button class="aba-ficha @(ViewModel.AbaAtiva == "inventario" ? "ativa" : "")"
                        @onclick='() => ViewModel.MudarAba("inventario")'
                        type="button" role="tab" aria-selected="@(ViewModel.AbaAtiva == "inventario")">
                    Inventário
                </button>
            </div>

            <!-- Renderização dinâmica da aba ativa -->
            @switch (ViewModel.AbaAtiva)
            {
                case "atributos":
                    <FichaAtributos Personagem="@ViewModel.PersonagemAtual" />
                    break;
                case "personagem":
                    <FichaDetalhes Personagem="@ViewModel.PersonagemAtual" />
                    break;
                case "inventario":
                    <FichaInventario Personagem="@ViewModel.PersonagemAtual" />
                    break;
            }

            @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
            {
                <div style="padding: 10px; margin-top: 15px; text-align: center; color: @(ViewModel.Sucesso ? "#28a745" : "#dc3545"); font-weight: bold;">
                    @ViewModel.MensagemFeedback
                </div>
            }

            <div style="padding: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button class="action-secondary" type="button" @onclick="AbrirAvisoSaida">Cancelar</button>
                <button class="action-primary" type="button" @onclick="ViewModel.SalvarAlteracoesAsync" disabled="@ViewModel.IsProcessing">
                    @(ViewModel.IsProcessing ? "Salvando..." : "Salvar Alterações")
                </button>
            </div>
        </section>
    </main>
</div>

@if (ExibirAvisoSaida)
{
    <div class="confirm-overlay" role="presentation" @onclick="FecharAvisoSaida">
        <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="titulo-aviso-personagem-edicao" aria-describedby="mensagem-aviso-personagem-edicao" @onclick:stopPropagation="true">
            <h2 id="titulo-aviso-personagem-edicao">Sair sem salvar?</h2>
            <p id="mensagem-aviso-personagem-edicao">Você tem certeza que quer sair? Vai perder tudo o que mudou.</p>
            <div class="confirm-actions">
                <button class="confirm-exit" type="button" @onclick="SairDaEdicao">Sim</button>
                <button class="confirm-cancel" type="button" @onclick="FecharAvisoSaida">Não</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool ExibirAvisoSaida { get; set; }
    private bool LiberarProximaNavegacao { get; set; }
    private string? DestinoPendente { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.CarregarPersonagemAsync(Id);
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }

    private void AbrirAvisoSaida() => ExibirAvisoSaida = true;

    private void ConfirmarNavegacao(LocationChangingContext contexto)
    {
        if (LiberarProximaNavegacao)
        {
            LiberarProximaNavegacao = false;
            return;
        }

        contexto.PreventNavigation();
        DestinoPendente = contexto.TargetLocation;
        ExibirAvisoSaida = true;
    }

    private void FecharAvisoSaida()
    {
        ExibirAvisoSaida = false;
        DestinoPendente = null;
    }

    private void SairDaEdicao()
    {
        LiberarProximaNavegacao = true;
        Navigation.NavigateTo(DestinoPendente ?? "/personagem-lib");
    }
}