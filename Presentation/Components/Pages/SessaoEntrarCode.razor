@page "/entrar-cod"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject SessaoEntrarCodeViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell join-shell">
    <main class="app-content join-content">
        <header class="page-heading join-page-heading">
            <div>
                <p class="page-kicker">Aventureiros, a mesa está aberta</p>
                <h1 class="page-title">@(ViewModel.CampanhaAtual?.Nome ?? "Entrar em campanha")</h1>
                <p class="page-description">Informe o código do mestre, monte sua ficha com o inventário da campanha e envie para análise.</p>
            </div>
            <button class="botao-voltar" type="button" @onclick="ViewModel.VoltarParaCampanhas"><span aria-hidden="true">←</span> Voltar</button>
        </header>

        <ol class="join-progress join-progress-2" aria-label="Etapas para entrar na campanha">
            <li class="@(ViewModel.EtapaAtual == 1 ? "ativa" : "concluida")" data-progresso="1">
                <button type="button" class="join-step-link" aria-current="@(ViewModel.EtapaAtual == 1 ? "step" : null)" @onclick="() => ViewModel.IrParaEtapa(1)">
                    <span>@(ViewModel.EtapaAtual > 1 ? "✓" : "1")</span>
                    <strong>1. Código da Campanha</strong>
                </button>
            </li>
            <li class="@(ViewModel.EtapaAtual == 2 ? "ativa" : "")" data-progresso="2">
                <button type="button" class="join-step-link" aria-current="@(ViewModel.EtapaAtual == 2 ? "step" : null)" disabled="@(!ViewModel.PodeAcessarEtapa(2))" @onclick="() => ViewModel.IrParaEtapa(2)">
                    <span>2</span>
                    <strong>2. Enviar Ficha para Análise</strong>
                </button>
            </li>
        </ol>

        @if (ViewModel.EtapaAtual == 1)
        {
            <section class="join-step join-card" id="etapa-codigo" aria-labelledby="titulo-codigo">
                <p class="page-kicker">Etapa 1</p>
                <h2 id="titulo-codigo">Código da campanha</h2>
                <form class="join-code-form" @onsubmit="ViewModel.ValidarCodigoAsync" @onsubmit:preventDefault="true">
                    <label class="form-field">
                        Código fornecido pelo mestre
                        <input @bind="ViewModel.CodigoConvite" maxlength="20" required autocomplete="off" autocapitalize="characters" placeholder="Ex.: CMP-9876" />
                    </label>
                    <p class="join-status @(ViewModel.TemErro ? "erro" : "")" role="status" aria-live="polite">@ViewModel.Mensagem</p>
                    <button class="action-primary" type="submit" disabled="@ViewModel.Carregando">
                        @(ViewModel.Carregando ? "Validando..." : "Continuar") <span aria-hidden="true">→</span>
                    </button>
                </form>
            </section>
        }
        else if (ViewModel.EtapaAtual == 2 && ViewModel.CampanhaAtual is not null)
        {
            <section class="join-step join-card" id="etapa-personagem" aria-labelledby="titulo-personagem">
                <p class="page-kicker">Etapa 2 · Preparação do Herói</p>
                <h2 id="titulo-personagem">Enviar Ficha e Inventário para @(ViewModel.CampanhaAtual.Nome)</h2>

                <form @onsubmit="ViewModel.EnviarFichaParaAnaliseAsync" @onsubmit:preventDefault="true">
                    <fieldset class="character-picker">
                        <legend>1. Escolha um personagem da sua biblioteca para enviar ao Mestre desta campanha:</legend>
                        @if (ViewModel.PersonagensNaoEnviados.Any())
                        {
                            <div class="character-options" id="opcoes-personagens">
                                @foreach (var personagem in ViewModel.PersonagensNaoEnviados)
                                {
                                    <label class="character-option @(ViewModel.PersonagemSelecionadoId == personagem.IdPersonagem ? "selecionado" : "")">
                                        <input type="radio"
                                               name="novo-personagem"
                                               value="@personagem.IdPersonagem"
                                               @onchange="() => ViewModel.AoEscolherPersonagemAsync(personagem.IdPersonagem)"
                                               checked="@(ViewModel.PersonagemSelecionadoId == personagem.IdPersonagem)" />
                                        <span class="character-option-copy">
                                            <strong>@personagem.Nome</strong>
                                            <small>@(personagem.RacaTexto ?? "Raça não informada") · @(personagem.ClasseTexto ?? "Classe não informada") · Nível @personagem.Nivel</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else if (ViewModel.PersonagensDisponiveis.Any())
                        {
                            <p class="join-status">Todos os seus personagens cadastrados já foram enviados para esta campanha.</p>
                        }
                        else
                        {
                            <p class="join-status">Você ainda não possui personagens cadastrados. Crie um personagem primeiro!</p>
                        }
                    </fieldset>

                    @if (ViewModel.PersonagemEmPreparacao != null)
                    {
                        <div class="ficha-preview-pergaminho" style="margin-top: 14px;">
                            <h3 style="margin: 0 0 6px; color: #392819; font-size: 18px;">
                                2. Equipar Itens da Campanha em @ViewModel.PersonagemEmPreparacao.Nome (Antes de Enviar)
                            </h3>
                            <p style="margin: 0 0 16px; font-size: 12px; color: #6b4e23;">
                                Escolha os itens disponíveis nesta campanha (@ViewModel.ItensDaCampanha.Count itens liberados pelo Mestre). Isso criará uma instância exclusiva deste personagem para esta campanha, sem alterar sua ficha original da biblioteca.
                            </p>

                            <div class="corpo-inventario-campanha">
                                <div>
                                    <!-- Armas -->
                                    <div class="categoria-itens-campanha">
                                        <div class="titulo-categoria-campanha">
                                            <h4>⌁ Armas</h4>
                                            <button type="button" class="btn-add-item-campanha" title="Adicionar arma da campanha" @onclick='() => ViewModel.AdicionarSlotItem("Armas")'>+</button>
                                        </div>
                                        <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                        @foreach (var slot in ViewModel.ItensInventarioEdicao.Where(i => i.Categoria == "Armas"))
                                        {
                                            <div class="item-linha-campanha">
                                                <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e.Value?.ToString())">
                                                    <option value="0">Selecione uma arma...</option>
                                                    @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Armas"))
                                                    {
                                                        <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                    }
                                                </select>
                                                <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => ViewModel.RemoverSlotItem(slot)">×</button>
                                            </div>
                                        }
                                    </div>

                                    <!-- Armaduras e Escudos -->
                                    <div class="categoria-itens-campanha">
                                        <div class="titulo-categoria-campanha">
                                            <h4>⌁ Armaduras e Escudos</h4>
                                            <button type="button" class="btn-add-item-campanha" title="Adicionar armadura da campanha" @onclick='() => ViewModel.AdicionarSlotItem("Armaduras")'>+</button>
                                        </div>
                                        <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                        @foreach (var slot in ViewModel.ItensInventarioEdicao.Where(i => i.Categoria == "Armaduras"))
                                        {
                                            <div class="item-linha-campanha">
                                                <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e.Value?.ToString())">
                                                    <option value="0">Selecione uma armadura...</option>
                                                    @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Armaduras"))
                                                    {
                                                        <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                    }
                                                </select>
                                                <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => ViewModel.RemoverSlotItem(slot)">×</button>
                                            </div>
                                        }
                                    </div>

                                    <!-- Poções e Consumíveis -->
                                    <div class="categoria-itens-campanha">
                                        <div class="titulo-categoria-campanha">
                                            <h4>⌁ Poções e Consumíveis</h4>
                                            <button type="button" class="btn-add-item-campanha" title="Adicionar consumível da campanha" @onclick='() => ViewModel.AdicionarSlotItem("Consumiveis")'>+</button>
                                        </div>
                                        <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                        @foreach (var slot in ViewModel.ItensInventarioEdicao.Where(i => i.Categoria == "Consumiveis"))
                                        {
                                            <div class="item-linha-campanha">
                                                <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e.Value?.ToString())">
                                                    <option value="0">Selecione um consumível...</option>
                                                    @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Consumiveis"))
                                                    {
                                                        <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                    }
                                                </select>
                                                <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => ViewModel.RemoverSlotItem(slot)">×</button>
                                            </div>
                                        }
                                    </div>

                                    <!-- Materiais e Outros -->
                                    <div class="categoria-itens-campanha">
                                        <div class="titulo-categoria-campanha">
                                            <h4>⌁ Materiais e Outros</h4>
                                            <button type="button" class="btn-add-item-campanha" title="Adicionar item da campanha" @onclick='() => ViewModel.AdicionarSlotItem("Outros")'>+</button>
                                        </div>
                                        <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                        @foreach (var slot in ViewModel.ItensInventarioEdicao.Where(i => i.Categoria == "Outros"))
                                        {
                                            <div class="item-linha-campanha">
                                                <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e.Value?.ToString())">
                                                    <option value="0">Selecione um item...</option>
                                                    @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Outros"))
                                                    {
                                                        <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                    }
                                                </select>
                                                <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => ViewModel.RemoverSlotItem(slot)">×</button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <aside class="resumo-inventario-campanha">
                                    <section class="painel-moedas-campanha">
                                        <h4>Moedas Iniciais</h4>
                                        <div class="moedas-grade-campanha">
                                            <label class="moeda-campanha"><span class="icone-moeda-campanha">PC</span><input type="number" min="0" @bind="ViewModel.MoedasPC" /></label>
                                            <label class="moeda-campanha"><span class="icone-moeda-campanha prata">PP</span><input type="number" min="0" @bind="ViewModel.MoedasPP" /></label>
                                            <label class="moeda-campanha"><span class="icone-moeda-campanha electrum">PE</span><input type="number" min="0" @bind="ViewModel.MoedasPE" /></label>
                                            <label class="moeda-campanha"><span class="icone-moeda-campanha ouro">PO</span><input type="number" min="0" @bind="ViewModel.MoedasPO" /></label>
                                            <label class="moeda-campanha"><span class="icone-moeda-campanha platina">PL</span><input type="number" min="0" @bind="ViewModel.MoedasPL" /></label>
                                        </div>
                                    </section>

                                    <section class="painel-carga-campanha">
                                        <h4>Capacidade de Carga</h4>
                                        <p style="text-align:center; margin:0 0 8px; font-size:12px;">
                                            <strong>@ViewModel.PesoTotalEdicao.ToString("0.0") kg</strong> / @ViewModel.CapacidadeCargaMaximaEdicao.ToString("0.0") kg
                                        </p>
                                        <progress max="@((double)ViewModel.CapacidadeCargaMaximaEdicao)" value="@((double)Math.Min(ViewModel.PesoTotalEdicao, ViewModel.CapacidadeCargaMaximaEdicao))"></progress>
                                    </section>

                                    <div class="notas-inventario-campanha">
                                        <h4>Notas do Inventário</h4>
                                        <textarea rows="3" @bind="ViewModel.NotasInventario" placeholder="Anote detalhes dos equipamentos escolhidos..."></textarea>
                                    </div>
                                </aside>
                            </div>
                        </div>
                    }

                    <p class="join-status @(ViewModel.TemErro ? "erro" : "")" role="status" aria-live="polite">@ViewModel.Mensagem</p>

                    <div class="join-actions">
                        <button class="action-secondary" type="button" disabled="@ViewModel.Carregando" @onclick="ViewModel.VoltarParaCodigo">← Voltar para Código</button>
                        <button class="action-primary" type="submit" disabled="@(ViewModel.Carregando || ViewModel.PersonagemEmPreparacao == null)">
                            @(ViewModel.Carregando ? "Enviando ficha para análise..." : "Enviar Ficha para Análise →")
                        </button>
                    </div>
                </form>
            </section>
        }

        <p class="join-local-note">Após o envio, você voltará para a tela de campanhas com esta campanha já vinculada à sua conta.</p>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ViewModel.Limpar();
        ViewModel.OnChange -= AtualizarTela;
        ViewModel.OnChange += AtualizarTela;
    }

    private void AtualizarTela() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.OnChange -= AtualizarTela;
    }
}