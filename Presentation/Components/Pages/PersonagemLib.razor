@page "/personagem-lib"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.Services
@using RPGdeMesa.Domain.Npcs
@using RPGdeMesa.Domain.Personagens
@inject PersonagemService PersonagemService
@inject NpcService NpcService
@inject SessaoUsuarioService SessaoUsuario
@inject AppCacheService AppCache
@inject HomeCacheService HomeCache
@implements IDisposable

<NavMenu />

<div class="tela-rpg tela-personagens botoes-personagem">
    <main class="conteudo-rpg">
        <div class="titulo-pagina">
            <div>
                <p class="sobretitulo-rpg">Heróis e lendas</p>
                <h1>Heróis</h1>
                <p class="texto-apoio">Suas fichas reunidas em um só lugar.</p>
            </div>
            <a class="botao-dourado" href="@(abaAtiva == "personagens" ? "/personagem-criar" : "/personagem-criar?tipo=NPC")">
                <span aria-hidden="true">+</span> @(abaAtiva == "personagens" ? "Novo personagem" : "Novo NPC")
            </a>
        </div>

        @if (abaAtiva == "personagens")
        {
            @if (personagens == null)
            {
                <p class="aviso-carregando">Carregando heróis...</p>
            }
            else
            {
                @if (!personagens.Any())
                {
                    <p class="aviso-vazio">Nenhum personagem encontrado na sua biblioteca pessoal.</p>
                }

                <div class="grade-personagens">
                    @foreach (var personagem in personagens)
                    {
                        <div class="cartao-wrap" @key="personagem.IdPersonagem">
                            <a class="cartao-personagem" href="/personagem-editar/@personagem.IdPersonagem" aria-label="Abrir ficha de @personagem.Nome">
                                <div class="retrato-personagem">
                                    <RetratoComIniciais Nome="@personagem.Nome" Imagem="@personagem.Imagem" />
                                </div>
                                <div class="info-personagem">
                                    <!--<span class="status-personagem">Aventureiro</span>-->
                                    <h2>@personagem.Nome</h2>
                                    <p>@(string.IsNullOrEmpty(personagem.RacaTexto) ? "Raça desconhecida" : personagem.RacaTexto) • @(string.IsNullOrEmpty(personagem.ClasseTexto) ? "Classe" : personagem.ClasseTexto) nível @personagem.Nivel</p>
                                    <small>Pronto para a aventura</small>
                                </div>
                            </a>
                            <BotaoExcluir Titulo="@($"Excluir {personagem.Nome}")" OnClick='() => PedirExclusao("personagem", personagem.IdPersonagem, personagem.Nome)' />
                        </div>
                    }

                    <a class="cartao-adicionar cartao-adicionar-personagem" href="/personagem-criar">
                        <span class="mais-adicionar" aria-hidden="true">+</span>
                        <strong>Criar personagem</strong>
                        <small>Escreva uma nova história</small>
                    </a>
                </div>
            }
        }
        else
        {
            @if (npcs == null)
            {
                <p class="aviso-carregando">Carregando NPCs...</p>
            }
            else
            {
                @if (!npcs.Any())
                {
                    <p class="aviso-vazio">Nenhum NPC encontrado na sua biblioteca pessoal.</p>
                }

                <div class="grade-personagens">
                    @foreach (var npc in npcs)
                    {
                        <div class="cartao-personagem cartao-npc" aria-label="Ficha do NPC @npc.Nome" @key="npc.IdNpc">
                            <BotaoExcluir Titulo="@($"Excluir {npc.Nome}")" OnClick='() => PedirExclusao("npc", npc.IdNpc, npc.Nome)' />
                            <div class="retrato-personagem">
                                <RetratoComIniciais Nome="@npc.Nome" Imagem="@npc.Imagem" />
                            </div>
                            <div class="info-personagem">
                                <span class="status-personagem">NPC</span>
                                <h2>@npc.Nome</h2>
                                <p>@(string.IsNullOrEmpty(npc.RacaTexto) ? "Raça desconhecida" : npc.RacaTexto) • @(string.IsNullOrEmpty(npc.ClasseTexto) ? (string.IsNullOrEmpty(npc.Ocupacao) ? "Sem classe" : npc.Ocupacao) : npc.ClasseTexto) nível @npc.Nivel</p>
                                <small>@(string.IsNullOrEmpty(npc.Tendencia) ? (string.IsNullOrEmpty(npc.Alinhamento) ? "Neutro" : npc.Alinhamento) : npc.Tendencia)</small>
                            </div>
                        </div>
                    }

                    <a class="cartao-adicionar cartao-adicionar-personagem" href="/personagem-criar?tipo=NPC">
                        <span class="mais-adicionar" aria-hidden="true">+</span>
                        <strong>Criar NPC</strong>
                        <small>Adicione uma figura ao mundo</small>
                    </a>
                </div>
            }
        }
    </main>
</div>

<ConfirmarExclusao Visivel="@(exclusaoPendente is not null)"
                   Processando="excluindo"
                   Titulo="@($"Excluir {exclusaoPendente?.Nome}?")"
                   Mensagem="Esta ação não pode ser desfeita. A ficha será removida da sua biblioteca."
                   Erro="@erroExclusao"
                   OnConfirmar="ConfirmarExclusao"
                   OnCancelar="CancelarExclusao" />

@code {
    private static readonly TimeSpan ValidadeCache = TimeSpan.FromMinutes(2);

    private List<Personagem>? personagens;
    private List<NPC>? npcs;
    private string abaAtiva = "personagens";

    private sealed record ExclusaoPendente(string Tipo, int Id, string Nome);
    private ExclusaoPendente? exclusaoPendente;
    private bool excluindo;
    private string? erroExclusao;

    private void PedirExclusao(string tipo, int id, string nome)
    {
        erroExclusao = null;
        exclusaoPendente = new ExclusaoPendente(tipo, id, nome);
    }

    private void CancelarExclusao()
    {
        if (excluindo) return;
        exclusaoPendente = null;
        erroExclusao = null;
    }

    private async Task ConfirmarExclusao()
    {
        if (exclusaoPendente is null || excluindo) return;

        excluindo = true;
        erroExclusao = null;
        try
        {
            var idUsuario = SessaoUsuario.IdUsuarioLogado;
            var idExcluido = exclusaoPendente.Id;
            var tipoExcluido = exclusaoPendente.Tipo;

            var resultado = tipoExcluido == "npc"
                ? await NpcService.RemoverNpcAsync(idExcluido)
                : await PersonagemService.RemoverPersonagemAsync(idUsuario, idExcluido);

            if (!resultado.Sucesso)
            {
                erroExclusao = resultado.Mensagem;
                return;
            }

            // Write-through: remove direto na lista local, no AppCache e na Home (sem refazer query)
            if (tipoExcluido == "npc")
            {
                npcs = npcs?.Where(n => n.IdNpc != idExcluido).ToList() ?? new();
                AppCache.RemoverNpc(idUsuario, idExcluido);
                HomeCache.RemoverNpc(idUsuario, idExcluido);
            }
            else
            {
                personagens = personagens?.Where(p => p.IdPersonagem != idExcluido).ToList() ?? new();
                AppCache.RemoverPersonagem(idUsuario, idExcluido);
                HomeCache.RemoverPersonagem(idUsuario, idExcluido);
            }

            exclusaoPendente = null;
        }
        catch (Exception ex)
        {
            erroExclusao = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            excluindo = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        int idUsuario = SessaoUsuario.IdUsuarioLogado;
        if (idUsuario <= 0)
        {
            personagens = new();
            npcs = new();
            return;
        }

        var snapshot = AppCache.ObterPersonagensLib(idUsuario);
        if (snapshot is not null)
        {
            personagens = snapshot.Personagens;
            npcs = snapshot.Npcs;

            if (!AppCache.PersonagensLibExpirados(idUsuario, ValidadeCache))
                return;
        }

        var tarefaPersonagens = PersonagemService.ObterPersonagensPorUsuarioAsync(idUsuario);
        var tarefaNpcs = NpcService.ObterNpcsPorUsuarioAsync(idUsuario);
        await Task.WhenAll(tarefaPersonagens, tarefaNpcs);

        personagens = tarefaPersonagens.Result;
        npcs = tarefaNpcs.Result;

        AppCache.SalvarPersonagensLib(new PersonagensLibCacheSnapshot
        {
            IdUsuario = idUsuario,
            AtualizadoEmUtc = DateTime.UtcNow,
            Personagens = personagens,
            Npcs = npcs
        });
    }

    public void Dispose()
    {
    }
}
