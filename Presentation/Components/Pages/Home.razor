@page "/home"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject HomeViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell">
    <main class="app-content home-content">
        <div class="home-greeting">
            <h1>Bom jogo, <span>@ViewModel.PrimeiroNomeUsuario</span>.</h1>
            <time class="home-date">@ViewModel.DataFormatada</time>
        </div>

        <section class="home-hero"
                 style="background-image: url('@ViewModel.CapaCampanhaDestaque'); background-size: cover; background-position: center;"
                 aria-labelledby="campanha-atual">
            <div class="home-hero-content">
                <p class="page-kicker">Sua próxima aventura começa aqui</p>
                <h2 id="campanha-atual">@(ViewModel.CampanhaEmDestaque?.Nome ?? "Sua próxima aventura")</h2>
                <p>@(ViewModel.CampanhaEmDestaque?.Descricao ?? "O grupo está reunido. As trilhas antigas aguardam a próxima sessão.")</p>
                <div class="home-hero-actions">
                    <a class="action-primary" href="@ViewModel.ObterRotaCampanha(ViewModel.CampanhaEmDestaque)">
                        @ViewModel.TextoBotaoPrincipalHero <span aria-hidden="true">→</span>
                    </a>
                    <a class="action-secondary" href="@ViewModel.RotaBotaoSecundarioHero">
                        @ViewModel.TextoBotaoSecundarioHero
                    </a>
                </div>
            </div>
        </section>

        <div class="home-layout">
            <div class="home-main-column">
                <section aria-labelledby="atalhos-titulo">
                    <div class="section-heading">
                        <div>
                            <h2 id="atalhos-titulo">Acesso rápido</h2>
                            <p>Prepare sua mesa sem perder o ritmo.</p>
                        </div>
                    </div>
                    <div class="quick-actions">
                        <a class="quick-action" href="/personagem-criar">
                            <span class="quick-action-icon" aria-hidden="true">✦</span>
                            <span><strong>Novo personagem</strong><small>Crie uma ficha de aventureiro</small></span>
                        </a>
                        <a class="quick-action" href="/monstro-criar">
                            <span class="quick-action-icon" aria-hidden="true">♜</span>
                            <span><strong>Cadastrar monstro</strong><small>Adicione uma criatura à coleção</small></span>
                        </a>
                        <a class="quick-action" href="/BibliotecaGeral">
                            <span class="quick-action-icon" aria-hidden="true">⌕</span>
                            <span><strong>Biblioteca</strong><small>Consulte monstros, itens e recursos</small></span>
                        </a>
                        <a class="quick-action" href="/campanhas">
                            <span class="quick-action-icon" aria-hidden="true">✎</span>
                            <span><strong>Suas campanhas</strong><small>Prepare suas mesas e aventuras</small></span>
                        </a>
                        <a class="quick-action" href="/entrar-cod">
                            <span class="quick-action-icon" aria-hidden="true">↗</span>
                            <span><strong>Entrar em sessão</strong><small>Use o código enviado pelo mestre</small></span>
                        </a>
                        <a class="quick-action" href="/personagem-lib">
                            <span class="quick-action-icon" aria-hidden="true">◇</span>
                            <span><strong>Ver personagens</strong><small>Abra fichas, atributos e inventários</small></span>
                        </a>
                    </div>
                </section>

                <section aria-labelledby="atividade-titulo">
                    <div class="section-heading">
                        <div>
                            <h2 id="atividade-titulo">Atividade recente</h2>
                            <p>Os últimos 3 registros criados ou alterados.</p>
                        </div>
                        <a class="text-link" href="/campanhas">Ver campanhas</a>
                    </div>
                    <div class="activity-list">
                        @if (ViewModel.AtividadesRecentes.Any())
                        {
                            @foreach (var item in ViewModel.AtividadesRecentes)
                            {
                                <a class="activity-row" href="@item.Rota">
                                    <span class="activity-avatar">@item.Iniciais</span>
                                    <span>
                                        <h3>@item.Titulo</h3>
                                        <p>@item.Descricao</p>
                                    </span>
                                    <time class="activity-meta">@item.Meta</time>
                                </a>
                            }
                        }
                        else if (!ViewModel.Carregando)
                        {
                            <p class="home-campaign-empty">Nenhuma atividade recente registrada nesta conta.</p>
                        }
                    </div>
                </section>
            </div>

            <aside class="home-side-column" aria-label="Resumo das campanhas">
                <section>
                    <div class="section-heading">
                        <div>
                            <h2>Suas campanhas</h2>
                            <p>Histórias em andamento</p>
                        </div>
                        <a class="text-link" href="/criar-campanha" aria-label="Criar campanha">+ Nova</a>
                    </div>
                    <div class="home-campaigns">
                        @foreach (var campanha in ViewModel.Campanhas.Take(3))
                        {
                            <a class="home-campaign-row" href="@ViewModel.ObterRotaCampanha(campanha)">
                                <img src="@ViewModel.ObterCapaCampanha(campanha)" alt="Capa de @campanha.Nome" />
                                <span>
                                    <strong>@campanha.Nome</strong>
                                    <small>@(ViewModel.EhMestreDaCampanha(campanha) ? $"Criada em {campanha.DataCriacao:dd/MM/yyyy}" : "Campanha em andamento")</small>
                                </span>
                                <em>@(ViewModel.EhMestreDaCampanha(campanha) ? "Sua mesa" : "Participando")</em>
                            </a>
                        }
                    </div>
                    @if (!ViewModel.Carregando && ViewModel.Campanhas.Count == 0)
                    {
                        <p class="home-campaign-empty">Nenhuma campanha nesta conta.</p>
                    }
                </section>

                <section id="resumo-mesa-home" hidden="@(!ViewModel.ExibirResumoMesa)">
                    <div class="section-heading">
                        <div>
                            <h2>Na sua mesa</h2>
                            <p>@(ViewModel.CampanhaEmDestaque?.Nome ?? "Campanhas em andamento")</p>
                        </div>
                    </div>
                    <div class="activity-list">
                        <div class="activity-row">
                            <span class="activity-avatar">@ViewModel.TotalPersonagensDestaque.ToString("00")</span>
                            <span>
                                <h3>Personagens</h3>
                                <p>Aventureiros nesta campanha</p>
                            </span>
                        </div>
                        <div class="activity-row">
                            <span class="activity-avatar">@ViewModel.TotalElementosMesaDestaque.ToString("00")</span>
                            <span>
                                <h3>Encontros</h3>
                                <p>Monstros e NPCs preparados</p>
                            </span>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.OnChange -= StateHasChanged;
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.CarregarDadosAsync();
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}