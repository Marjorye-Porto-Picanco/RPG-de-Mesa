@page "/home"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Application.Services
@using RPGdeMesa.Domain.Campanhas
@inject CampanhaService CampanhaService
@inject SessaoUsuarioService SessaoUsuario
<NavMenu />
<div class="app-shell">
    <main class="app-content home-content">
        <div class="home-greeting">
            <h1>Bom jogo, <span>@NomeExibido.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()</span>.</h1>
            <time class="home-date">@DateTime.Now.ToString("D", new System.Globalization.CultureInfo("pt-BR"))</time>
        </div>

        <section class="home-hero" aria-labelledby="campanha-atual">
            <div class="home-hero-content">
                <p class="page-kicker">Sua próxima aventura começa aqui</p>
                <h2 id="campanha-atual">@(CampanhaEmDestaque?.Nome ?? "Sua próxima aventura")</h2>
                <p>@(CampanhaEmDestaque?.Descricao ?? "O grupo está reunido. As trilhas antigas aguardam a próxima sessão.")</p>
                <div class="home-hero-actions">
                    <a class="action-primary" href="@(CampanhaEmDestaque is null ? "/criar-campanha" : CampanhaEmDestaque.IdAccount == SessaoUsuario.IdUsuarioLogado ? $"/sessao-iniciar/{CampanhaEmDestaque.IdCampanha}" : "/sessao-entrar")">@(CampanhaEmDestaque is null ? "Criar campanha" : CampanhaEmDestaque.IdAccount == SessaoUsuario.IdUsuarioLogado ? "Iniciar sessão" : "Entrar como jogador") <span aria-hidden="true">→</span></a>
                    <a class="action-secondary" href="@(EhJogador ? "/campanhas" : "/saladojogo")">@(EhJogador ? "Ver campanhas" : "Entrar na sala")</a>
                </div>
            </div>
        </section>

        <div class="home-layout">
            <div class="home-main-column">
                <section aria-labelledby="atalhos-titulo">
                    <div class="section-heading">
                        <div><h2 id="atalhos-titulo">Acesso rápido</h2><p>Prepare sua mesa sem perder o ritmo.</p></div>
                    </div>
                    <div class="quick-actions">
                        <a class="quick-action" href="/personagem-criar"><span class="quick-action-icon" aria-hidden="true">✦</span><span><strong>Novo personagem</strong><small>Crie uma ficha de aventureiro</small></span></a>
                        <a class="quick-action" href="/monstro-criar"><span class="quick-action-icon" aria-hidden="true">♜</span><span><strong>Cadastrar monstro</strong><small>Adicione uma criatura à coleção</small></span></a>
                        <a class="quick-action" href="/monstros-lib"><span class="quick-action-icon" aria-hidden="true">⌕</span><span><strong>Biblioteca de monstros</strong><small>Consulte ameaças e estatísticas</small></span></a>
                        <a class="quick-action" href="/ItensLib"><span class="quick-action-icon" aria-hidden="true">✧</span><span><strong>Biblioteca de itens</strong><small>Consulte equipamentos e recursos</small></span></a>
                        <a class="quick-action" href="/campanhas"><span class="quick-action-icon" aria-hidden="true">✎</span><span><strong>Suas campanhas</strong><small>Prepare suas mesas e aventuras</small></span></a>
                        <a class="quick-action" href="/sessao-entrar"><span class="quick-action-icon" aria-hidden="true">↗</span><span><strong>Entrar em sessão</strong><small>Use o código enviado pelo mestre</small></span></a>
                        <a class="quick-action" href="/personagem-lib"><span class="quick-action-icon" aria-hidden="true">◇</span><span><strong>Ver personagens</strong><small>Abra fichas, atributos e inventários</small></span></a>
                    </div>
                </section>

                <section aria-labelledby="atividade-titulo">
                    <div class="section-heading">
                        <div><h2 id="atividade-titulo">Atividade recente</h2><p>O que está acontecendo nas suas mesas.</p></div>
                        <a class="text-link" href="/campanhas">Ver campanhas</a>
                    </div>
                    <div class="activity-list">
                        <a class="activity-row" href="/personagem-lib">
                            <span class="activity-avatar">LV</span>
                            <span><h3>Lyra Ventobrasa</h3><p>Ficha atualizada em Crônicas de Eldoria</p></span>
                            <time class="activity-meta">Hoje</time>
                        </a>
                        <a class="activity-row" href="/monstros-lib">
                            <span class="activity-avatar">DR</span>
                            <span><h3>Bestiário da campanha</h3><p>Consulte as criaturas antes do próximo encontro</p></span>
                            <time class="activity-meta">Ontem</time>
                        </a>
                        <a class="activity-row" href="/personagem-lib">
                            <span class="activity-avatar">✧</span>
                            <span><h3>Tesouro do grupo</h3><p>Inventário pronto para receber novas recompensas</p></span>
                            <time class="activity-meta">Esta semana</time>
                        </a>
                    </div>
                </section>
            </div>

            <aside class="home-side-column" aria-label="Resumo das campanhas">
                <section>
                    <div class="section-heading">
                        <div><h2>Suas campanhas</h2><p>Histórias em andamento</p></div>
                        <a class="text-link" href="/criar-campanha" aria-label="Criar campanha">+ Nova</a>
                    </div>
                    <div class="home-campaigns">
                        @foreach (var campanha in Campanhas.Take(3))
                        {
                            <a class="home-campaign-row" href="@(campanha.IdAccount == SessaoUsuario.IdUsuarioLogado ? $"/sessao-iniciar/{campanha.IdCampanha}" : "/sessao-entrar")">
                                <img src="img/capacampanha1.png" alt="" />
                                <span><strong>@campanha.Nome</strong><small>@(campanha.IdAccount == SessaoUsuario.IdUsuarioLogado ? $"Criada em {campanha.DataCriacao:dd/MM/yyyy}" : "Campanha em andamento")</small></span>
                                <em>@(campanha.IdAccount == SessaoUsuario.IdUsuarioLogado ? "Sua mesa" : "Participando")</em>
                            </a>
                        }
                    </div>
                    @if (Campanhas.Count == 0)
                    {
                        <p class="home-campaign-empty">Nenhuma campanha nesta conta.</p>
                    }
                </section>

                <section id="resumo-mesa-home" hidden="@(!ExibirResumoMesa)">
                    <div class="section-heading">
                        <div><h2>Na sua mesa</h2><p>@(CampanhaEmDestaque?.Nome ?? "Campanhas em andamento")</p></div>
                    </div>
                    <div class="activity-list">
                        <div class="activity-row"><span class="activity-avatar">04</span><span><h3>Personagens</h3><p>Aventureiros nesta campanha</p></span></div>
                        <div class="activity-row"><span class="activity-avatar">12</span><span><h3>Encontros</h3><p>Notas e desafios preparados</p></span></div>
                    </div>
                </section>
            </aside>
        </div>
    </main>
</div>


@code {
    private List<Campanha> Campanhas { get; set; } = new();
    private Campanha? CampanhaEmDestaque => Campanhas.FirstOrDefault();
    private string NomeExibido => string.IsNullOrWhiteSpace(SessaoUsuario.NomeUsuario) ? "Mestre da mesa" : SessaoUsuario.NomeUsuario;
    private bool EhJogador => CampanhasComoJogador.Count > 0 && CampanhasComoMestre.Count == 0;
    private bool ExibirResumoMesa => Campanhas.Count > 0;
    private List<Campanha> CampanhasComoJogador { get; set; } = new();
    private List<Campanha> CampanhasComoMestre { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessaoUsuario.EstaLogado)
        {
            return;
        }

        CampanhasComoMestre = await CampanhaService.ObterCampanhasPorUsuarioAsync(SessaoUsuario.IdUsuarioLogado);
        CampanhasComoJogador = await CampanhaService.ObterCampanhasComoJogadorAsync(SessaoUsuario.IdUsuarioLogado);
        Campanhas = CampanhasComoMestre.Concat(CampanhasComoJogador)
            .DistinctBy(campanha => campanha.IdCampanha)
            .OrderByDescending(campanha => campanha.DataCriacao)
            .ToList();
    }
}
