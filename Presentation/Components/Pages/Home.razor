@page "/home"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject HomeViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell">
    <main class="app-content home-content botoes-personagem">
        <div class="home-greeting">
            <h1>Bom jogo, <span>@ViewModel.PrimeiroNomeUsuario</span>.</h1>
            <time class="home-date">@ViewModel.DataFormatada</time>
        </div>

        <section class="home-hero" aria-label="Campanhas em destaque">
            <div class="home-hero-art" aria-hidden="true">
                <img class="home-hero-cover home-hero-fallback @(ObterCapaVisivel(ViewModel.CampanhaCarrosselAtual) == HomeViewModel.CapaPadrao ? "is-active" : null)"
                     src="@HomeViewModel.CapaPadrao" alt="" />
                @foreach (var campanha in ViewModel.CampanhasCarrossel)
                {
                    var capa = ObterCapaVisivel(campanha);
                    if (capa != HomeViewModel.CapaPadrao)
                    {
                        <img @key="campanha!.IdCampanha"
                             class="home-hero-cover @(campanha == ViewModel.CampanhaCarrosselAtual ? "is-active" : null)"
                             src="@capa" alt="" @onerror="() => RegistrarFalhaNaCapa(capa)" />
                    }
                }
                @if (ViewModel.CampanhaCarrosselAtual is { } campanhaSemCapa && ObterCapaVisivel(campanhaSemCapa) == HomeViewModel.CapaPadrao)
                {
                    <div class="home-hero-iniciais">
                        <RetratoComIniciais Nome="@campanhaSemCapa.Nome" />
                    </div>
                }
            </div>
            <div class="home-hero-slides">
                @foreach (var campanha in ViewModel.CampanhasCarrossel)
                {
                    var ativa = campanha == ViewModel.CampanhaCarrosselAtual;
                    <div @key="campanha?.IdCampanha"
                         class="home-hero-slide @(ativa ? "is-active" : null)"
                         inert="@(!ativa)" aria-hidden="@(!ativa ? "true" : null)">
                        <p class="home-hero-label">@(campanha is null ? "RPG de Mesa" : "Campanha em destaque")</p>
                        <h2>@(campanha?.Nome ?? "Sua próxima aventura")</h2>
                        @if (campanha is null || !string.IsNullOrWhiteSpace(campanha.Descricao))
                        {
                            <p class="home-hero-description">@(campanha is null
                                ? "Crie uma campanha para organizar sua mesa e reunir seus jogadores."
                                : campanha.Descricao)</p>
                        }
                        <a class="botao-dourado home-hero-action" href="@ViewModel.ObterRotaCampanha(campanha)">
                            @ViewModel.ObterTextoBotaoHero(campanha) <span aria-hidden="true">→</span>
                        </a>
                    </div>
                }
            </div>
            @if (ViewModel.CampanhasResumo.Count > 1)
            {
                <p class="visually-hidden" role="status">
                    Campanha @(ViewModel.IndiceCampanhaCarrossel + 1) de @ViewModel.CampanhasResumo.Count: @ViewModel.CampanhaCarrosselAtual?.Nome
                </p>
                <div class="hero-carousel-controls" role="group" aria-label="Navegar pelas campanhas">
                    <div class="hero-carousel-indicators">
                        @for (var indice = 0; indice < ViewModel.CampanhasResumo.Count; indice++)
                        {
                            var posicao = indice;
                            var campanha = ViewModel.CampanhasResumo[posicao];
                            <button @key="campanha.IdCampanha" type="button"
                                    class="hero-carousel-indicator"
                                    aria-current="@(posicao == ViewModel.IndiceCampanhaCarrossel ? "true" : null)"
                                    aria-label="@($"Mostrar {campanha.Nome}, campanha {posicao + 1} de {ViewModel.CampanhasResumo.Count}")"
                                    @onclick="() => ViewModel.SelecionarCampanhaCarrossel(posicao)">
                            </button>
                        }
                    </div>
                    <div class="hero-carousel-arrows">
                        <button type="button" class="hero-carousel-arrow" aria-label="Campanha anterior"
                                @onclick="ViewModel.CampanhaAnterior">
                            <span aria-hidden="true">‹</span>
                        </button>
                        <button type="button" class="hero-carousel-arrow" aria-label="Próxima campanha"
                                @onclick="ViewModel.ProximaCampanha">
                            <span aria-hidden="true">›</span>
                        </button>
                    </div>
                </div>
            }
        </section>

        <div class="home-layout">
            <div class="home-main-column">
                <section aria-labelledby="atalhos-titulo">
                    <div class="section-heading">
                        <div>
                            <h2 id="atalhos-titulo">Acesso rápido</h2>
                            <p>Prepare sua mesa sem perder o ritmo.</p>
                        </div>
                    </div>
                    <div class="quick-actions">
                        <a class="quick-action" href="/personagem-criar">
                            <span class="quick-action-icon" aria-hidden="true">✦</span>
                            <span><strong>Novo personagem</strong><small>Crie uma ficha de aventureiro</small></span>
                        </a>
                        <a class="quick-action" href="/monstro-criar">
                            <span class="quick-action-icon" aria-hidden="true">♜</span>
                            <span><strong>Cadastrar monstro</strong><small>Adicione uma criatura à coleção</small></span>
                        </a>
                        <a class="quick-action" href="/BibliotecaGeral">
                            <span class="quick-action-icon" aria-hidden="true">⌕</span>
                            <span><strong>Biblioteca</strong><small>Consulte monstros, itens e recursos</small></span>
                        </a>
                        <a class="quick-action" href="/campanhas">
                            <span class="quick-action-icon" aria-hidden="true">✎</span>
                            <span><strong>Suas campanhas</strong><small>Prepare suas mesas e aventuras</small></span>
                        </a>
                        <a class="quick-action" href="/entrar-cod">
                            <span class="quick-action-icon" aria-hidden="true">↗</span>
                            <span><strong>Entrar em sessão</strong><small>Use o código enviado pelo mestre</small></span>
                        </a>
                        <a class="quick-action" href="/personagem-lib">
                            <span class="quick-action-icon" aria-hidden="true">◇</span>
                            <span><strong>Ver personagens</strong><small>Abra fichas, atributos e inventários</small></span>
                        </a>
                    </div>
                </section>

                <section aria-labelledby="atividade-titulo">
                    <div class="section-heading">
                        <div>
                            <h2 id="atividade-titulo">Atividade recente</h2>
                            <p>Os últimos 3 registros criados ou alterados.</p>
                        </div>
                        <a class="botao-secundario-dourado" href="/campanhas">Ver campanhas</a>
                    </div>
                    <div class="activity-list">
                        @if (ViewModel.AtividadesRecentes.Any())
                        {
                            @foreach (var item in ViewModel.AtividadesRecentes)
                            {
                                <a class="activity-row" href="@item.Rota">
                                    <span class="activity-avatar">@item.Iniciais</span>
                                    <span>
                                        <h3>@item.Titulo</h3>
                                        <p>@item.Descricao</p>
                                    </span>
                                    <time class="activity-meta">@item.Meta</time>
                                </a>
                            }
                        }
                        else if (!ViewModel.Carregando)
                        {
                            <p class="home-campaign-empty">Nenhuma atividade recente registrada nesta conta.</p>
                        }
                    </div>
                </section>
            </div>

            <aside class="home-side-column" aria-label="Resumo das campanhas">
                <section>
                    <div class="section-heading">
                        <div>
                            <h2>Suas campanhas</h2>
                            <p>Histórias em andamento</p>
                        </div>
                        <a class="botao-secundario-dourado" href="/criar-campanha" aria-label="Criar campanha">+ Nova</a>
                    </div>
                    <div class="home-campaigns">
                        @foreach (var campanha in ViewModel.CampanhasResumo)
                        {
                            <a class="home-campaign-row" href="@ViewModel.ObterRotaCampanha(campanha)">
                                <span class="home-campaign-retrato">
                                    <RetratoComIniciais Nome="@campanha.Nome" Imagem="@campanha.Capa" AceitarBase64="true" />
                                </span>
                                <span>
                                    <strong>@campanha.Nome</strong>
                                    <small>@(ViewModel.EhMestreDaCampanha(campanha) ? $"Criada em {campanha.DataCriacao:dd/MM/yyyy}" : "Campanha em andamento")</small>
                                </span>
                                <em>@(ViewModel.EhMestreDaCampanha(campanha) ? "Sua mesa" : "Participando")</em>
                            </a>
                        }
                    </div>
                    @if (!ViewModel.Carregando && ViewModel.CampanhasResumo.Count == 0)
                    {
                        <p class="home-campaign-empty">Nenhuma campanha nesta conta.</p>
                    }
                </section>

                <section id="resumo-mesa-home" hidden="@(!ViewModel.ExibirResumoMesa)">
                    <div class="section-heading">
                        <div>
                            <h2>Na sua mesa</h2>
                            <p>@ViewModel.DestaqueResumo?.Nome</p>
                        </div>
                    </div>
                    <div class="activity-list">
                        <div class="activity-row">
                            <span class="activity-avatar">@ViewModel.TotalPersonagensDestaque.ToString("00")</span>
                            <span>
                                <h3>Personagens</h3>
                                <p>Aventureiros nesta campanha</p>
                            </span>
                        </div>
                        <div class="activity-row">
                            <span class="activity-avatar">@ViewModel.TotalElementosMesaDestaque.ToString("00")</span>
                            <span>
                                <h3>Encontros</h3>
                                <p>Monstros e NPCs preparados</p>
                            </span>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </main>
</div>

@code {
    private readonly HashSet<string> _capasIndisponiveis = new(StringComparer.Ordinal);

    private string ObterCapaVisivel(HomeCampanhaResumo? campanha)
    {
        var capa = ViewModel.ObterCapaCampanha(campanha);
        return _capasIndisponiveis.Contains(capa) || RetratoComIniciais.UsaImagemAntiga(capa)
            ? HomeViewModel.CapaPadrao
            : capa;
    }

    private void RegistrarFalhaNaCapa(string capa)
    {
        if (capa != HomeViewModel.CapaPadrao)
            _capasIndisponiveis.Add(capa);
    }

    protected override void OnInitialized()
    {
        ViewModel.OnChange -= AtualizarTela;
        ViewModel.OnChange += AtualizarTela;
        ViewModel.HidratarDoCacheSincrono();
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.CarregarDadosAsync();
    }

    private void AtualizarTela() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.OnChange -= AtualizarTela;
    }
}
