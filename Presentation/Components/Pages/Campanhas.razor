@page "/campanhas"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject CampanhasViewModel VM

<NavMenu />

<div class="tela-rpg tela-campanhas">
    <main class="conteudo-rpg">
        <div class="titulo-pagina">
            <div>
                <p class="sobretitulo-rpg">Sua biblioteca de aventuras</p>
                <h1>Campanhas</h1>
                <p class="texto-apoio">Histórias prontas para continuar ou participar.</p>
            </div>

            <div class="acoes-cabecalho">
                <button type="button" class="botao-secundario-dourado" @onclick="VM.AbrirModalEntrar">
                    <span aria-hidden="true">🔑</span> Inserir convite
                </button>
                <a class="botao-dourado" href="/criar-campanha">
                    <span aria-hidden="true">+</span> Nova campanha
                </a>
            </div>
        </div>

        <div class="abas-navegacao">
            <button type="button"
                    class="botao-aba @(VM.AbaAtiva == "mestre" ? "ativo" : "")"
                    @onclick='() => VM.SelecionarAba("mestre")'>
                Como Mestre (@VM.CampanhasMestre.Count)
            </button>
            <button type="button"
                    class="botao-aba @(VM.AbaAtiva == "jogador" ? "ativo" : "")"
                    @onclick='() => VM.SelecionarAba("jogador")'>
                Como Jogador (@VM.CampanhasJogador.Count)
            </button>
        </div>

        @if (VM.AbaAtiva == "mestre")
        {
            @if (!VM.CampanhasMestre.Any())
            {
                <p class="aviso-vazio">Você ainda não criou nenhuma campanha como Mestre.</p>
            }

            <div class="grade-campanhas">
                <a class="cartao-adicionar" href="/criar-campanha">
                    <span class="mais-adicionar" aria-hidden="true">+</span>
                    <strong>Criar campanha</strong>
                    <small>Comece uma nova aventura</small>
                </a>

                @foreach (var campanha in VM.CampanhasMestre)
                {
                    <CartaoCampanha Campanha="campanha"
                                    ComoJogador="false"
                                    OnRemover="c => VM.PedirRemocaoCampanha(c, false)" />
                }
            </div>
        }
        else
        {
            @if (!VM.CampanhasJogador.Any())
            {
                <p class="aviso-vazio">Você ainda não está participando de nenhuma campanha como jogador.</p>
            }

            <div class="grade-campanhas">
                @foreach (var campanha in VM.CampanhasJogador)
                {
                    <CartaoCampanha Campanha="campanha"
                                    ComoJogador="true"
                                    OnRemover="c => VM.PedirRemocaoCampanha(c, true)" />
                }

                <button type="button" class="cartao-adicionar" @onclick="VM.AbrirModalEntrar">
                    <span class="mais-adicionar" aria-hidden="true">🔑</span>
                    <strong>Entrar com código</strong>
                    <small>Insira o convite do Mestre</small>
                </button>
            </div>
        }
    </main>

    @if (VM.ExibirModalEntrar)
    {
        <ModalEntrar OnFechar="VM.FecharModalEntrar"
                     OnCampanhaEntrada="VM.CampanhaEntradaSucessoAsync" />
    }

    <ConfirmarExclusao Visivel="@(VM.CampanhaPendente is not null)"
                       Processando="VM.ProcessandoRemocao"
                       Titulo="@VM.TituloConfirmacaoCampanha"
                       Mensagem="@VM.MensagemConfirmacaoCampanha"
                       Erro="@VM.ErroRemocaoCampanha"
                       OnConfirmar="VM.ConfirmarRemocaoCampanhaAsync"
                       OnCancelar="VM.CancelarRemocaoCampanha" />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.CarregarCampanhasAsync();
    }
}