@page "/perfil"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject PerfilViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell">
    <main class="app-content">
        <div class="page-heading">
            <div>
                <p class="page-kicker">Sua conta na mesa</p>
                <h1 class="page-title">Perfil</h1>
                <p class="page-description">Visualize os dados da sua conta e personalize seu nome de exibição, biografia e foto.</p>
            </div>
        </div>

        <div class="profile-layout">
            <aside class="profile-summary" aria-label="Resumo do perfil">
                <div class="profile-avatar" aria-hidden="true">
                    <span>@ViewModel.Iniciais</span>
                    @if (ViewModel.TemAvatar)
                    {
                        <img class="profile-photo-preview" src="@ViewModel.AvatarUrl" alt="Foto de perfil" />
                    }
                </div>

                <div>
                    <h2>@ViewModel.NomeExibicao</h2>
                    <p>@ViewModel.Email</p>
                </div>

                <div class="profile-metrics">
                    <div>
                        <strong>@ViewModel.TotalPersonagens</strong>
                        <small>personagens</small>
                    </div>
                    <div>
                        <strong>@ViewModel.TotalMonstros</strong>
                        <small>criaturas próprias</small>
                    </div>
                </div>

                <div class="upload-imagem profile-image-upload">
                    <label class="upload-imagem-botao">
                        <span aria-hidden="true">↑</span> @(ViewModel.TemAvatar ? "Trocar foto de perfil" : "Escolher foto de perfil")
                        <InputFile @key="ViewModel.ChaveInputAvatar" OnChange="ViewModel.SelecionarAvatarAsync" accept="image/*" aria-label="Escolher foto de perfil" />
                    </label>
                    @if (ViewModel.TemAvatar)
                    {
                        <button type="button" class="action-quiet" @onclick="ViewModel.RemoverAvatar">Remover foto</button>
                    }
                    <p class="upload-imagem-status" role="status" aria-live="polite">@ViewModel.StatusUpload</p>
                </div>
            </aside>

            <form class="profile-settings form-panel" @onsubmit="ViewModel.SalvarPerfilAsync" @onsubmit:preventDefault="true">
                <section class="settings-section">
                    <h2>Informações da conta</h2>
                    <div class="form-grid">
                        <label class="form-field">
                            Nome de exibição
                            <input @bind="ViewModel.NomeExibicaoInput" maxlength="100" required placeholder="Como você aparece nas mesas" />
                            <span class="field-hint">Exibido no menu, nas sessões e no chat.</span>
                        </label>
                        <label class="form-field">
                            Nome de usuário (login)
                            <input value="@ViewModel.UsernameLogin" readonly disabled />
                        </label>
                        <label class="form-field">
                            E-mail
                            <input type="email" value="@ViewModel.Email" readonly disabled />
                        </label>
                        <label class="form-field">
                            Status da conta
                            <input value="@ViewModel.StatusConta" readonly disabled />
                        </label>
                        <label class="form-field">
                            Membro desde
                            <input value="@(ViewModel.DataCadastro?.ToString("dd/MM/yyyy") ?? "—")" readonly disabled />
                        </label>
                        <label class="form-field full-width">
                            Sobre você (Biografia)
                            <textarea @bind="ViewModel.Biografia" maxlength="500" placeholder="Conte um pouco sobre seu estilo de jogo."></textarea>
                        </label>
                    </div>
                </section>

                <div class="form-footer">
                    <p class="form-status" role="status" aria-live="polite">@ViewModel.MensagemStatus</p>
                    <button class="action-secondary" type="button" disabled="@ViewModel.Salvando" @onclick="ViewModel.AbrirAvisoSaida">Cancelar</button>
                    <button class="action-primary" type="submit" disabled="@(ViewModel.Carregando || ViewModel.Salvando)">
                        @(ViewModel.Salvando ? "Salvando..." : "Salvar perfil")
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

@if (ViewModel.ExibirAvisoSaida)
{
    <div class="confirm-overlay" role="presentation" @onclick="ViewModel.FecharAvisoSaida">
        <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="titulo-aviso-perfil" aria-describedby="mensagem-aviso-perfil" @onclick:stopPropagation="true">
            <h2 id="titulo-aviso-perfil">Sair sem salvar?</h2>
            <p id="mensagem-aviso-perfil">As alterações feitas no perfil serão perdidas.</p>
            <div class="confirm-actions">
                <button class="confirm-exit" type="button" @onclick="ViewModel.ConfirmarSaida">Sim</button>
                <button class="confirm-cancel" type="button" @onclick="ViewModel.FecharAvisoSaida">Não</button>
            </div>
        </section>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.OnChange -= StateHasChanged;
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.CarregarPerfilAsync();
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}