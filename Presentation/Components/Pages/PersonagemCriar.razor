@page "/personagem-criar"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject PersonagemCriarViewModel ViewModel
@implements IDisposable

<NavigationLock OnBeforeInternalNavigation="ViewModel.ConfirmarNavegacao" />

<div class="app-shell criacao-personagem">
    <main class="app-content">
        <button class="exit-prompt-link" type="button" @onclick="ViewModel.AbrirAvisoSaida">
            <span aria-hidden="true">←</span> Voltar aos personagens
        </button>

        <header class="top-bar">
            <div class="top-bar-copy">
                <p class="page-kicker">Compêndio de Heróis</p>
                <h1 class="page-title">Criar Personagem Completo</h1>
                <p class="page-description">Preencha todas as etapas para gerar a ficha com atributos, história e grimório. Os equipamentos serão vinculados ao ingressar em uma campanha.</p>
            </div>
        </header>

        <aside class="form-aside" aria-label="Prévia do personagem">
            <div class="aside-portrait">
                @if (TemFotoPersonagem)
                {
                    <img id="preview-img"
                         src="@ViewModel.PersonagemAtual.Imagem"
                         alt="Prévia do retrato do personagem" />
                }
                else
                {
                    <span class="aside-initials" aria-hidden="true">@IniciaisPersonagem</span>
                }
            </div>
            <div class="aside-info">
                <div class="preview-actions">
                    <label class="btn-upload">
                        ↑ Escolher foto do herói
                        <InputFile OnChange="ViewModel.CarregarFotoAsync" accept="image/*" aria-label="Escolher foto do personagem" />
                    </label>
                    <p class="upload-help">Imagem de até 2 MB.</p>
                    @if (!string.IsNullOrWhiteSpace(ViewModel.ErroImagem))
                    {
                        <p class="field-error" role="alert">@ViewModel.ErroImagem</p>
                    }
                </div>
                <div class="aside-summary">
                    <strong class="aside-name">@(string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.Nome) ? "Novo Personagem" : ViewModel.PersonagemAtual.Nome)</strong>
                    <span class="aside-meta">@(string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.RacaTexto) ? "Raça" : ViewModel.PersonagemAtual.RacaTexto) • @(string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.ClasseTexto) ? "Classe" : ViewModel.PersonagemAtual.ClasseTexto) • Nível Total @ViewModel.PersonagemAtual.Nivel</span>
                    <hr class="aside-divider" />
                    <small class="aside-hint">Os dados preenchidos nas quatro etapas irão compor as abas Atributos, Personagem e Grimório da ficha final.</small>
                </div>
            </div>
        </aside>

        <section class="wizard-progress" aria-label="Progresso da criação">
            <div class="progress-info">
                <div class="progress-current">
                    <span>Progresso da criação</span>
                    <strong>Etapa @ViewModel.EtapaAtual de @PersonagemCriarViewModel.TotalEtapas</strong>
                </div>
                <p aria-live="polite">@(ViewModel.EtapaAtual == PersonagemCriarViewModel.TotalEtapas ? "Última etapa — falta concluir esta ficha" : $"{PersonagemCriarViewModel.TotalEtapas - ViewModel.EtapaAtual} {(PersonagemCriarViewModel.TotalEtapas - ViewModel.EtapaAtual == 1 ? "etapa restante" : "etapas restantes")}")</p>
            </div>
            <div class="progress-track" role="progressbar" aria-valuemin="1" aria-valuemax="@PersonagemCriarViewModel.TotalEtapas" aria-valuenow="@ViewModel.EtapaAtual" aria-label="Progresso das etapas">
                <div class="progress-fill" style="width: @(((ViewModel.EtapaAtual - 1) * 100) / (PersonagemCriarViewModel.TotalEtapas - 1))%"></div>
            </div>

            <nav class="wizard-steps" aria-label="Etapas da criação">
                @for (var indice = 0; indice < ViewModel.Etapas.Count; indice++)
                {
                    var etapa = indice + 1;
                    <button type="button" class="step-pill @(ViewModel.EtapaAtual == etapa ? "active" : ViewModel.EtapaAtual > etapa ? "completed" : "")"
                            disabled="@(etapa > ViewModel.EtapaAtual)"
                            title="@(etapa > ViewModel.EtapaAtual ? "Conclua as etapas anteriores para liberar esta." : "Revisar etapa")"
                            aria-current="@(ViewModel.EtapaAtual == etapa ? "step" : null)"
                            @onclick="() => ViewModel.IrParaEtapa(etapa)">
                        <span class="step-number">@(ViewModel.EtapaAtual > etapa ? "✓" : etapa.ToString())</span>
                        <span class="step-label"><small>Etapa @etapa</small><strong>@ViewModel.Etapas[indice]</strong></span>
                    </button>
                    @if (indice < ViewModel.Etapas.Count - 1)
                    {
                        <span class="step-connector" aria-hidden="true">→</span>
                    }
                }
            </nav>
        </section>

        <form id="form-wizard" class="wizard-layout" @onsubmit="ViewModel.SalvarPersonagemAsync" @onsubmit:preventDefault="true">
            <section class="ficha-pergaminho">

                @if (ViewModel.EtapaAtual == 1)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">1. Identidade, Raça, Classes e Biografia Física</h2>

                        <div class="form-grid-2">
                            <label class="campo-ficha full-width">
                                <span>Nome do Personagem</span>
                                <input type="text"
                                       @bind="ViewModel.PersonagemAtual.Nome"
                                       @bind:event="oninput"
                                       maxlength="60"
                                       placeholder="Ex.: Lyra Ventobrasa"
                                       autocomplete="off"
                                       required />
                            </label>

                            <label class="campo-ficha">
                                <span>Raça</span>
                                <select @bind="ViewModel.PersonagemAtual.RacaTexto" required>
                                    <option value="">Escolha uma raça...</option>
                                    <option value="Humano">Humano</option>
                                    <option value="Elfo">Elfo</option>
                                    <option value="Anão">Anão</option>
                                    <option value="Halfling">Halfling</option>
                                    <option value="Meio-elfo">Meio-elfo</option>
                                    <option value="Meio-orc">Meio-orc</option>
                                    <option value="Tiefling">Tiefling</option>
                                    <option value="Draconato">Draconato</option>
                                    <option value="Gnomo">Gnomo</option>
                                    <option value="Orc">Orc</option>
                                    <option value="Outra">Outra</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Antecedente</span>
                                <select @bind="ViewModel.PersonagemAtual.AntecedenteTexto" required>
                                    <option value="">Escolha um antecedente...</option>
                                    <option value="Acólito">Acólito</option>
                                    <option value="Artesão de Guilda">Artesão de Guilda</option>
                                    <option value="Artista">Artista</option>
                                    <option value="Batedor">Batedor</option>
                                    <option value="Charlatão">Charlatão</option>
                                    <option value="Criminoso">Criminoso</option>
                                    <option value="Eremita">Eremita</option>
                                    <option value="Forasteiro">Forasteiro</option>
                                    <option value="Herói do Povo">Herói do Povo</option>
                                    <option value="Marinheiro">Marinheiro</option>
                                    <option value="Nobre">Nobre</option>
                                    <option value="Órfão">Órfão</option>
                                    <option value="Sábio">Sábio</option>
                                    <option value="Soldado">Soldado</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Tendência</span>
                                <select @bind="ViewModel.PersonagemAtual.Tendencia">
                                    <option value="Neutra">Neutra</option>
                                    <option value="Leal e boa">Leal e boa</option>
                                    <option value="Neutra e boa">Neutra e boa</option>
                                    <option value="Caótica e boa">Caótica e boa</option>
                                    <option value="Leal e neutra">Leal e neutra</option>
                                    <option value="Caótica e neutra">Caótica e neutra</option>
                                    <option value="Leal e má">Leal e má</option>
                                    <option value="Neutra e má">Neutra e má</option>
                                    <option value="Caótica e má">Caótica e má</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Experiência (XP)</span>
                                <input type="number" @bind="ViewModel.PersonagemAtual.ExperienciaXp" min="0" max="999999" step="10" required />
                            </label>

                            <div class="categoria-itens full-width" style="margin-bottom: 4px;">
                                <div class="titulo-categoria">
                                    <h3>⌁ Classes do Personagem (Nível Total: @ViewModel.PersonagemAtual.Nivel)</h3>
                                    <button type="button" class="btn-add-item" title="Adicionar outra classe (Multiclasse)" @onclick="ViewModel.AdicionarClasse">+</button>
                                </div>
                                <div class="cabecalho-linha" style="grid-template-columns: 1fr 110px 32px;">
                                    <span>Classe</span>
                                    <span>Nível na Classe</span>
                                    <span></span>
                                </div>
                                @foreach (var cl in ViewModel.ClassesSelecionadas)
                                {
                                    <div class="item-linha" style="grid-template-columns: 1fr 110px 32px;">
                                        <select value="@cl.NomeClasse" @onchange="e => ViewModel.AlterarNomeClasse(cl, e.Value?.ToString())">
                                            @foreach (var op in ViewModel.ListaOpcoesClasses)
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        </select>
                                        <input type="number" min="1" max="20" value="@cl.Nivel" @onchange="e => ViewModel.AlterarNivelClasse(cl, e.Value?.ToString())" />
                                        @if (ViewModel.ClassesSelecionadas.Count > 1)
                                        {
                                            <button type="button" class="remover-item" title="Remover classe" @onclick="() => ViewModel.RemoverClasse(cl)">×</button>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="form-divider">Características Físicas (Aba Personagem)</div>

                            <div class="form-grid-4 full-width">
                                <label class="campo-ficha">
                                    <span>Idade (Anos)</span>
                                    <input type="number" @bind="ViewModel.IdadeNumero" min="1" max="10000" step="1" required />
                                </label>

                                <label class="campo-ficha">
                                    <span>Gênero</span>
                                    <select @bind="ViewModel.PersonagemAtual.Genero" required>
                                        <option value="Masculino">Masculino</option>
                                        <option value="Feminino">Feminino</option>
                                        <option value="Não-binário">Não-binário</option>
                                        <option value="Outro">Outro</option>
                                    </select>
                                </label>

                                <label class="campo-ficha">
                                    <span>Altura (cm)</span>
                                    <input type="number" @bind="ViewModel.AlturaCm" min="30" max="400" step="1" required />
                                </label>

                                <label class="campo-ficha">
                                    <span>Peso (kg)</span>
                                    <input type="number" @bind="ViewModel.PesoKg" min="1" max="1000" step="0.5" required />
                                </label>
                            </div>
                        </div>
                    </div>
                }
                else if (ViewModel.EtapaAtual == 2)
                {
                    <div class="step-panel active step-panel-attributes">
                        <h2 class="section-title">2. Atributos, Salvaguardas e Perícias</h2>
                        <p class="step-intro">Defina as capacidades do personagem e marque as competências em que ele é proficiente.</p>

                        <section class="atributos-area" aria-labelledby="titulo-atributos-criacao">
                            <div class="stage-heading">
                                <span class="stage-index">01</span>
                                <div>
                                    <h3 id="titulo-atributos-criacao">Atributos principais</h3>
                                    <p>Informe os valores de cada atributo. O modificador é calculado automaticamente.</p>
                                </div>
                            </div>
                            <div class="atributos-cards">
                                <label class="atributo-box">
                                    <span>Força</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Forca" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Forca)</small>
                                </label>
                                <label class="atributo-box">
                                    <span>Destreza</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Destreza" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Destreza)</small>
                                </label>
                                <label class="atributo-box">
                                    <span>Constituição</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Constituicao" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Constituicao)</small>
                                </label>
                                <label class="atributo-box">
                                    <span>Inteligência</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Inteligencia" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Inteligencia)</small>
                                </label>
                                <label class="atributo-box">
                                    <span>Sabedoria</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Sabedoria" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Sabedoria)</small>
                                </label>
                                <label class="atributo-box">
                                    <span>Carisma</span>
                                    <input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Carisma" @bind:event="oninput" />
                                    <small>@PersonagemCriarViewModel.ObterModificador(ViewModel.PersonagemAtual.Carisma)</small>
                                </label>
                            </div>
                        </section>

                        <div class="proficiencias-area">
                            <section class="pericias-grupo salvaguardas-grupo" aria-labelledby="titulo-salvaguardas">
                                <div class="grupo-heading">
                                    <div>
                                        <span class="grupo-kicker">Resistência</span>
                                        <h3 id="titulo-salvaguardas">Salvaguardas</h3>
                                    </div>
                                    <p>Marque os atributos em que possui proficiência.</p>
                                </div>
                                <div class="opcoes-salvaguarda">
                                    @foreach (var salv in ViewModel.ListaSalvaguardas)
                                    {
                                        <label class="opcao-proficiencia">
                                            <input type="checkbox"
                                                   checked="@ViewModel.SalvaguardasSelecionadas.Contains(salv)"
                                                   @onchange="e => ViewModel.AlternarSalvaguarda(salv, (bool)(e.Value ?? false))" />
                                            <span>@salv</span>
                                        </label>
                                    }
                                </div>
                            </section>

                            <section class="pericias-grupo lista-pericias-grupo" aria-labelledby="titulo-pericias">
                                <div class="grupo-heading">
                                    <div>
                                        <span class="grupo-kicker">Conhecimento e prática</span>
                                        <h3 id="titulo-pericias">Perícias</h3>
                                    </div>
                                    <p>Selecione todas as perícias nas quais o personagem é treinado.</p>
                                </div>
                                <div class="opcoes-pericias">
                                    @foreach (var pericia in ViewModel.ListaPericias)
                                    {
                                        <label class="opcao-proficiencia">
                                            <input type="checkbox"
                                                   checked="@ViewModel.PericiasSelecionadas.Contains(pericia)"
                                                   @onchange="e => ViewModel.AlternarPericia(pericia, (bool)(e.Value ?? false))" />
                                            <span>@pericia</span>
                                        </label>
                                    }
                                </div>
                            </section>
                        </div>
                    </div>
                }
                else if (ViewModel.EtapaAtual == 3)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">3. Personalidade, Diário, Aparência e História</h2>
                        <div class="form-grid-2">
                            <div class="painel-personagem">
                                <h3>Traços de Personalidade</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.TracosPersonalidade" placeholder="Ex.: Observo tudo antes de agir. A floresta sempre avisa."></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Ponto de Vista Atual</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.PontoDeVista" placeholder="Ex.: Nem toda trilha segura leva ao destino certo."></textarea>
                            </div>

                            <div class="form-divider">Seções do Diário (Aba Atributos)</div>

                            <div class="painel-personagem">
                                <h3>Ideais</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Ideais" placeholder="Ex.: Proteger os caminhos antigos é proteger quem ainda virá."></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Ligações</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Ligacoes" placeholder="Pessoas, lugares ou relíquias importantes..."></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Defeitos</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Defeitos" placeholder="Fraquezas, vícios ou medos do personagem..."></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Idiomas Conhecidos</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Idiomas" placeholder="Ex.: Comum, Élfico, Silvestre..."></textarea>
                            </div>

                            <div class="form-divider">Detalhes Narrativos (Aba Personagem)</div>

                            <div class="painel-personagem">
                                <h3>Aparência</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Aparencia" placeholder="Descreva a aparência física, cicatrizes e vestimentas..."></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Aliados e Organizações</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Aliados" placeholder="Descreva aliados, guildas e facções..."></textarea>
                            </div>
                            <div class="painel-personagem full-width">
                                <h3>História do Personagem</h3>
                                <textarea rows="4" @bind="ViewModel.PersonagemAtual.Historia" placeholder="De onde veio? O que busca? O que não consegue esquecer?"></textarea>
                            </div>
                            <div class="painel-personagem">
                                <h3>Características e Habilidades</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Caracteristicas" placeholder="Talentos raciais, habilidades de classe..."></textarea>
                            </div>
                            <div class="painel-personagem tesouro">
                                <h3>Tesouro Pessoal</h3>
                                <textarea @bind="ViewModel.PersonagemAtual.Tesouro" placeholder="Relíquias ou riquezas pessoais..."></textarea>
                            </div>
                        </div>
                    </div>
                }
                else if (ViewModel.EtapaAtual == 4)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">4. Equipar Magias e Truques do Grimório</h2>

                        <div class="corpo-inventario">
                            <!-- COLUNA ESQUERDA: Catálogo + Magias Vinculadas -->
                            <div class="magias-coluna-principal">
                                <!-- Seletor do catálogo dbo.Magia -->
                                <div class="categoria-itens">
                                    <div class="titulo-categoria">
                                        <h3>⌁ Catálogo de Magias</h3>
                                        <button type="button"
                                                class="btn-magia-manual"
                                                @onclick="ViewModel.AlternarFormNovaMagia">
                                            @(ViewModel.ExibirFormNovaMagia ? "Fechar cadastro manual" : "+ Magia personalizada")
                                        </button>
                                    </div>

                                    <div class="magia-filtros">
                                        <input type="search"
                                               class="magia-busca-input"
                                               @bind="ViewModel.TermoBuscaMagia"
                                               @bind:event="oninput"
                                               placeholder="Buscar magia por nome, escola ou efeito..."
                                               autocomplete="off" />

                                        <select class="magia-filtro-select" @bind="ViewModel.FiltroCirculoMagia" aria-label="Filtrar por círculo">
                                            <option value="todos">Todos os círculos</option>
                                            <option value="0">Truque (0)</option>
                                            <option value="1">1º Círculo</option>
                                            <option value="2">2º Círculo</option>
                                            <option value="3">3º Círculo</option>
                                            <option value="4">4º Círculo</option>
                                            <option value="5">5º Círculo</option>
                                            <option value="6">6º Círculo</option>
                                            <option value="7">7º Círculo</option>
                                            <option value="8">8º Círculo</option>
                                            <option value="9">9º Círculo</option>
                                        </select>
                                    </div>

                                    <div class="magia-catalogo-lista">
                                        @if (ViewModel.MagiasCatalogoFiltradas.Any())
                                        {
                                            @foreach (var magia in ViewModel.MagiasCatalogoFiltradas)
                                            {
                                                <div class="magia-catalogo-linha" @onclick="() => ViewModel.VisualizarMagiaCatalogo(magia)">
                                                    <div class="magia-catalogo-info">
                                                        <strong>@magia.Nome</strong>
                                                        <small>
                                                            @MagiaGrimorioEntry.ConverterNivelParaTexto(magia.CirculoNivel)
                                                            @if (!string.IsNullOrWhiteSpace(magia.Escola))
                                                            {
                                                                <text> · @magia.Escola</text>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(magia.TempoConjuracao))
                                                            {
                                                                <text> · @magia.TempoConjuracao</text>
                                                            }
                                                        </small>
                                                    </div>
                                                    <button type="button"
                                                            class="btn-add-item"
                                                            title="Equipar @magia.Nome no grimório"
                                                            aria-label="Equipar @magia.Nome"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => ViewModel.VincularMagiaDoCatalogo(magia)">
                                                        +
                                                    </button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="magia-vazia">Nenhuma magia encontrada no catálogo com esse filtro.</p>
                                        }
                                    </div>

                                    @if (ViewModel.ExibirFormNovaMagia)
                                    {
                                        <div class="magia-manual-box">
                                            <div class="form-grid-2">
                                                <label class="campo-ficha full-width">
                                                    <span>Nome da Magia*</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.Nome" maxlength="100" placeholder="Ex.: Mísseis Mágicos" />
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Círculo / Nível</span>
                                                    <select @bind="ViewModel.NovaMagiaManual.Circulo">
                                                        @foreach (var c in ViewModel.ListaCirculos)
                                                        {
                                                            <option value="@c">@c</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Escola</span>
                                                    <select @bind="ViewModel.NovaMagiaManual.Escola">
                                                        <option value="">Selecionar...</option>
                                                        @foreach (var esc in ViewModel.ListaEscolasMagia)
                                                        {
                                                            <option value="@esc">@esc</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Tempo de Conjuração</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.TempoConjuracao" maxlength="50" placeholder="Ex.: 1 ação" />
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Alcance</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.Alcance" maxlength="50" placeholder="Ex.: 36 metros" />
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Componentes</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.Componentes" maxlength="100" placeholder="Ex.: V, S" />
                                                </label>
                                                <label class="campo-ficha">
                                                    <span>Duração</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.Duracao" maxlength="50" placeholder="Ex.: Instantânea" />
                                                </label>
                                                <label class="campo-ficha full-width">
                                                    <span>Dano / Efeito</span>
                                                    <input type="text" @bind="ViewModel.NovaMagiaManual.DanoEfeito" maxlength="100" placeholder="Ex.: 3d4+3 de energia" />
                                                </label>
                                            </div>
                                            <div class="magia-manual-acoes">
                                                <button type="button" class="action-primary" @onclick="ViewModel.AdicionarMagiaManual">Adicionar ao Grimório</button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Lista de Magias Equipadas no Personagem -->
                                <div class="categoria-itens">
                                    <div class="titulo-categoria">
                                        <h3>✦ Magias Equipadas no Grimório (@ViewModel.Magias.Count)</h3>
                                    </div>

                                    @if (ViewModel.Magias.Any())
                                    {
                                        <div class="cabecalho-linha magia-equipada-grid">
                                            <span>Nome</span>
                                            <span>Círculo</span>
                                            <span>Escola</span>
                                            <span>Dano / Efeito</span>
                                            <span></span>
                                        </div>
                                        <div id="lista-magias">
                                            @foreach (var magia in ViewModel.Magias)
                                            {
                                                bool selecionada = ViewModel.MagiaEmVisualizacao == magia;
                                                <div class="item-linha magia-equipada-grid magia-equipada-row @(selecionada ? "selecionada" : "")"
                                                     @onclick="() => ViewModel.VisualizarMagia(magia)">
                                                    <strong class="magia-cell-nome">@magia.Nome</strong>
                                                    <span>@magia.Circulo</span>
                                                    <span>@(string.IsNullOrWhiteSpace(magia.Escola) ? "—" : magia.Escola)</span>
                                                    <span>@(string.IsNullOrWhiteSpace(magia.DanoEfeito) ? "—" : magia.DanoEfeito)</span>
                                                    <button type="button"
                                                            class="remover-item"
                                                            title="Remover magia"
                                                            aria-label="Remover @magia.Nome"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => ViewModel.RemoverMagia(magia)">
                                                        ×
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="magia-vazia">Nenhuma magia equipada ainda. Clique no <strong>+</strong> em uma magia do catálogo acima.</p>
                                    }
                                </div>
                            </div>

                            <!-- COLUNA DIREITA: Resumo + Visualização Completa de todos os campos da Magia -->
                            <aside class="resumo-inventario" aria-label="Detalhes e resumo do grimório">
                                <div class="painel-moedas">
                                    <h3>Resumo do Grimório</h3>
                                    <div class="grimorio-resumo-grid">
                                        <div>
                                            <span>Total</span>
                                            <strong>@ViewModel.Magias.Count</strong>
                                        </div>
                                        <div>
                                            <span>Truques</span>
                                            <strong>@ViewModel.Magias.Count(m => m.ObterNivelCirculo() == 0)</strong>
                                        </div>
                                        <div>
                                            <span>Círculos 1–9</span>
                                            <strong>@ViewModel.Magias.Count(m => m.ObterNivelCirculo() > 0)</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="painel-carga magia-detalhes-painel">
                                    <h3>Visualização da Magia</h3>
                                    @if (ViewModel.MagiaEmVisualizacao != null)
                                    {
                                        var m = ViewModel.MagiaEmVisualizacao;
                                        <strong class="magia-detalhe-titulo">@m.Nome</strong>
                                        <dl class="magia-detalhe-lista">
                                            <div>
                                                <dt>Círculo / Nível</dt>
                                                <dd>@m.Circulo (Nível @m.ObterNivelCirculo())</dd>
                                            </div>
                                            <div>
                                                <dt>Escola</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.Escola) ? "Não informada" : m.Escola)</dd>
                                            </div>
                                            <div>
                                                <dt>Tempo de Conjuração</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.TempoConjuracao) ? "Não informado" : m.TempoConjuracao)</dd>
                                            </div>
                                            <div>
                                                <dt>Alcance</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.Alcance) ? "Não informado" : m.Alcance)</dd>
                                            </div>
                                            <div>
                                                <dt>Componentes</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.Componentes) ? "Não informados" : m.Componentes)</dd>
                                            </div>
                                            <div>
                                                <dt>Duração</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.Duracao) ? "Não informada" : m.Duracao)</dd>
                                            </div>
                                            <div>
                                                <dt>Dano / Efeito</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(m.DanoEfeito) ? "Não informado" : m.DanoEfeito)</dd>
                                            </div>
                                        </dl>
                                    }
                                    else
                                    {
                                        <p class="magia-detalhe-vazio">Clique em qualquer magia do catálogo ou do grimório para visualizar escola, tempo de conjuração, alcance, componentes, duração e dano/efeito.</p>
                                    }
                                </div>
                            </aside>
                        </div>
                    </div>
                }

                <footer class="wizard-footer">
                    <button class="action-secondary"
                            type="button"
                            style="visibility: @(ViewModel.EtapaAtual == 1 ? "hidden" : "visible")"
                            @onclick="ViewModel.VoltarEtapa"
                            disabled="@(ViewModel.EtapaAtual == 1 || ViewModel.IsProcessing)">
                        ← Etapa Anterior
                    </button>

                    @if (ViewModel.EtapaAtual < PersonagemCriarViewModel.TotalEtapas)
                    {
                        <button class="action-primary" type="button" @onclick="ViewModel.AvancarEtapa" disabled="@ViewModel.IsProcessing">
                            Próxima Etapa →
                        </button>
                    }
                    else
                    {
                        <button class="action-primary" type="submit" disabled="@ViewModel.IsProcessing">
                            @(ViewModel.IsProcessing ? "Criando ficha..." : "✓ Finalizar e Criar Ficha")
                        </button>
                    }
                </footer>

                @if (!string.IsNullOrWhiteSpace(ViewModel.ErroEtapa))
                {
                    <p class="wizard-error" role="alert">@ViewModel.ErroEtapa</p>
                }

                @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
                {
                    <p class="form-status @(ViewModel.Sucesso ? "success" : "error")" role="status" aria-live="polite">
                        @ViewModel.MensagemFeedback
                    </p>
                }
            </section>
        </form>
    </main>
</div>

@if (ViewModel.ExibirAvisoSaida)
{
    <div class="confirm-overlay" role="presentation" @onclick="ViewModel.FecharAvisoSaida">
        <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="titulo-aviso-personagem" aria-describedby="mensagem-aviso-personagem" @onclick:stopPropagation="true">
            <h2 id="titulo-aviso-personagem">Sair sem salvar?</h2>
            <p id="mensagem-aviso-personagem">Você tem certeza que quer sair? Vai perder tudo o que preencheu nesta criação.</p>
            <div class="confirm-actions">
                <button class="confirm-exit" type="button" @onclick="ViewModel.SairDaCriacao">Sim</button>
                <button class="confirm-cancel" type="button" @onclick="ViewModel.FecharAvisoSaida">Não</button>
            </div>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "campanhaId")]
    public int? CampanhaId { get; set; }

    private bool TemFotoPersonagem =>
        !string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.Imagem) &&
        !string.Equals(ViewModel.PersonagemAtual.Imagem.Trim(), "img/armaduraprata.png", StringComparison.OrdinalIgnoreCase);

    private string IniciaisPersonagem
    {
        get
        {
            var nome = ViewModel.PersonagemAtual.Nome?.Trim();
            if (string.IsNullOrWhiteSpace(nome))
                return "NP";

            var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (partes.Length >= 2)
            {
                var primeira = StringInfo.GetNextTextElement(partes[0]).ToUpperInvariant();
                var segunda = StringInfo.GetNextTextElement(partes[1]).ToUpperInvariant();
                return $"{primeira}{segunda}";
            }

            var letra = StringInfo.GetNextTextElement(partes[0]).ToUpperInvariant();
            return letra;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.LimparFormulario();
        ViewModel.IdCampanhaOpcional = CampanhaId;
        ViewModel.OnChange -= StateHasChanged;
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.CarregarMagiasCatalogoAsync();
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}