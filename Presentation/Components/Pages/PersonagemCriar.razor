@page "/personagem-criar"
@using Microsoft.AspNetCore.Components.Forms
@using RPGdeMesa.Presentation.Components.Layout
@inject PersonagemCriarViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable

<NavigationLock OnBeforeInternalNavigation="ConfirmarNavegacao" />

<div class="app-shell criacao-personagem">
    <main class="app-content">
        <button class="text-link exit-prompt-link" type="button" @onclick="AbrirAvisoSaida">
            ← Voltar aos personagens
        </button>

        <header class="top-bar">
            <div class="top-bar-copy">
                <p class="page-kicker">Compêndio de Heróis</p>
                <h1 class="page-title">Criar personagem completo</h1>
                <p class="page-description">Preencha as etapas e monte a ficha do seu herói.</p>
            </div>
        </header>

        <aside class="form-aside" aria-label="Prévia do personagem">
            <div class="aside-portrait">
                <img id="preview-img"
                     src="@(string.IsNullOrEmpty(ViewModel.PersonagemAtual.Imagem) ? "img/armaduraprata.png" : ViewModel.PersonagemAtual.Imagem)"
                     alt="Prévia do retrato do personagem" />
            </div>
            <div class="aside-info">
                <div class="preview-actions">
                    <label class="btn-upload">
                        ↑ Escolher foto do herói
                        <InputFile OnChange="CarregarFotoAsync" accept="image/*" aria-label="Escolher foto do personagem" />
                    </label>
                    <p class="upload-help">Imagem de até 2 MB.</p>
                    @if (!string.IsNullOrWhiteSpace(ErroImagem))
                    {
                        <p class="field-error" role="alert">@ErroImagem</p>
                    }
                </div>
                <div class="aside-summary">
                    <strong>@(string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.Nome) ? $"Novo {ViewModel.TipoSelecionado}" : ViewModel.PersonagemAtual.Nome)</strong>
                    <span>@(ViewModel.PersonagemAtual.RacaTexto ?? "Raça") • @(ViewModel.PersonagemAtual.ClasseTexto ?? "Classe") • Nível @ViewModel.PersonagemAtual.Nivel</span>
                    <hr />
                    <small>Os dados salvos serão os campos compatíveis com a ficha atual do projeto.</small>
                </div>
            </div>
        </aside>

        <section class="wizard-progress" aria-label="Progresso da criação">
            <div class="progress-info">
                <div class="progress-current">
                    <span>Progresso da criação</span>
                    <strong>Etapa @EtapaAtual de @TotalEtapas</strong>
                </div>
                <p aria-live="polite">@(EtapaAtual == TotalEtapas ? "Última etapa — revise a ficha" : $"{TotalEtapas - EtapaAtual} etapas restantes")</p>
            </div>
            <div class="progress-track" role="progressbar" aria-valuemin="1" aria-valuemax="@TotalEtapas" aria-valuenow="@EtapaAtual" aria-label="Progresso da criação da ficha">
                <div class="progress-fill" style="width: @((EtapaAtual * 100) / TotalEtapas)%"></div>
            </div>

            <nav class="wizard-steps" aria-label="Etapas da criação">
                @for (var indice = 0; indice < Etapas.Length; indice++)
                {
                    var etapa = indice + 1;
                    <button type="button" class="step-pill @(EtapaAtual == etapa ? "active" : EtapaAtual > etapa ? "completed" : "")"
                            disabled="@(etapa > EtapaAtual)"
                            title="@(etapa > EtapaAtual ? "Conclua as etapas anteriores para liberar esta." : "Revisar etapa")"
                            aria-current="@(EtapaAtual == etapa ? "step" : null)"
                            @onclick="() => IrParaEtapa(etapa)">
                        <span class="step-number">@(EtapaAtual > etapa ? "✓" : etapa.ToString())</span>
                        <span class="step-label"><small>Etapa @etapa</small><strong>@Etapas[indice]</strong></span>
                    </button>
                    @if (indice < Etapas.Length - 1)
                    {
                        <span class="step-connector" aria-hidden="true">→</span>
                    }
                }
            </nav>
        </section>

        @* A prévia e o assistente seguem a estrutura do HTML de referência. *@

        <form id="form-wizard" class="wizard-layout" @onsubmit="ViewModel.SalvarPersonagemAsync" @onsubmit:preventDefault="true">
            <section class="ficha-pergaminho">
                @if (EtapaAtual == 1)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">1. Identidade, raça, classe e biografia física</h2>

                        <div class="form-grid-2">
                            <label class="campo-ficha full-width">
                                <span>Nome do personagem</span>
                                <input @bind="ViewModel.PersonagemAtual.Nome"
                                       maxlength="60"
                                       placeholder="Ex.: Lyra Ventobrasa"
                                       autocomplete="off"
                                       required />
                            </label>

                           <!-- <label class="campo-ficha">
                                <span>Tipo da ficha</span>
                                <select @bind="ViewModel.TipoSelecionado">
                                    <option value="Personagem">Personagem</option>
                                    <option value="NPC">NPC</option>
                                </select> -->

                            <label class="campo-ficha">
                                <span>Raça</span>
                                <select @bind="ViewModel.PersonagemAtual.RacaTexto" required>
                                    <option value="">Escolha uma raça</option>
                                    <option value="Humano">Humano</option>
                                    <option value="Elfo">Elfo</option>
                                    <option value="Anão">Anão</option>
                                    <option value="Halfling">Halfling</option>
                                    <option value="Meio-elfo">Meio-elfo</option>
                                    <option value="Tiefling">Tiefling</option>
                                    <option value="Orc">Orc</option>
                                    <option value="Outra">Outra</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Classe</span>
                                <select @bind="ViewModel.PersonagemAtual.ClasseTexto" required>
                                    <option value="">Escolha uma classe</option>
                                    <option value="Bárbaro">Bárbaro</option>
                                    <option value="Bardo">Bardo</option>
                                    <option value="Clérigo">Clérigo</option>
                                    <option value="Druida">Druida</option>
                                    <option value="Guerreiro">Guerreiro</option>
                                    <option value="Ladino">Ladino</option>
                                    <option value="Mago">Mago</option>
                                    <option value="Paladino">Paladino</option>
                                    <option value="Patrulheiro">Patrulheiro</option>
                                    <option value="Bruxo">Bruxo</option>
                                    <option value="Outra">Outra</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Tendência</span>
                                <select @bind="ViewModel.PersonagemAtual.Tendencia">
                                    <option value="Neutra">Neutra</option>
                                    <option value="Leal e boa">Leal e boa</option>
                                    <option value="Neutra e boa">Neutra e boa</option>
                                    <option value="Caótica e boa">Caótica e boa</option>
                                    <option value="Leal e neutra">Leal e neutra</option>
                                    <option value="Caótica e neutra">Caótica e neutra</option>
                                    <option value="Leal e má">Leal e má</option>
                                    <option value="Neutra e má">Neutra e má</option>
                                    <option value="Caótica e má">Caótica e má</option>
                                </select>
                            </label>

                            <label class="campo-ficha">
                                <span>Nível inicial</span>
                                <input @bind="ViewModel.PersonagemAtual.Nivel" type="number" min="1" max="20" required />
                            </label>

                            <label class="campo-ficha">
                                <span>Experiência (XP)</span>
                                <input @bind="ViewModel.PersonagemAtual.ExperienciaXp" type="number" min="0" />
                            </label>

                            <label class="campo-ficha">
                                <span>Antecedente</span>
                                <input @bind="ViewModel.PersonagemAtual.AntecedenteTexto" maxlength="50" placeholder="Ex.: Batedora" />
                            </label>

                            <div class="form-divider">Características físicas</div>
                            <div class="form-grid-4 full-width">
                                <label class="campo-ficha"><span>Idade</span><input @bind="ViewModel.PersonagemAtual.Idade" placeholder="Ex.: 128 anos" /></label>
                                <label class="campo-ficha"><span>Gênero</span><input @bind="ViewModel.PersonagemAtual.Genero" placeholder="Ex.: Feminino" /></label>
                                <label class="campo-ficha"><span>Altura</span><input @bind="ViewModel.PersonagemAtual.Altura" placeholder="Ex.: 1,72 m" /></label>
                                <label class="campo-ficha"><span>Peso</span><input @bind="ViewModel.PersonagemAtual.Peso" placeholder="Ex.: 64 kg" /></label>
                            </div>
                        </div>
                    </div>
                }
                else if (EtapaAtual == 2)
                {
                    <div class="step-panel active step-panel-attributes">
                        <h2 class="section-title">2. Atributos e pontos de vida</h2>
                        <p class="step-intro">Defina as capacidades do personagem. Os modificadores são calculados automaticamente.</p>
                        <section class="atributos-area" aria-labelledby="titulo-atributos-criacao">
                            <div class="stage-heading">
                                <span class="stage-index">01</span>
                                <div><h3 id="titulo-atributos-criacao">Atributos principais</h3><p>Informe os valores de cada atributo.</p></div>
                            </div>
                            <div class="atributos-cards">
                                <label class="atributo-box"><span>Força</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Forca" /><small>@ObterModificador(ViewModel.PersonagemAtual.Forca)</small></label>
                                <label class="atributo-box"><span>Destreza</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Destreza" /><small>@ObterModificador(ViewModel.PersonagemAtual.Destreza)</small></label>
                                <label class="atributo-box"><span>Constituição</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Constituicao" /><small>@ObterModificador(ViewModel.PersonagemAtual.Constituicao)</small></label>
                                <label class="atributo-box"><span>Inteligência</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Inteligencia" /><small>@ObterModificador(ViewModel.PersonagemAtual.Inteligencia)</small></label>
                                <label class="atributo-box"><span>Sabedoria</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Sabedoria" /><small>@ObterModificador(ViewModel.PersonagemAtual.Sabedoria)</small></label>
                                <label class="atributo-box"><span>Carisma</span><input type="number" min="1" max="30" @bind="ViewModel.PersonagemAtual.Carisma" /><small>@ObterModificador(ViewModel.PersonagemAtual.Carisma)</small></label>
                            </div>
                        </section>

                        <!--<section class="pv-banner" aria-label="Pontos de vida">
                            <div class="pv-intro"><span class="pv-symbol">♥</span><div><strong>Pontos de vida</strong><small>Vida inicial do personagem</small></div></div>
                            <div class="pv-fields">
                                <label>PV atuais<input type="number" min="0" @bind="ViewModel.PersonagemAtual.PvAtual" /></label>
                                <label>PV máximos<input type="number" min="1" @bind="ViewModel.PersonagemAtual.PvMaximo" /></label>
                            </div>
                        </section>-->
                        <!--por os campos de perica aqui em baixo-->
                        <p class="integration-notice" role="note">Salvaguardas e perícias ainda não têm campos no modelo persistido do personagem.</p>
                    </div>
                }
                else if (EtapaAtual == 3)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">3. Identidade física e história</h2>
                        <p class="section-description">Complete os detalhes pessoais e narrativos usando o componente da aba Personagem.</p>
                        <FichaDetalhes Personagem="@ViewModel.PersonagemAtual" />
                    </div>
                }
                else if (EtapaAtual == 4)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">4. Armas e inventário</h2>
                        <p class="section-description">Cadastre equipamentos, itens e moedas no mesmo componente utilizado pela aba Inventário.</p>
                        <FichaInventario Personagem="@ViewModel.PersonagemAtual" />
                    </div>
                }
                else if (EtapaAtual == 5)
                {
                    <div class="step-panel active">
                        <h2 class="section-title">5. Grimório e magias</h2>
                        <p class="section-description">Confira os dados antes de criar a ficha.</p>

                        <div class="integration-notice" role="note">
                            <strong>Grimório</strong>
                            <p>O cadastro de magias ainda não está ligado ao modelo do banco. Os campos de identidade, atributos e história preenchidos nas etapas anteriores seguem o fluxo de salvamento atual.</p>
                        </div>

                        <div class="review-card">
                            <h3>Resumo do personagem</h3>
                            <dl class="review-list">
                                <div><dt>Nome</dt><dd>@(string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.Nome) ? "Não informado" : ViewModel.PersonagemAtual.Nome)</dd></div>
                                <div><dt>Tipo</dt><dd>@ViewModel.TipoSelecionado</dd></div>
                                <div><dt>Raça</dt><dd>@(ViewModel.PersonagemAtual.RacaTexto ?? "Não informada")</dd></div>
                                <div><dt>Classe</dt><dd>@(ViewModel.PersonagemAtual.ClasseTexto ?? "Não informada")</dd></div>
                                <div><dt>Nível</dt><dd>@ViewModel.PersonagemAtual.Nivel</dd></div>
                                <div><dt>Experiência</dt><dd>@ViewModel.PersonagemAtual.ExperienciaXp.ToString("N0") XP</dd></div>
                                <div><dt>Antecedente</dt><dd>@(ViewModel.PersonagemAtual.AntecedenteTexto ?? "Não informado")</dd></div>
                            </dl>
                        </div>
                    </div>
                }

                <footer class="wizard-footer">
                    <button class="action-secondary"
                            type="button"
                            @onclick="VoltarEtapa"
                            disabled="@(EtapaAtual == 1 || ViewModel.IsProcessing)">
                        ← Etapa anterior
                    </button>

                    @if (EtapaAtual < TotalEtapas)
                    {
                        <button class="action-primary" type="button" @onclick="AvancarEtapa" disabled="@ViewModel.IsProcessing">
                            Próxima etapa →
                        </button>
                    }
                    else
                    {
                        <button class="action-primary" type="submit" disabled="@ViewModel.IsProcessing">
                            @(ViewModel.IsProcessing ? "Criando ficha..." : $"Criar {ViewModel.TipoSelecionado}") <span aria-hidden="true">✓</span>
                        </button>
                    }
                </footer>

                @if (!string.IsNullOrWhiteSpace(ErroEtapa))
                {
                    <p class="wizard-error" role="alert">@ErroEtapa</p>
                }

                @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
                {
                    <p class="form-status @(ViewModel.Sucesso ? "success" : "error")" role="status" aria-live="polite">
                        @ViewModel.MensagemFeedback
                    </p>
                }
            </section>
        </form>
    </main>
</div>

@if (ExibirAvisoSaida)
{
    <div class="confirm-overlay" role="presentation" @onclick="FecharAvisoSaida">
        <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="titulo-aviso-personagem" aria-describedby="mensagem-aviso-personagem" @onclick:stopPropagation="true">
            <h2 id="titulo-aviso-personagem">Sair sem salvar?</h2>
            <p id="mensagem-aviso-personagem">Você tem certeza que quer sair? Vai perder tudo o que preencheu nesta criação.</p>
            <div class="confirm-actions">
                <button class="confirm-exit" type="button" @onclick="SairDaCriacao">Sim</button>
                <button class="confirm-cancel" type="button" @onclick="FecharAvisoSaida">Não</button>
            </div>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "campanhaId")]
    public int? CampanhaId { get; set; }

    [SupplyParameterFromQuery(Name = "tipo")]
    public string? TipoInicial { get; set; }

    private const int TotalEtapas = 5;
    private const long LimiteImagemBytes = 2 * 1024 * 1024;
    private readonly string[] Etapas =
    {
        "Identidade & Físico",
        "Atributos & Perícias",
        "História & Diário",
        "Armas & Inventário",
        "Grimório & Magias"
    };

    private int EtapaAtual { get; set; } = 1;
    private string? ErroEtapa { get; set; }
    private string? ErroImagem { get; set; }
    private bool ExibirAvisoSaida { get; set; }
    private bool LiberarProximaNavegacao { get; set; }
    private string? DestinoPendente { get; set; }

    protected override void OnInitialized()
    {
        ViewModel.LimparFormulario();
        ViewModel.IdCampanhaOpcional = CampanhaId;

        if (!string.IsNullOrWhiteSpace(TipoInicial) &&
            (TipoInicial.Equals("NPC", StringComparison.OrdinalIgnoreCase) || TipoInicial.Equals("Personagem", StringComparison.OrdinalIgnoreCase)))
        {
            ViewModel.TipoSelecionado = TipoInicial.Equals("NPC", StringComparison.OrdinalIgnoreCase) ? "NPC" : "Personagem";
        }

        ViewModel.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }

    // Só permite avançar depois de preencher os campos obrigatórios da primeira etapa.
    private void AvancarEtapa()
    {
        ErroEtapa = null;

        if (EtapaAtual == 1)
        {
            if (string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.Nome))
            {
                ErroEtapa = "Informe o nome do personagem para continuar.";
                return;
            }

            if (string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.RacaTexto))
            {
                ErroEtapa = "Selecione a raça do personagem para continuar.";
                return;
            }

            if (string.IsNullOrWhiteSpace(ViewModel.PersonagemAtual.ClasseTexto))
            {
                ErroEtapa = "Selecione a classe do personagem para continuar.";
                return;
            }

            if (ViewModel.PersonagemAtual.Nivel < 1 || ViewModel.PersonagemAtual.Nivel > 20)
            {
                ErroEtapa = "O nível deve estar entre 1 e 20.";
                return;
            }
        }

        if (EtapaAtual < TotalEtapas)
        {
            EtapaAtual++;
        }
    }

    private void VoltarEtapa()
    {
        ErroEtapa = null;

        if (EtapaAtual > 1)
        {
            EtapaAtual--;
        }
    }

    private void IrParaEtapa(int etapa)
    {
        if (etapa >= 1 && etapa <= EtapaAtual)
        {
            ErroEtapa = null;
            EtapaAtual = etapa;
        }
    }

    private static string ObterModificador(int valor)
    {
        var modificador = (int)Math.Floor((valor - 10) / 2.0);
        return modificador >= 0 ? $"+{modificador}" : modificador.ToString();
    }

    // Lê a imagem e a converte para uma string que pode ser guardada na propriedade Imagem.
    private async Task CarregarFotoAsync(InputFileChangeEventArgs evento)
    {
        ErroImagem = null;
        var arquivo = evento.File;

        if (arquivo.Size > LimiteImagemBytes)
        {
            ErroImagem = "A imagem deve ter no máximo 2 MB.";
            return;
        }

        if (string.IsNullOrWhiteSpace(arquivo.ContentType) || !arquivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            ErroImagem = "Selecione um arquivo de imagem válido.";
            return;
        }

        try
        {
            await using var origem = arquivo.OpenReadStream(LimiteImagemBytes);
            using var memoria = new MemoryStream();
            await origem.CopyToAsync(memoria);

            ViewModel.PersonagemAtual.Imagem = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
        }
        catch (Exception)
        {
            ErroImagem = "Não foi possível carregar essa imagem. Tente outro arquivo.";
        }
    }

    private void AbrirAvisoSaida() => ExibirAvisoSaida = true;

    private void ConfirmarNavegacao(LocationChangingContext contexto)
    {
        if (LiberarProximaNavegacao)
        {
            LiberarProximaNavegacao = false;
            return;
        }

        contexto.PreventNavigation();
        DestinoPendente = contexto.TargetLocation;
        ExibirAvisoSaida = true;
    }

    private void FecharAvisoSaida()
    {
        ExibirAvisoSaida = false;
        DestinoPendente = null;
    }

    private void SairDaCriacao()
    {
        LiberarProximaNavegacao = true;
        Navigation.NavigateTo(DestinoPendente ?? "/personagem-lib");
    }
}
