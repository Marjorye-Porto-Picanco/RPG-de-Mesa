@page "/criar-campanha"
@implements IDisposable
@using RPGdeMesa.Presentation.Components.Layout
@inject CampanhaService CampanhaService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject SessaoUsuarioService SessaoUsuario

<NavMenu />

<main class="campanha-create-page">
    <div class="app-content">
        <header class="top-bar">
            <a class="voltar-link" href="/campanhas">
                <span aria-hidden="true">←</span> Voltar às campanhas
            </a>
            <p class="page-kicker">Abra os portões da aventura</p>
            <h1 class="page-title">Nova campanha</h1>
            <p class="page-description">Prepare o cenário, vincule seus recursos e reúna seu grupo.</p>
        </header>

        <div class="form-layout">
            <!-- ===== Formulário principal (Pergaminho) ===== -->
            <section class="ficha-pergaminho" aria-labelledby="titulo-detalhes">
                <div class="ficha-conteudo">
                    <div class="form-grid-2">
                        <label class="campo-ficha full-width">
                            <span>Nome da campanha*</span>
                            <input id="nome"
                                   type="text"
                                   @bind="viewModel.Nome"
                                   @bind:event="oninput"
                                   maxlength="100"
                                   autocomplete="off"
                                   placeholder="Ex.: As Crônicas de Eldoria" />
                        </label>

                        <div class="form-divider">Vincular recursos da biblioteca</div>

                        <!-- PESQUISA DE MONSTROS -->
                        <div class="campo-ficha campo-busca">
                            <span>Monstros</span>
                            <div class="busca-wrapper">
                                <input type="search"
                                       placeholder="Digite para buscar monstro..."
                                       autocomplete="off"
                                       @bind="viewModel.BuscaMonstro"
                                       @bind:event="oninput"
                                       @onfocus="() => _focoMonstro = true"
                                       @onblur="() => _focoMonstro = false" />

                                @if (_focoMonstro || !string.IsNullOrWhiteSpace(viewModel.BuscaMonstro))
                                {
                                    var resultados = viewModel.MonstrosFiltrados.ToList();
                                    <div class="busca-resultados" role="listbox" aria-label="Sugestões de monstros">
                                        @if (resultados.Any())
                                        {
                                            @foreach (var m in resultados)
                                            {
                                                <button type="button"
                                                        class="busca-opcao"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => { viewModel.AdicionarMonstroDaBiblioteca(m); _focoMonstro = false; }">
                                                    <strong>@m.Nome</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(m.Tipo) ? "Criatura" : m.Tipo)</small>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="busca-vazio">Nenhum monstro encontrado</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- PESQUISA DE NPCS -->
                        <div class="campo-ficha campo-busca">
                            <span>NPCs</span>
                            <div class="busca-wrapper">
                                <input type="search"
                                       placeholder="Digite para buscar NPC..."
                                       autocomplete="off"
                                       @bind="viewModel.BuscaNPC"
                                       @bind:event="oninput"
                                       @onfocus="() => _focoNpc = true"
                                       @onblur="() => _focoNpc = false" />

                                @if (_focoNpc || !string.IsNullOrWhiteSpace(viewModel.BuscaNPC))
                                {
                                    var resultados = viewModel.NPCsFiltrados.ToList();
                                    <div class="busca-resultados" role="listbox" aria-label="Sugestões de NPCs">
                                        @if (resultados.Any())
                                        {
                                            @foreach (var n in resultados)
                                            {
                                                <button type="button"
                                                        class="busca-opcao"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => { viewModel.AdicionarNPCDaBiblioteca(n); _focoNpc = false; }">
                                                    <strong>@n.Nome</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(n.ClasseTexto) ? "NPC" : n.ClasseTexto)</small>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="busca-vazio">Nenhum NPC encontrado</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- PESQUISA DE ITENS -->
                        <div class="campo-ficha campo-busca">
                            <span>Itens</span>
                            <div class="busca-wrapper">
                                <input type="search"
                                       placeholder="Digite para buscar item..."
                                       autocomplete="off"
                                       @bind="viewModel.BuscaItem"
                                       @bind:event="oninput"
                                       @onfocus="() => _focoItem = true"
                                       @onblur="() => _focoItem = false" />

                                @if (_focoItem || !string.IsNullOrWhiteSpace(viewModel.BuscaItem))
                                {
                                    var resultados = viewModel.ItensFiltrados.ToList();
                                    <div class="busca-resultados" role="listbox" aria-label="Sugestões de itens">
                                        @if (resultados.Any())
                                        {
                                            @foreach (var i in resultados)
                                            {
                                                <button type="button"
                                                        class="busca-opcao"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => { viewModel.AdicionarItemDaBiblioteca(i); _focoItem = false; }">
                                                    <strong>@i.Nome</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(i.Tipo) ? "Item" : i.Tipo)</small>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="busca-vazio">Nenhum item encontrado</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- MAPAS DA CAMPANHA -->
                        <div class="campo-ficha">
                            <span>Mapas da campanha</span>
                            <InputFile id="mapa" class="entrada-arquivo" OnChange="viewModel.AdicionarMapasAsync" multiple accept="image/*" />

                            @if (viewModel.ListaMapas.Any())
                            {
                                <div class="lista-mapas">
                                    @foreach (var mapa in viewModel.ListaMapas)
                                    {
                                        <div class="mapa-item">
                                            <span>@mapa.NomeRegiao</span>
                                            <button type="button" class="btn-remover-item" aria-label="Remover mapa @mapa.NomeRegiao" @onclick="() => viewModel.RemoverMapa(mapa)">×</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="form-divider">Capa e anotações</div>

                        <div class="campo-ficha full-width">
                            <span>Capa da campanha</span>
                            <InputFile id="capa" class="entrada-arquivo" OnChange="viewModel.SelecionarCapaAsync" accept="image/*" />

                            @if (!string.IsNullOrEmpty(viewModel.CapaBase64))
                            {
                                <div class="preview-capa">
                                    <img src="@viewModel.CapaBase64" alt="Pré-visualização da capa" />
                                    <div class="mapa-item">
                                        <span>@viewModel.NomeArquivoCapa</span>
                                        <button type="button" class="btn-remover-item" aria-label="Remover capa" @onclick="viewModel.RemoverCapa">×</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="painel-historia">
                            <label for="notas">Notas da campanha</label>
                            <textarea id="notas" @bind="viewModel.Notas" rows="4" placeholder="Anote os primeiros detalhes da aventura..."></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(viewModel.MensagemFeedback))
                    {
                        <p class="feedback @(viewModel.Sucesso ? "ok" : "erro")" role="status" aria-live="polite">@viewModel.MensagemFeedback</p>
                    }

                    <footer class="form-footer">
                        <a class="action-secondary" href="/campanhas">Cancelar</a>
                        <button class="action-primary" type="button" @onclick="viewModel.SalvarCampanhaAsync" disabled="@viewModel.IsProcessing">
                            @(viewModel.IsProcessing ? "Criando..." : "Criar campanha →")
                        </button>
                    </footer>
                </div>
            </section>

            <!-- ===== Coluna lateral ===== -->
            <aside class="form-aside">
                <section class="aside-card" aria-labelledby="titulo-convite">
                    <p class="aside-kicker">Convide seu grupo</p>
                    <h2 id="titulo-convite">Código de convite</h2>

                    <div class="codigo-convite">
                        <strong>@viewModel.CodigoConvite</strong>
                        <button type="button" class="btn-copiar" aria-label="Copiar código" @onclick="viewModel.CopiarCodigoAsync">Copiar</button>
                    </div>

                    <p class="texto-apoio">Compartilhe este código com seus jogadores.</p>
                </section>

                <!-- RECURSOS VINCULADOS (NO LUGAR DE JOGADORES) -->
                <section class="aside-card" aria-labelledby="titulo-vinculados">
                    <div class="aside-heading-linha">
                        <div>
                            <p class="aside-kicker">Biblioteca da mesa</p>
                            <h2 id="titulo-vinculados">Recursos vinculados</h2>
                        </div>
                        <span class="contador-badge">@viewModel.TotalRecursosVinculados</span>
                    </div>

                    <div class="vinculados-grupo">
                        <h3>Monstros (@viewModel.ListaMonstros.Count)</h3>
                        @if (viewModel.ListaMonstros.Any())
                        {
                            <div class="vinculados-lista">
                                @foreach (var m in viewModel.ListaMonstros)
                                {
                                    <span class="vinculado-chip">
                                        @m.Nome
                                        <button type="button" class="btn-remover-chip" aria-label="Remover @m.Nome" @onclick="() => viewModel.RemoverMonstro(m)">×</button>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="vinculados-vazio">Nenhum monstro vinculado.</p>
                        }
                    </div>

                    <div class="vinculados-grupo">
                        <h3>NPCs (@viewModel.ListaNPCs.Count)</h3>
                        @if (viewModel.ListaNPCs.Any())
                        {
                            <div class="vinculados-lista">
                                @foreach (var n in viewModel.ListaNPCs)
                                {
                                    <span class="vinculado-chip">
                                        @n.Nome
                                        <button type="button" class="btn-remover-chip" aria-label="Remover @n.Nome" @onclick="() => viewModel.RemoverNPC(n)">×</button>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="vinculados-vazio">Nenhum NPC vinculado.</p>
                        }
                    </div>

                    <div class="vinculados-grupo">
                        <h3>Itens (@viewModel.ListaItensCampanha.Count)</h3>
                        @if (viewModel.ListaItensCampanha.Any())
                        {
                            <div class="vinculados-lista">
                                @foreach (var i in viewModel.ListaItensCampanha)
                                {
                                    <span class="vinculado-chip">
                                        @i.Nome
                                        <button type="button" class="btn-remover-chip" aria-label="Remover @i.Nome" @onclick="() => viewModel.RemoverItem(i)">×</button>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="vinculados-vazio">Nenhum item vinculado.</p>
                        }
                    </div>
                </section>

                <p class="nota-editor"><span aria-hidden="true">✦</span> Você poderá editar os detalhes da campanha depois.</p>
            </aside>
        </div>
    </div>
</main>

@code {
    private CriarCampanhaViewModel viewModel = default!;
    private bool _focoMonstro;
    private bool _focoNpc;
    private bool _focoItem;

    protected override async Task OnInitializedAsync()
    {
        viewModel = new CriarCampanhaViewModel(CampanhaService, Navigation, JSRuntime, SessaoUsuario);
        viewModel.OnChange += StateHasChanged;
        await viewModel.CarregarBibliotecasAsync();
    }

    public void Dispose()
    {
        if (viewModel != null)
            viewModel.OnChange -= StateHasChanged;
    }
}