@page "/"
@page "/login"
@layout Layout.EmptyLayout
@inject UsuarioService UsuarioService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject SessaoUsuarioService SessaoUsuario
@implements IDisposable

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<section class="login">
    <div class="formes auth-card">
        <div class="auth-emblem" aria-hidden="true"><i class="bi bi-dice-5"></i></div>
        <p class="auth-eyebrow">A sua mesa de aventuras</p>
        <h1>Salão da Mesa</h1>
        <p class="subtitulo-login">Sua campanha, seus dados, seu tabuleiro — conectados.</p>

        <label class="campos" for="email">
            <span>Email ou usuário</span>
            <input type="text" id="email" @bind="viewModel.LoginOuEmail" @bind:event="oninput" @onkeydown="AoPressionarTecla" autocomplete="username" />
        </label>

        <label class="campos" for="senha">
            <span>Senha</span>
            <input type="password" id="senha" @bind="viewModel.Senha" @bind:event="oninput" @onkeydown="AoPressionarTecla" autocomplete="current-password" />
        </label>

        @if (!string.IsNullOrEmpty(viewModel.MensagemFeedback))
        {
            <p style="color: @(viewModel.Sucesso ? "#28a745" : "#dc3545"); text-align: center; margin: 8px 0; font-weight: bold;">
                @viewModel.MensagemFeedback
            </p>
        }

        <button class="auth-submit" type="button" @onclick="viewModel.EntrarAsync" disabled="@viewModel.IsProcessing">
            @(viewModel.IsProcessing ? "Entrando..." : "Entrar")
        </button>

        <!--<div class="icons">
            <a href="#" @onclick="viewModel.LoginComGoogleAsync" @onclick:preventDefault aria-label="Entrar com Google"><i class="bi bi-google"></i></a>
            <a href="#" @onclick="viewModel.LoginComFacebookAsync" @onclick:preventDefault aria-label="Entrar com Facebook"><i class="bi bi-facebook"></i></a>
        </div>-->

        <label class="termo">
            <span>Não possui conta? <a class="auth-create-link" href="/cadastro">Criar conta</a></span>
        </label>
    </div>
</section>

@code {
    private LoginViewModel viewModel = default!;

    protected override void OnInitialized()
    {
        viewModel = new LoginViewModel(UsuarioService, AuthService, Navigation, SessaoUsuario);
        viewModel.OnChange += StateHasChanged;
    }

    private async Task AoPressionarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
            await viewModel.EntrarAsync();
    }

    public void Dispose()
    {
        viewModel.OnChange -= StateHasChanged;
    }
}