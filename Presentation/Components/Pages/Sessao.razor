@page "/sessao/{IdCampanha:int}"
@page "/sessao/{IdCampanha:int}/{IdPersonagem:int}"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using RPGdeMesa.Application.Services
@using RPGdeMesa.Domain.Itens
@using RPGdeMesa.Domain.Personagens
@using RPGdeMesa.Domain.Sessoes
@using RPGdeMesa.Domain.ValueObjects
@using RPGdeMesa.Presentation.ViewModel
@inject SessaoViewModel ViewModel
@implements IAsyncDisposable

@if (ViewModel.Carregando)
{
    <div class="sala-jogo sala-estado">
        <p>Preparando a mesa da sessão...</p>
    </div>
}
else if (ViewModel.SessaoEncerradaPeloMestre)
{
    <div class="sala-jogo sala-estado">
        <h2>Sessão finalizada pelo Mestre</h2>
        <p>O Mestre encerrou a mesa e está revisando as fichas e distribuindo o XP da aventura. Volte para a tela da campanha para conferir sua ficha atualizada.</p>
        <div class="estado-acoes">
            <button type="button" class="game-finish" @onclick="ViewModel.VoltarParaPreparacaoCampanha">
                Ver minha ficha na campanha
            </button>
            <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
                Voltar para campanhas
            </button>
        </div>
    </div>
}
else if (ViewModel.ModoRevisaoPosSessao)
{
    <div class="sala-jogo revisao-shell">
        <header class="game-header">
            <div class="game-heading">
                <p>Revisão Pós-Sessão · Sessão #@ViewModel.Estado.NumeroSessao</p>
                <h1>@ViewModel.Estado.NomeCampanha</h1>
            </div>

            <div class="revisao-header-acoes">
                <div class="xp-lote-box">
                    <label for="xp-lote-input">XP para todos:</label>
                    <input id="xp-lote-input" type="number" min="0" step="50" @bind="ViewModel.XpEmLote" />
                    <button type="button" class="game-exit" @onclick="ViewModel.AplicarXpEmLote">Aplicar</button>
                </div>

                <button type="button"
                        class="game-finish"
                        disabled="@ViewModel.SalvandoRevisao"
                        @onclick="ViewModel.ConcluirRevisaoPosSessaoAsync">
                    @(ViewModel.SalvandoRevisao ? "Salvando e devolvendo..." : "✓ Concluir Revisão e Salvar Histórico")
                </button>
            </div>
        </header>

        <div class="revisao-layout">
            <aside class="revisao-lista" aria-label="Fichas dos jogadores">
                <div class="revisao-lista-titulo">
                    <h2>Fichas dos Jogadores (@ViewModel.FichasRevisao.Count)</h2>
                    <small>Clique em uma ficha para revisar, ajustar ou dar XP</small>
                </div>

                @if (!ViewModel.FichasRevisao.Any())
                {
                    <p class="revisao-vazio">Nenhuma ficha aceita encontrada nesta campanha.</p>
                }
                else
                {
                    @foreach (var item in ViewModel.FichasRevisao)
                    {
                        bool selecionada = ViewModel.FichaRevisaoSelecionada == item;
                        <button type="button"
                                class="revisao-card-btn @(selecionada ? "selecionada" : "")"
                                @onclick="() => ViewModel.SelecionarFichaRevisao(item)">
                            <img src="@(string.IsNullOrWhiteSpace(item.Personagem.Imagem) ? "img/armaduraprata.png" : item.Personagem.Imagem)"
                                 alt="@item.Personagem.Nome" />
                            <div>
                                <strong>@item.Personagem.Nome</strong>
                                <small>@(item.Personagem.Usuario?.UsarName ?? "Jogador") · Nv. @item.Personagem.Nivel</small>
                                <span class="revisao-xp-tag">
                                    XP: @item.Personagem.ExperienciaXp
                                    @if (item.XpGanhoSessao > 0)
                                    {
                                        <b> (+@item.XpGanhoSessao)</b>
                                    }
                                </span>
                            </div>
                        </button>
                    }
                }
            </aside>

            <main class="revisao-editor">
                @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackRevisao))
                {
                    <div class="revisao-aviso">@ViewModel.FeedbackRevisao</div>
                }

                <section class="revisao-painel revisao-resumo-box">
                    <div class="revisao-ficha-topo">
                        <div>
                            <h2>Diário da Sessão #@ViewModel.Estado.NumeroSessao</h2>
                            <p>Este registro ficará salvo na aba <strong>Histórico</strong> da campanha.</p>
                        </div>
                    </div>

                    <div class="revisao-resumo-campos">
                        <label>
                            <span>Título da Sessão</span>
                            <input type="text"
                                   maxlength="150"
                                   placeholder="Ex.: A Emboscada na Estrada Real"
                                   @bind="ViewModel.TituloSessaoRevisao" />
                        </label>
                        <label>
                            <span>Resumo do que aconteceu</span>
                            <textarea rows="4"
                                      placeholder="Anote eventos marcantes, decisões do grupo, NPCs encontrados, ganchos para a próxima sessão..."
                                      @bind="ViewModel.ResumoSessaoRevisao"></textarea>
                        </label>
                    </div>
                </section>

                @if (ViewModel.FichaRevisaoSelecionada != null)
                {
                    var f = ViewModel.FichaRevisaoSelecionada;
                    var p = f.Personagem;

                    <section class="revisao-painel">
                        <div class="revisao-ficha-topo">
                            <div>
                                <h2>@p.Nome</h2>
                                <p>Jogador: <strong>@(p.Usuario?.UsarName ?? "—")</strong> · @(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe")</p>
                            </div>
                            <div class="revisao-xp-destaque">
                                <label>XP ganho nesta sessão</label>
                                <input type="number" min="0" step="10" @bind="f.XpGanhoSessao" />
                                <small>Total após concluir: <strong>@(p.ExperienciaXp + Math.Max(0, f.XpGanhoSessao)) XP</strong></small>
                            </div>
                        </div>

                        <div class="revisao-grid-stats">
                            <label>
                                <span>Nível</span>
                                <input type="number" min="1" max="20" @bind="p.Nivel" />
                            </label>
                            <label>
                                <span>PV Atual</span>
                                <input type="number" min="0" max="9999" @bind="p.PvAtual" />
                            </label>
                            <label>
                                <span>PV Máximo</span>
                                <input type="number" min="1" max="9999" @bind="p.PvMaximo" />
                            </label>
                            <label>
                                <span>XP Atual (Base)</span>
                                <input type="number" min="0" @bind="p.ExperienciaXp" />
                            </label>
                        </div>

                        <h3 class="revisao-subtitulo">Atributos</h3>
                        <div class="revisao-grid-atributos">
                            <label><span>FOR</span><input type="number" min="1" max="30" @bind="p.Forca" /></label>
                            <label><span>DES</span><input type="number" min="1" max="30" @bind="p.Destreza" /></label>
                            <label><span>CON</span><input type="number" min="1" max="30" @bind="p.Constituicao" /></label>
                            <label><span>INT</span><input type="number" min="1" max="30" @bind="p.Inteligencia" /></label>
                            <label><span>SAB</span><input type="number" min="1" max="30" @bind="p.Sabedoria" /></label>
                            <label><span>CAR</span><input type="number" min="1" max="30" @bind="p.Carisma" /></label>
                        </div>

                        <h3 class="revisao-subtitulo">Moedas e Inventário</h3>
                        <div class="revisao-grid-moedas">
                            <label><span>PC</span><input type="number" min="0" @bind="f.MoedasPC" /></label>
                            <label><span>PP</span><input type="number" min="0" @bind="f.MoedasPP" /></label>
                            <label><span>PE</span><input type="number" min="0" @bind="f.MoedasPE" /></label>
                            <label><span>PO</span><input type="number" min="0" @bind="f.MoedasPO" /></label>
                            <label><span>PL</span><input type="number" min="0" @bind="f.MoedasPL" /></label>
                        </div>

                        <div class="revisao-itens-box">
                            <div class="revisao-itens-topo">
                                <span>Itens na Mochila (@f.Itens.Count)</span>
                                <button type="button" class="game-exit" @onclick="() => ViewModel.AdicionarItemRevisao(f)">
                                    + Adicionar item da campanha
                                </button>
                            </div>

                            @if (f.Itens.Any())
                            {
                                @foreach (var slot in f.Itens)
                                {
                                    <div class="revisao-item-linha">
                                        <select @bind="slot.IdItem">
                                            <option value="0">Selecione um item...</option>
                                            @foreach (var itemOpcao in ViewModel.ItensCampanhaRevisao)
                                            {
                                                <option value="@itemOpcao.IdItem">@itemOpcao.Nome (@(itemOpcao.Tipo ?? "Geral"))</option>
                                            }
                                        </select>
                                        <input type="number" min="1" max="999" @bind="slot.Quantidade" />
                                        <button type="button" class="revisao-remover-btn" title="Remover item" @onclick="() => ViewModel.RemoverItemRevisao(f, slot)">×</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="revisao-vazio">Nenhum item no inventário.</p>
                            }
                        </div>

                        <div class="revisao-grid-notas">
                            <label>
                                <span>Notas do Inventário</span>
                                <textarea rows="3" @bind="f.NotasInventario"></textarea>
                            </label>
                            <label>
                                <span>Tesouro Pessoal</span>
                                <textarea rows="3" @bind="p.Tesouro"></textarea>
                            </label>
                            <label>
                                <span>Características e Habilidades</span>
                                <textarea rows="3" @bind="p.Caracteristicas"></textarea>
                            </label>
                            <label>
                                <span>História / Anotações da Campanha</span>
                                <textarea rows="3" @bind="p.Historia"></textarea>
                            </label>
                        </div>
                    </section>
                }
                else
                {
                    <div class="revisao-painel">
                        <p class="revisao-vazio">Nenhuma ficha para revisar. Preencha o resumo acima e clique em "Concluir Revisão e Salvar Histórico".</p>
                    </div>
                }
            </main>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(ViewModel.ErroCarregamento))
{
    <div class="sala-jogo sala-estado">
        <h2>Não foi possível abrir a sessão</h2>
        <p>@ViewModel.ErroCarregamento</p>
        <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
            Voltar para campanhas
        </button>
    </div>
}
else
{
    <div class="sala-jogo @(ViewModel.PinoArrastando != null ? "em-arraste-pino" : "")"
         @onpointerup="ViewModel.FinalizarArrastePino">
        <header class="game-header">
            <button type="button"
                    class="game-home"
                    aria-label="Voltar às campanhas"
                    title="Voltar às campanhas"
                    @onclick="ViewModel.SairDaSessaoENavegarAsync">
                ←
            </button>

            <div class="game-heading">
                <p>@(ViewModel.Estado.EhMestre ? "Mesa do Mestre" : "Sessão em andamento")</p>
                <h1>@ViewModel.Estado.NomeCampanha</h1>
            </div>

            <div class="game-presence">
                <span class="presence-light"></span>
                Mesa aberta
                <span class="presence-divider">·</span>
                @ContarOnline() @(ContarOnline() == 1 ? "conectado" : "conectados")
            </div>

            @if (ViewModel.Estado.EhMestre)
            {
                <button type="button"
                        class="game-finish"
                        disabled="@ViewModel.FinalizandoSessao"
                        @onclick="ViewModel.FinalizarSessaoAsync">
                    @(ViewModel.FinalizandoSessao ? "Finalizando..." : "Finalizar sessão")
                </button>
            }

            <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
                Sair da mesa
            </button>
        </header>

        <div class="game-layout">
            <!-- BARRA LATERAL DE FERRAMENTAS -->
            <aside class="game-toolbar" aria-label="Ferramentas da mesa">
                <button class="toolbar-user @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva != "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Visualizar Ficha"
                        aria-label="Visualizar Ficha"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("atributos")'>
                    <span class="toolbar-avatar">@ObterIniciaisUsuarioLogado()</span>
                </button>

                <button class="toolbar-dice @(ViewModel.ExibirModalDados ? "selecionada" : "")"
                        type="button"
                        title="Rolar dados"
                        aria-label="Abrir dados para rolar"
                        @onclick="ViewModel.AbrirModalDados">
                    <span aria-hidden="true">⚄</span>
                </button>

                <span class="toolbar-separator" aria-hidden="true"></span>

                @if (ViewModel.Estado.EhMestre)
                {
                    <button class="toolbar-tool @(ViewModel.ExibirPainelPinos ? "selecionada" : "")"
                            type="button"
                            title="Administrar Pinos no Mapa (Jogadores, NPCs e Monstros)"
                            aria-label="Administrar pinos no mapa"
                            @onclick="ViewModel.AlternarPainelPinos">
                        <span aria-hidden="true">▦</span>
                    </button>
                }

                <button class="toolbar-tool @(ViewModel.ExibirModalAtaque ? "selecionada" : "")"
                        type="button"
                        disabled="@(!ViewModel.EhMeuTurno)"
                        title="@(ViewModel.Estado.EhMestre ? "Ação exclusiva de jogadores no turno" : (ViewModel.EhMeuTurno ? "Atacar inimigo" : "Aguarde o Mestre liberar seu turno"))"
                        aria-label="Abrir ataque"
                        @onclick="ViewModel.AbrirModalAtaqueAsync">
                    <span aria-hidden="true">⚔</span>
                </button>

                <button class="toolbar-tool @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva != "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Ficha do Personagem"
                        aria-label="Abrir ficha do personagem"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("atributos")'>
                    <span aria-hidden="true">▤</span>
                </button>

                <button class="toolbar-tool @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva == "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Inventário"
                        aria-label="Abrir inventário"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("inventario")'>
                    <span aria-hidden="true">◇</span>
                </button>

                <span class="toolbar-spacer"></span>

                <button class="toolbar-tool @(_mostrarCoordenadas ? "selecionada" : "")"
                        type="button"
                        title="Alternar coordenadas da grade 20×20"
                        aria-label="Alternar coordenadas da grade"
                        aria-pressed="@_mostrarCoordenadas.ToString().ToLowerInvariant()"
                        @onclick="AlternarCoordenadas">
                    <span aria-hidden="true">▧</span>
                </button>
            </aside>

            <!-- ÁREA PRINCIPAL: MAPA + CONSOLE -->
            <main class="game-main">
                <div class="map-toolbar">
                    <div class="map-location">
                        <span class="location-mark" aria-hidden="true">⌖</span>
                        <span>
                            <strong>@(ViewModel.Estado.MapaAtivo?.NomeRegiao ?? "Nenhum mapa selecionado")</strong>
                            <small>
                                Grade 20×20 · 1,5m/quadrado (30m×30m)
                                @if (!string.IsNullOrWhiteSpace(ViewModel.Estado.MapaAtivo?.Escala))
                                {
                                    <text> · @ViewModel.Estado.MapaAtivo.Escala</text>
                                }
                            </small>
                        </span>
                    </div>

                    <div class="map-controls" aria-label="Controles do mapa">
                        @if (ViewModel.Estado.EhMestre)
                        {
                            <select class="map-select-mestre"
                                    aria-label="Selecionar mapa da campanha"
                                    value="@(ViewModel.Estado.IdMapaAtivo?.ToString() ?? "")"
                                    @onchange="ViewModel.SelecionarMapaAsync">
                                <option value="">Sem mapa selecionado</option>
                                @foreach (var mapa in ViewModel.Estado.MapasDisponiveis)
                                {
                                    <option value="@mapa.IdMapa">@mapa.NomeRegiao</option>
                                }
                            </select>
                        }

                        <button type="button" title="Diminuir zoom" aria-label="Diminuir zoom" @onclick="ViewModel.DiminuirZoom">−</button>
                        <span id="nivel-zoom">@($"{Math.Round(ViewModel.NivelZoom * 100)}%")</span>
                        <button type="button" title="Aumentar zoom" aria-label="Aumentar zoom" @onclick="ViewModel.AumentarZoom">+</button>
                        <button type="button" title="Ajustar mapa" aria-label="Ajustar mapa" @onclick="ViewModel.ResetarZoom">⤢</button>
                    </div>
                </div>

                <!-- PALCO DO MAPA COM MALHA 20x20, CABEÇALHO EXTERNO E PINOS -->
                <section class="map-stage" aria-label="Mapa da sessão">
                    @if (ViewModel.Estado.EhMestre && ViewModel.ExibirPainelPinos)
                    {
                        <aside class="pinos-drawer" aria-label="Administração de pinos no mapa">
                            <header class="pinos-drawer-header">
                                <div>
                                    <p class="panel-kicker">Controle do Mestre</p>
                                    <h3>Pinos no Mapa</h3>
                                </div>
                                <button type="button" class="pinos-drawer-close" aria-label="Fechar painel de pinos" @onclick="ViewModel.AlternarPainelPinos">×</button>
                            </header>

                            <label class="pinos-visibilidade-padrao">
                                <input type="checkbox" @bind="ViewModel.NovoPinoVisivel" />
                                <span>Colocar novos pinos visíveis</span>
                            </label>

                            <div class="pinos-tabs" role="tablist">
                                <button type="button" class="pinos-tab @(ViewModel.AbaPinosAtiva == "jogadores" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaPinos("jogadores")'>Jogadores</button>
                                <button type="button" class="pinos-tab @(ViewModel.AbaPinosAtiva == "npcs" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaPinos("npcs")'>NPCs</button>
                                <button type="button" class="pinos-tab @(ViewModel.AbaPinosAtiva == "monstros" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaPinos("monstros")'>Monstros</button>
                            </div>

                            <div class="pinos-lista">
                                @if (ViewModel.AbaPinosAtiva == "jogadores")
                                {
                                    var jogadoresAtivos = ViewModel.Estado.Jogadores.Where(j => j.Online && j.IdPersonagem.HasValue).ToList();
                                    if (!jogadoresAtivos.Any())
                                    {
                                        <p class="pinos-vazio">Nenhum jogador ativo com ficha conectada no momento.</p>
                                    }
                                    else
                                    {
                                        @foreach (var jog in jogadoresAtivos)
                                        {
                                            int idEntidade = jog.IdPersonagem!.Value;
                                            string nome = jog.NomePersonagem ?? jog.Username;
                                            var pinoAtual = ViewModel.ObterPinoNoMapa(TiposPinoSessao.Personagem, idEntidade);
                                            var outroMapa = ViewModel.ObterResumoOutroMapaDoPino(TiposPinoSessao.Personagem, idEntidade);
                                            bool selecionado = ViewModel.PinoParaPosicionar?.TipoEntidade == TiposPinoSessao.Personagem
                                                && ViewModel.PinoParaPosicionar.IdEntidade == idEntidade;

                                            <div class="pino-item-card @(selecionado ? "selecionado" : "")">
                                                <button type="button"
                                                        class="pino-item-main"
                                                        title="@(outroMapa ?? "Clique e depois escolha uma casa no mapa")"
                                                        @onclick="() => ViewModel.SelecionarPinoParaPosicionar(TiposPinoSessao.Personagem, idEntidade, nome)">
                                                    <span class="pino-mini-avatar tipo-personagem">
                                                        @if (!string.IsNullOrWhiteSpace(jog.AvatarUrl))
                                                        {
                                                            <img src="@jog.AvatarUrl" alt="@nome" />
                                                        }
                                                        else
                                                        {
                                                            @ObterIniciais(nome)
                                                        }
                                                    </span>
                                                    <span class="pino-item-info">
                                                        <strong>@nome</strong>
                                                        <small>@(pinoAtual != null ? $"Neste mapa: {pinoAtual.CoordenadaTexto}" : (outroMapa ?? "Clique para posicionar"))</small>
                                                    </span>
                                                </button>

                                                @if (pinoAtual != null)
                                                {
                                                    <div class="pino-item-acoes">
                                                        <button type="button"
                                                                class="pino-btn-acao @(pinoAtual.Visivel ? "visivel" : "oculto")"
                                                                title="@(pinoAtual.Visivel ? "Visível para jogadores (clique para ocultar)" : "Oculto dos jogadores (clique para mostrar)")"
                                                                @onclick="() => ViewModel.AlternarVisibilidadePinoAsync(TiposPinoSessao.Personagem, idEntidade)">
                                                            @(pinoAtual.Visivel ? "👁" : "⊘")
                                                        </button>
                                                        <button type="button"
                                                                class="pino-btn-acao remover"
                                                                title="Remover deste mapa"
                                                                @onclick="() => ViewModel.RemoverPinoDoMapaAsync(TiposPinoSessao.Personagem, idEntidade)">
                                                            ×
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }
                                else if (ViewModel.AbaPinosAtiva == "npcs")
                                {
                                    if (!ViewModel.Estado.NpcsCampanha.Any())
                                    {
                                        <p class="pinos-vazio">Nenhum NPC vinculado a esta campanha.</p>
                                    }
                                    else
                                    {
                                        @foreach (var npc in ViewModel.Estado.NpcsCampanha)
                                        {
                                            var pinoAtual = ViewModel.ObterPinoNoMapa(TiposPinoSessao.Npc, npc.IdNpc);
                                            var outroMapa = ViewModel.ObterResumoOutroMapaDoPino(TiposPinoSessao.Npc, npc.IdNpc);
                                            bool selecionado = ViewModel.PinoParaPosicionar?.TipoEntidade == TiposPinoSessao.Npc
                                                && ViewModel.PinoParaPosicionar.IdEntidade == npc.IdNpc;

                                            <div class="pino-item-card @(selecionado ? "selecionado" : "")">
                                                <button type="button"
                                                        class="pino-item-main"
                                                        title="@(outroMapa ?? "Clique e depois escolha uma casa no mapa")"
                                                        @onclick="() => ViewModel.SelecionarPinoParaPosicionar(TiposPinoSessao.Npc, npc.IdNpc, npc.Nome)">
                                                    <span class="pino-mini-avatar tipo-npc">
                                                        @if (!string.IsNullOrWhiteSpace(npc.Imagem))
                                                        {
                                                            <img src="@npc.Imagem" alt="@npc.Nome" />
                                                        }
                                                        else
                                                        {
                                                            @ObterIniciais(npc.Nome)
                                                        }
                                                    </span>
                                                    <span class="pino-item-info">
                                                        <strong>@npc.Nome</strong>
                                                        <small>@(pinoAtual != null ? $"Neste mapa: {pinoAtual.CoordenadaTexto}" : (outroMapa ?? "Clique para posicionar"))</small>
                                                    </span>
                                                </button>

                                                @if (pinoAtual != null)
                                                {
                                                    <div class="pino-item-acoes">
                                                        <button type="button"
                                                                class="pino-btn-acao @(pinoAtual.Visivel ? "visivel" : "oculto")"
                                                                title="@(pinoAtual.Visivel ? "Visível para jogadores (clique para ocultar)" : "Oculto dos jogadores (clique para mostrar)")"
                                                                @onclick="() => ViewModel.AlternarVisibilidadePinoAsync(TiposPinoSessao.Npc, npc.IdNpc)">
                                                            @(pinoAtual.Visivel ? "👁" : "⊘")
                                                        </button>
                                                        <button type="button"
                                                                class="pino-btn-acao remover"
                                                                title="Remover deste mapa"
                                                                @onclick="() => ViewModel.RemoverPinoDoMapaAsync(TiposPinoSessao.Npc, npc.IdNpc)">
                                                            ×
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    if (!ViewModel.Estado.MonstrosCampanha.Any())
                                    {
                                        <p class="pinos-vazio">Nenhum monstro vinculado a esta campanha.</p>
                                    }
                                    else
                                    {
                                        @foreach (var monstro in ViewModel.Estado.MonstrosCampanha)
                                        {
                                            var pinoAtual = ViewModel.ObterPinoNoMapa(TiposPinoSessao.Monstro, monstro.IdMonstro);
                                            var outroMapa = ViewModel.ObterResumoOutroMapaDoPino(TiposPinoSessao.Monstro, monstro.IdMonstro);
                                            bool selecionado = ViewModel.PinoParaPosicionar?.TipoEntidade == TiposPinoSessao.Monstro
                                                && ViewModel.PinoParaPosicionar.IdEntidade == monstro.IdMonstro;
                                            int pvAtualMonstro = pinoAtual?.PvAtual ?? monstro.PvMaximo;

                                            <div class="pino-item-card @(selecionado ? "selecionado" : "")">
                                                <button type="button"
                                                        class="pino-item-main"
                                                        title="@(outroMapa ?? "Clique e depois escolha uma casa no mapa")"
                                                        @onclick="() => ViewModel.SelecionarPinoParaPosicionar(TiposPinoSessao.Monstro, monstro.IdMonstro, monstro.Nome)">
                                                    <span class="pino-mini-avatar tipo-monstro">
                                                        @if (!string.IsNullOrWhiteSpace(monstro.Imagem))
                                                        {
                                                            <img src="@monstro.Imagem" alt="@monstro.Nome" />
                                                        }
                                                        else
                                                        {
                                                            @ObterIniciais(monstro.Nome)
                                                        }
                                                    </span>
                                                    <span class="pino-item-info">
                                                        <strong>@monstro.Nome</strong>
                                                        <small>
                                                            @if (pinoAtual != null)
                                                            {
                                                                <text>@pinoAtual.CoordenadaTexto · PV @pvAtualMonstro/@monstro.PvMaximo</text>
                                                            }
                                                            else
                                                            {
                                                                @(outroMapa ?? "Clique para posicionar")
                                                            }
                                                        </small>
                                                    </span>
                                                </button>

                                                @if (pinoAtual != null)
                                                {
                                                    <div class="pino-item-acoes">
                                                        @if (pvAtualMonstro < monstro.PvMaximo)
                                                        {
                                                            <button type="button"
                                                                    class="pino-btn-acao curar"
                                                                    title="Restaurar PV máximo (@monstro.PvMaximo)"
                                                                    disabled="@ViewModel.SalvandoPvMonstro"
                                                                    @onclick="() => ViewModel.RestaurarPvMonstroPeloPainelAsync(monstro)">
                                                                ♥
                                                            </button>
                                                        }
                                                        <button type="button"
                                                                class="pino-btn-acao @(pinoAtual.Visivel ? "visivel" : "oculto")"
                                                                title="@(pinoAtual.Visivel ? "Visível para jogadores (clique para ocultar)" : "Oculto dos jogadores (clique para mostrar)")"
                                                                @onclick="() => ViewModel.AlternarVisibilidadePinoAsync(TiposPinoSessao.Monstro, monstro.IdMonstro)">
                                                            @(pinoAtual.Visivel ? "👁" : "⊘")
                                                        </button>
                                                        <button type="button"
                                                                class="pino-btn-acao remover"
                                                                title="Remover deste mapa"
                                                                @onclick="() => ViewModel.RemoverPinoDoMapaAsync(TiposPinoSessao.Monstro, monstro.IdMonstro)">
                                                            ×
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </aside>
                    }

                    @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAcao))
                    {
                        <div class="map-alert" role="status">
                            <span>@ViewModel.FeedbackAcao</span>
                            <button type="button" aria-label="Fechar aviso" @onclick="ViewModel.LimparFeedback">×</button>
                        </div>
                    }

                    @if (ViewModel.CarregandoFichaModal)
                    {
                        <div class="map-alert" role="status">
                            <span>Carregando ficha do personagem...</span>
                        </div>
                    }

                    <div class="map-viewport" @onwheel="AoRolarMouseMapa">
                        @{
                            int tamanhoPx = (int)Math.Round(SessaoViewModel.TamanhoBaseMapaPx * ViewModel.NivelZoom);
                            int cabecalhoPx = _mostrarCoordenadas ? Math.Max(22, (int)Math.Round(26 * ViewModel.NivelZoom)) : 0;
                        }
                        <div class="map-board-wrapper @(_mostrarCoordenadas ? "com-coordenadas" : "")"
                             style="--board-size: @(tamanhoPx)px; --header-size: @(cabecalhoPx)px;">

                            @if (_mostrarCoordenadas)
                            {
                                <div class="grade-canto" aria-hidden="true"></div>

                                <div class="grade-eixo-colunas" aria-hidden="true">
                                    @for (int col = 0; col < SessaoViewModel.GradeColunas; col++)
                                    {
                                        <span class="eixo-label">@((char)('A' + col))</span>
                                    }
                                </div>

                                <div class="grade-eixo-linhas" aria-hidden="true">
                                    @for (int linha = 0; linha < SessaoViewModel.GradeLinhas; linha++)
                                    {
                                        <span class="eixo-label">@(linha + 1)</span>
                                    }
                                </div>
                            }

                            <div class="map-art @(ViewModel.PinoParaPosicionar != null ? "modo-posicionar" : "")"
                                 style="width: @(tamanhoPx)px; height: @(tamanhoPx)px;">
                                @if (ViewModel.Estado.MapaAtivo != null && !string.IsNullOrWhiteSpace(ViewModel.Estado.MapaAtivo.ImagemUrl))
                                {
                                    <img class="map-bg-img"
                                         src="@ViewModel.Estado.MapaAtivo.ImagemUrl"
                                         alt="@ViewModel.Estado.MapaAtivo.NomeRegiao"
                                         draggable="false" />
                                }
                                else
                                {
                                    <div class="map-empty">
                                        <p>
                                            @(ViewModel.Estado.EhMestre
                                                ? "Selecione um mapa vinculado à campanha na barra superior."
                                                : "Aguardando o Mestre selecionar o mapa da sessão.")
                                        </p>
                                    </div>
                                }

                                <!-- GRADE TÁTICA D&D 20x20 COM ARRASTE POR POINTER EVENTS -->
                                <div class="mapa-grade-20x20" aria-label="Grade tática 20 por 20">
                                    @for (int linha = 0; linha < SessaoViewModel.GradeLinhas; linha++)
                                    {
                                        int linhaAtual = linha;
                                        @for (int col = 0; col < SessaoViewModel.GradeColunas; col++)
                                        {
                                            int colAtual = col;
                                            char letraCol = (char)('A' + colAtual);
                                            int numLinha = linhaAtual + 1;
                                            bool ehAlvoDrop = ViewModel.PinoArrastando != null
                                                && ViewModel.CelulaDestinoArraste == (colAtual, linhaAtual);

                                            var pinosCelula = ViewModel.PinosVisiveisNoMapa
                                                .Where(p => p.Coluna == colAtual && p.Linha == linhaAtual)
                                                .ToList();

                                            <div class="celula-grade @(ehAlvoDrop ? "celula-drop-alvo" : "")"
                                                 data-col="@colAtual"
                                                 data-row="@linhaAtual"
                                                 title="@($"{letraCol}{numLinha} (1,5m)")"
                                                 @onpointerenter="() => ViewModel.AtualizarCelulaDestinoArraste(colAtual, linhaAtual)"
                                                 @onpointerup="() => ViewModel.SoltarPinoNaCelulaAsync(colAtual, linhaAtual)"
                                                 @onpointerup:stopPropagation="true"
                                                 @onclick="() => ViewModel.AoClicarCelulaMapaAsync(colAtual, linhaAtual)">
                                                @foreach (var pino in pinosCelula)
                                                {
                                                    string classeTipo = pino.TipoEntidade switch
                                                    {
                                                        TiposPinoSessao.Monstro => "tipo-monstro",
                                                        TiposPinoSessao.Npc => "tipo-npc",
                                                        _ => "tipo-personagem"
                                                    };

                                                    bool estaArrastando = ViewModel.PinoArrastando != null
                                                        && ViewModel.PinoArrastando.TipoEntidade == pino.TipoEntidade
                                                        && ViewModel.PinoArrastando.IdEntidade == pino.IdEntidade;

                                                    bool monstroDerrotado = pino.TipoEntidade == TiposPinoSessao.Monstro
                                                        && pino.PvAtual.HasValue
                                                        && pino.PvAtual.Value <= 0;

                                                    string infoPv = pino.TipoEntidade == TiposPinoSessao.Monstro && pino.PvMaximo.HasValue
                                                        ? $" · PV {pino.PvAtual ?? pino.PvMaximo}/{pino.PvMaximo} · CA {pino.ClasseArmadura ?? 10}"
                                                        : string.Empty;

                                                    <button type="button"
                                                            @key="@($"{pino.IdMapa}-{pino.TipoEntidade}-{pino.IdEntidade}")"
                                                            draggable="false"
                                                            class="mapa-pino @classeTipo @(pino.Visivel ? "" : "pino-invisivel") @(monstroDerrotado ? "pino-derrotado" : "") @(ViewModel.Estado.EhMestre ? "arrastavel" : "") @(estaArrastando ? "arrastando" : "")"
                                                            title="@($"{pino.Nome} ({pino.TipoEntidade}) · {pino.CoordenadaTexto}{infoPv}{(pino.Visivel ? "" : " · Oculto")}{(ViewModel.Estado.EhMestre ? " · Segure e arraste para mover ou clique para abrir ficha" : "")}")"
                                                            @onpointerdown="(e) => AoPressionarPino(e, pino)"
                                                            @onpointerdown:stopPropagation="true"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => AoClicarPinoJogadorAsync(pino)">
                                                        @if (!string.IsNullOrWhiteSpace(pino.ImagemUrl))
                                                        {
                                                            <img src="@pino.ImagemUrl" alt="@pino.Nome" draggable="false" />
                                                        }
                                                        else
                                                        {
                                                            <span>@ObterIniciais(pino.Nome)</span>
                                                        }
                                                        @if (monstroDerrotado)
                                                        {
                                                            <em class="pino-badge-derrotado" aria-label="Derrotado">✕</em>
                                                        }
                                                        else if (!pino.Visivel)
                                                        {
                                                            <em class="pino-badge-oculto" aria-label="Oculto dos jogadores">⊘</em>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="map-caption">
                        <span class="map-caption-dot"></span>
                        Cena atual
                        <span>·</span>
                        @(ViewModel.Estado.MapaAtivo?.NomeRegiao ?? "Aguardando mapa")
                    </div>
                </section>

                <!-- CONSOLE: CHAT & AÇÕES RÁPIDAS -->
                <section class="game-console">
                    <div class="chat-panel">
                        <div class="chat-tabs" role="tablist" aria-label="Canais da mesa">
                            <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Chat ? "ativa" : "")"
                                    type="button"
                                    role="tab"
                                    aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Chat)"
                                    @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Chat)">
                                Chat
                            </button>
                            <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Registro ? "ativa" : "")"
                                    type="button"
                                    role="tab"
                                    aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Registro)"
                                    @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Registro)">
                                Registro
                            </button>
                            <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Npc ? "ativa" : "")"
                                    type="button"
                                    role="tab"
                                    aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Npc)"
                                    @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Npc)">
                                NPCs
                            </button>
                            <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Combate ? "ativa" : "")"
                                    type="button"
                                    role="tab"
                                    aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Combate)"
                                    @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Combate)">
                                Combate
                            </button>
                        </div>

                        <div class="chat-feed" aria-live="polite">
                            @if (ViewModel.AbaChatAtiva == CanaisSessao.Npc)
                            {
                                <p class="chat-placeholder">Canal de NPCs reservado para próximas atualizações.</p>
                            }
                            else if (!ViewModel.MensagensAbaAtiva.Any())
                            {
                                <p class="chat-placeholder">
                                    @(ViewModel.AbaChatAtiva switch
                                    {
                                        CanaisSessao.Registro => "Nenhuma rolagem registrada ainda.",
                                        CanaisSessao.Combate => "Nenhum ataque ou dano registrado ainda.",
                                        _ => "Nenhuma mensagem enviada ainda."
                                    })
                                </p>
                            }
                            else
                            {
                                @foreach (var msg in ViewModel.MensagensAbaAtiva)
                                {
                                    <p @key="msg.IdMensagem" class="chat-line @(msg.EhSistema ? "dice-line" : "")">
                                        <strong class="chat-name @(msg.EhSistema ? "sistema" : (msg.Autor == ViewModel.Estado.Mestre.Username ? "mestre" : ""))">
                                            @(msg.EhSistema ? "Sistema" : msg.Autor)
                                        </strong>
                                        <span>@msg.Conteudo</span>
                                        <time>@msg.DataEnvioLocal.ToString("HH:mm")</time>
                                    </p>
                                }
                            }
                        </div>

                        @if (ViewModel.AbaChatAtiva == CanaisSessao.Chat)
                        {
                            <form class="chat-compose" @onsubmit="ViewModel.EnviarMensagemChatAsync" @onsubmit:preventDefault="true">
                                <input type="text"
                                       maxlength="240"
                                       placeholder="Escreva para a mesa..."
                                       aria-label="Mensagem para a mesa"
                                       autocomplete="off"
                                       @bind="ViewModel.TextoMensagem"
                                       @bind:event="oninput"
                                       disabled="@ViewModel.EnviandoMensagem" />
                                <button type="submit"
                                        aria-label="Enviar mensagem"
                                        title="Enviar mensagem"
                                        disabled="@(ViewModel.EnviandoMensagem || string.IsNullOrWhiteSpace(ViewModel.TextoMensagem))">
                                    ↑
                                </button>
                            </form>
                        }
                    </div>

                    <!-- AÇÕES RÁPIDAS -->
                    <div class="action-panel">
                        <div class="action-heading">
                            <span>Ações rápidas</span>
                            @if (ViewModel.Estado.EhMestre)
                            {
                                <small class="@(ViewModel.Estado.IdAccountTurno.HasValue ? "turno-liberado-txt" : "")">
                                    @(string.IsNullOrWhiteSpace(ViewModel.Estado.NomeJogadorTurno)
                                        ? "🔒 Turnos bloqueados"
                                        : $"⏳ Turno: {ViewModel.Estado.NomeJogadorTurno}")
                                </small>
                            }
                            else
                            {
                                <small class="@(ViewModel.EhMeuTurno ? "turno-liberado-txt" : "turno-bloqueado-txt")">
                                    @(ViewModel.EhMeuTurno
                                        ? "✓ Seu turno liberado!"
                                        : (!string.IsNullOrWhiteSpace(ViewModel.Estado.NomeJogadorTurno)
                                            ? $"⏳ Turno de {ViewModel.Estado.NomeJogadorTurno}"
                                            : "🔒 Aguardando Mestre liberar turno"))
                                </small>
                            }
                        </div>
                        <div class="action-slots">
                            <button class="action-slot @(ViewModel.ExibirModalAtaque ? "ativa" : "")"
                                    type="button"
                                    disabled="@(!ViewModel.EhMeuTurno)"
                                    title="@(ViewModel.EhMeuTurno ? "Realizar ataque" : "Aguarde o Mestre liberar seu turno")"
                                    @onclick="ViewModel.AbrirModalAtaqueAsync">
                                <span class="slot-icon">⚔</span><span>Ataque</span><small>Ação</small>
                            </button>
                            <button class="action-slot" type="button" disabled="@(!ViewModel.EhMeuTurno)"><span class="slot-icon">✧</span><span>Conjurar Magia</span><small>Ação</small></button>
                            <button class="action-slot" type="button" disabled="@(!ViewModel.EhMeuTurno)"><span class="slot-icon">◷</span><span>Disparada</span><small>Movimento</small></button>
                            <button class="action-slot" type="button" disabled="@(!ViewModel.EhMeuTurno)"><span class="slot-icon">↺</span><span>Desengajar</span><small>Ação</small></button>
                            <button class="action-slot" type="button" disabled="@(!ViewModel.EhMeuTurno)"><span class="slot-icon">◈</span><span>Esquivar</span><small>Defesa</small></button>
                            <button class="action-slot" type="button" disabled="@(!ViewModel.EhMeuTurno)"><span class="slot-icon">⌕</span><span>Esconder</span><small>Furtividade</small></button>
                        </div>
                    </div>
                </section>
            </main>

            <!-- PAINEL LATERAL DIREITO: MESTRE E JOGADORES -->
            <aside class="players-panel" aria-labelledby="jogadores-titulo">
                <div class="players-heading">
                    <div>
                        <p class="panel-kicker">Na mesa</p>
                        <h2 id="jogadores-titulo">Jogadores</h2>
                    </div>
                    <span class="players-count">@ContarOnline()</span>
                </div>

                <div class="players-list">
                    @{
                        var mestre = ViewModel.Estado.Mestre;
                    }
                    <article class="player-card mestre-card @(mestre.Online ? "online-card" : "offline-card")">
                        <span class="player-avatar avatar-mestre">
                            @if (!string.IsNullOrWhiteSpace(mestre.AvatarUrl))
                            {
                                <img src="@mestre.AvatarUrl" alt="@mestre.Username" />
                            }
                            else
                            {
                                @ObterIniciais(mestre.Username)
                            }
                        </span>
                        <div class="player-info">
                            <strong>@mestre.Username</strong>
                            <span class="player-class">Mestre</span>
                        </div>
                        <span class="mic-status @(mestre.Online ? "" : "desconectado")"
                              title="@(mestre.Online ? "Conectado" : "Fora da sessão")"
                              aria-label="@(mestre.Online ? "Conectado" : "Fora da sessão")">●</span>
                    </article>

                    <div class="players-divider" aria-hidden="true"></div>

                    @foreach (var jogador in ViewModel.Estado.Jogadores)
                    {
                        bool podeAbrirFicha = jogador.IdPersonagem.HasValue
                            && (ViewModel.Estado.EhMestre || jogador.IdPersonagem == ViewModel.Estado.IdPersonagemLogado);
                        bool estaNoTurno = ViewModel.Estado.IdAccountTurno == jogador.IdAccount;

                        <article @key="jogador.IdAccount"
                                 class="player-card @(jogador.Online ? "online-card" : "offline-card") @(podeAbrirFicha ? "clicavel" : "") @(estaNoTurno ? "em-turno" : "")"
                                 title="@(podeAbrirFicha ? "Clique para ver ficha e inventário" : jogador.Username)"
                                 @onclick="() => ViewModel.AbrirFichaParticipanteAsync(jogador)">
                            <span class="player-avatar">
                                @if (!string.IsNullOrWhiteSpace(jogador.AvatarUrl))
                                {
                                    <img src="@jogador.AvatarUrl" alt="@jogador.Username" />
                                }
                                else
                                {
                                    @ObterIniciais(jogador.Username)
                                }
                            </span>
                            <div class="player-info">
                                <strong>@jogador.Username</strong>
                                <span class="player-sheet">@jogador.SubtituloLinha1</span>
                                @if (!string.IsNullOrWhiteSpace(jogador.SubtituloLinha2))
                                {
                                    <span class="player-class">@jogador.SubtituloLinha2</span>
                                }
                                @if (estaNoTurno)
                                {
                                    <span class="turno-badge">⚔ Em turno</span>
                                }
                                @if (ViewModel.Estado.EhMestre && jogador.IdPersonagem.HasValue)
                                {
                                    <button type="button"
                                            class="btn-turno-mestre @(estaNoTurno ? "encerrar" : "")"
                                            disabled="@ViewModel.AlterandoTurno"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ViewModel.AlternarTurnoJogadorAsync(jogador)">
                                        @(estaNoTurno ? "🔒 Encerrar turno" : "▶ Liberar turno")
                                    </button>
                                }
                            </div>
                            <span class="mic-status @(jogador.Online ? "" : "desconectado")"
                                  title="@(jogador.Online ? "Conectado" : "Fora da sessão")"
                                  aria-label="@(jogador.Online ? "Conectado" : "Fora da sessão")">●</span>
                        </article>
                    }
                </div>

                <div class="players-footer">
                    <span class="presence-light"></span>
                    <span>@ContarOnline() / @(ViewModel.Estado.Jogadores.Count + 1) conectados</span>
                    @if (ViewModel.Estado.EhMestre && ViewModel.Estado.IdAccountTurno.HasValue)
                    {
                        <button type="button"
                                class="btn-bloquear-turno-footer"
                                title="Bloquear turno atual"
                                disabled="@ViewModel.AlterandoTurno"
                                @onclick="ViewModel.EncerrarTurnoAtualAsync">
                            🔒
                        </button>
                    }
                </div>
            </aside>
        </div>
    </div>

    <!-- =========================================================================
         MODAL DE ATAQUE: ESCOLHER ARMA -> ESCOLHER ALVO -> ROLAR ATK -> ROLAR DANO
         ========================================================================= -->
    @if (ViewModel.ExibirModalAtaque)
    {
        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalAtaque"></div>

        <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-ataque" @onclick:stopPropagation="true">
            <header class="dice-popup-header">
                <div>
                    <p>Ação de Combate</p>
                    <h2 id="titulo-ataque">⚔ Realizar Ataque</h2>
                </div>
                <button class="dice-close" type="button" aria-label="Fechar ataque" @onclick="ViewModel.FecharModalAtaque">×</button>
            </header>

            @if (ViewModel.CarregandoAtaque)
            {
                <p class="attack-empty">Carregando armas do seu inventário...</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(ViewModel.ErroModalAtaque))
                {
                    <div class="attack-error">@ViewModel.ErroModalAtaque</div>
                }

                @if (ViewModel.EtapaAtaque == 1)
                {
                    <div class="attack-section">
                        <p class="dice-section-label">1. Escolha a arma do inventário</p>
                        @if (!ViewModel.ArmasDisponiveisAtaque.Any())
                        {
                            <p class="attack-empty">Nenhuma arma encontrada no seu inventário. Adicione uma arma na aba Inventário da sua ficha.</p>
                        }
                        else
                        {
                            <div class="attack-choice-list">
                                @foreach (var arma in ViewModel.ArmasDisponiveisAtaque)
                                {
                                    bool sel = ViewModel.IdArmaSelecionada == arma.IdItem;
                                    <button type="button"
                                            class="attack-choice-card @(sel ? "selecionado" : "")"
                                            @onclick="() => ViewModel.SelecionarArmaAtaque(arma.IdItem)">
                                        <strong>@arma.Nome</strong>
                                        <small>Dano: @(string.IsNullOrWhiteSpace(arma.Dano) ? "1d4" : arma.Dano) @arma.TipoDano</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="attack-section">
                        <p class="dice-section-label">2. Escolha o alvo no mapa</p>
                        @if (!ViewModel.MonstrosAlvoNoMapa.Any())
                        {
                            <p class="attack-empty">Nenhum monstro visível no mapa atual.</p>
                        }
                        else
                        {
                            <div class="attack-choice-list">
                                @foreach (var alvo in ViewModel.MonstrosAlvoNoMapa)
                                {
                                    int pvAt = alvo.PvAtual ?? alvo.PvMaximo ?? 0;
                                    int pvMx = alvo.PvMaximo ?? 0;
                                    bool derrotado = pvAt <= 0;
                                    bool sel = !derrotado && ViewModel.IdMonstroAlvoSelecionado == alvo.IdEntidade;

                                    <button type="button"
                                            disabled="@derrotado"
                                            class="attack-choice-card @(sel ? "selecionado" : "") @(derrotado ? "derrotado" : "")"
                                            title="@(derrotado ? "Monstro derrotado (0 PV)" : $"Atacar {alvo.Nome}")"
                                            @onclick="() => ViewModel.SelecionarAlvoAtaque(alvo.IdEntidade)">
                                        <strong>@alvo.Nome (@alvo.CoordenadaTexto)</strong>
                                        <small>
                                            @if (derrotado)
                                            {
                                                <text>☠️ Derrotado (0 / @pvMx PV)</text>
                                            }
                                            else
                                            {
                                                <text>PV: @pvAt / @pvMx · CA: @(alvo.ClasseArmadura ?? 10)</text>
                                            }
                                        </small>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="dice-options">
                        <label class="dice-field">
                            Bônus de Ataque (d20)
                            <input type="number" min="-50" max="50" @bind="ViewModel.ModificadorAtaque" />
                        </label>
                        <label class="dice-field">
                            Bônus de Dano
                            <input type="number" min="-50" max="50" @bind="ViewModel.ModificadorDano" />
                        </label>
                    </div>

                    <button type="button"
                            class="dice-roll"
                            disabled="@(ViewModel.ExecutandoAtaque || ViewModel.ArmaSelecionada == null || !ViewModel.AlvoSelecionadoVivo)"
                            @onclick="ViewModel.RolarDadoAtaqueAsync">
                        @(ViewModel.ExecutandoAtaque ? "Rolando..." : "🎲 3. Rolar Dado de Ataque (1d20)")
                    </button>
                }
                else if (ViewModel.EtapaAtaque == 2 && ViewModel.ResultadoAtaqueAtual != null)
                {
                    var r = ViewModel.ResultadoAtaqueAtual;
                    <div class="attack-result-box @(r.EhCritico ? "critico" : "acertou")">
                        <span class="attack-badge @(r.EhCritico ? "critico" : "acertou")">
                            @(r.EhCritico ? "💥 ACERTO CRÍTICO! (20 NATURAL)" : "ACERTOU!")
                        </span>
                        <strong>@(r.EhCritico ? "20!" : r.TotalAtaque.ToString())</strong>
                        <p>
                            @if (r.EhCritico)
                            {
                                <text>20 natural acerta <b>@r.NomeAlvo</b> (CA @r.CaAlvo) automaticamente e dobra os dados da arma!</text>
                            }
                            else
                            {
                                <text>
                                    d20 (@r.DadoAtaque) @(r.ModificadorAtaque >= 0 ? $"+ {r.ModificadorAtaque}" : $"− {Math.Abs(r.ModificadorAtaque)}")
                                    ≥ CA @r.CaAlvo de <b>@r.NomeAlvo</b>
                                </text>
                            }
                        </p>
                    </div>

                    <button type="button"
                            class="dice-roll @(r.EhCritico ? "attack-crit-btn" : "attack-damage-btn")"
                            disabled="@ViewModel.ExecutandoAtaque"
                            @onclick="ViewModel.RolarDanoEAplicarAsync">
                        @(ViewModel.ExecutandoAtaque
                            ? "Aplicando dano..."
                            : r.EhCritico
                                ? $"💥 Rolar Dano Crítico (2× dados de {r.ExpressaoDano})"
                                : $"💥 Rolar Dano da Arma ({r.ExpressaoDano})")
                    </button>
                }
                else if (ViewModel.EtapaAtaque == 3 && ViewModel.ResultadoAtaqueAtual != null)
                {
                    var r = ViewModel.ResultadoAtaqueAtual;
                    string classeBox = r.Acertou ? (r.EhCritico ? "critico" : "acertou") : "falhou";

                    <div class="attack-result-box @classeBox">
                        <span class="attack-badge @classeBox">
                            @(r.Acertou ? (r.EhCritico ? "💥 DANO CRÍTICO APLICADO" : "DANO APLICADO") : "ATAQUE FALHOU")
                        </span>

                        @if (r.Acertou)
                        {
                            <strong>-@r.DanoTotal PV</strong>
                            <p>
                                Arma: <b>@r.NomeArma</b> (@(r.EhCritico ? $"2× {r.ExpressaoDano}" : r.ExpressaoDano)) · Dados: [@string.Join(" + ", r.ResultadosDano)]
                                @(r.ModificadorDano != 0 ? (r.ModificadorDano > 0 ? $" + {r.ModificadorDano}" : $" − {Math.Abs(r.ModificadorDano)}") : "")
                            </p>
                            <p class="attack-hp-summary">
                                PV de <b>@r.NomeAlvo</b>: @r.PvAnterior → <b>@r.PvNovo / @r.PvMaximo</b>
                                @(r.PvNovo <= 0 ? " (Derrotado!)" : "")
                            </p>
                        }
                        else
                        {
                            <strong>@r.TotalAtaque</strong>
                            <p>
                                d20 (@r.DadoAtaque) @(r.ModificadorAtaque >= 0 ? $"+ {r.ModificadorAtaque}" : $"− {Math.Abs(r.ModificadorAtaque)}")
                                &lt; CA @r.CaAlvo de <b>@r.NomeAlvo</b>
                            </p>
                        }
                    </div>

                    <div class="attack-footer-actions">
                        <button type="button" class="game-exit" @onclick="ViewModel.NovoAtaque">Atacar novamente</button>
                        <button type="button" class="game-finish" @onclick="ViewModel.FecharModalAtaque">Fechar</button>
                    </div>
                }
            }
        </section>
    }

    <!-- =========================================================================
         MODAL DE FICHA: MONSTRO (AO CLICAR NO PINO DO MONSTRO)
         ========================================================================= -->
    @if (ViewModel.MonstroEmVisualizacao != null)
    {
        var m = ViewModel.MonstroEmVisualizacao;
        int pvAtualMonstro = ViewModel.PinoMonstroEmVisualizacao?.PvAtual ?? m.PvMaximo;

        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalEntidade"></div>

        <section class="entidade-modal-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-monstro-modal" @onclick:stopPropagation="true">
            <header class="ficha-modal-header">
                <div class="ficha-modal-identidade">
                    <img class="ficha-modal-retrato"
                         src="@(string.IsNullOrWhiteSpace(m.Imagem) ? "img/capacampanha2.png" : m.Imagem)"
                         alt="@m.Nome" />
                    <div>
                        <p class="ficha-modal-sub">Bestiário da Campanha</p>
                        <h2 id="titulo-monstro-modal">@m.Nome</h2>
                        <small>@(m.TipoMonstro ?? "Criatura") • @(m.Tamanho ?? "Médio") • @(m.Tendencia ?? "Neutra")</small>
                    </div>
                </div>
                <button class="ficha-modal-close" type="button" aria-label="Fechar ficha do monstro" @onclick="ViewModel.FecharModalEntidade">×</button>
            </header>

            <div class="ficha-modal-corpo">
                <div class="fm-dados-pessoais">
                    <div>
                        <span>PV Atual / Máximo</span>
                        @if (ViewModel.Estado.EhMestre)
                        {
                            <div class="fm-pv-monstro-edit">
                                <input type="number" min="0" max="@m.PvMaximo" @bind="ViewModel.PvAtualMonstroEdicao" />
                                <span>/ @m.PvMaximo</span>
                                <button type="button"
                                        class="fm-btn-pv-ok"
                                        title="Salvar PV atual"
                                        disabled="@ViewModel.SalvandoPvMonstro"
                                        @onclick="ViewModel.SalvarPvAtualMonstroAsync">
                                    ✓
                                </button>
                                <button type="button"
                                        class="fm-btn-pv-max"
                                        title="Restaurar PV máximo (@m.PvMaximo)"
                                        disabled="@ViewModel.SalvandoPvMonstro"
                                        @onclick="ViewModel.RestaurarPvMaximoMonstroAsync">
                                    ↻ Máx
                                </button>
                            </div>
                        }
                        else
                        {
                            <strong>@pvAtualMonstro / @m.PvMaximo</strong>
                        }
                    </div>
                    <div><span>CA</span><strong>@m.ClasseArmadura</strong></div>
                    <div><span>ND</span><strong>@(m.NivelDesafio?.ToString("0.##") ?? "—")</strong></div>
                    <div><span>Deslocamento</span><strong>@(string.IsNullOrWhiteSpace(m.Deslocamento) ? "—" : m.Deslocamento)</strong></div>
                </div>

                <div class="fm-grid-2">
                    <div class="fm-bloco-pergaminho">
                        <h3>Sentidos</h3>
                        <p>@(string.IsNullOrWhiteSpace(m.Sentidos) ? "—" : m.Sentidos)</p>
                    </div>
                    <div class="fm-bloco-pergaminho">
                        <h3>Resistências</h3>
                        <p>@(string.IsNullOrWhiteSpace(m.Resistencias) ? "—" : m.Resistencias)</p>
                    </div>
                    <div class="fm-box-escuro fm-span-2">
                        <h3>Habilidades</h3>
                        <p>@(string.IsNullOrWhiteSpace(m.Habilidades) ? "—" : m.Habilidades)</p>
                    </div>
                    <div class="fm-bloco-pergaminho fm-span-2">
                        <h3>Descrição</h3>
                        <p>@(string.IsNullOrWhiteSpace(m.Descricao) ? "Sem descrição registrada." : m.Descricao)</p>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- =========================================================================
         MODAL DE FICHA: NPC (AO CLICAR NO PINO DO NPC)
         ========================================================================= -->
    @if (ViewModel.NpcEmVisualizacao != null)
    {
        var n = ViewModel.NpcEmVisualizacao;
        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalEntidade"></div>

        <section class="entidade-modal-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-npc-modal" @onclick:stopPropagation="true">
            <header class="ficha-modal-header">
                <div class="ficha-modal-identidade">
                    <img class="ficha-modal-retrato"
                         src="@(string.IsNullOrWhiteSpace(n.Imagem) ? "img/capacampanha3.png" : n.Imagem)"
                         alt="@n.Nome" />
                    <div>
                        <p class="ficha-modal-sub">NPC da Campanha</p>
                        <h2 id="titulo-npc-modal">@n.Nome</h2>
                        <small>@(n.RacaTexto ?? "Raça") • @(n.ClasseTexto ?? "NPC") • Nível @n.Nivel</small>
                    </div>
                </div>
                <button class="ficha-modal-close" type="button" aria-label="Fechar ficha do NPC" @onclick="ViewModel.FecharModalEntidade">×</button>
            </header>

            <div class="ficha-modal-corpo">
                <div class="fm-grid-atributos">
                    <div class="fm-attr-card"><span>FOR</span><strong>@n.Forca</strong><small>@FormatarMod(n.Forca)</small></div>
                    <div class="fm-attr-card"><span>DES</span><strong>@n.Destreza</strong><small>@FormatarMod(n.Destreza)</small></div>
                    <div class="fm-attr-card"><span>CON</span><strong>@n.Constituicao</strong><small>@FormatarMod(n.Constituicao)</small></div>
                    <div class="fm-attr-card"><span>INT</span><strong>@n.Inteligencia</strong><small>@FormatarMod(n.Inteligencia)</small></div>
                    <div class="fm-attr-card"><span>SAB</span><strong>@n.Sabedoria</strong><small>@FormatarMod(n.Sabedoria)</small></div>
                    <div class="fm-attr-card"><span>CAR</span><strong>@n.Carisma</strong><small>@FormatarMod(n.Carisma)</small></div>
                </div>

                <div class="fm-dados-pessoais">
                    <div><span>Antecedente</span><strong>@(string.IsNullOrWhiteSpace(n.AntecedenteTexto) ? "—" : n.AntecedenteTexto)</strong></div>
                    <div><span>Tendência</span><strong>@(string.IsNullOrWhiteSpace(n.Tendencia) ? "Neutra" : n.Tendencia)</strong></div>
                    <div><span>Nível</span><strong>@n.Nivel</strong></div>
                    <div><span>Classe</span><strong>@(string.IsNullOrWhiteSpace(n.ClasseTexto) ? "—" : n.ClasseTexto)</strong></div>
                </div>

                <div class="fm-bloco-pergaminho">
                    <h3>História & Notas</h3>
                    <p>@(string.IsNullOrWhiteSpace(n.Historia) ? "Sem história registrada." : n.Historia)</p>
                </div>
            </div>
        </section>
    }

    <!-- =========================================================================
         MINI JANELA INDIVIDUAL: ROLAR DADOS (RESULTADO SAI NO CHAT)
         ========================================================================= -->
    @if (ViewModel.ExibirModalDados)
    {
        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalDados"></div>

        <section class="dice-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-dados" @onclick:stopPropagation="true">
            <header class="dice-popup-header">
                <div>
                    <p>Rolagem individual</p>
                    <h2 id="titulo-dados">Rolar dados</h2>
                </div>
                <button class="dice-close" type="button" aria-label="Fechar rolagem" @onclick="ViewModel.FecharModalDados">×</button>
            </header>

            <form @onsubmit="RolarDadosAsync" @onsubmit:preventDefault="true">
                <section class="dice-selection">
                    <p class="dice-section-label">Escolha o dado</p>
                    <div class="dice-faces" role="group" aria-label="Tipo de dado">
                        @foreach (var face in _facesPadrao)
                        {
                            bool selecionado = _facesSelecionadas == face;
                            <button class="dice-face @(selecionado ? "selecionado" : "")"
                                    type="button"
                                    aria-pressed="@selecionado.ToString().ToLowerInvariant()"
                                    @onclick="() => _facesSelecionadas = face">
                                @($"d{face}")
                            </button>
                        }
                    </div>
                </section>

                <div class="dice-options">
                    <label class="dice-field">
                        Quantidade
                        <input type="number" min="1" max="20" @bind="_qtdDados" />
                    </label>
                    <label class="dice-field">
                        Modificador
                        <input type="number" min="-100" max="100" @bind="_modificadorDado" />
                    </label>
                </div>

                <label class="dice-field" style="margin-top: 10px;">
                    Descrição / Teste (opcional)
                    <input type="text" maxlength="60" placeholder="Ex.: Ataque, Percepção, Iniciativa..." @bind="_contextoDado" />
                </label>

                <button class="dice-roll" type="submit" disabled="@_rolandoDados">
                    <span aria-hidden="true">⚄</span> @(_rolandoDados ? "Rolando..." : "Rolar e enviar no Chat")
                </button>
            </form>

            @if (_ultimoResultadoDado != null)
            {
                <section class="dice-result" aria-live="polite">
                    <p class="dice-result-label">Resultado total</p>
                    <strong class="dice-total">@_ultimoResultadoDado.Total</strong>
                    <p class="dice-expression">@_descricaoDetalhadaDado</p>
                    <div class="dice-breakdown" aria-label="Resultados individuais">
                        @foreach (var valor in _ultimoResultadoDado.ResultadosIndividuais)
                        {
                            <span>@valor</span>
                        }
                        @if (_ultimoResultadoDado.Modificador != 0)
                        {
                            <span class="modifier-result">
                                @(_ultimoResultadoDado.Modificador > 0 ? $"+{_ultimoResultadoDado.Modificador}" : $"−{Math.Abs(_ultimoResultadoDado.Modificador)}")
                            </span>
                        }
                    </div>
                </section>
            }

            <p class="dice-popup-footer">O resultado é enviado automaticamente no Chat da sessão.</p>
        </section>
    }

    <!-- =========================================================================
         MINI JANELA COMPLETA: FICHA, INVENTÁRIO & GRIMÓRIO
         ========================================================================= -->
    @if (ViewModel.ExibirModalFicha && ViewModel.FichaEmVisualizacao != null)
    {
        var p = ViewModel.FichaEmVisualizacao;
        decimal pesoModal = ViewModel.CalcularPesoModal();
        decimal capModal = Math.Round(Math.Max(1, p.Forca) * 7.5m, 1);

        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalFicha"></div>

        <section class="ficha-modal-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-ficha-modal" @onclick:stopPropagation="true">
            <header class="ficha-modal-header">
                <div class="ficha-modal-identidade">
                    <img class="ficha-modal-retrato"
                         src="@(string.IsNullOrWhiteSpace(p.Imagem) ? "img/armaduraprata.png" : p.Imagem)"
                         alt="@p.Nome" />
                    <div>
                        <p class="ficha-modal-sub">
                            Ficha na Sessão
                            @if (!string.IsNullOrWhiteSpace(p.Usuario?.UsarName))
                            {
                                <text> · Jogador: @p.Usuario.UsarName</text>
                            }
                        </p>
                        <h2 id="titulo-ficha-modal">@p.Nome</h2>
                        <small>@(p.RacaTexto ?? "Raça") • @ObterResumoClasses(p) • Nível @p.Nivel • @p.ExperienciaXp.ToString("N0") XP</small>
                    </div>
                </div>

                <div class="ficha-modal-header-acoes">
                    @if (ViewModel.Estado.EhMestre && ViewModel.Estado.Jogadores.Count(j => j.IdPersonagem.HasValue) > 1)
                    {
                        <select class="fm-trocar-jogador"
                                aria-label="Trocar ficha do jogador"
                                value="@p.IdPersonagem"
                                @onchange="AoTrocarJogadorModalAsync">
                            @foreach (var jog in ViewModel.Estado.Jogadores.Where(j => j.IdPersonagem.HasValue))
                            {
                                <option value="@jog.IdPersonagem">@jog.Username (@jog.NomePersonagem)</option>
                            }
                        </select>
                    }

                    <div class="ficha-modal-pv">
                        <span>PV</span>
                        @if (ViewModel.PodeEditarFichaModal)
                        {
                            <div class="fm-pv-inputs">
                                <input type="number" min="0" max="9999" @bind="p.PvAtual" aria-label="PV atual" />
                                <span>/</span>
                                <input type="number" min="1" max="9999" @bind="p.PvMaximo" aria-label="PV máximo" />
                            </div>
                        }
                        else
                        {
                            <strong>@p.PvAtual / @p.PvMaximo</strong>
                        }
                    </div>
                    <button class="ficha-modal-close" type="button" aria-label="Fechar ficha" @onclick="ViewModel.FecharModalFicha">×</button>
                </div>
            </header>

            <nav class="ficha-modal-abas" role="tablist">
                <button type="button" class="ficha-modal-aba @(ViewModel.AbaFichaModalAtiva == "atributos" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaFichaModal("atributos")'>Atributos & Perícias</button>
                <button type="button" class="ficha-modal-aba @(ViewModel.AbaFichaModalAtiva == "personagem" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaFichaModal("personagem")'>Personagem</button>
                <button type="button" class="ficha-modal-aba @(ViewModel.AbaFichaModalAtiva == "inventario" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaFichaModal("inventario")'>Inventário (@ViewModel.ItensModalEdicao.Count)</button>
                <button type="button" class="ficha-modal-aba @(ViewModel.AbaFichaModalAtiva == "grimorio" ? "ativa" : "")" @onclick='() => ViewModel.MudarAbaFichaModal("grimorio")'>Grimório (@p.PersonagemMagias.Count)</button>
            </nav>

            <div class="ficha-modal-corpo">
                @if (ViewModel.AbaFichaModalAtiva == "atributos")
                {
                    <div class="fm-grid-atributos">
                        @if (ViewModel.PodeEditarFichaModal)
                        {
                            <label class="fm-attr-card"><span>Força</span><input type="number" min="1" max="30" @bind="p.Forca" /><small>@FormatarMod(p.Forca)</small></label>
                            <label class="fm-attr-card"><span>Destreza</span><input type="number" min="1" max="30" @bind="p.Destreza" /><small>@FormatarMod(p.Destreza)</small></label>
                            <label class="fm-attr-card"><span>Constituição</span><input type="number" min="1" max="30" @bind="p.Constituicao" /><small>@FormatarMod(p.Constituicao)</small></label>
                            <label class="fm-attr-card"><span>Inteligência</span><input type="number" min="1" max="30" @bind="p.Inteligencia" /><small>@FormatarMod(p.Inteligencia)</small></label>
                            <label class="fm-attr-card"><span>Sabedoria</span><input type="number" min="1" max="30" @bind="p.Sabedoria" /><small>@FormatarMod(p.Sabedoria)</small></label>
                            <label class="fm-attr-card"><span>Carisma</span><input type="number" min="1" max="30" @bind="p.Carisma" /><small>@FormatarMod(p.Carisma)</small></label>
                        }
                        else
                        {
                            <div class="fm-attr-card"><span>Força</span><strong>@p.Forca</strong><small>@FormatarMod(p.Forca)</small></div>
                            <div class="fm-attr-card"><span>Destreza</span><strong>@p.Destreza</strong><small>@FormatarMod(p.Destreza)</small></div>
                            <div class="fm-attr-card"><span>Constituição</span><strong>@p.Constituicao</strong><small>@FormatarMod(p.Constituicao)</small></div>
                            <div class="fm-attr-card"><span>Inteligência</span><strong>@p.Inteligencia</strong><small>@FormatarMod(p.Inteligencia)</small></div>
                            <div class="fm-attr-card"><span>Sabedoria</span><strong>@p.Sabedoria</strong><small>@FormatarMod(p.Sabedoria)</small></div>
                            <div class="fm-attr-card"><span>Carisma</span><strong>@p.Carisma</strong><small>@FormatarMod(p.Carisma)</small></div>
                        }
                    </div>

                    <div class="fm-grid-2">
                        <div class="fm-box-escuro">
                            <h3>Salvaguardas Treinadas</h3>
                            @if (p.Salvaguardas.Any())
                            {
                                <div class="fm-tags">
                                    @foreach (var s in p.Salvaguardas)
                                    {
                                        <span class="fm-tag">@s.Atributo</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="fm-vazio">Nenhuma salvaguarda treinada.</p>
                            }

                            <h3 style="margin-top: 14px;">Perícias Treinadas</h3>
                            @if (p.Pericias.Any())
                            {
                                <div class="fm-tags">
                                    @foreach (var per in p.Pericias)
                                    {
                                        <span class="fm-tag">@per.NomePericia</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="fm-vazio">Nenhuma perícia treinada.</p>
                            }
                        </div>

                        <div class="fm-coluna-notas">
                            <div class="fm-bloco-pergaminho">
                                <h3>Traços de Personalidade</h3>
                                @if (ViewModel.PodeEditarFichaModal)
                                {
                                    <textarea class="fm-textarea" rows="2" @bind="p.TracosPersonalidade"></textarea>
                                }
                                else
                                {
                                    <p>@(string.IsNullOrWhiteSpace(p.TracosPersonalidade) ? "—" : p.TracosPersonalidade)</p>
                                }
                            </div>
                            <div class="fm-bloco-pergaminho">
                                <h3>Ponto de Vista Atual</h3>
                                @if (ViewModel.PodeEditarFichaModal)
                                {
                                    <textarea class="fm-textarea" rows="2" @bind="p.PontoDeVista"></textarea>
                                }
                                else
                                {
                                    <p>@(string.IsNullOrWhiteSpace(p.PontoDeVista) ? "—" : p.PontoDeVista)</p>
                                }
                            </div>
                            <div class="fm-bloco-pergaminho">
                                <h3>Ideais / Ligações / Defeitos / Idiomas</h3>
                                <p><strong>Ideais:</strong> @(string.IsNullOrWhiteSpace(p.Ideais) ? "—" : p.Ideais)</p>
                                <p><strong>Ligações:</strong> @(string.IsNullOrWhiteSpace(p.Ligacoes) ? "—" : p.Ligacoes)</p>
                                <p><strong>Defeitos:</strong> @(string.IsNullOrWhiteSpace(p.Defeitos) ? "—" : p.Defeitos)</p>
                                <p><strong>Idiomas:</strong> @(string.IsNullOrWhiteSpace(p.Idiomas) ? "—" : p.Idiomas)</p>
                            </div>
                        </div>
                    </div>
                }
                else if (ViewModel.AbaFichaModalAtiva == "personagem")
                {
                    <div class="fm-dados-pessoais">
                        <div><span>Antecedente</span><strong>@(p.AntecedenteTexto ?? "—")</strong></div>
                        <div><span>Tendência</span><strong>@(p.Tendencia ?? "Neutra")</strong></div>
                        <div><span>Idade</span><strong>@(p.Idade ?? "—")</strong></div>
                        <div><span>Gênero</span><strong>@(p.Genero ?? "—")</strong></div>
                        <div><span>Altura</span><strong>@(p.Altura ?? "—")</strong></div>
                        <div><span>Peso</span><strong>@(p.Peso ?? "—")</strong></div>
                        <div><span>Deslocamento</span><strong>@(p.Deslocamento ?? 9)m</strong></div>
                        <div><span>Iniciativa</span><strong>@(p.Iniciativa ?? 0)</strong></div>
                    </div>

                    <div class="fm-grid-2">
                        <div class="fm-bloco-pergaminho">
                            <h3>Aparência</h3>
                            <p>@(string.IsNullOrWhiteSpace(p.Aparencia) ? "—" : p.Aparencia)</p>
                        </div>
                        <div class="fm-bloco-pergaminho">
                            <h3>Aliados e Organizações</h3>
                            <p>@(string.IsNullOrWhiteSpace(p.Aliados) ? "—" : p.Aliados)</p>
                        </div>
                        <div class="fm-bloco-pergaminho fm-span-2">
                            <h3>História do Personagem</h3>
                            @if (ViewModel.PodeEditarFichaModal)
                            {
                                <textarea class="fm-textarea" rows="4" @bind="p.Historia"></textarea>
                            }
                            else
                            {
                                <p>@(string.IsNullOrWhiteSpace(p.Historia) ? "—" : p.Historia)</p>
                            }
                        </div>
                        <div class="fm-bloco-pergaminho">
                            <h3>Características e Habilidades</h3>
                            @if (ViewModel.PodeEditarFichaModal)
                            {
                                <textarea class="fm-textarea" rows="3" @bind="p.Caracteristicas"></textarea>
                            }
                            else
                            {
                                <p>@(string.IsNullOrWhiteSpace(p.Caracteristicas) ? "—" : p.Caracteristicas)</p>
                            }
                        </div>
                        <div class="fm-box-escuro">
                            <h3>Tesouro Pessoal</h3>
                            @if (ViewModel.PodeEditarFichaModal)
                            {
                                <textarea class="fm-textarea escuro" rows="3" @bind="p.Tesouro"></textarea>
                            }
                            else
                            {
                                <p>@(string.IsNullOrWhiteSpace(p.Tesouro) ? "—" : p.Tesouro)</p>
                            }
                        </div>
                    </div>
                }
                else if (ViewModel.AbaFichaModalAtiva == "inventario")
                {
                    <div class="fm-inv-layout">
                        <div class="fm-inv-lista">
                            <div class="fm-inv-topo">
                                <h3>Itens na Mochila (@ViewModel.ItensModalEdicao.Count)</h3>
                                @if (ViewModel.PodeEditarFichaModal)
                                {
                                    <button type="button" class="fm-btn-add" title="Adicionar item da campanha" @onclick="ViewModel.AdicionarItemModal">+</button>
                                }
                            </div>

                            @if (ViewModel.ItensModalEdicao.Any())
                            {
                                <div class="fm-itens-detalhados">
                                    @foreach (var slot in ViewModel.ItensModalEdicao)
                                    {
                                        var itemInfo = ViewModel.ObterDetalhesItem(slot.IdItem);
                                        <div class="fm-item-card">
                                            @if (ViewModel.PodeEditarFichaModal)
                                            {
                                                <div class="fm-item-edit-row">
                                                    <select @bind="slot.IdItem">
                                                        <option value="0">Selecione um item da campanha...</option>
                                                        @foreach (var itemOpcao in ViewModel.Estado.ItensCampanha)
                                                        {
                                                            <option value="@itemOpcao.IdItem">@itemOpcao.Nome (@(itemOpcao.Tipo ?? "Geral"))</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="999" @bind="slot.Quantidade" />
                                                    <button type="button" class="fm-btn-rem" title="Remover item" @onclick="() => ViewModel.RemoverItemModal(slot)">×</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="fm-item-readonly-topo">
                                                    <strong>@(slot.Quantidade)x @(itemInfo?.Nome ?? "Item")</strong>
                                                    <span>@(itemInfo?.Tipo ?? "Geral")</span>
                                                </div>
                                            }

                                            @if (itemInfo != null)
                                            {
                                                <div class="fm-item-meta">
                                                    <span><b>Tipo:</b> @(itemInfo.Tipo ?? "Geral")</span>
                                                    <span><b>Peso:</b> @(((itemInfo.Peso ?? 0m) * Math.Max(1, slot.Quantidade)).ToString("0.##")) kg</span>
                                                    <span><b>Preço:</b> @(itemInfo.Preco.HasValue ? $"{itemInfo.Preco:0.##} PO" : "—")</span>
                                                    @if (!string.IsNullOrWhiteSpace(itemInfo.Raridade))
                                                    {
                                                        <span><b>Raridade:</b> @itemInfo.Raridade</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(itemInfo.Dano))
                                                    {
                                                        <span><b>Dano:</b> @itemInfo.Dano @itemInfo.TipoDano</span>
                                                    }
                                                    @if (itemInfo.CaBonus > 0)
                                                    {
                                                        <span><b>CA:</b> +@itemInfo.CaBonus</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(itemInfo.Propriedades))
                                                {
                                                    <p class="fm-item-desc"><b>Propriedades:</b> @itemInfo.Propriedades</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(itemInfo.Descricao))
                                                {
                                                    <p class="fm-item-desc">@itemInfo.Descricao</p>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="fm-vazio-claro">Nenhum item cadastrado no inventário desta ficha.</p>
                            }
                        </div>

                        <aside class="fm-inv-resumo">
                            <div class="fm-box-escuro">
                                <h3>Moedas</h3>
                                <div class="fm-moedas">
                                    @if (ViewModel.PodeEditarFichaModal)
                                    {
                                        <div><span>PC</span><input type="number" min="0" @bind="ViewModel.ModalMoedasPC" /></div>
                                        <div><span>PP</span><input type="number" min="0" @bind="ViewModel.ModalMoedasPP" /></div>
                                        <div><span>PE</span><input type="number" min="0" @bind="ViewModel.ModalMoedasPE" /></div>
                                        <div><span>PO</span><input type="number" min="0" @bind="ViewModel.ModalMoedasPO" /></div>
                                        <div><span>PL</span><input type="number" min="0" @bind="ViewModel.ModalMoedasPL" /></div>
                                    }
                                    else
                                    {
                                        <div><span>PC</span><strong>@ViewModel.ModalMoedasPC</strong></div>
                                        <div><span>PP</span><strong>@ViewModel.ModalMoedasPP</strong></div>
                                        <div><span>PE</span><strong>@ViewModel.ModalMoedasPE</strong></div>
                                        <div><span>PO</span><strong>@ViewModel.ModalMoedasPO</strong></div>
                                        <div><span>PL</span><strong>@ViewModel.ModalMoedasPL</strong></div>
                                    }
                                </div>
                            </div>

                            <div class="fm-box-escuro">
                                <h3>Carga</h3>
                                <p class="fm-carga-texto"><strong>@pesoModal.ToString("0.0") kg</strong> / @capModal.ToString("0.0") kg</p>
                                <progress max="@capModal.ToString("0.0", CultureInfo.InvariantCulture)"
                                          value="@Math.Min(pesoModal, capModal).ToString("0.0", CultureInfo.InvariantCulture)"></progress>
                            </div>

                            <div class="fm-box-escuro">
                                <h3>Notas do Inventário</h3>
                                @if (ViewModel.PodeEditarFichaModal)
                                {
                                    <textarea class="fm-textarea escuro" rows="4" @bind="ViewModel.ModalNotasInventario" placeholder="Anote itens encontrados ou detalhes..."></textarea>
                                }
                                else
                                {
                                    <p>@(string.IsNullOrWhiteSpace(ViewModel.ModalNotasInventario) ? "Sem anotações." : ViewModel.ModalNotasInventario)</p>
                                }
                            </div>
                        </aside>
                    </div>
                }
                else if (ViewModel.AbaFichaModalAtiva == "grimorio")
                {
                    var magias = p.PersonagemMagias
                        .Where(pm => pm.Magia != null)
                        .Select(pm => pm.Magia!)
                        .OrderBy(m => m.CirculoNivel)
                        .ThenBy(m => m.Nome)
                        .ToList();

                    if (magias.Any())
                    {
                        <div class="fm-magias-grid">
                            @foreach (var m in magias)
                            {
                                <article class="fm-magia-card">
                                    <header>
                                        <strong>@m.Nome</strong>
                                        <span>@(m.CirculoNivel == 0 ? "Truque" : $"{m.CirculoNivel}º Círculo")</span>
                                    </header>
                                    <small>
                                        @(m.Escola ?? "Escola não informada")
                                        • Conj.: @(m.TempoConjuracao ?? "—")
                                        • Alcance: @(m.Alcance ?? "—")
                                    </small>
                                    <small>
                                        Comp.: @(m.Componentes ?? "—")
                                        • Duração: @(m.Duracao ?? "—")
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(m.DanoEfeito))
                                    {
                                        <p><b>Efeito:</b> @m.DanoEfeito</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="fm-vazio-claro">Nenhuma magia preparada no grimório desta ficha.</p>
                    }
                }
            </div>

            @if (ViewModel.PodeEditarFichaModal)
            {
                <footer class="ficha-modal-footer">
                    <span class="fm-feedback">@ViewModel.FeedbackFichaModal</span>
                    <button type="button" class="fm-btn-salvar" disabled="@ViewModel.SalvandoFichaModal" @onclick="ViewModel.SalvarFichaEmVisualizacaoAsync">
                        @(ViewModel.SalvandoFichaModal ? "Salvando..." : "Salvar Alterações na Ficha")
                    </button>
                </footer>
            }
        </section>
    }
}

@code {
    [Parameter]
    public int IdCampanha { get; set; }

    [Parameter]
    public int? IdPersonagem { get; set; }

    private int _ultimoIdCampanha = -1;
    private int? _ultimoIdPersonagem;
    private bool _mostrarCoordenadas = true;

    private readonly int[] _facesPadrao = [4, 6, 8, 10, 12, 20, 100];
    private int _facesSelecionadas = 20;
    private int _qtdDados = 1;
    private int _modificadorDado = 0;
    private string _contextoDado = string.Empty;
    private bool _rolandoDados = false;
    private ResultadoRolagemDto? _ultimoResultadoDado;
    private string _descricaoDetalhadaDado = string.Empty;

    protected override void OnInitialized()
    {
        ViewModel.OnChange += AtualizarUi;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IdCampanha != _ultimoIdCampanha || IdPersonagem != _ultimoIdPersonagem)
        {
            _ultimoIdCampanha = IdCampanha;
            _ultimoIdPersonagem = IdPersonagem;
            await ViewModel.InicializarAsync(IdCampanha, IdPersonagem);
        }
    }

    private void AtualizarUi()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void AlternarCoordenadas()
    {
        _mostrarCoordenadas = !_mostrarCoordenadas;
    }

    private void AoPressionarPino(PointerEventArgs e, PinoMapaDto pino)
    {
        if (!ViewModel.Estado.EhMestre || e.Button != 0)
            return;

        ViewModel.IniciarArrastePino(pino);
    }

    private async Task AoClicarPinoJogadorAsync(PinoMapaDto pino)
    {
        if (ViewModel.Estado.EhMestre)
            return;

        await ViewModel.AoClicarPinoMapaAsync(pino);
    }

    private async Task RolarDadosAsync()
    {
        if (_rolandoDados) return;
        _rolandoDados = true;
        try
        {
            int qtd = Math.Clamp(_qtdDados, 1, 20);
            int mod = Math.Clamp(_modificadorDado, -100, 100);
            _qtdDados = qtd;
            _modificadorDado = mod;

            var rolagens = new List<int>(qtd);
            for (int i = 0; i < qtd; i++)
            {
                rolagens.Add(Random.Shared.Next(1, _facesSelecionadas + 1));
            }

            int total = rolagens.Sum() + mod;
            string modExpressao = mod > 0 ? $" + {mod}" : mod < 0 ? $" - {Math.Abs(mod)}" : string.Empty;
            string expressao = $"{qtd}d{_facesSelecionadas}{modExpressao}";
            string modDetalhe = mod > 0 ? $" + {mod}" : mod < 0 ? $" − {Math.Abs(mod)}" : string.Empty;

            _ultimoResultadoDado = new ResultadoRolagemDto
            {
                Contexto = _contextoDado?.Trim() ?? string.Empty,
                Faces = _facesSelecionadas,
                Quantidade = qtd,
                Modificador = mod,
                ResultadosIndividuais = rolagens,
                Total = total,
                Expressao = expressao
            };

            _descricaoDetalhadaDado = $"{expressao} · {string.Join(" + ", rolagens)}{modDetalhe}";

            await ViewModel.RegistrarRolagemAsync(_ultimoResultadoDado);
        }
        finally
        {
            _rolandoDados = false;
        }
    }

    private async Task AoTrocarJogadorModalAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idPersonagem))
        {
            var jogador = ViewModel.Estado.Jogadores.FirstOrDefault(j => j.IdPersonagem == idPersonagem);
            if (jogador != null)
            {
                await ViewModel.AbrirFichaParticipanteAsync(jogador, ViewModel.AbaFichaModalAtiva);
            }
        }
    }

    private int ContarOnline()
    {
        int total = ViewModel.Estado.Mestre.Online ? 1 : 0;
        total += ViewModel.Estado.Jogadores.Count(j => j.Online);
        return total;
    }

    private string ObterIniciaisUsuarioLogado()
    {
        if (ViewModel.Estado.EhMestre)
            return ObterIniciais(ViewModel.Estado.Mestre.Username);

        var eu = ViewModel.Estado.Jogadores.FirstOrDefault(j => j.IdPersonagem == ViewModel.Estado.IdPersonagemLogado);
        return ObterIniciais(eu?.NomePersonagem ?? eu?.Username ?? "J");
    }

    private static string ObterIniciais(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "?";
        var partes = texto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1)
            return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(partes[0][0])}{char.ToUpperInvariant(partes[^1][0])}";
    }

    private static string FormatarMod(int valor)
    {
        int mod = AtributosBase.CalcularModificador(valor);
        return mod >= 0 ? $"+{mod}" : mod.ToString();
    }

    private static string ObterResumoClasses(Personagem personagem)
    {
        if (personagem.PersonagemClasses.Any(pc => pc.Classe != null))
            return string.Join(" / ", personagem.PersonagemClasses.Where(pc => pc.Classe != null).Select(pc => $"{pc.Classe!.Nome} {pc.NivelNaClasse}"));

        return string.IsNullOrWhiteSpace(personagem.ClasseTexto) ? "Classe" : personagem.ClasseTexto;
    }

    private void AoRolarMouseMapa(WheelEventArgs e)
    {
        if (!e.CtrlKey) return;

        if (e.DeltaY < 0)
            ViewModel.AumentarZoom();
        else if (e.DeltaY > 0)
            ViewModel.DiminuirZoom();
    }

    public async ValueTask DisposeAsync()
    {
        ViewModel.OnChange -= AtualizarUi;
        await ViewModel.DisposeAsync();
    }
}