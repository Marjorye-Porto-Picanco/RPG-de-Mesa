@page "/sessao/{IdCampanha:int}"
@page "/sessao/{IdCampanha:int}/{IdPersonagem:int}"
@using RPGdeMesa.Application.Services
@using RPGdeMesa.Presentation.ViewModel
@using RPGdeMesa.Presentation.Components.Layout
@inject SessaoViewModel ViewModel
@implements IAsyncDisposable

@if (ViewModel.Carregando)
{
    <div class="sala-jogo sala-estado">
        <p>Preparando a mesa da sessão...</p>
    </div>
}
else if (ViewModel.SessaoEncerradaPeloMestre)
{
    <div class="sala-jogo sala-estado">
        <h2>Sessão finalizada pelo Mestre</h2>
        <p>O Mestre encerrou a mesa e está revisando as fichas e distribuindo o XP da aventura. Volte para a tela da campanha para conferir sua ficha atualizada.</p>
        <div class="estado-acoes">
            <button type="button" class="game-finish" @onclick="ViewModel.VoltarParaPreparacaoCampanha">
                Ver minha ficha na campanha
            </button>
            <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
                Voltar para campanhas
            </button>
        </div>
    </div>
}
else if (ViewModel.ModoRevisaoPosSessao)
{
    <SessaoRevisaoPosSessao ViewModel="ViewModel" />
}
else if (!string.IsNullOrWhiteSpace(ViewModel.ErroCarregamento))
{
    <div class="sala-jogo sala-estado">
        <h2>Não foi possível abrir a sessão</h2>
        <p>@ViewModel.ErroCarregamento</p>
        <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
            Voltar para campanhas
        </button>
    </div>
}
else
{
    <div class="sala-jogo @(ViewModel.PinoArrastando != null ? "em-arraste-pino" : "")"
         @onpointerup="ViewModel.FinalizarArrastePino">
        <header class="game-header">
            <button type="button"
                    class="game-home"
                    aria-label="Voltar às campanhas"
                    title="Voltar às campanhas"
                    @onclick="ViewModel.SairDaSessaoENavegarAsync">
                ←
            </button>

            <div class="game-heading">
                <p>@(ViewModel.Estado.EhMestre ? "Mesa do Mestre" : "Sessão em andamento")</p>
                <h1>@ViewModel.Estado.NomeCampanha</h1>
            </div>

            <div class="game-presence">
                <span class="presence-light"></span>
                Mesa aberta
                <span class="presence-divider">·</span>
                @ContarOnline() @(ContarOnline() == 1 ? "conectado" : "conectados")
            </div>

            @if (ViewModel.Estado.EhMestre)
            {
                <button type="button"
                        class="game-finish"
                        disabled="@ViewModel.FinalizandoSessao"
                        @onclick="ViewModel.FinalizarSessaoAsync">
                    @(ViewModel.FinalizandoSessao ? "Finalizando..." : "Finalizar sessão")
                </button>
            }

            <button type="button" class="game-exit" @onclick="ViewModel.SairDaSessaoENavegarAsync">
                Sair da mesa
            </button>
        </header>

        <div class="game-layout">
            <!-- BARRA LATERAL DE FERRAMENTAS -->
            <aside class="game-toolbar" aria-label="Ferramentas da mesa">
                <button class="toolbar-user @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva != "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Visualizar Ficha"
                        aria-label="Visualizar Ficha"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("atributos")'>
                    <span class="toolbar-avatar">@ObterIniciaisUsuarioLogado()</span>
                </button>

                <button class="toolbar-dice @(ViewModel.ExibirModalDados ? "selecionada" : "")"
                        type="button"
                        title="Rolar dados"
                        aria-label="Abrir dados para rolar"
                        @onclick="ViewModel.AbrirModalDados">
                    <span aria-hidden="true">⚄</span>
                </button>

                <span class="toolbar-separator" aria-hidden="true"></span>

                @if (ViewModel.Estado.EhMestre)
                {
                    <button class="toolbar-tool @(ViewModel.ExibirPainelPinos ? "selecionada" : "")"
                            type="button"
                            title="Administrar Pinos no Mapa (Jogadores, NPCs e Monstros)"
                            aria-label="Administrar pinos no mapa"
                            @onclick="ViewModel.AlternarPainelPinos">
                        <span aria-hidden="true">▦</span>
                    </button>
                }

                <button class="toolbar-tool @(ViewModel.ExibirModalAtaque ? "selecionada" : "")"
                        type="button"
                        disabled="@(!ViewModel.EhMeuTurno)"
                        title="@(ViewModel.Estado.EhMestre ? "Ação exclusiva de jogadores no turno" : (ViewModel.EhMeuTurno ? "Atacar alvo no mapa" : "Aguarde o Mestre liberar seu turno"))"
                        aria-label="Abrir ataque"
                        @onclick="ViewModel.AbrirModalAtaqueAsync">
                    <span aria-hidden="true">⚔</span>
                </button>

                <button class="toolbar-tool @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva != "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Ficha do Personagem"
                        aria-label="Abrir ficha do personagem"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("atributos")'>
                    <span aria-hidden="true">▤</span>
                </button>

                <button class="toolbar-tool @(ViewModel.ExibirModalFicha && ViewModel.AbaFichaModalAtiva == "inventario" ? "selecionada" : "")"
                        type="button"
                        title="Inventário"
                        aria-label="Abrir inventário"
                        @onclick='() => ViewModel.AbrirFichaPropriaAsync("inventario")'>
                    <span aria-hidden="true">◇</span>
                </button>

                <span class="toolbar-spacer"></span>

                <button class="toolbar-tool @(_mostrarCoordenadas ? "selecionada" : "")"
                        type="button"
                        title="Alternar coordenadas da grade 20×20"
                        aria-label="Alternar coordenadas da grade"
                        aria-pressed="@_mostrarCoordenadas.ToString().ToLowerInvariant()"
                        @onclick="AlternarCoordenadas">
                    <span aria-hidden="true">▧</span>
                </button>
            </aside>

            <!-- ÁREA PRINCIPAL: MAPA + CONSOLE -->
            <main class="game-main">
                <SessaoMapa ViewModel="ViewModel" MostrarCoordenadas="_mostrarCoordenadas" />

                <section class="game-console">
                    <SessaoChat ViewModel="ViewModel" />
                    <SessaoAcoes ViewModel="ViewModel" />
                </section>
            </main>

            <!-- PAINEL LATERAL DIREITO: MESTRE E JOGADORES -->
            <aside class="players-panel" aria-labelledby="jogadores-titulo">
                <div class="players-heading">
                    <div>
                        <p class="panel-kicker">Na mesa</p>
                        <h2 id="jogadores-titulo">Jogadores</h2>
                    </div>
                    <span class="players-count">@ContarOnline()</span>
                </div>

                <div class="players-list">
                    @{
                        var mestre = ViewModel.Estado.Mestre;
                    }
                    <article class="player-card mestre-card @(mestre.Online ? "online-card" : "offline-card")">
                        <span class="player-avatar avatar-mestre">
                            @if (!string.IsNullOrWhiteSpace(mestre.AvatarUrl))
                            {
                                <img src="@mestre.AvatarUrl" alt="@mestre.Username" />
                            }
                            else
                            {
                                @ObterIniciais(mestre.Username)
                            }
                        </span>
                        <div class="player-info">
                            <strong>@mestre.Username</strong>
                            <span class="player-class">Mestre</span>
                        </div>
                        <span class="mic-status @(mestre.Online ? "" : "desconectado")"
                              title="@(mestre.Online ? "Conectado" : "Fora da sessão")"
                              aria-label="@(mestre.Online ? "Conectado" : "Fora da sessão")">●</span>
                    </article>

                    <div class="players-divider" aria-hidden="true"></div>

                    @foreach (var jogador in ViewModel.Estado.Jogadores)
                    {
                        bool podeAbrirFicha = jogador.IdPersonagem.HasValue
                            && (ViewModel.Estado.EhMestre || jogador.IdPersonagem == ViewModel.Estado.IdPersonagemLogado);
                        bool estaNoTurno = ViewModel.Estado.IdAccountTurno == jogador.IdAccount;

                        <article @key="jogador.IdAccount"
                                 class="player-card @(jogador.Online ? "online-card" : "offline-card") @(podeAbrirFicha ? "clicavel" : "") @(estaNoTurno ? "em-turno" : "")"
                                 title="@(podeAbrirFicha ? "Clique para ver ficha e inventário" : jogador.Username)"
                                 @onclick="() => ViewModel.AbrirFichaParticipanteAsync(jogador)">
                            <span class="player-avatar">
                                @if (!string.IsNullOrWhiteSpace(jogador.AvatarUrl))
                                {
                                    <img src="@jogador.AvatarUrl" alt="@jogador.Username" />
                                }
                                else
                                {
                                    @ObterIniciais(jogador.Username)
                                }
                            </span>
                            <div class="player-info">
                                <strong>@jogador.Username</strong>
                                <span class="player-sheet">@jogador.SubtituloLinha1</span>
                                @if (!string.IsNullOrWhiteSpace(jogador.SubtituloLinha2))
                                {
                                    <span class="player-class">@jogador.SubtituloLinha2</span>
                                }
                                @if (estaNoTurno)
                                {
                                    <span class="turno-badge">⚔ Em turno</span>
                                }
                                @if (jogador.Esquivando)
                                {
                                    <span class="turno-badge">◈ Esquivando</span>
                                }
                                @if (jogador.Escondido && (ViewModel.Estado.EhMestre || jogador.IdPersonagem == ViewModel.Estado.IdPersonagemLogado))
                                {
                                    <span class="turno-badge">🥷 Furtivo</span>
                                }
                                @if (ViewModel.Estado.EhMestre && jogador.IdPersonagem.HasValue)
                                {
                                    <button type="button"
                                            class="btn-turno-mestre @(estaNoTurno ? "encerrar" : "")"
                                            disabled="@ViewModel.AlterandoTurno"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ViewModel.AlternarTurnoJogadorAsync(jogador)">
                                        @(estaNoTurno ? "🔒 Encerrar turno" : "▶ Liberar turno")
                                    </button>
                                }
                            </div>
                            <span class="mic-status @(jogador.Online ? "" : "desconectado")"
                                  title="@(jogador.Online ? "Conectado" : "Fora da sessão")"
                                  aria-label="@(jogador.Online ? "Conectado" : "Fora da sessão")">●</span>
                        </article>
                    }
                </div>

                <div class="players-footer">
                    <span class="presence-light"></span>
                    <span>@ContarOnline() / @(ViewModel.Estado.Jogadores.Count + 1) conectados</span>
                    @if (ViewModel.Estado.EhMestre && ViewModel.Estado.IdAccountTurno.HasValue)
                    {
                        <button type="button"
                                class="btn-bloquear-turno-footer"
                                title="Bloquear turno atual"
                                disabled="@ViewModel.AlterandoTurno"
                                @onclick="ViewModel.EncerrarTurnoAtualAsync">
                            🔒
                        </button>
                    }
                </div>
            </aside>
        </div>
    </div>

    <!-- MODAIS IMPORTADOS -->
    <SessaoModalEntidade ViewModel="ViewModel" />
    <SessaoModalFicha ViewModel="ViewModel" />

    <!-- MODAL DE DADOS -->
    @if (ViewModel.ExibirModalDados)
    {
        <div class="sessao-modal-backdrop" @onclick="ViewModel.FecharModalDados"></div>

        <section class="dice-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-dados" @onclick:stopPropagation="true">
            <header class="dice-popup-header">
                <div>
                    <p>Rolagem individual</p>
                    <h2 id="titulo-dados">Rolar dados</h2>
                </div>
                <button class="dice-close" type="button" aria-label="Fechar rolagem" @onclick="ViewModel.FecharModalDados">×</button>
            </header>

            <form @onsubmit="RolarDadosAsync" @onsubmit:preventDefault="true">
                <section class="dice-selection">
                    <p class="dice-section-label">Escolha o dado</p>
                    <div class="dice-faces" role="group" aria-label="Tipo de dado">
                        @foreach (var face in _facesPadrao)
                        {
                            bool selecionado = _facesSelecionadas == face;
                            <button class="dice-face @(selecionado ? "selecionado" : "")"
                                    type="button"
                                    aria-pressed="@selecionado.ToString().ToLowerInvariant()"
                                    @onclick="() => _facesSelecionadas = face">
                                @($"d{face}")
                            </button>
                        }
                    </div>
                </section>

                <div class="dice-options">
                    <label class="dice-field">
                        Quantidade
                        <input type="number" min="1" max="20" @bind="_qtdDados" />
                    </label>
                    <label class="dice-field">
                        Modificador
                        <input type="number" min="-100" max="100" @bind="_modificadorDado" />
                    </label>
                </div>

                <label class="dice-field" style="margin-top: 10px;">
                    Descrição / Teste (opcional)
                    <input type="text" maxlength="60" placeholder="Ex.: Ataque, Percepção, Iniciativa..." @bind="_contextoDado" />
                </label>

                <button class="dice-roll" type="submit" disabled="@_rolandoDados">
                    <span aria-hidden="true">⚄</span> @(_rolandoDados ? "Rolando..." : "Rolar e enviar no Chat")
                </button>
            </form>

            @if (_ultimoResultadoDado != null)
            {
                <section class="dice-result" aria-live="polite">
                    <p class="dice-result-label">Resultado total</p>
                    <strong class="dice-total">@_ultimoResultadoDado.Total</strong>
                    <p class="dice-expression">@_descricaoDetalhadaDado</p>
                    <div class="dice-breakdown" aria-label="Resultados individuais">
                        @foreach (var valor in _ultimoResultadoDado.ResultadosIndividuais)
                        {
                            <span>@valor</span>
                        }
                        @if (_ultimoResultadoDado.Modificador != 0)
                        {
                            <span class="modifier-result">
                                @(_ultimoResultadoDado.Modificador > 0 ? $"+{_ultimoResultadoDado.Modificador}" : $"−{Math.Abs(_ultimoResultadoDado.Modificador)}")
                            </span>
                        }
                    </div>
                </section>
            }

            <p class="dice-popup-footer">O resultado é enviado automaticamente no Chat da sessão.</p>
        </section>
    }
}

@code {
    [Parameter]
    public int IdCampanha { get; set; }

    [Parameter]
    public int? IdPersonagem { get; set; }

    private int _ultimoIdCampanha = -1;
    private int? _ultimoIdPersonagem;
    private bool _mostrarCoordenadas = true;

    private readonly int[] _facesPadrao = [4, 6, 8, 10, 12, 20, 100];
    private int _facesSelecionadas = 20;
    private int _qtdDados = 1;
    private int _modificadorDado = 0;
    private string _contextoDado = string.Empty;
    private bool _rolandoDados = false;
    private ResultadoRolagemDto? _ultimoResultadoDado;
    private string _descricaoDetalhadaDado = string.Empty;

    protected override void OnInitialized()
    {
        ViewModel.OnChange += AtualizarUi;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IdCampanha != _ultimoIdCampanha || IdPersonagem != _ultimoIdPersonagem)
        {
            _ultimoIdCampanha = IdCampanha;
            _ultimoIdPersonagem = IdPersonagem;
            await ViewModel.InicializarAsync(IdCampanha, IdPersonagem);
        }
    }

    private void AtualizarUi()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void AlternarCoordenadas()
    {
        _mostrarCoordenadas = !_mostrarCoordenadas;
    }

    private async Task RolarDadosAsync()
    {
        if (_rolandoDados) return;
        _rolandoDados = true;
        try
        {
            int qtd = Math.Clamp(_qtdDados, 1, 20);
            int mod = Math.Clamp(_modificadorDado, -100, 100);
            _qtdDados = qtd;
            _modificadorDado = mod;

            var rolagens = new List<int>(qtd);
            for (int i = 0; i < qtd; i++)
            {
                rolagens.Add(Random.Shared.Next(1, _facesSelecionadas + 1));
            }

            int total = rolagens.Sum() + mod;
            string modExpressao = mod > 0 ? $" + {mod}" : mod < 0 ? $" - {Math.Abs(mod)}" : string.Empty;
            string expressao = $"{qtd}d{_facesSelecionadas}{modExpressao}";
            string modDetalhe = mod > 0 ? $" + {mod}" : mod < 0 ? $" − {Math.Abs(mod)}" : string.Empty;

            _ultimoResultadoDado = new ResultadoRolagemDto
            {
                Contexto = _contextoDado?.Trim() ?? string.Empty,
                Faces = _facesSelecionadas,
                Quantidade = qtd,
                Modificador = mod,
                ResultadosIndividuais = rolagens,
                Total = total,
                Expressao = expressao
            };

            _descricaoDetalhadaDado = $"{expressao} · {string.Join(" + ", rolagens)}{modDetalhe}";

            await ViewModel.RegistrarRolagemAsync(_ultimoResultadoDado);
        }
        finally
        {
            _rolandoDados = false;
        }
    }

    private int ContarOnline()
    {
        int total = ViewModel.Estado.Mestre.Online ? 1 : 0;
        total += ViewModel.Estado.Jogadores.Count(j => j.Online);
        return total;
    }

    private string ObterIniciaisUsuarioLogado()
    {
        if (ViewModel.Estado.EhMestre)
            return ObterIniciais(ViewModel.Estado.Mestre.Username);

        var eu = ViewModel.Estado.Jogadores.FirstOrDefault(j => j.IdPersonagem == ViewModel.Estado.IdPersonagemLogado);
        return ObterIniciais(eu?.NomePersonagem ?? eu?.Username ?? "J");
    }

    private static string ObterIniciais(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "?";
        var partes = texto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1)
            return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(partes[0][0])}{char.ToUpperInvariant(partes[^1][0])}";
    }

    public async ValueTask DisposeAsync()
    {
        ViewModel.OnChange -= AtualizarUi;
        await ViewModel.DisposeAsync();
    }
}