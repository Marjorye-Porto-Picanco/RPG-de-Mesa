                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha electrum">PE</span><input type="number" min="0" @bind="MoedasPE" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha ouro">PO</span><input type="number" min="0" @bind="MoedasPO" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha platina">PL</span><input type="number" min="0" @bind="MoedasPL" /></label>
                                                </div>
                                            </section>

                                            <section class="painel-carga-campanha">
                                                <h4>Capacidade de Carga</h4>
                                                <p style="text-align:center; margin:0 0 8px; font-size:12px;">
                                                    <strong>@PesoTotalEdicao.ToString("0.0") kg</strong> / @CapacidadeCargaMaximaEdicao.ToString("0.0") kg
                                                </p>
                                                <progress max="@((double)CapacidadeCargaMaximaEdicao)" value="@((double)Math.Min(PesoTotalEdicao, CapacidadeCargaMaximaEdicao))"></progress>
                                            </section>

                                            <div class="notas-inventario-campanha">
                                                <h4>Notas do Inventário</h4>
                                                <textarea rows="3" @bind="NotasInventario" placeholder="Anote detalhes dos equipamentos escolhidos..."></textarea>
                                            </div>
                                        </aside>
                                    </div>
                                }
                            </div>
                        }

                        <p class="join-status @(TemErro ? "erro" : "")" role="status" aria-live="polite">@Mensagem</p>

                        <div class="join-actions">
                            @if (VinculosDoJogador.Any())
                            {
                                <button class="action-secondary" type="button" @onclick="CancelarModoEdicaoOuAdicao">
                                    ← Cancelar e voltar para minhas fichas
                                </button>
                            }
                            else
                            {
                                <button class="action-secondary" type="button" @onclick="VoltarParaHome">Voltar</button>
                            }

                            <button class="action-primary" type="submit" disabled="@(Carregando || PersonagemEmPreparacao == null)">
                                @(Carregando ? "Salvando e enviando..." : (ModoReenviarRecusada ? "Salvar Ajustes na Ficha e Reenviar ao Mestre →" : "Vincular Inventário e Enviar Ficha ao Mestre →"))
                            </button>
                        </div>
                    </form>
                }
            </section>
        }
        else if (EtapaAtual == 2)
        {
            <!-- =========================================================================
                 ETAPA 2: ESCOLHER ENTRE AS FICHAS ACEITAS (EXIBE INVENTÁRIO) E CONECTAR
                 ========================================================================= -->
            <section class="join-step join-card" id="etapa-confirmacao" aria-labelledby="titulo-confirmacao">
                <p class="page-kicker">Etapa 2 · Sala de Jogo</p>
                <h2 id="titulo-confirmacao">Conectar na Sessão</h2>
                <p class="join-session-name">Campanha: <strong>@(CampanhaAtual.Nome)</strong></p>

                @if (FichasAceitasDoJogador.Count > 1)
                {
                    <fieldset class="character-picker" style="margin-bottom: 18px;">
                        <legend>Você possui <strong>@FichasAceitasDoJogador.Count fichas aceitas</strong> nesta campanha. Escolha com qual vai jogar agora:</legend>
                        <div class="character-options">
                            @foreach (var vinculoAceito in FichasAceitasDoJogador)
                            {
                                var p = vinculoAceito.Personagem!;
                                bool selecionada = VinculoSelecionado?.IdPersonagem == p.IdPersonagem;
                                <label class="character-option @(selecionada ? "selecionado" : "")" @onclick="() => SelecionarVinculoExistenteAsync(vinculoAceito)">
                                    <input type="radio"
                                           name="ficha-conectar"
                                           checked="@selecionada"
                                           @onchange="() => SelecionarVinculoExistenteAsync(vinculoAceito)" />
                                    <span class="character-option-copy">
                                        <strong>@p.Nome</strong>
                                        <small>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <dl class="join-review">
                    <div>
                        <dt>Personagem Escolhido</dt>
                        <dd>@(FichaCompletaVinculada?.Nome ?? "Nenhuma ficha selecionada")</dd>
                    </div>
                    <div>
                        <dt>Raça & Classe</dt>
                        <dd>@(FichaCompletaVinculada != null ? $"{FichaCompletaVinculada.RacaTexto} · {FichaCompletaVinculada.ClasseTexto} (Nv. {FichaCompletaVinculada.Nivel})" : "—")</dd>
                    </div>
                    <div>
                        <dt>Status de Aprovação</dt>
                        <dd>
                            @if (StatusFichaAtual == "Aceita")
                            {
                                <strong style="color: #78be82;">✓ Aceita pelo Mestre</strong>
                            }
                            else if (StatusFichaAtual == "Pendente")
                            {
                                <strong style="color: #e6c665;">⏳ Aguardando Mestre</strong>
                            }
                            else if (StatusFichaAtual == "Recusada")
                            {
                                <strong style="color: #e88d8d;">✕ Recusada pelo Mestre</strong>
                            }
                            else
                            {
                                <span>Não enviada</span>
                            }
                        </dd>
                    </div>
                </dl>

                <!-- EXIBE O INVENTÁRIO VINCULADO DO PERSONAGEM NA ETAPA DE CONECTAR -->
                @if (FichaCompletaVinculada?.Inventario != null)
                {
                    <div class="ficha-preview-pergaminho" style="margin-top: 16px;">
                        <h4 style="margin: 0 0 10px; color: #392819; font-size: 14px; text-transform: uppercase;">
                            🎒 Inventário de @FichaCompletaVinculada.Nome na Sessão (Carga: @(FichaCompletaVinculada.Inventario.PesoAtual ?? 0) kg / @(FichaCompletaVinculada.Inventario.CapacidadeCarga ?? 0) kg)
                        </h4>
                        <div class="dados-fisicos-grid" style="margin-bottom: 10px;">
                            <div><span>PC</span><strong>@FichaCompletaVinculada.Inventario.MoedasPC</strong></div>
                            <div><span>PP</span><strong>@FichaCompletaVinculada.Inventario.MoedasPP</strong></div>
                            <div><span>PE</span><strong>@FichaCompletaVinculada.Inventario.MoedasPE</strong></div>
                            <div><span>PO</span><strong>@FichaCompletaVinculada.Inventario.MoedasPO</strong></div>
                            <div><span>PL</span><strong>@FichaCompletaVinculada.Inventario.MoedasPL</strong></div>
                        </div>

                        @if (FichaCompletaVinculada.Inventario.Itens != null && FichaCompletaVinculada.Inventario.Itens.Any())
                        {
                            <ul class="lista-itens-preview">
                                @foreach (var ii in FichaCompletaVinculada.Inventario.Itens)
                                {
                                    <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> <span>(@(ii.Item?.Tipo ?? "Geral") · @(ii.Item?.Peso ?? 0) kg)</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="margin:0; font-size:12px;">Nenhum item equipado.</p>
                        }
                    </div>
                }

                @if (StatusFichaAtual != "Aceita")
                {
                    <div class="ficha-alert pendente" style="margin-top: 16px;">
                        Para entrar na sala de jogo, selecione uma ficha que esteja <strong>Aceita pelo Mestre</strong> (na Etapa 1) ou clique em "Atualizar Status".
                    </div>
                }

                <p class="join-status @(TemErro ? "erro" : "")" role="status" aria-live="polite">@Mensagem</p>

                <div class="join-actions">
                    <button class="action-secondary" type="button" disabled="@Carregando" @onclick="() => IrParaEtapa(1)">
                        ← Voltar para Fichas (Etapa 1)
                    </button>
                    <div style="display: flex; gap: 10px;">
                        <button class="action-secondary" type="button" disabled="@Carregando" @onclick="RecarregarStatusAsync">
                            ↻ Atualizar Status
                        </button>
                        <button class="action-primary"
                                type="button"
                                disabled="@(Carregando || StatusFichaAtual != "Aceita")"
                                @onclick="ConectarNaSala">
                            @(Carregando ? "Conectando..." : $"Conectar com {(FichaCompletaVinculada?.Nome ?? "Ficha")} →")
                        </button>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    [SupplyParameterFromQuery(Name = "campanhaId")]
    public int? CampanhaIdQuery { get; set; }

    private int EtapaAtual { get; set; } = 1;
    private string Mensagem { get; set; } = string.Empty;
    private bool TemErro { get; set; }
    private bool Carregando { get; set; }
    private bool ModoAdicionarNovaFicha { get; set; }
    private bool ModoReenviarRecusada { get; set; }

    private Campanha? CampanhaAtual { get; set; }
    private List<Personagem> PersonagensDisponiveis { get; set; } = new();
    private List<PersonagemCampanha> VinculosDoJogador { get; set; } = new();

    private List<Item> ItensDaCampanha =>
        CampanhaAtual?.Itens.OrderBy(i => i.Nome).ToList() ?? new List<Item>();

    private List<PersonagemCampanha> FichasAceitasDoJogador =>
        VinculosDoJogador
            .Where(v => string.IsNullOrEmpty(v.StatusAprovacao) ||
                        v.StatusAprovacao.Equals("Aceita", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private bool PossuiAlgumaFichaAceita => FichasAceitasDoJogador.Any();

    private List<Personagem> PersonagensNaoEnviados =>
        PersonagensDisponiveis
            .Where(p => !VinculosDoJogador.Any(v =>
                v.IdPersonagem == p.IdPersonagem ||
                (v.Personagem != null && v.Personagem.IdPersonagemOrigem == p.IdPersonagem)))
            .ToList();

    private PersonagemCampanha? VinculoSelecionado { get; set; }
    private Personagem? FichaCompletaVinculada { get; set; }
    private int NovoPersonagemParaEnviarId { get; set; }
    private Personagem? PersonagemEmPreparacao { get; set; }
    private string StatusFichaAtual => VinculoSelecionado?.StatusAprovacao ?? string.Empty;
    private string AbaFichaPreview { get; set; } = "atributos";
    private string AbaEdicaoRecusada { get; set; } = "atributos";

    private readonly string[] ListaOpcoesClasses =
    {
        "Bárbaro", "Bardo", "Bruxo", "Clérigo", "Druida", "Feiticeiro",
        "Guerreiro", "Ladino", "Mago", "Monge", "Paladino", "Patrulheiro", "Outra"
    };

    private readonly string[] ListaSalvaguardas =
    {
        "Força", "Destreza", "Constituição", "Inteligência", "Sabedoria", "Carisma"
    };

    private readonly string[] ListaPericias =
    {
        "Acrobacia", "Adestrar Animais", "Arcanismo", "Atletismo", "Atuação", "Enganação",
        "Furtividade", "História", "Intimidação", "Intuição", "Investigação", "Medicina",
        "Natureza", "Percepção", "Persuasão", "Prestidigitação", "Religião", "Sobrevivência"
    };

    private List<ClasseCampanhaEntry> ClassesEdicao { get; set; } = new();
    private HashSet<string> SalvaguardasEdicao { get; set; } = new();
    private HashSet<string> PericiasEdicao { get; set; } = new();
    private List<MagiaCampanhaEntry> MagiasEdicao { get; set; } = new();

    private List<ItemInventarioVinculado> ItensInventarioEdicao { get; set; } = new();
    private int MoedasPC { get; set; } = 0;
    private int MoedasPP { get; set; } = 0;
    private int MoedasPE { get; set; } = 0;
    private int MoedasPO { get; set; } = 10;
    private int MoedasPL { get; set; } = 0;
    private string NotasInventario { get; set; } = string.Empty;

    private decimal PesoTotalEdicao =>
        ItensInventarioEdicao.Where(i => i.IdItem > 0).Sum(i => i.PesoUnitario * Math.Max(1, i.Quantidade));

    private decimal CapacidadeCargaMaximaEdicao =>
        Math.Round(Math.Max(1, PersonagemEmPreparacao?.Forca ?? 10) * 7.5m, 1);

    protected override async Task OnParametersSetAsync()
    {
        if (!SessaoUsuario.EstaLogado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CarregarContextoJogadorAsync();
    }

    private async Task CarregarContextoJogadorAsync()
    {
        Carregando = true;
        LimparMensagem();
        try
        {
            int idUsuario = SessaoUsuario.IdUsuarioLogado;
            PersonagensDisponiveis = await PersonagemService.ObterPersonagensPorUsuarioAsync(idUsuario);

            int idAlvo = IdCampanha > 0 ? IdCampanha : (CampanhaIdQuery ?? 0);
            if (idAlvo <= 0)
            {
                var campanhasDoJogador = await CampanhaService.ObterCampanhasComoJogadorAsync(idUsuario);
                if (campanhasDoJogador.Any())
                    idAlvo = campanhasDoJogador[0].IdCampanha;
            }

            if (idAlvo > 0)
            {
                CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(idAlvo);
                await SincronizarVinculosDoJogadorAsync();
            }
        }
        catch (Exception ex)
        {
            DefinirErro($"Erro ao carregar dados da sessão: {ex.Message}");
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task SincronizarVinculosDoJogadorAsync(int? idPersonagemPreferencial = null)
    {
        VinculosDoJogador.Clear();
        VinculoSelecionado = null;
        FichaCompletaVinculada = null;

        if (CampanhaAtual is null) return;

        int idUsuario = SessaoUsuario.IdUsuarioLogado;
        VinculosDoJogador = CampanhaAtual.PersonagemCampanhas
            .Where(pc => pc.Personagem != null && pc.Personagem.IdAccount == idUsuario)
            .OrderByDescending(pc => pc.StatusAprovacao == "Aceita")
            .ThenByDescending(pc => pc.StatusAprovacao == "Pendente")
            .ToList();

        if (VinculosDoJogador.Any())
        {
            var escolhido = (idPersonagemPreferencial.HasValue
                ? VinculosDoJogador.FirstOrDefault(v => v.IdPersonagem == idPersonagemPreferencial.Value)
                : null)
                ?? FichasAceitasDoJogador.FirstOrDefault()
                ?? VinculosDoJogador.First();

            await CarregarVinculoSelecionadoInternoAsync(escolhido);
        }
        else if (PersonagensNaoEnviados.Count == 1)
        {
            await AoEscolherPersonagemParaEnviarAsync(PersonagensNaoEnviados[0].IdPersonagem);
        }
    }

    private async Task SelecionarVinculoExistenteAsync(PersonagemCampanha vinculo)
    {
        if (Carregando) return;
        Carregando = true;
        try
        {
            await CarregarVinculoSelecionadoInternoAsync(vinculo);
        }
        finally
        {
            Carregando = false;
            StateHasChanged();
        }
    }

    private async Task CarregarVinculoSelecionadoInternoAsync(PersonagemCampanha vinculo)
    {
        VinculoSelecionado = vinculo;
        FichaCompletaVinculada = await PersonagemService.ObterPorIdAsync(vinculo.IdPersonagem) ?? vinculo.Personagem;
    }

    private async Task AoEscolherPersonagemParaEnviarAsync(int idPersonagem)
    {
        NovoPersonagemParaEnviarId = idPersonagem;
        PersonagemEmPreparacao = await PersonagemService.ObterPorIdAsync(idPersonagem)
                                 ?? PersonagensDisponiveis.FirstOrDefault(p => p.IdPersonagem == idPersonagem);
        PreencherEditorCompletoComDadosDoPersonagem(PersonagemEmPreparacao);
    }

    private void PreencherEditorCompletoComDadosDoPersonagem(Personagem? p)
    {
        ClassesEdicao.Clear();
        SalvaguardasEdicao.Clear();
        PericiasEdicao.Clear();
        MagiasEdicao.Clear();
        ItensInventarioEdicao.Clear();

        MoedasPC = 0;
        MoedasPP = 0;
        MoedasPE = 0;
        MoedasPO = 10;
        MoedasPL = 0;
        NotasInventario = string.Empty;

        if (p == null) return;

        if (p.PersonagemClasses != null && p.PersonagemClasses.Any())
        {
            foreach (var pc in p.PersonagemClasses)
            {
                if (pc.Classe != null)
                {
                    ClassesEdicao.Add(new ClasseCampanhaEntry
                    {
                        NomeClasse = pc.Classe.Nome,
                        Nivel = pc.NivelNaClasse
                    });
                }
            }
        }

        if (!ClassesEdicao.Any())
        {
            ClassesEdicao.Add(new ClasseCampanhaEntry
            {
                NomeClasse = string.IsNullOrWhiteSpace(p.ClasseTexto) ? "Guerreiro" : p.ClasseTexto.Split('/')[0].Trim(),
                Nivel = Math.Max(1, p.Nivel)
            });
        }

        foreach (var s in p.Salvaguardas)
            SalvaguardasEdicao.Add(s.Atributo);

        foreach (var per in p.Pericias)
            PericiasEdicao.Add(per.NomePericia);

        foreach (var pm in p.PersonagemMagias)
        {
            if (pm.Magia != null)
            {
                MagiasEdicao.Add(new MagiaCampanhaEntry
                {
                    Nome = pm.Magia.Nome,
                    Circulo = pm.Magia.CirculoNivel == 0 ? "Truque" : $"{pm.Magia.CirculoNivel}º Círculo",
                    Efeito = pm.Magia.DanoEfeito ?? string.Empty,
                    AlcanceNotas = pm.Magia.Alcance ?? string.Empty
                });
            }
        }
        if (!MagiasEdicao.Any())
            MagiasEdicao.Add(new MagiaCampanhaEntry());

        if (p.Inventario != null)
        {
            MoedasPC = p.Inventario.MoedasPC;
            MoedasPP = p.Inventario.MoedasPP;
            MoedasPE = p.Inventario.MoedasPE;
            MoedasPO = p.Inventario.MoedasPO;
            MoedasPL = p.Inventario.MoedasPL;
            NotasInventario = p.Inventario.Notas ?? string.Empty;

            var idsPermitidosNaCampanha = ItensDaCampanha.Select(i => i.IdItem).ToHashSet();

            foreach (var ii in p.Inventario.Itens)
            {
                if (!idsPermitidosNaCampanha.Contains(ii.IdItem)) continue;

                var itemRef = ItensDaCampanha.FirstOrDefault(x => x.IdItem == ii.IdItem) ?? ii.Item;
                if (itemRef != null)
                {
                    ItensInventarioEdicao.Add(new ItemInventarioVinculado
                    {
                        Categoria = PersonagemCriarViewModel.ClassificarCategoriaItem(itemRef),
                        IdItem = itemRef.IdItem,
                        Nome = itemRef.Nome,
                        Quantidade = ii.Quantidade,
                        PesoUnitario = itemRef.Peso ?? 0m,
                        PrecoUnitario = itemRef.Preco ?? 0m
                    });
                }
            }
        }
    }

    private async Task AbrirModoEnviarNovaFicha()
    {
        LimparMensagem();
        ModoReenviarRecusada = false;
        ModoAdicionarNovaFicha = true;
        int idInicial = PersonagensNaoEnviados.FirstOrDefault()?.IdPersonagem ?? 0;
        if (idInicial > 0)
            await AoEscolherPersonagemParaEnviarAsync(idInicial);
        else
            PersonagemEmPreparacao = null;
    }

    private async Task AbrirReenvioDeFichaRecusada()
    {
        if (FichaCompletaVinculada == null || StatusFichaAtual != "Recusada") return;
        LimparMensagem();
        ModoAdicionarNovaFicha = false;
        ModoReenviarRecusada = true;
        AbaEdicaoRecusada = "atributos";
        NovoPersonagemParaEnviarId = FichaCompletaVinculada.IdPersonagem;
        PersonagemEmPreparacao = await PersonagemService.ObterPorIdAsync(FichaCompletaVinculada.IdPersonagem) ?? FichaCompletaVinculada;
        PreencherEditorCompletoComDadosDoPersonagem(PersonagemEmPreparacao);
    }

    private void CancelarModoEdicaoOuAdicao()
    {
        ModoAdicionarNovaFicha = false;
        ModoReenviarRecusada = false;
        PersonagemEmPreparacao = null;
        LimparMensagem();
    }

    private void AlternarSalvaguardaEdicao(string atributo, bool marcado)
    {
        if (marcado) SalvaguardasEdicao.Add(atributo);
        else SalvaguardasEdicao.Remove(atributo);
    }

    private void AlternarPericiaEdicao(string pericia, bool marcado)
    {
        if (marcado) PericiasEdicao.Add(pericia);
        else PericiasEdicao.Remove(pericia);
    }

    private void AdicionarClasseEdicao()
    {
        ClassesEdicao.Add(new ClasseCampanhaEntry { NomeClasse = "Guerreiro", Nivel = 1 });
        SincronizarClassesENivelEdicao();
    }

    private void RemoverClasseEdicao(ClasseCampanhaEntry item)
    {
        if (ClassesEdicao.Count > 1)
        {
            ClassesEdicao.Remove(item);
            SincronizarClassesENivelEdicao();
        }
    }

    private void AlterarNomeClasseEdicao(ClasseCampanhaEntry cl, ChangeEventArgs e)
    {
        cl.NomeClasse = e.Value?.ToString() ?? "Guerreiro";
        SincronizarClassesENivelEdicao();
    }

    private void AlterarNivelClasseEdicao(ClasseCampanhaEntry cl, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nv))
        {
            cl.Nivel = Math.Clamp(nv, 1, 20);
            SincronizarClassesENivelEdicao();
        }
    }

    private void SincronizarClassesENivelEdicao()
    {
        if (PersonagemEmPreparacao == null) return;
        var validas = ClassesEdicao.Where(c => !string.IsNullOrWhiteSpace(c.NomeClasse)).ToList();
        if (!validas.Any()) return;

        PersonagemEmPreparacao.Nivel = Math.Clamp(validas.Sum(c => Math.Max(1, c.Nivel)), 1, 20);
        PersonagemEmPreparacao.ClasseTexto = validas.Count == 1
            ? validas[0].NomeClasse
            : string.Join(" / ", validas.Select(c => $"{c.NomeClasse} {c.Nivel}"));
    }

    private void AdicionarMagiaEdicao() => MagiasEdicao.Add(new MagiaCampanhaEntry());
    private void RemoverMagiaEdicao(MagiaCampanhaEntry magia) => MagiasEdicao.Remove(magia);

    private static int ExtrairCirculoMagia(string circuloTexto)
    {
        if (string.IsNullOrWhiteSpace(circuloTexto) || circuloTexto.Contains("Truque", StringComparison.OrdinalIgnoreCase))
            return 0;
        var digito = new string(circuloTexto.Where(char.IsDigit).ToArray());
        return int.TryParse(digito, out int c) ? c : 1;
    }

    private IEnumerable<Item> ObterItensCampanhaPorCategoria(string categoria)
    {
        if (!ItensDaCampanha.Any()) return Enumerable.Empty<Item>();
        var filtrados = ItensDaCampanha.Where(i => PersonagemCriarViewModel.ClassificarCategoriaItem(i) == categoria);
        return filtrados.Any() ? filtrados : ItensDaCampanha;
    }

    private void AdicionarSlotItem(string categoria)
    {
        ItensInventarioEdicao.Add(new ItemInventarioVinculado
        {
            Categoria = categoria,
            Quantidade = 1
        });
    }

    private void AlterarItemSlot(ItemInventarioVinculado slot, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idItem))
        {
            slot.IdItem = idItem;
            var itemCampanha = ItensDaCampanha.FirstOrDefault(i => i.IdItem == idItem);
            if (itemCampanha != null)
            {
                slot.Nome = itemCampanha.Nome;
                slot.PesoUnitario = itemCampanha.Peso ?? 0m;
                slot.PrecoUnitario = itemCampanha.Preco ?? 0m;
            }
            else
            {
                slot.Nome = string.Empty;
                slot.PesoUnitario = 0m;
                slot.PrecoUnitario = 0m;
            }
        }
    }

    private void RemoverSlotItem(ItemInventarioVinculado slot)
    {
        ItensInventarioEdicao.Remove(slot);
    }

    private async Task EnviarFichaComInventarioAoMestreAsync()
    {
        if (CampanhaAtual is null || PersonagemEmPreparacao is null)
        {
            DefinirErro("Selecione um personagem para enviar ao Mestre.");
            return;
        }

        int idBaseOuInstancia = PersonagemEmPreparacao.IdPersonagem;

        var vinculoExistente = VinculosDoJogador.FirstOrDefault(v =>
            v.IdPersonagem == idBaseOuInstancia ||
            (v.Personagem != null && v.Personagem.IdPersonagemOrigem == idBaseOuInstancia));

        if (vinculoExistente != null && !string.Equals(vinculoExistente.StatusAprovacao, "Recusada", StringComparison.OrdinalIgnoreCase))
        {
            DefinirErro("Esta ficha já foi enviada ao Mestre nesta campanha e não pode mais ser editada por aqui.");
            return;
        }

        Carregando = true;
        LimparMensagem();
        try
        {
            var dadosInventario = new Inventario
            {
                CapacidadeCarga = CapacidadeCargaMaximaEdicao,
                PesoAtual = PesoTotalEdicao,
                Dinheiro = MoedasPO,
                MoedasPC = MoedasPC,
                MoedasPP = MoedasPP,
                MoedasPE = MoedasPE,
                MoedasPO = MoedasPO,
                MoedasPL = MoedasPL,
                Notas = NotasInventario
            };

            var listaItens = ItensInventarioEdicao
                .Where(i => i.IdItem > 0)
                .Select(i => (i.IdItem, i.Quantidade))
                .ToList();

            int idInstanciaCampanha;

            if (ModoReenviarRecusada && vinculoExistente != null)
            {
                SincronizarClassesENivelEdicao();
                int modCon = (int)Math.Floor((PersonagemEmPreparacao.Constituicao - 10) / 2.0);
                PersonagemEmPreparacao.PvMaximo = Math.Max(1, (10 + modCon) + ((PersonagemEmPreparacao.Nivel - 1) * Math.Max(1, 6 + modCon)));
                PersonagemEmPreparacao.PvAtual = PersonagemEmPreparacao.PvMaximo;

                var resAtu = await PersonagemService.AtualizarPersonagemAsync(PersonagemEmPreparacao);
                if (!resAtu.Sucesso)
                {
                    DefinirErro(resAtu.Mensagem);
                    return;
                }

                var classesParaSalvar = ClassesEdicao
                    .Where(c => !string.IsNullOrWhiteSpace(c.NomeClasse))
                    .Select(c => (c.NomeClasse.Trim(), Math.Max(1, c.Nivel)))
                    .ToList();

                var magiasParaSalvar = MagiasEdicao
                    .Where(m => !string.IsNullOrWhiteSpace(m.Nome))
                    .Select(m => new Magia
                    {
                        Nome = m.Nome.Trim(),
                        CirculoNivel = ExtrairCirculoMagia(m.Circulo),
                        DanoEfeito = m.Efeito,
                        Alcance = m.AlcanceNotas
                    })
                    .ToList();

                dadosInventario.IdPersonagem = PersonagemEmPreparacao.IdPersonagem;

                var res3Fn = await PersonagemService.SalvarComplementos3FNAsync(
                    PersonagemEmPreparacao.IdPersonagem,
                    classesParaSalvar,
                    SalvaguardasEdicao,
                    PericiasEdicao,
                    dadosInventario,
                    listaItens,
                    magiasParaSalvar);

                if (!res3Fn.Sucesso)
                {
                    DefinirErro(res3Fn.Mensagem);
                    return;
                }

                idInstanciaCampanha = PersonagemEmPreparacao.IdPersonagem;
            }
            else
            {
                var resultadoInstancia = await PersonagemService.InstanciarPersonagemParaCampanhaAsync(
                    idBaseOuInstancia,
                    CampanhaAtual.IdCampanha,
                    dadosInventario,
                    listaItens);

                if (!resultadoInstancia.Sucesso || resultadoInstancia.IdPersonagemInstancia <= 0)
                {
                    DefinirErro(resultadoInstancia.Mensagem);
                    return;
                }

                idInstanciaCampanha = resultadoInstancia.IdPersonagemInstancia;
            }

            var resultado = await CampanhaService.EnviarFichaParaAvaliacaoAsync(CampanhaAtual.IdCampanha, idInstanciaCampanha);
            if (!resultado.Sucesso)
            {
                DefinirErro(resultado.Mensagem);
                return;
            }

            CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(CampanhaAtual.IdCampanha);
            ModoAdicionarNovaFicha = false;
            ModoReenviarRecusada = false;
            PersonagemEmPreparacao = null;
            await SincronizarVinculosDoJogadorAsync(idInstanciaCampanha);
            AbaFichaPreview = "atributos";
            Mensagem = "Ficha e inventário atualizados e enviados para avaliação do Mestre!";
        }
        catch (Exception ex)
        {
            DefinirErro($"Erro ao enviar ficha e inventário: {ex.Message}");
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task RecarregarStatusAsync()
    {
        if (CampanhaAtual is null) return;
        Carregando = true;
        LimparMensagem();
        try
        {
            int? idAtual = VinculoSelecionado?.IdPersonagem;
            CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(CampanhaAtual.IdCampanha);
            await SincronizarVinculosDoJogadorAsync(idAtual);
            Mensagem = StatusFichaAtual == "Aceita"
                ? "Ficha aprovada! Você já pode conectar na sessão."
                : "Status atualizado.";
        }
        finally
        {
            Carregando = false;
        }
    }

    private void ConectarNaSala()
    {
        if (StatusFichaAtual != "Aceita" && FichasAceitasDoJogador.Any())
        {
            VinculoSelecionado = FichasAceitasDoJogador.First();
            FichaCompletaVinculada = VinculoSelecionado.Personagem;
        }

        if (StatusFichaAtual != "Aceita")
        {
            DefinirErro("Selecione uma ficha aprovada pelo Mestre antes de conectar na sessão.");
            return;
        }

        Navigation.NavigateTo("/saladojogo");
    }

    private void IrParaEtapa(int etapa)
    {
        if (etapa == 2 && StatusFichaAtual != "Aceita" && FichasAceitasDoJogador.Any())
        {
            _ = SelecionarVinculoExistenteAsync(FichasAceitasDoJogador.First());
        }

        EtapaAtual = etapa;
        LimparMensagem();
    }

    private static string ObterModificador(int valor)
    {
        var modificador = (int)Math.Floor((valor - 10) / 2.0);
        return modificador >= 0 ? $"+{modificador}" : modificador.ToString();
    }

    private void VoltarParaHome() => Navigation.NavigateTo("/campanhas");
    private void LimparMensagem() { Mensagem = string.Empty; TemErro = false; }
    private void DefinirErro(string mensagem) { TemErro = true; Mensagem = mensagem; }

