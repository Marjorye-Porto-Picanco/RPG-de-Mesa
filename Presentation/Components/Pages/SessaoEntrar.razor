                                            </div>
                                            <div>
                                                <span>Raça (Fixo)</span>
                                                <input type="text" value="@ViewModel.PersonagemEmPreparacao.RacaTexto" readonly disabled style="width:100%; opacity:0.75; background:rgba(0,0,0,0.08); border:1px solid #b59257; border-radius:4px; padding:5px;" />
                                            </div>
                                            <div>
                                                <span>Antecedente (Fixo)</span>
