                                                {
                                                    <div class="item-linha-campanha">
                                                        <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e)">
                                                            <option value="0">Selecione uma arma...</option>
                                                            @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Armas"))
                                                            {
                                                                <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                            }
                                                        </select>
