                                                    <button type="button" class="btn-add-item-campanha" title="Adicionar item da campanha" @onclick='() => ViewModel.AdicionarSlotItem("Outros")'>+</button>
                                                </div>
                                                <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                                @foreach (var slot in ViewModel.ItensInventarioEdicao.Where(i => i.Categoria == "Outros"))
                                                {
                                                    <div class="item-linha-campanha">
                                                        <select value="@slot.IdItem" @onchange="e => ViewModel.AlterarItemSlot(slot, e)">
                                                            <option value="0">Selecione um item...</option>
                                                            @foreach (var itemOpcao in ViewModel.ObterItensCampanhaPorCategoria("Outros"))
                                                            {
                                                                <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                            }
                                                        </select>
                                                        <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                        <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                        <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                        <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => ViewModel.RemoverSlotItem(slot)">×</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <aside class="resumo-inventario-campanha">
                                            <section class="painel-moedas-campanha">
                                                <h4>Moedas Iniciais</h4>
                                                <div class="moedas-grade-campanha">
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha">PC</span><input type="number" min="0" @bind="ViewModel.MoedasPC" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha prata">PP</span><input type="number" min="0" @bind="ViewModel.MoedasPP" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha electrum">PE</span><input type="number" min="0" @bind="ViewModel.MoedasPE" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha ouro">PO</span><input type="number" min="0" @bind="ViewModel.MoedasPO" /></label>
                                                    <label class="moeda-campanha"><span class="icone-moeda-campanha platina">PL</span><input type="number" min="0" @bind="ViewModel.MoedasPL" /></label>
                                                </div>
                                            </section>

                                            <section class="painel-carga-campanha">
                                                <h4>Capacidade de Carga</h4>
                                                <p style="text-align:center; margin:0 0 8px; font-size:12px;">
                                                    <strong>@ViewModel.PesoTotalEdicao.ToString("0.0") kg</strong> / @ViewModel.CapacidadeCargaMaximaEdicao.ToString("0.0") kg
                                                </p>
                                                <progress max="@((double)ViewModel.CapacidadeCargaMaximaEdicao)" value="@((double)Math.Min(ViewModel.PesoTotalEdicao, ViewModel.CapacidadeCargaMaximaEdicao))"></progress>
                                            </section>

                                            <div class="notas-inventario-campanha">
                                                <h4>Notas do Inventário</h4>
                                                <textarea rows="3" @bind="ViewModel.NotasInventario" placeholder="Anote detalhes dos equipamentos escolhidos..."></textarea>
                                            </div>
                                        </aside>
                                    </div>
                                }
                            </div>
                        }

                        <p class="join-status @(ViewModel.TemErro ? "erro" : "")" role="status" aria-live="polite">@ViewModel.Mensagem</p>

                        <div class="join-actions">
                            @if (ViewModel.VinculosDoJogador.Any())
                            {
                                <button class="action-secondary" type="button" @onclick="ViewModel.CancelarModoEdicaoOuAdicao">
                                    ← Cancelar e voltar para minhas fichas
                                </button>
                            }
                            else
                            {
                                <button class="action-secondary" type="button" @onclick="ViewModel.VoltarParaHome">Voltar</button>
                            }

                            <button class="action-primary" type="submit" disabled="@(ViewModel.Carregando || ViewModel.PersonagemEmPreparacao == null)">
                                @(ViewModel.Carregando ? "Salvando e enviando..." : (ViewModel.ModoReenviarRecusada ? "Salvar Ajustes na Ficha e Reenviar ao Mestre →" : "Vincular Inventário e Enviar Ficha ao Mestre →"))
                            </button>
                        </div>
                    </form>
                }
            </section>
        }
        else if (ViewModel.EtapaAtual == 2)
        {
            <!-- =========================================================================
                 ETAPA 2: ESCOLHER ENTRE AS FICHAS ACEITAS (EXIBE INVENTÁRIO) E CONECTAR
                 ========================================================================= -->
            <section class="join-step join-card" id="etapa-confirmacao" aria-labelledby="titulo-confirmacao">
                <p class="page-kicker">Etapa 2 · Sala de Jogo</p>
                <h2 id="titulo-confirmacao">Conectar na Sessão</h2>
                <p class="join-session-name">Campanha: <strong>@(ViewModel.CampanhaAtual.Nome)</strong></p>

                @if (ViewModel.FichasAceitasDoJogador.Count > 1)
                {
                    <fieldset class="character-picker" style="margin-bottom: 18px;">
                        <legend>Você possui <strong>@ViewModel.FichasAceitasDoJogador.Count fichas aceitas</strong> nesta campanha. Escolha com qual vai jogar agora:</legend>
                        <div class="character-options">
                            @foreach (var vinculoAceito in ViewModel.FichasAceitasDoJogador)
                            {
                                var p = vinculoAceito.Personagem!;
                                bool selecionada = ViewModel.VinculoSelecionado?.IdPersonagem == p.IdPersonagem;
                                <label class="character-option @(selecionada ? "selecionado" : "")" @onclick="() => ViewModel.SelecionarVinculoExistenteAsync(vinculoAceito)">
                                    <input type="radio"
                                           name="ficha-conectar"
                                           checked="@selecionada"
                                           @onchange="() => ViewModel.SelecionarVinculoExistenteAsync(vinculoAceito)" />
                                    <span class="character-option-copy">
                                        <strong>@p.Nome</strong>
                                        <small>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <dl class="join-review">
                    <div>
                        <dt>Personagem Escolhido</dt>
                        <dd>@(ViewModel.FichaCompletaVinculada?.Nome ?? "Nenhuma ficha selecionada")</dd>
                    </div>
                    <div>
                        <dt>Raça & Classe</dt>
                        <dd>@(ViewModel.FichaCompletaVinculada != null ? $"{ViewModel.FichaCompletaVinculada.RacaTexto} · {ViewModel.FichaCompletaVinculada.ClasseTexto} (Nv. {ViewModel.FichaCompletaVinculada.Nivel})" : "—")</dd>
                    </div>
                    <div>
                        <dt>Status de Aprovação</dt>
                        <dd>
                            @if (ViewModel.StatusFichaAtual == "Aceita")
                            {
                                <strong style="color: #78be82;">✓ Aceita pelo Mestre</strong>
                            }
                            else if (ViewModel.StatusFichaAtual == "Pendente")
                            {
                                <strong style="color: #e6c665;">⏳ Aguardando Mestre</strong>
                            }
                            else if (ViewModel.StatusFichaAtual == "Recusada")
                            {
                                <strong style="color: #e88d8d;">✕ Recusada pelo Mestre</strong>
                            }
                            else
                            {
                                <span>Não enviada</span>
                            }
                        </dd>
                    </div>
                </dl>

                <!-- EXIBE O INVENTÁRIO VINCULADO DO PERSONAGEM NA ETAPA DE CONECTAR -->
                @if (ViewModel.FichaCompletaVinculada?.Inventario != null)
                {
                    <div class="ficha-preview-pergaminho" style="margin-top: 16px;">
                        <h4 style="margin: 0 0 10px; color: #392819; font-size: 14px; text-transform: uppercase;">
                            🎒 Inventário de @ViewModel.FichaCompletaVinculada.Nome na Sessão (Carga: @(ViewModel.FichaCompletaVinculada.Inventario.PesoAtual ?? 0) kg / @(ViewModel.FichaCompletaVinculada.Inventario.CapacidadeCarga ?? 0) kg)
                        </h4>
                        <div class="dados-fisicos-grid" style="margin-bottom: 10px;">
                            <div><span>PC</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPC</strong></div>
                            <div><span>PP</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPP</strong></div>
                            <div><span>PE</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPE</strong></div>
                            <div><span>PO</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPO</strong></div>
                            <div><span>PL</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPL</strong></div>
                        </div>

                        @if (ViewModel.FichaCompletaVinculada.Inventario.Itens != null && ViewModel.FichaCompletaVinculada.Inventario.Itens.Any())
                        {
                            <ul class="lista-itens-preview">
                                @foreach (var ii in ViewModel.FichaCompletaVinculada.Inventario.Itens)
                                {
                                    <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> <span>(@(ii.Item?.Tipo ?? "Geral") · @(ii.Item?.Peso ?? 0) kg)</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="margin:0; font-size:12px;">Nenhum item equipado.</p>
                        }
                    </div>
                }

                @if (ViewModel.StatusFichaAtual != "Aceita")
                {
                    <div class="ficha-alert pendente" style="margin-top: 16px;">
                        Para entrar na sala de jogo, selecione uma ficha que esteja <strong>Aceita pelo Mestre</strong> (na Etapa 1) ou clique em "Atualizar Status".
                    </div>
                }

                <p class="join-status @(ViewModel.TemErro ? "erro" : "")" role="status" aria-live="polite">@ViewModel.Mensagem</p>

                <div class="join-actions">
                    <button class="action-secondary" type="button" disabled="@ViewModel.Carregando" @onclick="() => ViewModel.IrParaEtapa(1)">
                        ← Voltar para Fichas (Etapa 1)
                    </button>
                    <div style="display: flex; gap: 10px;">
                        <button class="action-secondary" type="button" disabled="@ViewModel.Carregando" @onclick="ViewModel.RecarregarStatusAsync">
                            ↻ Atualizar Status
                        </button>
                        <button class="action-primary"
                                type="button"
                                disabled="@(ViewModel.Carregando || ViewModel.StatusFichaAtual != "Aceita")"
                                @onclick="ViewModel.ConectarNaSala">
                            @(ViewModel.Carregando ? "Conectando..." : $"Conectar com {(ViewModel.FichaCompletaVinculada?.Nome ?? "Ficha")} →")
                        </button>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    [SupplyParameterFromQuery(Name = "campanhaId")]
    public int? CampanhaIdQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.InicializarAsync(IdCampanha, CampanhaIdQuery);
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}