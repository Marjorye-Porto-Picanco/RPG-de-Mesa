                                            <div class="box-texto-preview full-span">
                                                <h4>História do Personagem</h4>
                                                <textarea rows="4" @bind="ViewModel.PersonagemEmPreparacao.Historia" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Características e Habilidades</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Caracteristicas" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Tesouro Pessoal</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Tesouro" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @* ABA EDITÁVEL 3: GRIMÓRIO *@
                                @if (ViewModel.ModoReenviarRecusada && ViewModel.AbaEdicaoRecusada == "grimorio")
                                {
