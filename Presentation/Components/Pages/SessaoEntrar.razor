                                            </div>
                                            <div>
                                                <span>Idade</span>
                                                <input type="text" @bind="ViewModel.PersonagemEmPreparacao.Idade" style="width:100%; background:rgba(255,255,255,0.75); border:1px solid #b59257; border-radius:4px; padding:5px; color:#2b1b0e;" />
                                            </div>
                                            <div>
                                                <span>Peso</span>
                                                <input type="text" @bind="ViewModel.PersonagemEmPreparacao.Peso" style="width:100%; background:rgba(255,255,255,0.75); border:1px solid #b59257; border-radius:4px; padding:5px; color:#2b1b0e;" />
                                            </div>
                                            <div>
                                                <span>Gênero / Altura (Fixo)</span>
                                                <input type="text" value="@($"{ViewModel.PersonagemEmPreparacao.Genero ?? "—"} / {ViewModel.PersonagemEmPreparacao.Altura ?? "—"}")" readonly disabled style="width:100%; opacity:0.75; background:rgba(0,0,0,0.08); border:1px solid #b59257; border-radius:4px; padding:5px;" />
                                            </div>
                                        </div>

                                        <!-- CLASSES (MULTICLASSE) -->
                                        <div class="categoria-itens-campanha">
                                            <div class="titulo-categoria-campanha">
                                                <h4>⌁ Classes do Personagem (Nível Total: @ViewModel.PersonagemEmPreparacao.Nivel)</h4>
                                                <button type="button" class="btn-add-item-campanha" title="Adicionar classe (Multiclasse)" @onclick="ViewModel.AdicionarClasseEdicao">+</button>
                                            </div>
                                            <div class="cabecalho-linha-campanha" style="grid-template-columns: 1fr 120px 28px;">
                                                <span>Classe</span>
                                                <span>Nível na Classe</span>
                                                <span></span>
                                            </div>
                                            @foreach (var cl in ViewModel.ClassesEdicao)
                                            {
                                                <div class="item-linha-campanha" style="grid-template-columns: 1fr 120px 28px;">
                                                    <select value="@cl.NomeClasse" @onchange="e => ViewModel.AlterarNomeClasseEdicao(cl, e)">
                                                        @foreach (var op in ViewModel.ListaOpcoesClasses)
                                                        {
                                                            <option value="@op">@op</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="20" value="@cl.Nivel" @onchange="e => ViewModel.AlterarNivelClasseEdicao(cl, e)" />
