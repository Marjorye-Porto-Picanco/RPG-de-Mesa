@page "/sessao-entrar"
@page "/sessao-entrar/{IdCampanha:int}"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@using RPGdeMesa.Domain.Campanhas
@using RPGdeMesa.Domain.Itens
@using RPGdeMesa.Domain.Personagens
@inject SessaoEntrarViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell join-shell">
    <main class="app-content join-content">
        <header class="page-heading join-page-heading">
            <div>
                <p class="page-kicker">Aventureiros, a mesa está aberta</p>
                <h1 class="page-title">@(ViewModel.CampanhaAtual?.Nome ?? "Entrar em sessão")</h1>
                <p class="page-description">Escolha sua ficha, monte seu inventário inicial da campanha e conecte-se na sala.</p>
            </div>
            <button class="botao-voltar" type="button" @onclick="ViewModel.VoltarParaHome"><span aria-hidden="true">←</span> Voltar</button>
        </header>

        <!-- 2 ETAPAS INDEPENDENTES -->
        <ol class="join-progress join-progress-2" aria-label="Etapas para entrar na sessão">
            <li class="@(ViewModel.EtapaAtual == 1 ? "ativa" : ViewModel.PossuiAlgumaFichaAceita ? "concluida" : "")">
                <button type="button" class="join-step-link" aria-current="@(ViewModel.EtapaAtual == 1 ? "step" : null)" @onclick="() => ViewModel.IrParaEtapa(1)">
                    <span>@(ViewModel.PossuiAlgumaFichaAceita ? "✓" : "1")</span>
                    <strong>1. Ficha e Inventário na Campanha (@ViewModel.VinculosDoJogador.Count)</strong>
                </button>
            </li>
            <li class="@(ViewModel.EtapaAtual == 2 ? "ativa" : "")">
                <button type="button" class="join-step-link" aria-current="@(ViewModel.EtapaAtual == 2 ? "step" : null)" @onclick="() => ViewModel.IrParaEtapa(2)">
                    <span>2</span>
                    <strong>2. Conectar na Sessão</strong>
                </button>
            </li>
        </ol>

        @if (ViewModel.CampanhaAtual is null)
        {
            <section class="join-step join-card">
                <p class="page-kicker">Aviso</p>
                <h2>Campanha não localizada</h2>
                <p class="join-status">Selecione uma campanha válida na sua biblioteca de Campanhas para configurar sua ficha e entrar na sessão.</p>
                <div class="join-actions">
                    <button class="action-primary" type="button" @onclick="ViewModel.VoltarParaHome">Voltar para Campanhas →</button>
                </div>
            </section>
        }
        else if (ViewModel.EtapaAtual == 1)
        {
            <!-- =========================================================================
                 ETAPA 1: VISUALIZAR FICHAS ENVIADAS OU ENVIAR/AJUSTAR FICHA NA CAMPANHA
                 ========================================================================= -->
            <section class="join-step join-card" id="etapa-personagem" aria-labelledby="titulo-personagem">
                <div class="step-header-row">
                    <div>
                        <p class="page-kicker">Etapa 1 · Preparação dos Heróis</p>
                        <h2 id="titulo-personagem">Suas Fichas e Equipamentos em @(ViewModel.CampanhaAtual.Nome)</h2>
                    </div>

                    @if (ViewModel.VinculosDoJogador.Any() && !ViewModel.ModoAdicionarNovaFicha && !ViewModel.ModoReenviarRecusada && ViewModel.PersonagensNaoEnviados.Any())
                    {
                        <button type="button" class="action-secondary" style="min-height:34px; font-size:11px;" @onclick="ViewModel.AbrirModoEnviarNovaFichaAsync">
                            + Enviar outra ficha
                        </button>
                    }
                </div>

                @if (ViewModel.VinculosDoJogador.Any() && !ViewModel.ModoAdicionarNovaFicha && !ViewModel.ModoReenviarRecusada)
                {
                    <!-- SELETOR DAS FICHAS JÁ VINCULADAS PELO JOGADOR NESTA CAMPANHA -->
                    <fieldset class="character-picker" style="margin-bottom: 18px;">
                        <legend>Selecione uma das suas fichas vinculadas a esta campanha para visualizar ou jogar:</legend>
                        <div class="character-options">
                            @foreach (var vinculo in ViewModel.VinculosDoJogador)
                            {
                                var p = vinculo.Personagem!;
                                bool estaSelecionada = ViewModel.VinculoSelecionado?.IdPersonagem == p.IdPersonagem;
                                <label class="character-option @(estaSelecionada ? "selecionado" : "")" @onclick="() => ViewModel.SelecionarVinculoExistenteAsync(vinculo)">
                                    <input type="radio"
                                           name="vinculo-ativo"
                                           checked="@estaSelecionada"
                                           @onchange="() => ViewModel.SelecionarVinculoExistenteAsync(vinculo)" />
                                    <span class="character-option-copy" style="flex:1;">
                                        <strong>@p.Nome</strong>
                                        <small>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</small>
                                    </span>
                                    <span class="status-badge status-@vinculo.StatusAprovacao.ToLowerInvariant()" style="font-size:10px; padding:3px 8px;">
                                        @(vinculo.StatusAprovacao == "Aceita" ? "✓ Aceita" :
                                          vinculo.StatusAprovacao == "Pendente" ? "⏳ Pendente" : "✕ Recusada")
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    @if (ViewModel.VinculoSelecionado != null && ViewModel.FichaCompletaVinculada != null)
                    {
                        @if (ViewModel.StatusFichaAtual == "Pendente")
                        {
                            <div class="ficha-alert pendente">
                                <strong>Ficha e equipamentos em avaliação!</strong> O mestre está analisando a ficha e os itens escolhidos para <b>@ViewModel.FichaCompletaVinculada.Nome</b>. Os dados e itens não podem ser alterados após o envio.
                            </div>
                        }
                        else if (ViewModel.StatusFichaAtual == "Aceita")
                        {
                            <div class="ficha-alert aceita">
                                <strong>Ficha e equipamentos aprovados pelo Mestre!</strong> O personagem <b>@ViewModel.FichaCompletaVinculada.Nome</b> e seu inventário inicial já foram validados e estão prontos para a partida.
                            </div>
                        }
                        else if (ViewModel.StatusFichaAtual == "Recusada")
                        {
                            <div class="ficha-alert recusada" style="display:flex; flex-direction:column; gap:10px;">
                                <span><strong>Esta ficha foi recusada pelo Mestre.</strong> Clique no botão abaixo para abrir a edição completa desta ficha da campanha (Atributos, Perícias, História, Grimório e Inventário) aqui mesmo na tela e reenviá-la.</span>
                                @if (!string.IsNullOrWhiteSpace(ViewModel.VinculoSelecionado?.MotivoRecusa))
                                {
                                    <p style="margin:0; font-size:11px; background: rgba(0,0,0,0.25); padding:8px; border-radius:4px;">
                                        💬 <b>Mensagem do Mestre:</b> @ViewModel.VinculoSelecionado.MotivoRecusa
                                    </p>
                                }
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <button type="button" class="action-primary" style="min-height:34px; font-size:11px;" @onclick="ViewModel.AbrirReenvioDeFichaRecusadaAsync">
                                        ✏️ Ajustar Ficha e Inventário Aqui Mesmo e Reenviar ao Mestre
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- VISUALIZAÇÃO SOMENTE LEITURA DA FICHA E DO INVENTÁRIO ENVIADO -->
                        <div class="ficha-preview-pergaminho">
                            <div class="ficha-cabecalho-preview">
                                <div class="retrato-preview">
                                    <img src="@(string.IsNullOrEmpty(ViewModel.FichaCompletaVinculada.Imagem) ? "img/armaduraprata.png" : ViewModel.FichaCompletaVinculada.Imagem)" alt="Retrato do personagem" />
                                </div>
                                <div class="identidade-preview">
                                    <p class="sobretitulo-preview">Ficha Instanciada na Campanha (@ViewModel.StatusFichaAtual)</p>
                                    <h3>@ViewModel.FichaCompletaVinculada.Nome</h3>
                                    <p class="subtitulo-preview">@(ViewModel.FichaCompletaVinculada.RacaTexto ?? "Raça") • @(ViewModel.FichaCompletaVinculada.ClasseTexto ?? "Classe") • Nível Total @ViewModel.FichaCompletaVinculada.Nivel</p>
                                    <div class="dados-rapidos-preview">
                                        <span><b>Tendência:</b> @(ViewModel.FichaCompletaVinculada.Tendencia ?? "Neutra")</span>
                                        <span><b>Antecedente:</b> @(ViewModel.FichaCompletaVinculada.AntecedenteTexto ?? "Não informado")</span>
                                        <span><b>XP:</b> @ViewModel.FichaCompletaVinculada.ExperienciaXp.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="abas-ficha-preview" role="tablist">
                                <button type="button" class="aba-btn @(ViewModel.AbaFichaPreview == "atributos" ? "ativa" : "")" @onclick='() => ViewModel.AbaFichaPreview = "atributos"'>Atributos & Diário</button>
                                <button type="button" class="aba-btn @(ViewModel.AbaFichaPreview == "personagem" ? "ativa" : "")" @onclick='() => ViewModel.AbaFichaPreview = "personagem"'>Personagem & Classes</button>
                                <button type="button" class="aba-btn @(ViewModel.AbaFichaPreview == "inventario" ? "ativa" : "")" @onclick='() => ViewModel.AbaFichaPreview = "inventario"'>Inventário da Campanha</button>
                                <button type="button" class="aba-btn @(ViewModel.AbaFichaPreview == "grimorio" ? "ativa" : "")" @onclick='() => ViewModel.AbaFichaPreview = "grimorio"'>Grimório</button>
                            </div>

                            @if (ViewModel.AbaFichaPreview == "atributos")
                            {
                                <div class="preview-tab-body">
                                    <div class="atributos-grid-preview">
                                        <div class="attr-card"><span>FOR</span><strong>@ViewModel.FichaCompletaVinculada.Forca</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Forca)</small></div>
                                        <div class="attr-card"><span>DES</span><strong>@ViewModel.FichaCompletaVinculada.Destreza</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Destreza)</small></div>
                                        <div class="attr-card"><span>CON</span><strong>@ViewModel.FichaCompletaVinculada.Constituicao</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Constituicao)</small></div>
                                        <div class="attr-card"><span>INT</span><strong>@ViewModel.FichaCompletaVinculada.Inteligencia</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Inteligencia)</small></div>
                                        <div class="attr-card"><span>SAB</span><strong>@ViewModel.FichaCompletaVinculada.Sabedoria</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Sabedoria)</small></div>
                                        <div class="attr-card"><span>CAR</span><strong>@ViewModel.FichaCompletaVinculada.Carisma</strong><small>@SessaoEntrarViewModel.ObterModificador(ViewModel.FichaCompletaVinculada.Carisma)</small></div>
                                    </div>

                                    <div class="tags-row-preview">
                                        <div>
                                            <h4>Salvaguardas Proficientes</h4>
                                            <p>@(ViewModel.FichaCompletaVinculada.Salvaguardas.Any() ? string.Join(", ", ViewModel.FichaCompletaVinculada.Salvaguardas.Select(s => s.Atributo)) : "Nenhuma marcada")</p>
                                        </div>
                                        <div>
                                            <h4>Perícias Treinadas</h4>
                                            <p>@(ViewModel.FichaCompletaVinculada.Pericias.Any() ? string.Join(", ", ViewModel.FichaCompletaVinculada.Pericias.Select(p => p.NomePericia)) : "Nenhuma marcada")</p>
                                        </div>
                                    </div>

                                    <div class="diario-grid-preview">
                                        <div class="box-texto-preview"><h4>Traços de Personalidade</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.TracosPersonalidade) ? "—" : ViewModel.FichaCompletaVinculada.TracosPersonalidade)</p></div>
                                        <div class="box-texto-preview"><h4>Ponto de Vista</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.PontoDeVista) ? "—" : ViewModel.FichaCompletaVinculada.PontoDeVista)</p></div>
                                        <div class="box-texto-preview"><h4>Ideais</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Ideais) ? "—" : ViewModel.FichaCompletaVinculada.Ideais)</p></div>
                                        <div class="box-texto-preview"><h4>Ligações</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Ligacoes) ? "—" : ViewModel.FichaCompletaVinculada.Ligacoes)</p></div>
                                        <div class="box-texto-preview"><h4>Defeitos</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Defeitos) ? "—" : ViewModel.FichaCompletaVinculada.Defeitos)</p></div>
                                        <div class="box-texto-preview"><h4>Idiomas</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Idiomas) ? "—" : ViewModel.FichaCompletaVinculada.Idiomas)</p></div>
                                    </div>
                                </div>
                            }
                            else if (ViewModel.AbaFichaPreview == "personagem")
                            {
                                <div class="preview-tab-body">
                                    <div class="dados-fisicos-grid">
                                        <div><span>Idade</span><strong>@(ViewModel.FichaCompletaVinculada.Idade ?? "—")</strong></div>
                                        <div><span>Gênero</span><strong>@(ViewModel.FichaCompletaVinculada.Genero ?? "—")</strong></div>
                                        <div><span>Altura</span><strong>@(ViewModel.FichaCompletaVinculada.Altura ?? "—")</strong></div>
                                        <div><span>Peso</span><strong>@(ViewModel.FichaCompletaVinculada.Peso ?? "—")</strong></div>
                                    </div>

                                    <div class="diario-grid-preview">
                                        <div class="box-texto-preview"><h4>Aparência</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Aparencia) ? "—" : ViewModel.FichaCompletaVinculada.Aparencia)</p></div>
                                        <div class="box-texto-preview"><h4>Aliados e Organizações</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Aliados) ? "—" : ViewModel.FichaCompletaVinculada.Aliados)</p></div>
                                        <div class="box-texto-preview full-span"><h4>História do Personagem</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Historia) ? "—" : ViewModel.FichaCompletaVinculada.Historia)</p></div>
                                        <div class="box-texto-preview"><h4>Características e Habilidades</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Caracteristicas) ? "—" : ViewModel.FichaCompletaVinculada.Caracteristicas)</p></div>
                                        <div class="box-texto-preview"><h4>Tesouro Pessoal</h4><p>@(string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Tesouro) ? "—" : ViewModel.FichaCompletaVinculada.Tesouro)</p></div>
                                    </div>
                                </div>
                            }
                            else if (ViewModel.AbaFichaPreview == "inventario")
                            {
                                <div class="preview-tab-body">
                                    @if (ViewModel.FichaCompletaVinculada.Inventario != null)
                                    {
                                        <div class="dados-fisicos-grid">
                                            <div><span>PC</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPC</strong></div>
                                            <div><span>PP</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPP</strong></div>
                                            <div><span>PE</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPE</strong></div>
                                            <div><span>PO</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPO</strong></div>
                                            <div><span>PL</span><strong>@ViewModel.FichaCompletaVinculada.Inventario.MoedasPL</strong></div>
                                        </div>

                                        <div class="box-texto-preview full-span" style="margin-top: 12px;">
                                            <h4>Itens Vinculados na Campanha (Carga: @(ViewModel.FichaCompletaVinculada.Inventario.PesoAtual ?? 0) kg / @(ViewModel.FichaCompletaVinculada.Inventario.CapacidadeCarga ?? 0) kg)</h4>
                                            @if (ViewModel.FichaCompletaVinculada.Inventario.Itens != null && ViewModel.FichaCompletaVinculada.Inventario.Itens.Any())
                                            {
                                                <ul class="lista-itens-preview">
                                                    @foreach (var ii in ViewModel.FichaCompletaVinculada.Inventario.Itens)
                                                    {
                                                        <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> <span>(@(ii.Item?.Tipo ?? "Geral") · Peso unit.: @(ii.Item?.Peso ?? 0) kg · Valor: @(ii.Item?.Preco ?? 0) po)</span></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p>Nenhum item registrado no inventário.</p>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(ViewModel.FichaCompletaVinculada.Inventario.Notas))
                                        {
                                            <div class="box-texto-preview full-span" style="margin-top: 10px;">
                                                <h4>Notas do Inventário</h4>
                                                <p>@ViewModel.FichaCompletaVinculada.Inventario.Notas</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p>Nenhum inventário registrado para esta ficha.</p>
                                    }
                                </div>
                            }
                            else if (ViewModel.AbaFichaPreview == "grimorio")
                            {
                                <div class="preview-tab-body">
                                    @if (ViewModel.FichaCompletaVinculada.PersonagemMagias != null && ViewModel.FichaCompletaVinculada.PersonagemMagias.Any())
                                    {
                                        <ul class="lista-itens-preview">
                                            @foreach (var pm in ViewModel.FichaCompletaVinculada.PersonagemMagias)
                                            {
                                                if (pm.Magia != null)
                                                {
                                                    <li>
                                                        <strong>@pm.Magia.Nome</strong>
                                                        <span>(Círculo @pm.Magia.CirculoNivel · Efeito: @(pm.Magia.DanoEfeito ?? "—") · Alcance: @(pm.Magia.Alcance ?? "—"))</span>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p>Nenhuma magia cadastrada no grimório.</p>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <p class="join-status @(ViewModel.TemErro ? "erro" : "")" role="status" aria-live="polite">@ViewModel.Mensagem</p>

                    <div class="join-actions">
                        @if (ViewModel.PersonagensNaoEnviados.Any())
                        {
                            <button class="action-secondary" type="button" @onclick="ViewModel.AbrirModoEnviarNovaFichaAsync">
                                + Enviar outra ficha para esta campanha
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }
                        <button class="action-primary" type="button" @onclick="() => ViewModel.IrParaEtapa(2)">
                            Ir para Etapa 2: Conectar com @(ViewModel.FichaCompletaVinculada?.Nome ?? "Ficha") <span aria-hidden="true">→</span>
                        </button>
                    </div>
                }
                else
                {
                    <!-- =====================================================================
                         FORMULÁRIO DE ESCOLHA DA FICHA OU EDIÇÃO COMPLETA DA FICHA RECUSADA
                         ===================================================================== -->
                    <form @onsubmit="ViewModel.EnviarFichaComInventarioAoMestreAsync" @onsubmit:preventDefault="true">
                        @if (!ViewModel.ModoReenviarRecusada)
                        {
                            <fieldset class="character-picker">
                                <legend>1. Escolha um personagem da sua biblioteca para enviar ao Mestre desta campanha:</legend>
                                @if (ViewModel.PersonagensNaoEnviados.Any())
                                {
                                    <div class="character-options" id="opcoes-personagens">
                                        @foreach (var personagem in ViewModel.PersonagensNaoEnviados)
                                        {
                                            <label class="character-option @(ViewModel.NovoPersonagemParaEnviarId == personagem.IdPersonagem ? "selecionado" : "")">
                                                <input type="radio"
                                                       name="novo-personagem"
                                                       value="@personagem.IdPersonagem"
                                                       @onchange="() => ViewModel.AoEscolherPersonagemParaEnviarAsync(personagem.IdPersonagem)"
                                                       checked="@(ViewModel.NovoPersonagemParaEnviarId == personagem.IdPersonagem)" />
                                                <span class="character-option-copy">
                                                    <strong>@personagem.Nome</strong>
                                                    <small>@(personagem.RacaTexto ?? "Raça não informada") · @(personagem.ClasseTexto ?? "Classe não informada") · Nível @personagem.Nivel</small>
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }
                                else if (ViewModel.PersonagensDisponiveis.Any())
                                {
                                    <p class="join-status">Todos os seus personagens cadastrados já foram enviados para esta campanha!</p>
                                }
                                else
                                {
                                    <p class="join-status">Você ainda não possui personagens cadastrados. Crie um personagem primeiro!</p>
                                }
                            </fieldset>
                        }
                        else
                        {
                            <div class="ficha-alert recusada" style="display:flex; flex-direction:column; gap:6px;">
                                <span>Ajustando a ficha e o inventário de <strong>@(ViewModel.PersonagemEmPreparacao?.Nome)</strong> para reenviar ao Mestre da campanha <strong>@(ViewModel.CampanhaAtual.Nome)</strong>.</span>
                                @if (!string.IsNullOrWhiteSpace(ViewModel.VinculoSelecionado?.MotivoRecusa))
                                {
                                    <small style="background: rgba(0,0,0,0.25); padding:6px 8px; border-radius:4px;">
                                        💬 <b>Motivo da recusa do Mestre:</b> @ViewModel.VinculoSelecionado.MotivoRecusa
                                    </small>
                                }
                            </div>
                        }

                        @if (ViewModel.PersonagemEmPreparacao != null)
                        {
                            <div class="ficha-preview-pergaminho" style="margin-top: 14px;">
                                @if (ViewModel.ModoReenviarRecusada)
                                {
                                    <div class="ficha-cabecalho-preview">
                                        <div class="retrato-preview">
                                            <img src="@(string.IsNullOrEmpty(ViewModel.PersonagemEmPreparacao.Imagem) ? "img/armaduraprata.png" : ViewModel.PersonagemEmPreparacao.Imagem)" alt="Retrato do personagem" />
                                        </div>
                                        <div class="identidade-preview">
                                            <p class="sobretitulo-preview">Editando Ficha da Campanha (Isolada da Biblioteca)</p>
                                            <h3>@ViewModel.PersonagemEmPreparacao.Nome</h3>
                                            <p class="subtitulo-preview">@(ViewModel.PersonagemEmPreparacao.RacaTexto ?? "Raça") • @(ViewModel.PersonagemEmPreparacao.ClasseTexto ?? "Classe") • Nível Total @ViewModel.PersonagemEmPreparacao.Nivel</p>
                                        </div>
                                    </div>

                                    <!-- 4 ABAS EDITÁVEIS DENTRO DO SESSAOENTRAR QUANDO RECUSADA -->
                                    <div class="abas-ficha-preview" role="tablist">
                                        <button type="button" class="aba-btn @(ViewModel.AbaEdicaoRecusada == "atributos" ? "ativa" : "")" @onclick='() => ViewModel.AbaEdicaoRecusada = "atributos"'>1. Atributos & Diário</button>
                                        <button type="button" class="aba-btn @(ViewModel.AbaEdicaoRecusada == "personagem" ? "ativa" : "")" @onclick='() => ViewModel.AbaEdicaoRecusada = "personagem"'>2. Personagem & Classes</button>
                                        <button type="button" class="aba-btn @(ViewModel.AbaEdicaoRecusada == "grimorio" ? "ativa" : "")" @onclick='() => ViewModel.AbaEdicaoRecusada = "grimorio"'>3. Grimório</button>
                                        <button type="button" class="aba-btn @(ViewModel.AbaEdicaoRecusada == "inventario" ? "ativa" : "")" @onclick='() => ViewModel.AbaEdicaoRecusada = "inventario"'>4. Inventário da Campanha</button>
