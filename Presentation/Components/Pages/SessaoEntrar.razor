                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ABA EDITÁVEL 4 (OU PADRÃO AO ENVIAR NOVA FICHA): INVENTÁRIO DA CAMPANHA *@
                                @if (!ViewModel.ModoReenviarRecusada || ViewModel.AbaEdicaoRecusada == "inventario")
