                                                <small>@SessaoEntrarViewModel.ObterModificador(ViewModel.PersonagemEmPreparacao.Sabedoria)</small>
                                            </label>
                                            <label class="attr-card">
                                                <span>CAR</span>
                                                <input type="number" min="1" max="30" @bind="ViewModel.PersonagemEmPreparacao.Carisma" @bind:event="oninput" style="width:100%; text-align:center; font-weight:bold; font-size:18px; background:rgba(255,255,255,0.6); border:1px solid #9c783d; border-radius:4px; color:#2b1b0e;" />
                                                <small>@SessaoEntrarViewModel.ObterModificador(ViewModel.PersonagemEmPreparacao.Carisma)</small>
                                            </label>
                                        </div>

                                        <div class="tags-row-preview">
