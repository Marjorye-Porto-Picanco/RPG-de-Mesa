@page "/sessao-entrar"
@page "/sessao-entrar/{IdCampanha:int}"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@using RPGdeMesa.Domain.Campanhas
@using RPGdeMesa.Domain.Itens
@using RPGdeMesa.Domain.Personagens
@inject CampanhaService CampanhaService
@inject PersonagemService PersonagemService
@inject SessaoUsuarioService SessaoUsuario
@inject NavigationManager Navigation

<NavMenu />

<div class="app-shell join-shell">
    <main class="app-content join-content">
        <header class="page-heading join-page-heading">
            <div>
                <p class="page-kicker">Aventureiros, a mesa está aberta</p>
                <h1 class="page-title">@(CampanhaAtual?.Nome ?? "Entrar em sessão")</h1>
                <p class="page-description">Escolha sua ficha, monte seu inventário inicial da campanha e conecte-se na sala.</p>
            </div>
            <button class="botao-voltar" type="button" @onclick="VoltarParaHome"><span aria-hidden="true">←</span> Voltar</button>
        </header>

        <!-- 2 ETAPAS INDEPENDENTES -->
        <ol class="join-progress join-progress-2" aria-label="Etapas para entrar na sessão">
            <li class="@(EtapaAtual == 1 ? "ativa" : PossuiAlgumaFichaAceita ? "concluida" : "")">
                <button type="button" class="join-step-link" aria-current="@(EtapaAtual == 1 ? "step" : null)" @onclick="() => IrParaEtapa(1)">
                    <span>@(PossuiAlgumaFichaAceita ? "✓" : "1")</span>
                    <strong>1. Ficha e Inventário na Campanha (@VinculosDoJogador.Count)</strong>
                </button>
            </li>
            <li class="@(EtapaAtual == 2 ? "ativa" : "")">
                <button type="button" class="join-step-link" aria-current="@(EtapaAtual == 2 ? "step" : null)" @onclick="() => IrParaEtapa(2)">
                    <span>2</span>
                    <strong>2. Conectar na Sessão</strong>
                </button>
            </li>
        </ol>

        @if (CampanhaAtual is null)
        {
            <section class="join-step join-card">
                <p class="page-kicker">Aviso</p>
                <h2>Campanha não localizada</h2>
                <p class="join-status">Selecione uma campanha válida na sua biblioteca de Campanhas para configurar sua ficha e entrar na sessão.</p>
                <div class="join-actions">
                    <button class="action-primary" type="button" @onclick="VoltarParaHome">Voltar para Campanhas →</button>
                </div>
            </section>
        }
        else if (EtapaAtual == 1)
        {
            <!-- =========================================================================
                 ETAPA 1: VISUALIZAR FICHAS ENVIADAS OU ENVIAR NOVA FICHA COM INVENTÁRIO
                 ========================================================================= -->
            <section class="join-step join-card" id="etapa-personagem" aria-labelledby="titulo-personagem">
                <div class="step-header-row">
                    <div>
                        <p class="page-kicker">Etapa 1 · Preparação dos Heróis</p>
                        <h2 id="titulo-personagem">Suas Fichas e Equipamentos em @(CampanhaAtual.Nome)</h2>
                    </div>

                    @if (VinculosDoJogador.Any() && !ModoAdicionarNovaFicha && !ModoReenviarRecusada && PersonagensNaoEnviados.Any())
                    {
                        <button type="button" class="action-secondary" style="min-height:34px; font-size:11px;" @onclick="AbrirModoEnviarNovaFicha">
                            + Enviar outra ficha
                        </button>
                    }
                </div>

                @if (VinculosDoJogador.Any() && !ModoAdicionarNovaFicha && !ModoReenviarRecusada)
                {
                    <!-- SELETOR DAS FICHAS JÁ VINCULADAS PELO JOGADOR NESTA CAMPANHA -->
                    <fieldset class="character-picker" style="margin-bottom: 18px;">
                        <legend>Selecione uma das suas fichas vinculadas a esta campanha para visualizar ou jogar:</legend>
                        <div class="character-options">
                            @foreach (var vinculo in VinculosDoJogador)
                            {
                                var p = vinculo.Personagem!;
                                bool estaSelecionada = VinculoSelecionado?.IdPersonagem == p.IdPersonagem;
                                <label class="character-option @(estaSelecionada ? "selecionado" : "")" @onclick="() => SelecionarVinculoExistenteAsync(vinculo)">
                                    <input type="radio"
                                           name="vinculo-ativo"
                                           checked="@estaSelecionada"
                                           @onchange="() => SelecionarVinculoExistenteAsync(vinculo)" />
                                    <span class="character-option-copy" style="flex:1;">
                                        <strong>@p.Nome</strong>
                                        <small>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</small>
                                    </span>
                                    <span class="status-badge status-@vinculo.StatusAprovacao.ToLowerInvariant()" style="font-size:10px; padding:3px 8px;">
                                        @(vinculo.StatusAprovacao == "Aceita" ? "✓ Aceita" :
                                          vinculo.StatusAprovacao == "Pendente" ? "⏳ Pendente" : "✕ Recusada")
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    @if (VinculoSelecionado != null && FichaCompletaVinculada != null)
                    {
                        @if (StatusFichaAtual == "Pendente")
                        {
                            <div class="ficha-alert pendente">
                                <strong>Ficha e equipamentos em avaliação!</strong> O mestre está analisando a ficha e os itens escolhidos para <b>@FichaCompletaVinculada.Nome</b>. Os itens não podem ser alterados após o envio.
                            </div>
                        }
                        else if (StatusFichaAtual == "Aceita")
                        {
                            <div class="ficha-alert aceita">
                                <strong>Ficha e equipamentos aprovados pelo Mestre!</strong> O personagem <b>@FichaCompletaVinculada.Nome</b> e seu inventário inicial já foram validados e estão prontos para a partida.
                            </div>
                        }
                        else if (StatusFichaAtual == "Recusada")
                        {
                            <div class="ficha-alert recusada" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
                                <span><strong>Esta ficha foi recusada pelo Mestre.</strong> Você pode ajustar os itens escolhidos e enviá-la novamente para avaliação.</span>
                                <button type="button" class="action-secondary" style="min-height:32px; font-size:11px;" @onclick="AbrirReenvioDeFichaRecusada">
                                    ↻ Ajustar Itens e Reenviar ao Mestre
                                </button>
                            </div>
                        }

                        <!-- VISUALIZAÇÃO SOMENTE LEITURA DA FICHA E DO INVENTÁRIO ENVIADO -->
                        <div class="ficha-preview-pergaminho">
                            <div class="ficha-cabecalho-preview">
                                <div class="retrato-preview">
                                    <img src="@(string.IsNullOrEmpty(FichaCompletaVinculada.Imagem) ? "img/armaduraprata.png" : FichaCompletaVinculada.Imagem)" alt="Retrato do personagem" />
                                </div>
                                <div class="identidade-preview">
                                    <p class="sobretitulo-preview">Ficha Selecionada (@StatusFichaAtual)</p>
                                    <h3>@FichaCompletaVinculada.Nome</h3>
                                    <p class="subtitulo-preview">@(FichaCompletaVinculada.RacaTexto ?? "Raça") • @(FichaCompletaVinculada.ClasseTexto ?? "Classe") • Nível Total @FichaCompletaVinculada.Nivel</p>
                                    <div class="dados-rapidos-preview">
                                        <span><b>Tendência:</b> @(FichaCompletaVinculada.Tendencia ?? "Neutra")</span>
                                        <span><b>Antecedente:</b> @(FichaCompletaVinculada.AntecedenteTexto ?? "Não informado")</span>
                                        <span><b>XP:</b> @FichaCompletaVinculada.ExperienciaXp.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="abas-ficha-preview" role="tablist">
                                <button type="button" class="aba-btn @(AbaFichaPreview == "atributos" ? "ativa" : "")" @onclick='() => AbaFichaPreview = "atributos"'>Atributos & Diário</button>
                                <button type="button" class="aba-btn @(AbaFichaPreview == "personagem" ? "ativa" : "")" @onclick='() => AbaFichaPreview = "personagem"'>Personagem & Classes</button>
                                <button type="button" class="aba-btn @(AbaFichaPreview == "inventario" ? "ativa" : "")" @onclick='() => AbaFichaPreview = "inventario"'>Inventário da Campanha</button>
                                <button type="button" class="aba-btn @(AbaFichaPreview == "grimorio" ? "ativa" : "")" @onclick='() => AbaFichaPreview = "grimorio"'>Grimório</button>
                            </div>

                            @if (AbaFichaPreview == "atributos")
                            {
                                <div class="preview-tab-body">
                                    <div class="atributos-grid-preview">
                                        <div class="attr-card"><span>FOR</span><strong>@FichaCompletaVinculada.Forca</strong><small>@ObterModificador(FichaCompletaVinculada.Forca)</small></div>
                                        <div class="attr-card"><span>DES</span><strong>@FichaCompletaVinculada.Destreza</strong><small>@ObterModificador(FichaCompletaVinculada.Destreza)</small></div>
                                        <div class="attr-card"><span>CON</span><strong>@FichaCompletaVinculada.Constituicao</strong><small>@ObterModificador(FichaCompletaVinculada.Constituicao)</small></div>
                                        <div class="attr-card"><span>INT</span><strong>@FichaCompletaVinculada.Inteligencia</strong><small>@ObterModificador(FichaCompletaVinculada.Inteligencia)</small></div>
                                        <div class="attr-card"><span>SAB</span><strong>@FichaCompletaVinculada.Sabedoria</strong><small>@ObterModificador(FichaCompletaVinculada.Sabedoria)</small></div>
                                        <div class="attr-card"><span>CAR</span><strong>@FichaCompletaVinculada.Carisma</strong><small>@ObterModificador(FichaCompletaVinculada.Carisma)</small></div>
                                    </div>

                                    <div class="tags-row-preview">
                                        <div>
                                            <h4>Salvaguardas Proficientes</h4>
                                            <p>@(FichaCompletaVinculada.Salvaguardas.Any() ? string.Join(", ", FichaCompletaVinculada.Salvaguardas.Select(s => s.Atributo)) : "Nenhuma marcada")</p>
                                        </div>
                                        <div>
                                            <h4>Perícias Treinadas</h4>
                                            <p>@(FichaCompletaVinculada.Pericias.Any() ? string.Join(", ", FichaCompletaVinculada.Pericias.Select(p => p.NomePericia)) : "Nenhuma marcada")</p>
                                        </div>
                                    </div>

                                    <div class="diario-grid-preview">
                                        <div class="box-texto-preview"><h4>Traços de Personalidade</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.TracosPersonalidade) ? "—" : FichaCompletaVinculada.TracosPersonalidade)</p></div>
                                        <div class="box-texto-preview"><h4>Ponto de Vista</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.PontoDeVista) ? "—" : FichaCompletaVinculada.PontoDeVista)</p></div>
                                        <div class="box-texto-preview"><h4>Ideais</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Ideais) ? "—" : FichaCompletaVinculada.Ideais)</p></div>
                                        <div class="box-texto-preview"><h4>Ligações</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Ligacoes) ? "—" : FichaCompletaVinculada.Ligacoes)</p></div>
                                        <div class="box-texto-preview"><h4>Defeitos</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Defeitos) ? "—" : FichaCompletaVinculada.Defeitos)</p></div>
                                        <div class="box-texto-preview"><h4>Idiomas</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Idiomas) ? "—" : FichaCompletaVinculada.Idiomas)</p></div>
                                    </div>
                                </div>
                            }
                            else if (AbaFichaPreview == "personagem")
                            {
                                <div class="preview-tab-body">
                                    <div class="dados-fisicos-grid">
                                        <div><span>Idade</span><strong>@(FichaCompletaVinculada.Idade ?? "—")</strong></div>
                                        <div><span>Gênero</span><strong>@(FichaCompletaVinculada.Genero ?? "—")</strong></div>
                                        <div><span>Altura</span><strong>@(FichaCompletaVinculada.Altura ?? "—")</strong></div>
                                        <div><span>Peso</span><strong>@(FichaCompletaVinculada.Peso ?? "—")</strong></div>
                                    </div>

                                    <div class="diario-grid-preview">
                                        <div class="box-texto-preview"><h4>Aparência</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Aparencia) ? "—" : FichaCompletaVinculada.Aparencia)</p></div>
                                        <div class="box-texto-preview"><h4>Aliados e Organizações</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Aliados) ? "—" : FichaCompletaVinculada.Aliados)</p></div>
                                        <div class="box-texto-preview full-span"><h4>História do Personagem</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Historia) ? "—" : FichaCompletaVinculada.Historia)</p></div>
                                        <div class="box-texto-preview"><h4>Características e Habilidades</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Caracteristicas) ? "—" : FichaCompletaVinculada.Caracteristicas)</p></div>
                                        <div class="box-texto-preview"><h4>Tesouro Pessoal</h4><p>@(string.IsNullOrWhiteSpace(FichaCompletaVinculada.Tesouro) ? "—" : FichaCompletaVinculada.Tesouro)</p></div>
                                    </div>
                                </div>
                            }
                            else if (AbaFichaPreview == "inventario")
                            {
                                <div class="preview-tab-body">
                                    @if (FichaCompletaVinculada.Inventario != null)
                                    {
                                        <div class="dados-fisicos-grid">
                                            <div><span>PC</span><strong>@FichaCompletaVinculada.Inventario.MoedasPC</strong></div>
                                            <div><span>PP</span><strong>@FichaCompletaVinculada.Inventario.MoedasPP</strong></div>
                                            <div><span>PE</span><strong>@FichaCompletaVinculada.Inventario.MoedasPE</strong></div>
                                            <div><span>PO</span><strong>@FichaCompletaVinculada.Inventario.MoedasPO</strong></div>
                                            <div><span>PL</span><strong>@FichaCompletaVinculada.Inventario.MoedasPL</strong></div>
                                        </div>

                                        <div class="box-texto-preview full-span" style="margin-top: 12px;">
                                            <h4>Itens Vinculados na Campanha (Carga: @(FichaCompletaVinculada.Inventario.PesoAtual ?? 0) kg / @(FichaCompletaVinculada.Inventario.CapacidadeCarga ?? 0) kg)</h4>
                                            @if (FichaCompletaVinculada.Inventario.Itens != null && FichaCompletaVinculada.Inventario.Itens.Any())
                                            {
                                                <ul class="lista-itens-preview">
                                                    @foreach (var ii in FichaCompletaVinculada.Inventario.Itens)
                                                    {
                                                        <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> <span>(@(ii.Item?.Tipo ?? "Geral") · Peso unit.: @(ii.Item?.Peso ?? 0) kg · Valor: @(ii.Item?.Preco ?? 0) po)</span></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p>Nenhum item registrado no inventário.</p>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(FichaCompletaVinculada.Inventario.Notas))
                                        {
                                            <div class="box-texto-preview full-span" style="margin-top: 10px;">
                                                <h4>Notas do Inventário</h4>
                                                <p>@FichaCompletaVinculada.Inventario.Notas</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p>Nenhum inventário registrado para esta ficha.</p>
                                    }
                                </div>
                            }
                            else if (AbaFichaPreview == "grimorio")
                            {
                                <div class="preview-tab-body">
                                    @if (FichaCompletaVinculada.PersonagemMagias != null && FichaCompletaVinculada.PersonagemMagias.Any())
                                    {
                                        <ul class="lista-itens-preview">
                                            @foreach (var pm in FichaCompletaVinculada.PersonagemMagias)
                                            {
                                                if (pm.Magia != null)
                                                {
                                                    <li>
                                                        <strong>@pm.Magia.Nome</strong>
                                                        <span>(Círculo @pm.Magia.CirculoNivel · Efeito: @(pm.Magia.DanoEfeito ?? "—") · Alcance: @(pm.Magia.Alcance ?? "—"))</span>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p>Nenhuma magia cadastrada no grimório.</p>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <p class="join-status @(TemErro ? "erro" : "")" role="status" aria-live="polite">@Mensagem</p>

                    <div class="join-actions">
                        @if (PersonagensNaoEnviados.Any())
                        {
                            <button class="action-secondary" type="button" @onclick="AbrirModoEnviarNovaFicha">
                                + Enviar outra ficha para esta campanha
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }
                        <button class="action-primary" type="button" @onclick="() => IrParaEtapa(2)">
                            Ir para Etapa 2: Conectar com @(FichaCompletaVinculada?.Nome ?? "Ficha") <span aria-hidden="true">→</span>
                        </button>
                    </div>
                }
                else
                {
                    <!-- =====================================================================
                         FORMULÁRIO DE ESCOLHA DA FICHA + MONTAGEM DO INVENTÁRIO (ANTES DE ENVIAR)
                         ===================================================================== -->
                    <form @onsubmit="EnviarFichaComInventarioAoMestreAsync" @onsubmit:preventDefault="true">
                        @if (!ModoReenviarRecusada)
                        {
                            <fieldset class="character-picker">
                                <legend>1. Escolha um personagem da sua biblioteca para enviar ao Mestre desta campanha:</legend>
                                @if (PersonagensNaoEnviados.Any())
                                {
                                    <div class="character-options" id="opcoes-personagens">
                                        @foreach (var personagem in PersonagensNaoEnviados)
                                        {
                                            <label class="character-option @(NovoPersonagemParaEnviarId == personagem.IdPersonagem ? "selecionado" : "")">
                                                <input type="radio"
                                                       name="novo-personagem"
                                                       value="@personagem.IdPersonagem"
                                                       @onchange="() => AoEscolherPersonagemParaEnviarAsync(personagem.IdPersonagem)"
                                                       checked="@(NovoPersonagemParaEnviarId == personagem.IdPersonagem)" />
                                                <span class="character-option-copy">
                                                    <strong>@personagem.Nome</strong>
                                                    <small>@(personagem.RacaTexto ?? "Raça não informada") · @(personagem.ClasseTexto ?? "Classe não informada") · Nível @personagem.Nivel</small>
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }
                                else if (PersonagensDisponiveis.Any())
                                {
                                    <p class="join-status">Todos os seus personagens cadastrados já foram enviados para esta campanha!</p>
                                }
                                else
                                {
                                    <p class="join-status">Você ainda não possui personagens cadastrados. Crie um personagem primeiro!</p>
                                }
                            </fieldset>
                        }
                        else
                        {
                            <div class="ficha-alert recusada">
                                Ajustando os itens iniciais de <strong>@(PersonagemEmPreparacao?.Nome)</strong> para reenviar ao Mestre da campanha <strong>@(CampanhaAtual.Nome)</strong>.
                            </div>
                        }

                        @* ASSIM QUE O JOGADOR ESCOLHE A FICHA PARA ENVIAR, APARECE O INVENTÁRIO DA CAMPANHA ABAIXO *@
                        @if (PersonagemEmPreparacao != null)
                        {
                            <div class="ficha-preview-pergaminho" style="margin-top: 14px;">
                                <h3 style="margin: 0 0 6px; color: #392819; font-size: 18px;">
                                    2. Equipar Itens da Campanha em @PersonagemEmPreparacao.Nome (Antes de Enviar)
                                </h3>
                                <p style="margin: 0 0 16px; font-size: 12px; color: #6b4e23;">
                                    Escolha com atenção as armas, armaduras, poções e materiais disponíveis nesta campanha (@ItensDaCampanha.Count itens liberados pelo Mestre). Após enviar para o Mestre, os itens ficarão travados para validação.
                                </p>

                                <div class="corpo-inventario-campanha">
                                    <div>
                                        <!-- Armas -->
                                        <div class="categoria-itens-campanha">
                                            <div class="titulo-categoria-campanha">
                                                <h4>⌁ Armas</h4>
                                                <button type="button" class="btn-add-item-campanha" title="Adicionar arma da campanha" @onclick='() => AdicionarSlotItem("Armas")'>+</button>
                                            </div>
                                            <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                            @foreach (var slot in ItensInventarioEdicao.Where(i => i.Categoria == "Armas"))
                                            {
                                                <div class="item-linha-campanha">
                                                    <select value="@slot.IdItem" @onchange="e => AlterarItemSlot(slot, e)">
                                                        <option value="0">Selecione uma arma...</option>
                                                        @foreach (var itemOpcao in ObterItensCampanhaPorCategoria("Armas"))
                                                        {
                                                            <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                    <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                    <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                    <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => RemoverSlotItem(slot)">×</button>
                                                </div>
                                            }
                                        </div>

                                        <!-- Armaduras e Escudos -->
                                        <div class="categoria-itens-campanha">
                                            <div class="titulo-categoria-campanha">
                                                <h4>⌁ Armaduras e Escudos</h4>
                                                <button type="button" class="btn-add-item-campanha" title="Adicionar armadura da campanha" @onclick='() => AdicionarSlotItem("Armaduras")'>+</button>
                                            </div>
                                            <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                            @foreach (var slot in ItensInventarioEdicao.Where(i => i.Categoria == "Armaduras"))
                                            {
                                                <div class="item-linha-campanha">
                                                    <select value="@slot.IdItem" @onchange="e => AlterarItemSlot(slot, e)">
                                                        <option value="0">Selecione uma armadura...</option>
                                                        @foreach (var itemOpcao in ObterItensCampanhaPorCategoria("Armaduras"))
                                                        {
                                                            <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                    <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                    <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                    <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => RemoverSlotItem(slot)">×</button>
                                                </div>
                                            }
                                        </div>

                                        <!-- Poções e Consumíveis -->
                                        <div class="categoria-itens-campanha">
                                            <div class="titulo-categoria-campanha">
                                                <h4>⌁ Poções e Consumíveis</h4>
                                                <button type="button" class="btn-add-item-campanha" title="Adicionar consumível da campanha" @onclick='() => AdicionarSlotItem("Consumiveis")'>+</button>
                                            </div>
                                            <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                            @foreach (var slot in ItensInventarioEdicao.Where(i => i.Categoria == "Consumiveis"))
                                            {
                                                <div class="item-linha-campanha">
                                                    <select value="@slot.IdItem" @onchange="e => AlterarItemSlot(slot, e)">
                                                        <option value="0">Selecione um consumível...</option>
                                                        @foreach (var itemOpcao in ObterItensCampanhaPorCategoria("Consumiveis"))
                                                        {
                                                            <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                    <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                    <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                    <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => RemoverSlotItem(slot)">×</button>
                                                </div>
                                            }
                                        </div>

                                        <!-- Materiais e Outros -->
                                        <div class="categoria-itens-campanha">
                                            <div class="titulo-categoria-campanha">
                                                <h4>⌁ Materiais e Outros</h4>
                                                <button type="button" class="btn-add-item-campanha" title="Adicionar item da campanha" @onclick='() => AdicionarSlotItem("Outros")'>+</button>
                                            </div>
                                            <div class="cabecalho-linha-campanha"><span>Item da Campanha</span><span>Qtd.</span><span>Peso</span><span>Valor</span><span></span></div>
                                            @foreach (var slot in ItensInventarioEdicao.Where(i => i.Categoria == "Outros"))
                                            {
                                                <div class="item-linha-campanha">
                                                    <select value="@slot.IdItem" @onchange="e => AlterarItemSlot(slot, e)">
                                                        <option value="0">Selecione um item...</option>
                                                        @foreach (var itemOpcao in ObterItensCampanhaPorCategoria("Outros"))
                                                        {
                                                            <option value="@itemOpcao.IdItem">@itemOpcao.Nome</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="1" max="99" @bind="slot.Quantidade" @bind:event="oninput" />
                                                    <input type="text" value="@($"{(slot.PesoUnitario * Math.Max(1, slot.Quantidade)):0.#} kg")" readonly />
                                                    <input type="text" value="@($"{(slot.PrecoUnitario * Math.Max(1, slot.Quantidade)):0.##} po")" readonly />
                                                    <button type="button" class="remover-item-campanha" title="Remover item" @onclick="() => RemoverSlotItem(slot)">×</button>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <aside class="resumo-inventario-campanha">
                                        <section class="painel-moedas-campanha">
                                            <h4>Moedas Iniciais</h4>
                                            <div class="moedas-grade-campanha">
                                                <label class="moeda-campanha"><span class="icone-moeda-campanha">PC</span><input type="number" min="0" @bind="MoedasPC" /></label>
                                                <label class="moeda-campanha"><span class="icone-moeda-campanha prata">PP</span><input type="number" min="0" @bind="MoedasPP" /></label>
                                                <label class="moeda-campanha"><span class="icone-moeda-campanha electrum">PE</span><input type="number" min="0" @bind="MoedasPE" /></label>
                                                <label class="moeda-campanha"><span class="icone-moeda-campanha ouro">PO</span><input type="number" min="0" @bind="MoedasPO" /></label>
                                                <label class="moeda-campanha"><span class="icone-moeda-campanha platina">PL</span><input type="number" min="0" @bind="MoedasPL" /></label>
                                            </div>
                                        </section>

                                        <section class="painel-carga-campanha">
                                            <h4>Capacidade de Carga</h4>
                                            <p style="text-align:center; margin:0 0 8px; font-size:12px;">
                                                <strong>@PesoTotalEdicao.ToString("0.0") kg</strong> / @CapacidadeCargaMaximaEdicao.ToString("0.0") kg
                                            </p>
                                            <progress max="@((double)CapacidadeCargaMaximaEdicao)" value="@((double)Math.Min(PesoTotalEdicao, CapacidadeCargaMaximaEdicao))"></progress>
                                        </section>

                                        <div class="notas-inventario-campanha">
                                            <h4>Notas do Inventário</h4>
                                            <textarea rows="3" @bind="NotasInventario" placeholder="Anote detalhes dos equipamentos escolhidos..."></textarea>
                                        </div>
                                    </aside>
                                </div>
                            </div>
                        }

                        <p class="join-status @(TemErro ? "erro" : "")" role="status" aria-live="polite">@Mensagem</p>

                        <div class="join-actions">
                            @if (VinculosDoJogador.Any())
                            {
                                <button class="action-secondary" type="button" @onclick="CancelarModoEdicaoOuAdicao">
                                    ← Cancelar e voltar para minhas fichas
                                </button>
                            }
                            else
                            {
                                <button class="action-secondary" type="button" @onclick="VoltarParaHome">Voltar</button>
                            }

                            <button class="action-primary" type="submit" disabled="@(Carregando || PersonagemEmPreparacao == null)">
                                @(Carregando ? "Salvando e enviando..." : "Vincular Inventário e Enviar Ficha ao Mestre →")
                            </button>
                        </div>
                    </form>
                }
            </section>
        }
        else if (EtapaAtual == 2)
        {
            <!-- =========================================================================
                 ETAPA 2: ESCOLHER ENTRE AS FICHAS ACEITAS (EXIBE INVENTÁRIO) E CONECTAR
                 ========================================================================= -->
            <section class="join-step join-card" id="etapa-confirmacao" aria-labelledby="titulo-confirmacao">
                <p class="page-kicker">Etapa 2 · Sala de Jogo</p>
                <h2 id="titulo-confirmacao">Conectar na Sessão</h2>
                <p class="join-session-name">Campanha: <strong>@(CampanhaAtual.Nome)</strong></p>

                @if (FichasAceitasDoJogador.Count > 1)
                {
                    <fieldset class="character-picker" style="margin-bottom: 18px;">
                        <legend>Você possui <strong>@FichasAceitasDoJogador.Count fichas aceitas</strong> nesta campanha. Escolha com qual vai jogar agora:</legend>
                        <div class="character-options">
                            @foreach (var vinculoAceito in FichasAceitasDoJogador)
                            {
                                var p = vinculoAceito.Personagem!;
                                bool selecionada = VinculoSelecionado?.IdPersonagem == p.IdPersonagem;
                                <label class="character-option @(selecionada ? "selecionado" : "")" @onclick="() => SelecionarVinculoExistenteAsync(vinculoAceito)">
                                    <input type="radio"
                                           name="ficha-conectar"
                                           checked="@selecionada"
                                           @onchange="() => SelecionarVinculoExistenteAsync(vinculoAceito)" />
                                    <span class="character-option-copy">
                                        <strong>@p.Nome</strong>
                                        <small>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <dl class="join-review">
                    <div>
                        <dt>Personagem Escolhido</dt>
                        <dd>@(FichaCompletaVinculada?.Nome ?? "Nenhuma ficha selecionada")</dd>
                    </div>
                    <div>
                        <dt>Raça & Classe</dt>
                        <dd>@(FichaCompletaVinculada != null ? $"{FichaCompletaVinculada.RacaTexto} · {FichaCompletaVinculada.ClasseTexto} (Nv. {FichaCompletaVinculada.Nivel})" : "—")</dd>
                    </div>
                    <div>
                        <dt>Status de Aprovação</dt>
                        <dd>
                            @if (StatusFichaAtual == "Aceita")
                            {
                                <strong style="color: #78be82;">✓ Aceita pelo Mestre</strong>
                            }
                            else if (StatusFichaAtual == "Pendente")
                            {
                                <strong style="color: #e6c665;">⏳ Aguardando Mestre</strong>
                            }
                            else if (StatusFichaAtual == "Recusada")
                            {
                                <strong style="color: #e88d8d;">✕ Recusada pelo Mestre</strong>
                            }
                            else
                            {
                                <span>Não enviada</span>
                            }
                        </dd>
                    </div>
                </dl>

                <!-- EXIBE O INVENTÁRIO VINCULADO DO PERSONAGEM NA ETAPA DE CONECTAR -->
                @if (FichaCompletaVinculada?.Inventario != null)
                {
                    <div class="ficha-preview-pergaminho" style="margin-top: 16px;">
                        <h4 style="margin: 0 0 10px; color: #392819; font-size: 14px; text-transform: uppercase;">
                            🎒 Inventário de @FichaCompletaVinculada.Nome na Sessão (Carga: @(FichaCompletaVinculada.Inventario.PesoAtual ?? 0) kg / @(FichaCompletaVinculada.Inventario.CapacidadeCarga ?? 0) kg)
                        </h4>
                        <div class="dados-fisicos-grid" style="margin-bottom: 10px;">
                            <div><span>PC</span><strong>@FichaCompletaVinculada.Inventario.MoedasPC</strong></div>
                            <div><span>PP</span><strong>@FichaCompletaVinculada.Inventario.MoedasPP</strong></div>
                            <div><span>PE</span><strong>@FichaCompletaVinculada.Inventario.MoedasPE</strong></div>
                            <div><span>PO</span><strong>@FichaCompletaVinculada.Inventario.MoedasPO</strong></div>
                            <div><span>PL</span><strong>@FichaCompletaVinculada.Inventario.MoedasPL</strong></div>
                        </div>

                        @if (FichaCompletaVinculada.Inventario.Itens != null && FichaCompletaVinculada.Inventario.Itens.Any())
                        {
                            <ul class="lista-itens-preview">
                                @foreach (var ii in FichaCompletaVinculada.Inventario.Itens)
                                {
                                    <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> <span>(@(ii.Item?.Tipo ?? "Geral") · @(ii.Item?.Peso ?? 0) kg)</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="margin:0; font-size:12px;">Nenhum item equipado.</p>
                        }
                    </div>
                }

                @if (StatusFichaAtual != "Aceita")
                {
                    <div class="ficha-alert pendente" style="margin-top: 16px;">
                        Para entrar na sala de jogo, selecione uma ficha que esteja <strong>Aceita pelo Mestre</strong> (na Etapa 1) ou clique em "Atualizar Status".
                    </div>
                }

                <p class="join-status @(TemErro ? "erro" : "")" role="status" aria-live="polite">@Mensagem</p>

                <div class="join-actions">
                    <button class="action-secondary" type="button" disabled="@Carregando" @onclick="() => IrParaEtapa(1)">
                        ← Voltar para Fichas (Etapa 1)
                    </button>
                    <div style="display: flex; gap: 10px;">
                        <button class="action-secondary" type="button" disabled="@Carregando" @onclick="RecarregarStatusAsync">
                            ↻ Atualizar Status
                        </button>
                        <button class="action-primary"
                                type="button"
                                disabled="@(Carregando || StatusFichaAtual != "Aceita")"
                                @onclick="ConectarNaSala">
                            @(Carregando ? "Conectando..." : $"Conectar com {(FichaCompletaVinculada?.Nome ?? "Ficha")} →")
                        </button>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    [SupplyParameterFromQuery(Name = "campanhaId")]
    public int? CampanhaIdQuery { get; set; }

    private int EtapaAtual { get; set; } = 1;
    private string Mensagem { get; set; } = string.Empty;
    private bool TemErro { get; set; }
    private bool Carregando { get; set; }
    private bool ModoAdicionarNovaFicha { get; set; }
    private bool ModoReenviarRecusada { get; set; }

    private Campanha? CampanhaAtual { get; set; }
    private List<Personagem> PersonagensDisponiveis { get; set; } = new();
    private List<PersonagemCampanha> VinculosDoJogador { get; set; } = new();

    private List<Item> ItensDaCampanha =>
        CampanhaAtual?.Itens.OrderBy(i => i.Nome).ToList() ?? new List<Item>();

    private List<PersonagemCampanha> FichasAceitasDoJogador =>
        VinculosDoJogador
            .Where(v => string.IsNullOrEmpty(v.StatusAprovacao) ||
                        v.StatusAprovacao.Equals("Aceita", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private bool PossuiAlgumaFichaAceita => FichasAceitasDoJogador.Any();

    private List<Personagem> PersonagensNaoEnviados =>
        PersonagensDisponiveis
            .Where(p => !VinculosDoJogador.Any(v => v.IdPersonagem == p.IdPersonagem))
            .ToList();

    private PersonagemCampanha? VinculoSelecionado { get; set; }
    private Personagem? FichaCompletaVinculada { get; set; }
    private int NovoPersonagemParaEnviarId { get; set; }
    private Personagem? PersonagemEmPreparacao { get; set; }
    private string StatusFichaAtual => VinculoSelecionado?.StatusAprovacao ?? string.Empty;
    private string AbaFichaPreview { get; set; } = "atributos";

    // Estado do Construtor de Inventário da Campanha
    private List<ItemInventarioVinculado> ItensInventarioEdicao { get; set; } = new();
    private int MoedasPC { get; set; } = 0;
    private int MoedasPP { get; set; } = 0;
    private int MoedasPE { get; set; } = 0;
    private int MoedasPO { get; set; } = 10;
    private int MoedasPL { get; set; } = 0;
    private string NotasInventario { get; set; } = string.Empty;

    private decimal PesoTotalEdicao =>
        ItensInventarioEdicao.Where(i => i.IdItem > 0).Sum(i => i.PesoUnitario * Math.Max(1, i.Quantidade));

    private decimal CapacidadeCargaMaximaEdicao =>
        Math.Round(Math.Max(1, PersonagemEmPreparacao?.Forca ?? 10) * 7.5m, 1);

    protected override async Task OnParametersSetAsync()
    {
        if (!SessaoUsuario.EstaLogado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CarregarContextoJogadorAsync();
    }

    private async Task CarregarContextoJogadorAsync()
    {
        Carregando = true;
        LimparMensagem();
        try
        {
            int idUsuario = SessaoUsuario.IdUsuarioLogado;
            PersonagensDisponiveis = await PersonagemService.ObterPersonagensPorUsuarioAsync(idUsuario);

            int idAlvo = IdCampanha > 0 ? IdCampanha : (CampanhaIdQuery ?? 0);
            if (idAlvo <= 0)
            {
                var campanhasDoJogador = await CampanhaService.ObterCampanhasComoJogadorAsync(idUsuario);
                if (campanhasDoJogador.Any())
                    idAlvo = campanhasDoJogador[0].IdCampanha;
            }

            if (idAlvo > 0)
            {
                CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(idAlvo);
                await SincronizarVinculosDoJogadorAsync();
            }
        }
        catch (Exception ex)
        {
            DefinirErro($"Erro ao carregar dados da sessão: {ex.Message}");
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task SincronizarVinculosDoJogadorAsync(int? idPersonagemPreferencial = null)
    {
        VinculosDoJogador.Clear();
        VinculoSelecionado = null;
        FichaCompletaVinculada = null;

        if (CampanhaAtual is null) return;

        int idUsuario = SessaoUsuario.IdUsuarioLogado;
        VinculosDoJogador = CampanhaAtual.PersonagemCampanhas
            .Where(pc => pc.Personagem != null && pc.Personagem.IdAccount == idUsuario)
            .OrderByDescending(pc => pc.StatusAprovacao == "Aceita")
            .ThenByDescending(pc => pc.StatusAprovacao == "Pendente")
            .ToList();

        if (VinculosDoJogador.Any())
        {
            var escolhido = (idPersonagemPreferencial.HasValue
                ? VinculosDoJogador.FirstOrDefault(v => v.IdPersonagem == idPersonagemPreferencial.Value)
                : null)
                ?? FichasAceitasDoJogador.FirstOrDefault()
                ?? VinculosDoJogador.First();

            await CarregarVinculoSelecionadoInternoAsync(escolhido);
        }
        else if (PersonagensNaoEnviados.Count == 1)
        {
            await AoEscolherPersonagemParaEnviarAsync(PersonagensNaoEnviados[0].IdPersonagem);
        }
    }

    private async Task SelecionarVinculoExistenteAsync(PersonagemCampanha vinculo)
    {
        if (Carregando) return;
        Carregando = true;
        try
        {
            await CarregarVinculoSelecionadoInternoAsync(vinculo);
        }
        finally
        {
            Carregando = false;
            StateHasChanged();
        }
    }

    private async Task CarregarVinculoSelecionadoInternoAsync(PersonagemCampanha vinculo)
    {
        VinculoSelecionado = vinculo;
        FichaCompletaVinculada = await PersonagemService.ObterPorIdAsync(vinculo.IdPersonagem) ?? vinculo.Personagem;
    }

    private async Task AoEscolherPersonagemParaEnviarAsync(int idPersonagem)
    {
        NovoPersonagemParaEnviarId = idPersonagem;
        PersonagemEmPreparacao = await PersonagemService.ObterPorIdAsync(idPersonagem)
                                 ?? PersonagensDisponiveis.FirstOrDefault(p => p.IdPersonagem == idPersonagem);
        PreencherEditorInventarioComDadosDoPersonagem(PersonagemEmPreparacao);
    }

    private void PreencherEditorInventarioComDadosDoPersonagem(Personagem? p)
    {
        ItensInventarioEdicao.Clear();
        MoedasPC = 0;
        MoedasPP = 0;
        MoedasPE = 0;
        MoedasPO = 10;
        MoedasPL = 0;
        NotasInventario = string.Empty;

        if (p?.Inventario == null) return;

        MoedasPC = p.Inventario.MoedasPC;
        MoedasPP = p.Inventario.MoedasPP;
        MoedasPE = p.Inventario.MoedasPE;
        MoedasPO = p.Inventario.MoedasPO;
        MoedasPL = p.Inventario.MoedasPL;
        NotasInventario = p.Inventario.Notas ?? string.Empty;

        var idsPermitidosNaCampanha = ItensDaCampanha.Select(i => i.IdItem).ToHashSet();

        foreach (var ii in p.Inventario.Itens)
        {
            if (!idsPermitidosNaCampanha.Contains(ii.IdItem)) continue;

            var itemRef = ItensDaCampanha.FirstOrDefault(x => x.IdItem == ii.IdItem) ?? ii.Item;
            if (itemRef != null)
            {
                ItensInventarioEdicao.Add(new ItemInventarioVinculado
                {
                    Categoria = PersonagemCriarViewModel.ClassificarCategoriaItem(itemRef),
                    IdItem = itemRef.IdItem,
                    Nome = itemRef.Nome,
                    Quantidade = ii.Quantidade,
                    PesoUnitario = itemRef.Peso ?? 0m,
                    PrecoUnitario = itemRef.Preco ?? 0m
                });
            }
        }
    }

    private async Task AbrirModoEnviarNovaFicha()
    {
        LimparMensagem();
        ModoReenviarRecusada = false;
        ModoAdicionarNovaFicha = true;
        int idInicial = PersonagensNaoEnviados.FirstOrDefault()?.IdPersonagem ?? 0;
        if (idInicial > 0)
            await AoEscolherPersonagemParaEnviarAsync(idInicial);
        else
            PersonagemEmPreparacao = null;
    }

    private void AbrirReenvioDeFichaRecusada()
    {
        // Só permite abrir se a ficha tiver sido Recusada pelo Mestre
        if (FichaCompletaVinculada == null || StatusFichaAtual != "Recusada") return;
        LimparMensagem();
        ModoAdicionarNovaFicha = false;
        ModoReenviarRecusada = true;
        NovoPersonagemParaEnviarId = FichaCompletaVinculada.IdPersonagem;
        PersonagemEmPreparacao = FichaCompletaVinculada;
        PreencherEditorInventarioComDadosDoPersonagem(FichaCompletaVinculada);
    }

    private void CancelarModoEdicaoOuAdicao()
    {
        ModoAdicionarNovaFicha = false;
        ModoReenviarRecusada = false;
        PersonagemEmPreparacao = null;
        LimparMensagem();
    }

    private IEnumerable<Item> ObterItensCampanhaPorCategoria(string categoria)
    {
        if (!ItensDaCampanha.Any()) return Enumerable.Empty<Item>();
        var filtrados = ItensDaCampanha.Where(i => PersonagemCriarViewModel.ClassificarCategoriaItem(i) == categoria);
        return filtrados.Any() ? filtrados : ItensDaCampanha;
    }

    private void AdicionarSlotItem(string categoria)
    {
        ItensInventarioEdicao.Add(new ItemInventarioVinculado
        {
            Categoria = categoria,
            Quantidade = 1
        });
    }

    private void AlterarItemSlot(ItemInventarioVinculado slot, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idItem))
        {
            slot.IdItem = idItem;
            var itemCampanha = ItensDaCampanha.FirstOrDefault(i => i.IdItem == idItem);
            if (itemCampanha != null)
            {
                slot.Nome = itemCampanha.Nome;
                slot.PesoUnitario = itemCampanha.Peso ?? 0m;
                slot.PrecoUnitario = itemCampanha.Preco ?? 0m;
            }
            else
            {
                slot.Nome = string.Empty;
                slot.PesoUnitario = 0m;
                slot.PrecoUnitario = 0m;
            }
        }
    }

    private void RemoverSlotItem(ItemInventarioVinculado slot)
    {
        ItensInventarioEdicao.Remove(slot);
    }

    private async Task EnviarFichaComInventarioAoMestreAsync()
    {
        if (CampanhaAtual is null || PersonagemEmPreparacao is null)
        {
            DefinirErro("Selecione um personagem para enviar ao Mestre.");
            return;
        }

        int idEnviado = PersonagemEmPreparacao.IdPersonagem;

        // Trava de segurança: impede editar itens de ficha que já foi enviada (Pendente) ou aprovada (Aceita)
        var vinculoExistente = VinculosDoJogador.FirstOrDefault(v => v.IdPersonagem == idEnviado);
        if (vinculoExistente != null && !string.Equals(vinculoExistente.StatusAprovacao, "Recusada", StringComparison.OrdinalIgnoreCase))
        {
            DefinirErro("Esta ficha já foi enviada ao Mestre e seus itens não podem mais ser editados por aqui.");
            return;
        }

        Carregando = true;
        LimparMensagem();
        try
        {
            var dadosInventario = new Inventario
            {
                IdPersonagem = idEnviado,
                CapacidadeCarga = CapacidadeCargaMaximaEdicao,
                PesoAtual = PesoTotalEdicao,
                Dinheiro = MoedasPO,
                MoedasPC = MoedasPC,
                MoedasPP = MoedasPP,
                MoedasPE = MoedasPE,
                MoedasPO = MoedasPO,
                MoedasPL = MoedasPL,
                Notas = NotasInventario
            };

            var listaItens = ItensInventarioEdicao
                .Where(i => i.IdItem > 0)
                .Select(i => (i.IdItem, i.Quantidade))
                .ToList();

            var resultadoInv = await PersonagemService.SalvarInventarioCampanhaAsync(idEnviado, dadosInventario, listaItens);
            if (!resultadoInv.Sucesso)
            {
                DefinirErro(resultadoInv.Mensagem);
                return;
            }

            var resultado = await CampanhaService.EnviarFichaParaAvaliacaoAsync(CampanhaAtual.IdCampanha, idEnviado);
            if (!resultado.Sucesso)
            {
                DefinirErro(resultado.Mensagem);
                return;
            }

            CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(CampanhaAtual.IdCampanha);
            ModoAdicionarNovaFicha = false;
            ModoReenviarRecusada = false;
            PersonagemEmPreparacao = null;
            await SincronizarVinculosDoJogadorAsync(idEnviado);
            AbaFichaPreview = "inventario";
            Mensagem = "Ficha e inventário enviados para avaliação do Mestre!";
        }
        catch (Exception ex)
        {
            DefinirErro($"Erro ao enviar ficha e inventário: {ex.Message}");
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task RecarregarStatusAsync()
    {
        if (CampanhaAtual is null) return;
        Carregando = true;
        LimparMensagem();
        try
        {
            int? idAtual = VinculoSelecionado?.IdPersonagem;
            CampanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(CampanhaAtual.IdCampanha);
            await SincronizarVinculosDoJogadorAsync(idAtual);
            Mensagem = StatusFichaAtual == "Aceita"
                ? "Ficha aprovada! Você já pode conectar na sessão."
                : "Status atualizado.";
        }
        finally
        {
            Carregando = false;
        }
    }

    private void ConectarNaSala()
    {
        if (StatusFichaAtual != "Aceita" && FichasAceitasDoJogador.Any())
        {
            VinculoSelecionado = FichasAceitasDoJogador.First();
            FichaCompletaVinculada = VinculoSelecionado.Personagem;
        }

        if (StatusFichaAtual != "Aceita")
        {
            DefinirErro("Selecione uma ficha aprovada pelo Mestre antes de conectar na sessão.");
            return;
        }

        Navigation.NavigateTo("/saladojogo");
    }

    private void IrParaEtapa(int etapa)
    {
        if (etapa == 2 && StatusFichaAtual != "Aceita" && FichasAceitasDoJogador.Any())
        {
            _ = SelecionarVinculoExistenteAsync(FichasAceitasDoJogador.First());
        }

        EtapaAtual = etapa;
        LimparMensagem();
    }

    private static string ObterModificador(int valor)
    {
        var modificador = (int)Math.Floor((valor - 10) / 2.0);
        return modificador >= 0 ? $"+{modificador}" : modificador.ToString();
    }

    private void VoltarParaHome() => Navigation.NavigateTo("/campanhas");
    private void LimparMensagem() { Mensagem = string.Empty; TemErro = false; }
    private void DefinirErro(string mensagem) { TemErro = true; Mensagem = mensagem; }
}