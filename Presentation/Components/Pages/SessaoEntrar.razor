                                                    {
                                                        <button type="button" class="remover-item-campanha" @onclick="() => ViewModel.RemoverClasseEdicao(cl)">×</button>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="diario-grid-preview">
                                            <div class="box-texto-preview">
                                                <h4>Aparência</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Aparencia" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Aliados e Organizações</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Aliados" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
