                                                    {
                                                        <label style="display:flex; align-items:center; gap:6px; font-size:12px; cursor:pointer;">
                                                            <input type="checkbox"
                                                                   checked="@ViewModel.SalvaguardasEdicao.Contains(salv)"
                                                                   @onchange="e => ViewModel.AlternarSalvaguardaEdicao(salv, (bool)(e.Value ?? false))" />
                                                            <span>@salv</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                            <div>
                                                <h4>Perícias Treinadas</h4>
                                                <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:6px; margin-top:6px; max-height:170px; overflow-y:auto;">
                                                    @foreach (var pericia in ViewModel.ListaPericias)
                                                    {
                                                        <label style="display:flex; align-items:center; gap:6px; font-size:12px; cursor:pointer;">
                                                            <input type="checkbox"
                                                                   checked="@ViewModel.PericiasEdicao.Contains(pericia)"
                                                                   @onchange="e => ViewModel.AlternarPericiaEdicao(pericia, (bool)(e.Value ?? false))" />
                                                            <span>@pericia</span>
                                                        </label>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="diario-grid-preview">
                                            <div class="box-texto-preview">
                                                <h4>Traços de Personalidade</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.TracosPersonalidade" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Ponto de Vista</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.PontoDeVista" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Ideais</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Ideais" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Ligações</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Ligacoes" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Defeitos</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Defeitos" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                            <div class="box-texto-preview">
                                                <h4>Idiomas</h4>
                                                <textarea rows="3" @bind="ViewModel.PersonagemEmPreparacao.Idiomas" style="width:100%; background:rgba(255,255,255,0.65); border:1px solid #b59257; border-radius:4px; padding:6px; color:#2b1b0e;"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @* ABA EDITÁVEL 2: PERSONAGEM, CLASSES E HISTÓRIA *@
                                @if (ViewModel.ModoReenviarRecusada && ViewModel.AbaEdicaoRecusada == "personagem")
