@page "/sessao-iniciar/{idCampanha:int}"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Domain.Campanhas
@using RPGdeMesa.Domain.Bestiario
@using RPGdeMesa.Domain.Itens
@using RPGdeMesa.Domain.Npcs
@using RPGdeMesa.Domain.Personagens
@inject CampanhaService CampanhaService
@inject PersonagemService PersonagemService
@inject NpcService NpcService
@inject ItemService ItemService
@inject NavigationManager Navigation

<NavMenu />

<div class="app-shell">
    <main class="app-content">
        <div class="session-layout">
            <!-- Sidebar: Navegação e Jogadores -->
            <aside class="session-sidebar">
                <nav class="session-nav" aria-label="Páginas da sessão">
                    <a class="session-nav-link @(abaMenu == "iniciar" ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirIniciar">Iniciar sessão</a>
                    <a class="session-nav-link @(abaMenu == "config" ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirConfig">Configurações</a>
                    <a class="session-nav-link @(abaMenu == "fichas" ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirFichas" style="display:flex; justify-content:space-between; align-items:center;">
                        <span>Fichas dos Jogadores</span>
                        @if (FichasPendentes.Any())
                        {
                            <span class="badge-pendentes">@FichasPendentes.Count()</span>
                        }
                    </a>
                    <a class="session-nav-link @(abaMenu == "hist" ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirHist">Histórico</a>
                </nav>

                <section class="session-players-panel" aria-labelledby="titulo-jogadores">
                    <h2 id="titulo-jogadores">Jogadores Aceitos na Mesa</h2>
                    <div class="session-players">
                        @if (campanhaAtual?.Personagens != null && campanhaAtual.Personagens.Any())
                        {
                            @foreach (var p in campanhaAtual.Personagens)
                            {
                                <div class="player-option" style="cursor:pointer;" title="Clique para inspecionar a ficha" @onclick="() => InspecionarFichaNaAbaAsync(p.IdPersonagem)">
                                    <span>@p.Nome<span>@(p.RacaTexto ?? "Aventureiro") · @(p.ClasseTexto ?? "Geral") (Nv. @p.Nivel)</span></span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="aviso-vazio" style="font-size: 0.85rem; padding: 10px; color: #888;">Nenhuma ficha aceita ainda.</p>
                        }
                    </div>
                </section>
            </aside>

            <!-- Conteúdo Principal -->
            <section class="preview-content">
                @if (abaMenu == "iniciar")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Prepare a mesa</p>
                            <h1>Iniciar sessão</h1>
                            <p class="page-description">Reúna o grupo, gerencie o plano e acompanhe a aventura.</p>
                        </div>
                    </header>
                    <section class="session-summary" aria-label="Resumo da sessão">
                        <p class="summary-kicker">Campanha Ativa</p>
                        <h2>@(campanhaAtual?.Nome ?? "Carregando...")</h2>
                        <p class="summary-description">@(campanhaAtual?.Descricao ?? "Sem descrição informada.")</p>
                        <dl class="summary-details">
                            <div><dt>Código</dt><dd>@(campanhaAtual?.CodigoConvite ?? "---")</dd></div>
                            <div><dt>Criação</dt><dd>@campanhaAtual?.DataCriacao.ToString("dd/MM/yyyy")</dd></div>
                            <div><dt>Aventureiros Aceitos</dt><dd>@(campanhaAtual?.Personagens.Count() ?? 0) presentes</dd></div>
                            <div><dt>Fichas Pendentes</dt><dd>@FichasPendentes.Count() aguardando avaliação</dd></div>
                        </dl>
                        <div style="display:flex; gap:12px; flex-wrap:wrap;">
                            <a class="action-primary" href="/saladojogo">Abrir Sala de Jogo <span aria-hidden="true">→</span></a>
                            @if (FichasPendentes.Any())
                            {
                                <button type="button" class="action-primary" style="background:#6f5296; border-color:#a28acb;" @onclick="AbrirFichas">
                                    Avaliar @FichasPendentes.Count() Ficha(s) Pendente(s)
                                </button>
                            }
                            <a class="action-primary" style="background:transparent; border-color:rgba(217,184,120,0.4);" href="/campanhas">Voltar para campanhas</a>
                        </div>
                    </section>
                }

                @if (abaMenu == "config")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Preparação da mesa</p>
                            <h1>Configurações da sessão</h1>
                            <p class="page-description">Monte encontros, monstros, NPCs e itens da aventura.</p>
                        </div>
                    </header>

                    <div class="session-page-content">
                        <section class="configuration-content" aria-label="Conteúdo da sessão">
                            <div class="configuration-heading">
                                <div><p class="page-kicker">Encontro atual</p><h2>@(campanhaAtual?.Nome)</h2></div>
                            </div>
                            <div class="configuration-layout">
                                <!-- LADO ESQUERDO: Navegador de Recursos -->
                                <section class="resource-browser" aria-labelledby="titulo-recursos">
                                    <h3 id="titulo-recursos">Elementos da sessão</h3>

                                    <div class="search-box">
                                        <span aria-hidden="true">⌕</span>
                                        <input id="busca-catalogo" type="search" @bind="termoBusca" @bind:event="oninput" placeholder="Busque por nome ou tipo" autocomplete="off" />
                                    </div>
                                    
                                    <div class="resource-tabs" role="tablist">
                                        <button class="resource-tab @(categoriaAtiva == "todos" ? "ativa" : "")" @onclick='() => categoriaAtiva = "todos"'>Todos</button>
                                        <button class="resource-tab @(categoriaAtiva == "npcs" ? "ativa" : "")" @onclick='() => categoriaAtiva = "npcs"'>NPCs</button>
                                        <button class="resource-tab @(categoriaAtiva == "monstros" ? "ativa" : "")" @onclick='() => categoriaAtiva = "monstros"'>Monstros</button>
                                        <button class="resource-tab @(categoriaAtiva == "itens" ? "ativa" : "")" @onclick='() => categoriaAtiva = "itens"'>Itens</button>
                                    </div>

                                    <div class="link-tabs" role="tablist">
                                        <button class="link-tab @(modoVisualizacao == "vinculados" ? "ativa" : "")" @onclick='() => modoVisualizacao = "vinculados"'>Vinculados</button>
                                        <button class="link-tab @(modoVisualizacao == "disponiveis" ? "ativa" : "")" @onclick='() => modoVisualizacao = "disponiveis"'>Disponíveis (Biblioteca)</button>
                                    </div>

                                    <div class="resource-list">
                                        @if (modoVisualizacao == "vinculados")
                                        {
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "npcs")
                                            {
                                                @foreach (var npc in NpcsVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[NPC]</strong> @npc.Nome <span>(@(npc.ClasseTexto ?? npc.Ocupacao))</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular NPC" aria-label="Desvincular NPC" @onclick="() => DesvincularNpc(npc.IdNpc)">✕</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "monstros")
                                            {
                                                @foreach (var mc in MonstrosVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[Monstro]</strong> @mc.Monstro?.Nome <span>(ND: @mc.Monstro?.NivelDesafio)</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular Monstro" aria-label="Desvincular Monstro" @onclick="() => DesvincularMonstro(mc.IdMonstro)">✕</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "itens")
                                            {
                                                @foreach (var ic in ItensVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[Item]</strong> @ic.Item?.Nome <span>(@ic.Item?.Tipo)</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular Item" aria-label="Desvincular Item" @onclick="() => DesvincularItem(ic.IdItem)">✕</button>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @if (categoriaAtiva == "npcs" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var n in NpcsDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">NPC: <strong>@n.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular NPC" aria-label="Vincular NPC" @onclick="() => VincularNpcExistente(n.IdNpc)">+</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "monstros" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var m in MonstrosDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">Monstro: <strong>@m.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular Monstro" aria-label="Vincular Monstro" @onclick="() => VincularMonstro(m.IdMonstro)">+</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "itens" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var i in ItensDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">Item: <strong>@i.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular Item" aria-label="Vincular Item" @onclick="() => VincularItem(i.IdItem)">+</button>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </section>

                                <!-- LADO DIREITO: Formulário Dinâmico -->
                                <form class="resource-editor" @onsubmit="SalvarRegistroAsync">
                                    <div class="editor-heading">
                                        <div><p class="page-kicker">Ficha do elemento</p><h3>Cadastrar e Vincular @categoriaSelecionada.ToUpper()</h3></div>
                                    </div>

                                    <label class="form-field">
                                        Categoria de Cadastro
                                        <select @bind="categoriaSelecionada">
                                            <option value="npc">NPC</option>
                                            <option value="monstro">Monstro</option>
                                            <option value="item">Item</option>
                                        </select>
                                    </label>

                                    @if (categoriaSelecionada == "npc")
                                    {
                                        <label class="form-field">Nome do NPC<input @bind="npcNome" required maxlength="60" placeholder="Ex.: Aldeão" /></label>
                                        <label class="form-field">
                                            Raça
                                            <select @bind="npcRaca">
                                                <option value="Humano">Humano</option>
                                                <option value="Elfo">Elfo</option>
                                                <option value="Anão">Anão</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Classe
                                            <select @bind="npcClasse">
                                                <option value="Guerreiro">Guerreiro</option>
                                                <option value="Mago">Mago</option>
                                                <option value="Bardo">Bardo</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Nível<input @bind="npcNivel" type="number" min="1" max="20" /></label>
                                        <label class="form-field">Antecedente<input @bind="npcAntecedente" maxlength="50" placeholder="Ex.: Batedor" /></label>
                                        <label class="form-field">
                                            Tendência
                                            <select @bind="npcTendencia">
                                                <option value="Neutra">Neutra</option>
                                                <option value="Leal e boa">Leal e boa</option>
                                                <option value="Caótica e má">Caótica e má</option>
                                            </select>
                                        </label>

                                        <div class="form-divider" style="margin: 10px 0 5px 0; font-size: 0.85rem; color: #d4af37;">Atributos</div>
                                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
                                            <label class="form-field" style="font-size:0.8rem;">FOR<input @bind="npcForca" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">DES<input @bind="npcDestreza" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CON<input @bind="npcConstituicao" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">INT<input @bind="npcInteligencia" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">SAB<input @bind="npcSabedoria" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CAR<input @bind="npcCarisma" type="number" min="1" max="30" style="padding:4px;" /></label>
                                        </div>

                                        <label class="form-field" style="margin-top: 8px;">História e anotações<textarea @bind="npcHistoria" rows="2" placeholder="Detalhes do NPC..."></textarea></label>
                                    }
                                    else if (categoriaSelecionada == "monstro")
                                    {
                                        <label class="form-field">Nome da criatura<input @bind="monstroNome" required maxlength="60" placeholder="Ex.: Guardião" /></label>
                                        <label class="form-field">
                                            Tipo
                                            <select @bind="monstroTipo" style="color: white;">
                                                <option value="Outro">Outro</option>
                                                <option value="Dragao">Dragão</option>
                                                <option value="Fera">Fera</option>
                                                <option value="Morto-vivo">Morto-vivo</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Tamanho
                                            <select @bind="monstroTamanho" style="color: white;">
                                                <option value="Médio">Médio</option>
                                                <option value="Grande">Grande</option>
                                                <option value="Pequeno">Pequeno</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Alinhamento<input @bind="monstroAlinhamento" maxlength="40" placeholder="Ex.: Caótico e mau" /></label>
                                        <label class="form-field">Nível de desafio<input @bind="monstroNd" type="number" min="0" max="30" step="0.125" /></label>
                                        <label class="form-field">Classe de armadura<input @bind="monstroDefesa" type="number" min="0" max="40" /></label>
                                        <label class="form-field">Pontos de vida<input @bind="monstroVida" type="number" min="1" max="9999" /></label>
                                        <label class="form-field">Deslocamento<input @bind="monstroDeslocamento" maxlength="50" placeholder="9 m" /></label>
                                        <label class="form-field">Sentidos<input @bind="monstroSentidos" maxlength="80" placeholder="Visão no escuro 18 m" /></label>
                                        <label class="form-field full-width">Resistências e imunidades<input @bind="monstroResistencias" maxlength="120" placeholder="Ex.: frio, veneno" /></label>
                                        <label class="form-field full-width">Habilidades especiais<input @bind="monstroHabilidades" maxlength="160" placeholder="Ex.: Ataque múltiplo" /></label>
                                        <label class="form-field full-width">Descrição<textarea @bind="monstroDescricao" rows="2" placeholder="Táticas e anotações..."></textarea></label>
                                    }
                                    else
                                    {
                                        <label class="form-field">Nome do Item<input @bind="itemNome" required maxlength="100" placeholder="Ex.: Espada Longa" /></label>
                                        <label class="form-field">
                                            Tipo
                                            <select @bind="itemTipo" style="color: white;">
                                                <option value="">Selecionar...</option>
                                                <option value="Anéis">Anéis</option>
                                                <option value="Armadura">Armadura</option>
                                                <option value="armas">armas</option>
                                                <option value="Bastões">Bastões</option>
                                                <option value="cajados">cajados</option>
                                                <option value="itens maravilhosos">itens maravilhosos</option>
                                                <option value="pergaminhos">pergaminhos</option>
                                                <option value="poções">poções</option>
                                                <option value="varinhas">varinhas</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Peso (kg)<input @bind="itemPeso" type="number" step="0.1" min="0" /></label>
                                        <label class="form-field">Preço (PO)<input @bind="itemPreco" type="number" step="0.01" min="0" /></label>
                                        <label class="form-field">Dano<input @bind="itemDano" maxlength="20" placeholder="Ex.: 1d8" /></label>
                                        <label class="form-field">Tipo de Dano<input @bind="itemTipoDano" maxlength="30" placeholder="Ex.: Cortante" /></label>
                                        <label class="form-field">Propriedades<input @bind="itemPropriedades" maxlength="100" placeholder="Ex.: Versátil, acuidade" /></label>
                                        <label class="form-field">Bônus de CA<input @bind="itemCaBonus" type="number" min="0" max="10" /></label>
                                        
                                        <label class="form-field">
                                            Raridade
                                            <select @bind="itemRaridade">
                                                <option value="">Sem raridade</option>
                                                <option value="Comum">Comum</option>
                                                <option value="Incomum">Incomum</option>
                                                <option value="Raro">Raro</option>
                                                <option value="Muito Raro">Muito Raro</option>
                                                <option value="Lendário">Lendário</option>
                                            </select>
                                        </label>

                                        <label class="form-field">
                                            Sintonização
                                            <select @bind="itemSintonizacao">
                                                <option value="Não">Não</option>
                                                <option value="Sim">Sim</option>
                                            </select>
                                        </label>

                                        <label class="form-field full-width">Descrição<textarea @bind="itemDescricao" rows="2" placeholder="Efeito mágico ou história do item..."></textarea></label>
                                    }

                                    <div class="editor-actions">
                                        <button class="save-button" type="submit">Cadastrar e Vincular</button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(mensagemFeedback))
                                    {
                                        <p class="save-status" role="status" style="margin-top: 10px; color: #d4af37;">@mensagemFeedback</p>
                                    }
                                </form>
                            </div>
                        </section>
                    </div>
                }

                @* =========================================================================
                   NOVA ABA DO MESTRE: FICHAS DOS JOGADORES (ACEITAR / RECUSAR E VER FICHA ABAIXO)
                   ========================================================================= *@
                @if (abaMenu == "fichas")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Controle do Mestre</p>
                            <h1>Fichas dos Jogadores</h1>
                            <p class="page-description">Inspecione as fichas enviadas pelos jogadores, aceite ou recuse a entrada na mesa.</p>
                        </div>
                    </header>

                    <div class="session-page-content">
                        <div class="link-tabs" role="tablist" style="max-width: 480px; margin-bottom: 16px;">
                            <button class="link-tab @(filtroFichasMestre == "pendentes" ? "ativa" : "")" @onclick='() => filtroFichasMestre = "pendentes"'>
                                Fichas para Validar <span>@FichasPendentes.Count()</span>
                            </button>
                            <button class="link-tab @(filtroFichasMestre == "aceitas" ? "ativa" : "")" @onclick='() => filtroFichasMestre = "aceitas"'>
                                Fichas Aceitas <span>@FichasAceitas.Count()</span>
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(mensagemFeedbackFichas))
                        {
                            <p class="save-status" style="margin-bottom: 14px; font-size: 12px; color: #d4af37; font-weight: bold;">@mensagemFeedbackFichas</p>
                        }

                        <div class="fichas-mestre-lista">
                            @if (filtroFichasMestre == "pendentes")
                            {
                                @if (FichasPendentes.Any())
                                {
                                    @foreach (var pc in FichasPendentes)
                                    {
                                        var p = pc.Personagem!;
                                        <div class="ficha-mestre-card @(fichaInspecionada?.IdPersonagem == p.IdPersonagem ? "selecionada" : "")">
                                            <div class="ficha-mestre-info">
                                                <strong>@p.Nome</strong>
                                                <span>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</span>
                                                <small>Jogador: @(p.Usuario?.UsarName ?? $"Conta #{p.IdAccount}")</small>
                                            </div>
                                            <div class="ficha-mestre-acoes">
                                                <button type="button" class="btn-inspecionar" @onclick="() => CarregarFichaParaInspecaoAsync(p.IdPersonagem)">
                                                    @(fichaInspecionada?.IdPersonagem == p.IdPersonagem ? "▼ Ficha Aberta Abaixo" : "👁 Inspecionar Ficha")
                                                </button>
                                                <button type="button" class="btn-aprovar-ficha" @onclick="() => AprovarFichaJogadorAsync(p.IdPersonagem)">✓ Aceitar</button>
                                                <button type="button" class="btn-recusar-ficha" @onclick="() => RecusarFichaJogadorAsync(p.IdPersonagem)">✕ Recusar</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="empty-message">Nenhuma ficha pendente de validação no momento.</p>
                                }
                            }
                            else
                            {
                                @if (FichasAceitas.Any())
                                {
                                    @foreach (var pc in FichasAceitas)
                                    {
                                        var p = pc.Personagem!;
                                        <div class="ficha-mestre-card @(fichaInspecionada?.IdPersonagem == p.IdPersonagem ? "selecionada" : "")">
                                            <div class="ficha-mestre-info">
                                                <strong>@p.Nome <span class="tag-aceita">✓ Aceita</span></strong>
                                                <span>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</span>
                                                <small>Jogador: @(p.Usuario?.UsarName ?? $"Conta #{p.IdAccount}")</small>
                                            </div>
                                            <div class="ficha-mestre-acoes">
                                                <button type="button" class="btn-inspecionar" @onclick="() => CarregarFichaParaInspecaoAsync(p.IdPersonagem)">
                                                    @(fichaInspecionada?.IdPersonagem == p.IdPersonagem ? "▼ Ficha Aberta Abaixo" : "👁 Visualizar Ficha")
                                                </button>
                                                <button type="button" class="btn-recusar-ficha" title="Revogar aprovação da ficha" @onclick="() => RecusarFichaJogadorAsync(p.IdPersonagem)">Revogar</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="empty-message">Nenhuma ficha aceita nesta campanha ainda.</p>
                                }
                            }
                        </div>

                        <!-- =========================================================================
                             PAINEL DE INSPEÇÃO COMPLETA DA FICHA LOGO ABAIXO (ESTILO PERGAMINHO)
                             ========================================================================= -->
                        @if (fichaInspecionada != null)
                        {
                            <section class="ficha-pergaminho-inspecao" aria-label="Inspeção completa da ficha">
                                <div class="inspecao-top-bar">
                                    <span>Inspecionando ficha de <strong>@fichaInspecionada.Nome</strong></span>
                                    <div style="display:flex; gap:8px;">
                                        @if (StatusDaFichaInspecionada == "Pendente")
                                        {
                                            <button type="button" class="btn-aprovar-ficha" @onclick="() => AprovarFichaJogadorAsync(fichaInspecionada.IdPersonagem)">✓ Aceitar Ficha na Mesa</button>
                                            <button type="button" class="btn-recusar-ficha" @onclick="() => RecusarFichaJogadorAsync(fichaInspecionada.IdPersonagem)">✕ Recusar Ficha</button>
                                        }
                                        <button type="button" class="btn-fechar-inspecao" @onclick="() => fichaInspecionada = null">Fechar ✕</button>
                                    </div>
                                </div>

                                <div class="ficha-cabecalho-inspecao">
                                    <div class="retrato-inspecao">
                                        <img src="@(string.IsNullOrEmpty(fichaInspecionada.Imagem) ? "img/armaduraprata.png" : fichaInspecionada.Imagem)" alt="Retrato do personagem" />
                                    </div>
                                    <div class="identidade-inspecao">
                                        <p class="sobretitulo-inspecao">Ficha de Personagem (@StatusDaFichaInspecionada)</p>
                                        <h2>@fichaInspecionada.Nome</h2>
                                        <p class="descricao-inspecao">@(fichaInspecionada.RacaTexto ?? "Raça") • @(fichaInspecionada.ClasseTexto ?? "Classe") • Nível Total @fichaInspecionada.Nivel</p>
                                        <div class="dados-inspecao">
                                            <span><b>Raça:</b> @(fichaInspecionada.RacaTexto ?? "Não informada")</span>
                                            <span><b>Tendência:</b> @(fichaInspecionada.Tendencia ?? "Neutra")</span>
                                            <span><b>Antecedente:</b> @(fichaInspecionada.AntecedenteTexto ?? "Não informado")</span>
                                            <span><b>Experiência:</b> @fichaInspecionada.ExperienciaXp.ToString("N0") XP</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="troca-ficha-inspecao" role="tablist">
                                    <button type="button" class="aba-inspecao @(abaInspecao == "atributos" ? "ativa" : "")" @onclick='() => abaInspecao = "atributos"'>Atributos & Diário</button>
                                    <button type="button" class="aba-inspecao @(abaInspecao == "personagem" ? "ativa" : "")" @onclick='() => abaInspecao = "personagem"'>Personagem & Classes</button>
                                    <button type="button" class="aba-inspecao @(abaInspecao == "inventario" ? "ativa" : "")" @onclick='() => abaInspecao = "inventario"'>Inventário</button>
                                    <button type="button" class="aba-inspecao @(abaInspecao == "grimorio" ? "ativa" : "")" @onclick='() => abaInspecao = "grimorio"'>Grimório</button>
                                </div>

                                @if (abaInspecao == "atributos")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="atributos-grid-inspecao">
                                            <div class="box-attr-inspecao"><span>Força</span><strong>@fichaInspecionada.Forca</strong><small>@ObterModificador(fichaInspecionada.Forca)</small></div>
                                            <div class="box-attr-inspecao"><span>Destreza</span><strong>@fichaInspecionada.Destreza</strong><small>@ObterModificador(fichaInspecionada.Destreza)</small></div>
                                            <div class="box-attr-inspecao"><span>Constituição</span><strong>@fichaInspecionada.Constituicao</strong><small>@ObterModificador(fichaInspecionada.Constituicao)</small></div>
                                            <div class="box-attr-inspecao"><span>Inteligência</span><strong>@fichaInspecionada.Inteligencia</strong><small>@ObterModificador(fichaInspecionada.Inteligencia)</small></div>
                                            <div class="box-attr-inspecao"><span>Sabedoria</span><strong>@fichaInspecionada.Sabedoria</strong><small>@ObterModificador(fichaInspecionada.Sabedoria)</small></div>
                                            <div class="box-attr-inspecao"><span>Carisma</span><strong>@fichaInspecionada.Carisma</strong><small>@ObterModificador(fichaInspecionada.Carisma)</small></div>
                                        </div>

                                        <div class="grid-2-inspecao">
                                            <div class="painel-escuro-inspecao">
                                                <h4>Salvaguardas Marcadas</h4>
                                                <p>@(fichaInspecionada.Salvaguardas.Any() ? string.Join(", ", fichaInspecionada.Salvaguardas.Select(s => s.Atributo)) : "Nenhuma salvaguarda marcada.")</p>
                                            </div>
                                            <div class="painel-escuro-inspecao">
                                                <h4>Perícias Treinadas</h4>
                                                <p>@(fichaInspecionada.Pericias.Any() ? string.Join(", ", fichaInspecionada.Pericias.Select(p => p.NomePericia)) : "Nenhuma perícia marcada.")</p>
                                            </div>
                                        </div>

                                        <div class="grid-2-inspecao">
                                            <div class="painel-marrom-inspecao">
                                                <h4>Traços de Personalidade</h4>
                                                <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.TracosPersonalidade) ? "Não informado." : fichaInspecionada.TracosPersonalidade)</p>
                                            </div>
                                            <div class="painel-marrom-inspecao">
                                                <h4>Ponto de Vista Atual</h4>
                                                <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.PontoDeVista) ? "Não informado." : fichaInspecionada.PontoDeVista)</p>
                                            </div>
                                        </div>

                                        <!-- SWITCH DO DIÁRIO NA INSPEÇÃO DO MESTRE -->
                                        <div class="diario-inspecao-switch">
                                            <div class="diario-inspecao-tabs">
                                                <button type="button" class="@(secaoDiarioInspecao == "ideais" ? "ativa" : "")" @onclick='() => secaoDiarioInspecao = "ideais"'>Ideais</button>
                                                <button type="button" class="@(secaoDiarioInspecao == "ligacoes" ? "ativa" : "")" @onclick='() => secaoDiarioInspecao = "ligacoes"'>Ligações</button>
                                                <button type="button" class="@(secaoDiarioInspecao == "defeitos" ? "ativa" : "")" @onclick='() => secaoDiarioInspecao = "defeitos"'>Defeitos</button>
                                                <button type="button" class="@(secaoDiarioInspecao == "idiomas" ? "ativa" : "")" @onclick='() => secaoDiarioInspecao = "idiomas"'>Idiomas</button>
                                            </div>
                                            <div class="painel-marrom-inspecao">
                                                @if (secaoDiarioInspecao == "ideais")
                                                {
                                                    <h4>Ideais</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Ideais) ? "Não informado." : fichaInspecionada.Ideais)</p>
                                                }
                                                else if (secaoDiarioInspecao == "ligacoes")
                                                {
                                                    <h4>Ligações</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Ligacoes) ? "Não informado." : fichaInspecionada.Ligacoes)</p>
                                                }
                                                else if (secaoDiarioInspecao == "defeitos")
                                                {
                                                    <h4>Defeitos</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Defeitos) ? "Não informado." : fichaInspecionada.Defeitos)</p>
                                                }
                                                else
                                                {
                                                    <h4>Idiomas Conhecidos</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Idiomas) ? "Não informado." : fichaInspecionada.Idiomas)</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (abaInspecao == "personagem")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="grid-4-inspecao">
                                            <div class="campo-leitura-inspecao"><span>Idade</span><strong>@(fichaInspecionada.Idade ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Gênero</span><strong>@(fichaInspecionada.Genero ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Altura</span><strong>@(fichaInspecionada.Altura ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Peso</span><strong>@(fichaInspecionada.Peso ?? "—")</strong></div>
                                        </div>

                                        @if (fichaInspecionada.PersonagemClasses != null && fichaInspecionada.PersonagemClasses.Any())
                                        {
                                            <div class="painel-marrom-inspecao">
                                                <h4>Classes (Multiclasse)</h4>
                                                <p>@string.Join(" / ", fichaInspecionada.PersonagemClasses.Where(c => c.Classe != null).Select(c => $"{c.Classe!.Nome} (Nível {c.NivelNaClasse})"))</p>
                                            </div>
                                        }

                                        <div class="grid-2-inspecao">
                                            <div class="painel-marrom-inspecao"><h4>Aparência</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Aparencia) ? "—" : fichaInspecionada.Aparencia)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Aliados e Organizações</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Aliados) ? "—" : fichaInspecionada.Aliados)</p></div>
                                            <div class="painel-marrom-inspecao full-col"><h4>História do Personagem</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Historia) ? "—" : fichaInspecionada.Historia)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Características e Habilidades</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Caracteristicas) ? "—" : fichaInspecionada.Caracteristicas)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Tesouro Pessoal</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Tesouro) ? "—" : fichaInspecionada.Tesouro)</p></div>
                                        </div>
                                    </div>
                                }
                                else if (abaInspecao == "inventario")
                                {
                                    <div class="inspecao-corpo">
                                        @if (fichaInspecionada.Inventario != null)
                                        {
                                            <div class="grid-4-inspecao" style="grid-template-columns: repeat(5, 1fr);">
                                                <div class="campo-leitura-inspecao"><span>PC</span><strong>@fichaInspecionada.Inventario.MoedasPC</strong></div>
                                                <div class="campo-leitura-inspecao"><span>PP</span><strong>@fichaInspecionada.Inventario.MoedasPP</strong></div>
                                                <div class="campo-leitura-inspecao"><span>PE</span><strong>@fichaInspecionada.Inventario.MoedasPE</strong></div>
                                                <div class="campo-leitura-inspecao"><span>PO</span><strong>@fichaInspecionada.Inventario.MoedasPO</strong></div>
                                                <div class="campo-leitura-inspecao"><span>PL</span><strong>@fichaInspecionada.Inventario.MoedasPL</strong></div>
                                            </div>

                                            <div class="painel-marrom-inspecao">
                                                <h4>Itens no Inventário (Peso Atual: @(fichaInspecionada.Inventario.PesoAtual ?? 0) kg / @(fichaInspecionada.Inventario.CapacidadeCarga ?? 0) kg)</h4>
                                                @if (fichaInspecionada.Inventario.Itens != null && fichaInspecionada.Inventario.Itens.Any())
                                                {
                                                    <ul style="margin: 0; padding-left: 18px;">
                                                        @foreach (var ii in fichaInspecionada.Inventario.Itens)
                                                        {
                                                            <li><strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong> — @(ii.Item?.Tipo ?? "Geral") (@(ii.Item?.Peso ?? 0) kg, @(ii.Item?.Preco ?? 0) po)</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p>Nenhum item equipado.</p>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(fichaInspecionada.Inventario.Notas))
                                            {
                                                <div class="painel-marrom-inspecao">
                                                    <h4>Notas do Inventário</h4>
                                                    <p>@fichaInspecionada.Inventario.Notas</p>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p>Inventário vazio.</p>
                                        }
                                    </div>
                                }
                                else if (abaInspecao == "grimorio")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="painel-marrom-inspecao">
                                            <h4>Magias Conhecidas / Preparadas</h4>
                                            @if (fichaInspecionada.PersonagemMagias != null && fichaInspecionada.PersonagemMagias.Any())
                                            {
                                                <ul style="margin: 0; padding-left: 18px;">
                                                    @foreach (var pm in fichaInspecionada.PersonagemMagias)
                                                    {
                                                        if (pm.Magia != null)
                                                        {
                                                            <li><strong>@pm.Magia.Nome</strong> — Círculo @pm.Magia.CirculoNivel | Efeito: @(pm.Magia.DanoEfeito ?? "—") | Alcance: @(pm.Magia.Alcance ?? "—")</li>
                                                        }
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p>Nenhuma magia registrada no grimório.</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }

                @if (abaMenu == "hist")
                {
                    <header class="page-heading">
                        <div><p class="page-kicker">Memória da campanha</p><h1>Histórico das sessões</h1><p class="page-description">Acompanhe os registros desta mesa.</p></div>
                    </header>
                    <div class="session-page-content">
                        <p class="aviso-vazio">Diário de bordo ativo para <strong>@(campanhaAtual?.Nome)</strong>.</p>
                    </div>
                }
            </section>
        </div>
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    private Campanha? campanhaAtual;
    private List<Monstro> monstrosDisponiveis = new();
    private List<NPC> npcsDisponiveis = new();
    private List<Item> itensDisponiveis = new();
    private string termoBusca = string.Empty;

    private string abaMenu = "iniciar"; // "iniciar", "config", "fichas", "hist"
    private string categoriaAtiva = "todos";
    private string modoVisualizacao = "vinculados";
    private string categoriaSelecionada = "npc";

    // Estado da Aba de Fichas do Mestre
    private string filtroFichasMestre = "pendentes";
    private Personagem? fichaInspecionada;
    private string abaInspecao = "atributos";
    private string secaoDiarioInspecao = "ideais";
    private string mensagemFeedbackFichas = string.Empty;

    private IEnumerable<PersonagemCampanha> FichasPendentes =>
        campanhaAtual?.FichasPendentes ?? Enumerable.Empty<PersonagemCampanha>();

    private IEnumerable<PersonagemCampanha> FichasAceitas =>
        campanhaAtual?.FichasAceitas ?? Enumerable.Empty<PersonagemCampanha>();

    private string StatusDaFichaInspecionada =>
        campanhaAtual?.PersonagemCampanhas
            .FirstOrDefault(pc => pc.IdPersonagem == fichaInspecionada?.IdPersonagem)?.StatusAprovacao ?? "Pendente";

    private IEnumerable<NPC> NpcsVinculadosFiltrados =>
        (campanhaAtual?.Npcs ?? Array.Empty<NPC>()).Where(n =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            n.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (n.ClasseTexto != null && n.ClasseTexto.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
            (n.Ocupacao != null && n.Ocupacao.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<MonstroCampanha> MonstrosVinculadosFiltrados =>
        (campanhaAtual?.MonstroCampanhas ?? Enumerable.Empty<MonstroCampanha>()).Where(mc =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            (mc.Monstro != null && (
                mc.Monstro.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                (mc.Monstro.TipoMonstro != null && mc.Monstro.TipoMonstro.Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
            )));

    private IEnumerable<ItemCampanha> ItensVinculadosFiltrados =>
        (campanhaAtual?.ItemCampanhas ?? Enumerable.Empty<ItemCampanha>()).Where(ic =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            (ic.Item != null && (
                ic.Item.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                (ic.Item.Tipo != null && ic.Item.Tipo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
            )));

    private IEnumerable<NPC> NpcsDisponiveisFiltrados =>
        npcsDisponiveis.Where(n =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            n.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (n.ClasseTexto != null && n.ClasseTexto.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
            (n.Ocupacao != null && n.Ocupacao.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<Monstro> MonstrosDisponiveisFiltrados =>
        monstrosDisponiveis.Where(m =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            m.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (m.TipoMonstro != null && m.TipoMonstro.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<Item> ItensDisponiveisFiltrados =>
        itensDisponiveis.Where(i =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            i.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (i.Tipo != null && i.Tipo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    // Campos do NPC
    private string npcNome = string.Empty, npcRaca = "Humano", npcClasse = "Guerreiro", npcTendencia = "Neutra", npcAntecedente = string.Empty, npcHistoria = string.Empty;
    private int npcNivel = 1;
    private int npcForca = 10, npcDestreza = 10, npcConstituicao = 10, npcInteligencia = 10, npcSabedoria = 10, npcCarisma = 10;

    // Campos do Monstro
    private string monstroNome = string.Empty, monstroTipo = "Outro", monstroTamanho = "Médio", monstroAlinhamento = string.Empty, monstroDeslocamento = "9 m", monstroSentidos = string.Empty, monstroResistencias = string.Empty, monstroHabilidades = string.Empty, monstroDescricao = string.Empty;
    private decimal monstroNd = 1; int monstroDefesa = 12, monstroVida = 15;

    // Campos de Item Completos
    private string itemNome = string.Empty, itemTipo = string.Empty, itemDescricao = string.Empty;
    private decimal? itemPeso = null;
    private decimal? itemPreco = null;
    private string? itemDano = string.Empty;
    private string? itemTipoDano = string.Empty;
    private string? itemPropriedades = string.Empty;
    private int itemCaBonus = 0;
    private string itemRaridade = string.Empty;
    private string itemSintonizacao = "Não";
    
    private string mensagemFeedback = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await CarregarDadosCampanhaAsync();
    }

    private async Task CarregarDadosCampanhaAsync()
    {
        if (IdCampanha > 0)
        {
            campanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(IdCampanha);
            if (campanhaAtual != null)
            {
                var todosMonstros = await CampanhaService.ObterMonstrosParaSessaoAsync(campanhaAtual.IdAccount);
                var idsMonstrosVinculados = campanhaAtual.MonstroCampanhas.Select(mc => mc.IdMonstro).ToList();
                monstrosDisponiveis = todosMonstros.Where(m => !idsMonstrosVinculados.Contains(m.IdMonstro)).ToList();

                var todosNpcsUsuario = await NpcService.ObterNpcsPorUsuarioAsync(campanhaAtual.IdAccount);
                var idsNpcsVinculados = campanhaAtual.NpcCampanhas.Select(nc => nc.IdNpc).ToList();
                npcsDisponiveis = todosNpcsUsuario.Where(n => !idsNpcsVinculados.Contains(n.IdNpc)).ToList();

                var todosItens = await CampanhaService.ObterItensParaSessaoAsync(campanhaAtual.IdAccount);
                var idsItensVinculados = campanhaAtual.ItemCampanhas.Select(ic => ic.IdItem).ToList();
                itensDisponiveis = todosItens.Where(i => !idsItensVinculados.Contains(i.IdItem)).ToList();
            }
        }
    }

    private async Task InspecionarFichaNaAbaAsync(int idPersonagem)
    {
        abaMenu = "fichas";
        filtroFichasMestre = "aceitas";
        await CarregarFichaParaInspecaoAsync(idPersonagem);
    }

    private async Task CarregarFichaParaInspecaoAsync(int idPersonagem)
    {
        fichaInspecionada = await PersonagemService.ObterPorIdAsync(idPersonagem);
        abaInspecao = "atributos";
        secaoDiarioInspecao = "ideais";
    }

    private async Task AprovarFichaJogadorAsync(int idPersonagem)
    {
        var resultado = await CampanhaService.AprovarFichaCampanhaAsync(IdCampanha, idPersonagem);
        mensagemFeedbackFichas = resultado.Mensagem;
        await CarregarDadosCampanhaAsync();
        if (fichaInspecionada?.IdPersonagem == idPersonagem)
        {
            fichaInspecionada = await PersonagemService.ObterPorIdAsync(idPersonagem);
        }
    }

    private async Task RecusarFichaJogadorAsync(int idPersonagem)
    {
        var resultado = await CampanhaService.RecusarFichaCampanhaAsync(IdCampanha, idPersonagem);
        mensagemFeedbackFichas = resultado.Mensagem;
        if (fichaInspecionada?.IdPersonagem == idPersonagem)
        {
            fichaInspecionada = null;
        }
        await CarregarDadosCampanhaAsync();
    }

    private async Task SalvarRegistroAsync()
    {
        if (campanhaAtual == null) return;

        try
        {
            if (categoriaSelecionada == "npc")
            {
                var novoNpc = new NPC(
                    idAccount: campanhaAtual.IdAccount,
                    nome: npcNome,
                    racaTexto: npcRaca,
                    classeTexto: npcClasse,
                    nivel: npcNivel,
                    antecedenteTexto: npcAntecedente,
                    tendencia: npcTendencia,
                    forca: npcForca,
                    destreza: npcDestreza,
                    constituicao: npcConstituicao,
                    inteligencia: npcInteligencia,
                    sabedoria: npcSabedoria,
                    carisma: npcCarisma,
                    historia: npcHistoria,
                    idCampanha: IdCampanha
                );

                var resultado = await NpcService.CriarNpcAsync(campanhaAtual.IdAccount, novoNpc, IdCampanha);
                mensagemFeedback = resultado.Sucesso ? "NPC cadastrado e vinculado à campanha!" : resultado.Mensagem;
                if (resultado.Sucesso) { npcNome = npcAntecedente = npcHistoria = string.Empty; }
            }
            else if (categoriaSelecionada == "monstro")
            {
                var novoMonstro = new Monstro
                {
                    Nome = monstroNome,
                    TipoMonstro = monstroTipo,
                    NivelDesafio = monstroNd,
                    PvMaximo = monstroVida,
                    ClasseArmadura = monstroDefesa,
                    Tamanho = monstroTamanho,
                    Tendencia = monstroAlinhamento,
                    Deslocamento = monstroDeslocamento,
                    Sentidos = monstroSentidos,
                    Resistencias = monstroResistencias,
                    Habilidades = monstroHabilidades,
                    Descricao = monstroDescricao
                };

                var resultado = await CampanhaService.CriarE_VincularMonstroNaCampanhaAsync(IdCampanha, novoMonstro);
                mensagemFeedback = resultado.Mensagem;
                if (resultado.Sucesso) { monstroNome = monstroDescricao = string.Empty; }
            }
            else if (categoriaSelecionada == "item")
            {
                var novoItem = new Item(
                    idAccount: campanhaAtual.IdAccount,
                    nome: itemNome,
                    tipo: itemTipo,
                    peso: itemPeso,
                    preco: itemPreco,
                    dano: string.IsNullOrWhiteSpace(itemDano) ? null : itemDano,
                    tipoDano: string.IsNullOrWhiteSpace(itemTipoDano) ? null : itemTipoDano,
                    propriedades: string.IsNullOrWhiteSpace(itemPropriedades) ? null : itemPropriedades,
                    caBonus: itemCaBonus,
                    descricao: itemDescricao,
                    raridade: string.IsNullOrEmpty(itemRaridade) ? null : itemRaridade,
                    sintonizacao: itemSintonizacao
                );

                var resultadoCriacao = await ItemService.CriarItemAsync(campanhaAtual.IdAccount, novoItem);
                if (resultadoCriacao.Sucesso)
                {
                    if (resultadoCriacao.IdItemCriado > 0)
                    {
                        await CampanhaService.AdicionarItemNaCampanhaAsync(IdCampanha, resultadoCriacao.IdItemCriado);
                    }

                    mensagemFeedback = "Item cadastrado e vinculado com sucesso!";
                    itemNome = itemTipo = itemDescricao = string.Empty;
                    itemDano = itemTipoDano = itemPropriedades = string.Empty;
                    itemPeso = null;
                    itemPreco = null;
                    itemCaBonus = 0;
                    itemRaridade = string.Empty;
                    itemSintonizacao = "Não";
                }
                else
                {
                    mensagemFeedback = resultadoCriacao.Mensagem;
                }
            }

            await CarregarDadosCampanhaAsync();
        }
        catch (Exception ex)
        {
            mensagemFeedback = $"Erro: {ex.Message}";
        }
    }

