@page "/sessao-iniciar/{idCampanha:int}"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Domain.Campanhas
@using RPGdeMesa.Domain.Bestiario
@using RPGdeMesa.Domain.Itens
@using RPGdeMesa.Domain.Npcs
@inject CampanhaService CampanhaService
@inject NpcService NpcService
@inject ItemService ItemService
@inject NavigationManager Navigation

<NavMenu />

<div class="app-shell">
    <main class="app-content">
        <div class="session-layout">
            <!-- Sidebar: Navegação e Jogadores -->
            <aside class="session-sidebar">
                <nav class="session-nav" aria-label="Páginas da sessão">
                    <a class="session-nav-link @(iniciar ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirIniciar">Iniciar sessão</a>
                    <a class="session-nav-link @(config ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirConfig">Configurações</a>
                    <a class="session-nav-link @(hist ? "ativa" : "")" href="javascript:void(0)" @onclick="AbrirHist">Histórico</a>
                </nav>

                <section class="session-players-panel" aria-labelledby="titulo-jogadores">
                    <h2 id="titulo-jogadores">Jogadores na Mesa</h2>
                    <div class="session-players">
                        @if (campanhaAtual?.Personagens != null && campanhaAtual.Personagens.Any())
                        {
                            @foreach (var p in campanhaAtual.Personagens)
                            {
                                <div class="player-option">
                                    <span>@p.Nome<span>@(p.RacaTexto ?? "Aventureiro") · @(p.ClasseTexto ?? "Geral")</span></span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="aviso-vazio" style="font-size: 0.85rem; padding: 10px; color: #888;">Nenhum personagem vinculado.</p>
                        }
                    </div>
                </section>
            </aside>

            <!-- Conteúdo Principal -->
            <section class="preview-content">
                @if (iniciar)
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Prepare a mesa</p>
                            <h1>Iniciar sessão</h1>
                            <p class="page-description">Reúna o grupo, gerencie o plano e acompanhe a aventura.</p>
                        </div>
                    </header>
                    <section class="session-summary" aria-label="Resumo da sessão">
                        <p class="summary-kicker">Campanha Ativa</p>
                        <h2>@(campanhaAtual?.Nome ?? "Carregando...")</h2>
                        <p class="summary-description">@(campanhaAtual?.Descricao ?? "Sem descrição informada.")</p>
                        <dl class="summary-details">
                            <div><dt>Código</dt><dd>@(campanhaAtual?.CodigoConvite ?? "---")</dd></div>
                            <div><dt>Criação</dt><dd>@campanhaAtual?.DataCriacao.ToString("dd/MM/yyyy")</dd></div>
                            <div><dt>Aventureiros</dt><dd>@(campanhaAtual?.Personagens.Count() ?? 0) presentes</dd></div>
                        </dl>
                        <a class="action-primary" href="/campanhas">Voltar para campanhas <span aria-hidden="true">→</span></a>
                    </section>
                }

                @if (config)
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Preparação da mesa</p>
                            <h1>Configurações da sessão</h1>
                            <p class="page-description">Monte encontros, monstros, NPCs e itens da aventura.</p>
                        </div>
                        <button class="add-button" type="button" @onclick="LimparFormulario"><span>+</span> Novo Registro</button>
                    </header>

                    <div class="session-page-content">
                        <section class="configuration-content" aria-label="Conteúdo da sessão">
                            <div class="configuration-heading">
                                <div><p class="page-kicker">Encontro atual</p><h2>@(campanhaAtual?.Nome)</h2></div>
                            </div>
                            <div class="configuration-layout">
                                <!-- LADO ESQUERDO: Navegador de Recursos -->
                                <section class="resource-browser" aria-labelledby="titulo-recursos">
                                    <h3 id="titulo-recursos">Elementos da sessão</h3>

                                    <div class="search-box" style="margin-bottom: 12px;">
                                        <span aria-hidden="true">⌕</span>
                                        <input id="busca-catalogo" type="search" @bind="termoBusca" @bind:event="oninput" placeholder="Busque por nome ou tipo" autocomplete="off" />
                                    </div>
                                    
                                    <div class="resource-tabs" role="tablist">
                                        <button class="resource-tab @(categoriaAtiva == "todos" ? "ativa" : "")" @onclick='() => categoriaAtiva = "todos"'>Todos</button>
                                        <button class="resource-tab @(categoriaAtiva == "npcs" ? "ativa" : "")" @onclick='() => categoriaAtiva = "npcs"'>NPCs</button>
                                        <button class="resource-tab @(categoriaAtiva == "monstros" ? "ativa" : "")" @onclick='() => categoriaAtiva = "monstros"'>Monstros</button>
                                        <button class="resource-tab @(categoriaAtiva == "itens" ? "ativa" : "")" @onclick='() => categoriaAtiva = "itens"'>Itens</button>
                                    </div>

                                    <div class="link-tabs" role="tablist" style="margin-top: 10px;">
                                        <button class="link-tab @(modoVisualizacao == "vinculados" ? "ativa" : "")" @onclick='() => modoVisualizacao = "vinculados"'>Vinculados</button>
                                        <button class="link-tab @(modoVisualizacao == "disponiveis" ? "ativa" : "")" @onclick='() => modoVisualizacao = "disponiveis"'>Disponíveis (Biblioteca)</button>
                                    </div>

                                    <div class="resource-list" style="margin-top: 15px; max-height: 280px; overflow-y: auto;">
                                        @if (modoVisualizacao == "vinculados")
                                        {
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "npcs")
                                            {
                                                @foreach (var npc in NpcsVinculadosFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
                                                        <span><strong>[NPC]</strong> @npc.Nome <span>(@(npc.ClasseTexto ?? npc.Ocupacao))</span></span>
                                                        <button type="button" title="Desvincular NPC" style="background:transparent; border:none; color:#ff4d4d; cursor:pointer; font-weight:bold;" @onclick="() => DesvincularNpc(npc.IdNpc)">❌</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "monstros")
                                            {
                                                @foreach (var mc in MonstrosVinculadosFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
                                                        <span><strong>[Monstro]</strong> @mc.Monstro?.Nome <span>(ND: @mc.Monstro?.NivelDesafio)</span></span>
                                                        <button type="button" title="Desvincular Monstro" style="background:transparent; border:none; color:#ff4d4d; cursor:pointer; font-weight:bold;" @onclick="() => DesvincularMonstro(mc.IdMonstro)">❌</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "todos" || categoriaAtiva == "itens")
                                            {
                                                @foreach (var ic in ItensVinculadosFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
                                                        <span><strong>[Item]</strong> @ic.Item?.Nome <span>(@ic.Item?.Tipo)</span></span>
                                                        <button type="button" title="Desvincular Item" style="background:transparent; border:none; color:#ff4d4d; cursor:pointer; font-weight:bold;" @onclick="() => DesvincularItem(ic.IdItem)">❌</button>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @if (categoriaAtiva == "npcs" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var n in NpcsDisponiveisFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; background: rgba(212,175,55,0.1); display: flex; justify-content: space-between; align-items: center;">
                                                        <span>NPC: <strong>@n.Nome</strong></span>
                                                        <button type="button" title="Vincular NPC" style="background:transparent; border:none; color:#28a745; cursor:pointer; font-weight:bold;" @onclick="() => VincularNpcExistente(n.IdNpc)">➕</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "monstros" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var m in MonstrosDisponiveisFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; background: rgba(212,175,55,0.1); display: flex; justify-content: space-between; align-items: center;">
                                                        <span>Monstro: <strong>@m.Nome</strong></span>
                                                        <button type="button" title="Vincular Monstro" style="background:transparent; border:none; color:#28a745; cursor:pointer; font-weight:bold;" @onclick="() => VincularMonstro(m.IdMonstro)">➕</button>
                                                    </div>
                                                }
                                            }
                                            @if (categoriaAtiva == "itens" || categoriaAtiva == "todos")
                                            {
                                                @foreach (var i in ItensDisponiveisFiltrados)
                                                {
                                                    <div class="player-option" style="margin-bottom: 6px; background: rgba(212,175,55,0.1); display: flex; justify-content: space-between; align-items: center;">
                                                        <span>Item: <strong>@i.Nome</strong></span>
                                                        <button type="button" title="Vincular Item" style="background:transparent; border:none; color:#28a745; cursor:pointer; font-weight:bold;" @onclick="() => VincularItem(i.IdItem)">➕</button>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </section>

                                <!-- LADO DIREITO: Formulário Dinâmico -->
                                <form class="resource-editor" @onsubmit="SalvarRegistroAsync">
                                    <div class="editor-heading">
                                        <div><p class="page-kicker">Ficha do elemento</p><h3>Cadastrar e Vincular @categoriaSelecionada.ToUpper()</h3></div>
                                    </div>

                                    <label class="form-field">
                                        Categoria de Cadastro
                                        <select @bind="categoriaSelecionada">
                                            <option value="npc">NPC</option>
                                            <option value="monstro">Monstro</option>
                                            <option value="item">Item</option>
                                        </select>
                                    </label>

                                    @if (categoriaSelecionada == "npc")
                                    {
                                        <label class="form-field">Nome do NPC<input @bind="npcNome" required maxlength="60" placeholder="Ex.: Aldeão" /></label>
                                        <label class="form-field">
                                            Raça
                                            <select @bind="npcRaca">
                                                <option value="Humano">Humano</option>
                                                <option value="Elfo">Elfo</option>
                                                <option value="Anão">Anão</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Classe
                                            <select @bind="npcClasse">
                                                <option value="Guerreiro">Guerreiro</option>
                                                <option value="Mago">Mago</option>
                                                <option value="Bardo">Bardo</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Nível<input @bind="npcNivel" type="number" min="1" max="20" /></label>
                                        <label class="form-field">Antecedente<input @bind="npcAntecedente" maxlength="50" placeholder="Ex.: Batedor" /></label>
                                        <label class="form-field">
                                            Tendência
                                            <select @bind="npcTendencia">
                                                <option value="Neutra">Neutra</option>
                                                <option value="Leal e boa">Leal e boa</option>
                                                <option value="Caótica e má">Caótica e má</option>
                                            </select>
                                        </label>

                                        <div class="form-divider" style="margin: 10px 0 5px 0; font-size: 0.85rem; color: #d4af37;">Atributos</div>
                                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
                                            <label class="form-field" style="font-size:0.8rem;">FOR<input @bind="npcForca" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">DES<input @bind="npcDestreza" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CON<input @bind="npcConstituicao" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">INT<input @bind="npcInteligencia" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">SAB<input @bind="npcSabedoria" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CAR<input @bind="npcCarisma" type="number" min="1" max="30" style="padding:4px;" /></label>
                                        </div>

                                        <label class="form-field" style="margin-top: 8px;">História e anotações<textarea @bind="npcHistoria" rows="2" placeholder="Detalhes do NPC..."></textarea></label>
                                    }
                                    else if (categoriaSelecionada == "monstro")
                                    {
                                        <label class="form-field">Nome da criatura<input @bind="monstroNome" required maxlength="60" placeholder="Ex.: Guardião" /></label>
                                        <label class="form-field">
                                            Tipo
                                            <select @bind="monstroTipo">
                                                <option value="Outro">Outro</option>
                                                <option value="Dragao">Dragão</option>
                                                <option value="Fera">Fera</option>
                                                <option value="Morto-vivo">Morto-vivo</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Tamanho
                                            <select @bind="monstroTamanho">
                                                <option value="Médio">Médio</option>
                                                <option value="Grande">Grande</option>
                                                <option value="Pequeno">Pequeno</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Alinhamento<input @bind="monstroAlinhamento" maxlength="40" placeholder="Ex.: Caótico e mau" /></label>
                                        <label class="form-field">Nível de desafio<input @bind="monstroNd" type="number" min="0" max="30" step="0.125" /></label>
                                        <label class="form-field">Classe de armadura<input @bind="monstroDefesa" type="number" min="0" max="40" /></label>
                                        <label class="form-field">Pontos de vida<input @bind="monstroVida" type="number" min="1" max="9999" /></label>
                                        <label class="form-field">Deslocamento<input @bind="monstroDeslocamento" maxlength="50" placeholder="9 m" /></label>
                                        <label class="form-field">Sentidos<input @bind="monstroSentidos" maxlength="80" placeholder="Visão no escuro 18 m" /></label>
                                        <label class="form-field full-width">Resistências e imunidades<input @bind="monstroResistencias" maxlength="120" placeholder="Ex.: frio, veneno" /></label>
                                        <label class="form-field full-width">Habilidades especiais<input @bind="monstroHabilidades" maxlength="160" placeholder="Ex.: Ataque múltiplo" /></label>
                                        <label class="form-field full-width">Descrição<textarea @bind="monstroDescricao" rows="2" placeholder="Táticas e anotações..."></textarea></label>
                                    }
                                    else
                                    {
                                        <!-- CAMPOS COMPLETOS DA TABELA DE ITENS -->
                                        <label class="form-field">Nome do Item<input @bind="itemNome" required maxlength="100" placeholder="Ex.: Espada Longa" /></label>
                                        <label class="form-field">Tipo<input @bind="itemTipo" maxlength="50" placeholder="Ex.: Arma / Poção" /></label>
                                        <label class="form-field">Peso (kg)<input @bind="itemPeso" type="number" step="0.1" min="0" /></label>
                                        <label class="form-field">Preço (PO)<input @bind="itemPreco" type="number" step="0.01" min="0" /></label>
                                        <label class="form-field">Dano<input @bind="itemDano" maxlength="20" placeholder="Ex.: 1d8" /></label>
                                        <label class="form-field">Tipo de Dano<input @bind="itemTipoDano" maxlength="30" placeholder="Ex.: Cortante" /></label>
                                        <label class="form-field">Propriedades<input @bind="itemPropriedades" maxlength="100" placeholder="Ex.: Versátil, acuidade" /></label>
                                        <label class="form-field">Bônus de CA<input @bind="itemCaBonus" type="number" min="0" max="10" /></label>
                                        
                                        <label class="form-field">
                                            Raridade
                                            <select @bind="itemRaridade">
                                                <option value="">Sem raridade</option>
                                                <option value="Comum">Comum</option>
                                                <option value="Incomum">Incomum</option>
                                                <option value="Raro">Raro</option>
                                                <option value="Muito Raro">Muito Raro</option>
                                                <option value="Lendário">Lendário</option>
                                            </select>
                                        </label>

                                        <label class="form-field">
                                            Sintonização
                                            <select @bind="itemSintonizacao">
                                                <option value="Não">Não</option>
                                                <option value="Sim">Sim</option>
                                            </select>
                                        </label>

                                        <label class="form-field full-width">Descrição<textarea @bind="itemDescricao" rows="2" placeholder="Efeito mágico ou história do item..."></textarea></label>
                                    }

                                    <div class="editor-actions">
                                        <button class="save-button" type="submit">Cadastrar e Vincular</button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(mensagemFeedback))
                                    {
                                        <p class="save-status" role="status" style="margin-top: 10px; color: #d4af37;">@mensagemFeedback</p>
                                    }
                                </form>
                            </div>
                        </section>
                    </div>
                }

                @if (hist)
                {
                    <header class="page-heading">
                        <div><p class="page-kicker">Memória da campanha</p><h1>Histórico das sessões</h1><p class="page-description">Acompanhe os registros desta mesa.</p></div>
                    </header>
                    <div class="session-page-content">
                        <p class="aviso-vazio">Diário de bordo ativo para <strong>@(campanhaAtual?.Nome)</strong>.</p>
                    </div>
                }
            </section>
        </div>
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    private Campanha? campanhaAtual;
    private List<Monstro> monstrosDisponiveis = new();
    private List<NPC> npcsDisponiveis = new();
    private List<Item> itensDisponiveis = new();
    private string termoBusca = string.Empty;

    private bool config = false;
    private bool iniciar = true;
    private bool hist = false;
    private string categoriaAtiva = "todos";
    private string modoVisualizacao = "vinculados";
    private string categoriaSelecionada = "npc";

    private IEnumerable<NPC> NpcsVinculadosFiltrados =>
        (campanhaAtual?.Npcs ?? Array.Empty<NPC>()).Where(n =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            n.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (n.ClasseTexto != null && n.ClasseTexto.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
            (n.Ocupacao != null && n.Ocupacao.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<MonstroCampanha> MonstrosVinculadosFiltrados =>
        (campanhaAtual?.MonstroCampanhas ?? Enumerable.Empty<MonstroCampanha>()).Where(mc =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            (mc.Monstro != null && (
                mc.Monstro.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                (mc.Monstro.TipoMonstro != null && mc.Monstro.TipoMonstro.Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
            )));

    private IEnumerable<ItemCampanha> ItensVinculadosFiltrados =>
        (campanhaAtual?.ItemCampanhas ?? Enumerable.Empty<ItemCampanha>()).Where(ic =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            (ic.Item != null && (
                ic.Item.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                (ic.Item.Tipo != null && ic.Item.Tipo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
            )));

    private IEnumerable<NPC> NpcsDisponiveisFiltrados =>
        npcsDisponiveis.Where(n =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            n.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (n.ClasseTexto != null && n.ClasseTexto.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)) ||
            (n.Ocupacao != null && n.Ocupacao.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<Monstro> MonstrosDisponiveisFiltrados =>
        monstrosDisponiveis.Where(m =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            m.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (m.TipoMonstro != null && m.TipoMonstro.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<Item> ItensDisponiveisFiltrados =>
        itensDisponiveis.Where(i =>
            string.IsNullOrWhiteSpace(termoBusca) ||
            i.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            (i.Tipo != null && i.Tipo.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)));

    // Campos do NPC
    private string npcNome = string.Empty, npcRaca = "Humano", npcClasse = "Guerreiro", npcTendencia = "Neutra", npcAntecedente = string.Empty, npcHistoria = string.Empty;
    private int npcNivel = 1;
    private int npcForca = 10, npcDestreza = 10, npcConstituicao = 10, npcInteligencia = 10, npcSabedoria = 10, npcCarisma = 10;

    // Campos do Monstro
    private string monstroNome = string.Empty, monstroTipo = "Outro", monstroTamanho = "Médio", monstroAlinhamento = string.Empty, monstroDeslocamento = "9 m", monstroSentidos = string.Empty, monstroResistencias = string.Empty, monstroHabilidades = string.Empty, monstroDescricao = string.Empty;
    private decimal monstroNd = 1; int monstroDefesa = 12, monstroVida = 15;

    // Campos de Item Completos
    private string itemNome = string.Empty, itemTipo = string.Empty, itemDescricao = string.Empty;
    private decimal? itemPeso = null;
    private decimal? itemPreco = null;
    private string? itemDano = string.Empty;
    private string? itemTipoDano = string.Empty;
    private string? itemPropriedades = string.Empty;
    private int itemCaBonus = 0;
    private string itemRaridade = string.Empty;
    private string itemSintonizacao = "Não";
    
    private string mensagemFeedback = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await CarregarDadosCampanhaAsync();
    }

    private async Task CarregarDadosCampanhaAsync()
    {
        if (IdCampanha > 0)
        {
            campanhaAtual = await CampanhaService.ObterDetalhesCampanhaAsync(IdCampanha);
            if (campanhaAtual != null)
            {
                var todosMonstrosUsuario = await CampanhaService.ObterMonstrosDoUsuarioAsync(campanhaAtual.IdAccount);
                var idsMonstrosVinculados = campanhaAtual.MonstroCampanhas.Select(mc => mc.IdMonstro).ToList();
                monstrosDisponiveis = todosMonstrosUsuario.Where(m => !idsMonstrosVinculados.Contains(m.IdMonstro)).ToList();

                var todosNpcsUsuario = await NpcService.ObterNpcsPorUsuarioAsync(campanhaAtual.IdAccount);
                var idsNpcsVinculados = campanhaAtual.NpcCampanhas.Select(nc => nc.IdNpc).ToList();
                npcsDisponiveis = todosNpcsUsuario.Where(n => !idsNpcsVinculados.Contains(n.IdNpc)).ToList();

                var todosItensUsuario = await ItemService.ObterItensPorUsuarioAsync(campanhaAtual.IdAccount);
                var idsItensVinculados = campanhaAtual.ItemCampanhas.Select(ic => ic.IdItem).ToList();
                itensDisponiveis = todosItensUsuario.Where(i => !idsItensVinculados.Contains(i.IdItem)).ToList();
            }
        }
    }

    private async Task SalvarRegistroAsync()
    {
        if (campanhaAtual == null) return;

        try
        {
            if (categoriaSelecionada == "npc")
            {
                var novoNpc = new NPC(
                    idAccount: campanhaAtual.IdAccount,
                    nome: npcNome,
                    racaTexto: npcRaca,
                    classeTexto: npcClasse,
                    nivel: npcNivel,
                    antecedenteTexto: npcAntecedente,
                    tendencia: npcTendencia,
                    forca: npcForca,
                    destreza: npcDestreza,
                    constituicao: npcConstituicao,
                    inteligencia: npcInteligencia,
                    sabedoria: npcSabedoria,
                    carisma: npcCarisma,
                    historia: npcHistoria,
                    idCampanha: IdCampanha
                );

                var resultado = await NpcService.CriarNpcAsync(campanhaAtual.IdAccount, novoNpc, IdCampanha);
                mensagemFeedback = resultado.Sucesso ? "NPC cadastrado e vinculado à campanha!" : resultado.Mensagem;
                if (resultado.Sucesso) { npcNome = npcAntecedente = npcHistoria = string.Empty; }
            }
            else if (categoriaSelecionada == "monstro")
            {
                var novoMonstro = new Monstro
                {
                    Nome = monstroNome,
                    TipoMonstro = monstroTipo,
                    NivelDesafio = monstroNd,
                    PvMaximo = monstroVida,
                    ClasseArmadura = monstroDefesa,
                    Tamanho = monstroTamanho,
                    Tendencia = monstroAlinhamento,
                    Deslocamento = monstroDeslocamento,
                    Sentidos = monstroSentidos,
                    Resistencias = monstroResistencias,
                    Habilidades = monstroHabilidades,
                    Descricao = monstroDescricao,
                    // Não atribui imagem padrão ao monstro criado na sessão.
                };

                var resultado = await CampanhaService.CriarE_VincularMonstroNaCampanhaAsync(IdCampanha, novoMonstro);
                mensagemFeedback = resultado.Mensagem;
                if (resultado.Sucesso) { monstroNome = monstroDescricao = string.Empty; }
            }
            else if (categoriaSelecionada == "item")
            {
                var novoItem = new Item(
                    idAccount: campanhaAtual.IdAccount, // Associa à conta do usuário logado
                    nome: itemNome,
                    tipo: itemTipo,
                    peso: itemPeso,
                    preco: itemPreco,
                    dano: string.IsNullOrWhiteSpace(itemDano) ? null : itemDano,
                    tipoDano: string.IsNullOrWhiteSpace(itemTipoDano) ? null : itemTipoDano,
                    propriedades: string.IsNullOrWhiteSpace(itemPropriedades) ? null : itemPropriedades,
                    caBonus: itemCaBonus,
                    descricao: itemDescricao,
                    raridade: string.IsNullOrEmpty(itemRaridade) ? null : itemRaridade,
                    sintonizacao: itemSintonizacao
                );

                var resultadoCriacao = await ItemService.CriarItemAsync(campanhaAtual.IdAccount, novoItem);
                if (resultadoCriacao.Sucesso)
                {
                    // Vincula automaticamente o item criado à campanha ativa
                    if (resultadoCriacao.IdItemCriado > 0)
                    {
                        await CampanhaService.AdicionarItemNaCampanhaAsync(IdCampanha, resultadoCriacao.IdItemCriado);
                    }

                    mensagemFeedback = "Item cadastrado e vinculado com sucesso!";
                    itemNome = itemTipo = itemDescricao = string.Empty;
                    itemDano = itemTipoDano = itemPropriedades = string.Empty;
                    itemPeso = null;
                    itemPreco = null;
                    itemCaBonus = 0;
                    itemRaridade = string.Empty;
                    itemSintonizacao = "Não";
                }
                else
                {
                    mensagemFeedback = resultadoCriacao.Mensagem;
                }
            }

            await CarregarDadosCampanhaAsync();
        }
        catch (Exception ex)
        {
            mensagemFeedback = $"Erro: {ex.Message}";
        }
    }

    private async Task VincularMonstro(int idMonstro)
    {
        var resultado = await CampanhaService.AdicionarMonstroNaCampanhaAsync(IdCampanha, idMonstro);
        mensagemFeedback = resultado.Mensagem;
        await CarregarDadosCampanhaAsync();
    }

