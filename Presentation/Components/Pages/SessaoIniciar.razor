@page "/sessao-iniciar/{idCampanha:int}"
@using RPGdeMesa.Presentation.Components.Layout
@using RPGdeMesa.Presentation.ViewModel
@inject SessaoIniciarViewModel ViewModel
@implements IDisposable

<NavMenu />

<div class="app-shell">
    <main class="app-content">
        <div class="session-layout">
            <!-- Sidebar: Navegação e Jogadores -->
            <aside class="session-sidebar">
                <nav class="session-nav" aria-label="Páginas da sessão">
                    <a class="session-nav-link @(ViewModel.AbaMenu == "iniciar" ? "ativa" : "")" href="javascript:void(0)" @onclick="ViewModel.AbrirIniciar">Iniciar sessão</a>
                    <a class="session-nav-link @(ViewModel.AbaMenu == "config" ? "ativa" : "")" href="javascript:void(0)" @onclick="ViewModel.AbrirConfig">Configurações</a>
                    <a class="session-nav-link @(ViewModel.AbaMenu == "fichas" ? "ativa" : "")" href="javascript:void(0)" @onclick="ViewModel.AbrirFichas" style="display:flex; justify-content:space-between; align-items:center;">
                        <span>Fichas dos Jogadores</span>
                        @if (ViewModel.FichasPendentes.Any())
                        {
                            <span class="badge-pendentes">@ViewModel.FichasPendentes.Count()</span>
                        }
                    </a>
                    <a class="session-nav-link @(ViewModel.AbaMenu == "hist" ? "ativa" : "")" href="javascript:void(0)" @onclick="ViewModel.AbrirHist">Histórico</a>
                </nav>

                <section class="session-players-panel" aria-labelledby="titulo-jogadores">
                    <h2 id="titulo-jogadores">Jogadores Aceitos na Mesa</h2>
                    <div class="session-players">
                        @if (ViewModel.CampanhaAtual?.Personagens != null && ViewModel.CampanhaAtual.Personagens.Any())
                        {
                            @foreach (var p in ViewModel.CampanhaAtual.Personagens)
                            {
                                <div class="player-option" style="cursor:pointer;" title="Clique para inspecionar a ficha e o inventário" @onclick="() => ViewModel.InspecionarFichaNaAbaAsync(p.IdPersonagem)">
                                    <span>@p.Nome<span>@(p.RacaTexto ?? "Aventureiro") · @(p.ClasseTexto ?? "Geral") (Nv. @p.Nivel)</span></span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="aviso-vazio" style="font-size: 0.85rem; padding: 10px; color: #888;">Nenhuma ficha aceita ainda.</p>
                        }
                    </div>
                </section>
            </aside>

            <!-- Conteúdo Principal -->
            <section class="preview-content">
                @if (ViewModel.AbaMenu == "iniciar")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Prepare a mesa</p>
                            <h1>Iniciar sessão</h1>
                            <p class="page-description">Reúna o grupo, gerencie o plano e acompanhe a aventura.</p>
                        </div>
                    </header>
                    <section class="session-summary" aria-label="Resumo da sessão">
                        <p class="summary-kicker">Campanha Ativa</p>
                        <h2>@(ViewModel.CampanhaAtual?.Nome ?? "Carregando...")</h2>
                        <p class="summary-description">@(ViewModel.CampanhaAtual?.Descricao ?? "Sem descrição informada.")</p>
                        <dl class="summary-details">
                            <div><dt>Código</dt><dd>@(ViewModel.CampanhaAtual?.CodigoConvite ?? "---")</dd></div>
                            <div><dt>Criação</dt><dd>@ViewModel.CampanhaAtual?.DataCriacao.ToString("dd/MM/yyyy")</dd></div>
                            <div><dt>Aventureiros Aceitos</dt><dd>@(ViewModel.CampanhaAtual?.Personagens.Count() ?? 0) presentes</dd></div>
                            <div><dt>Fichas Pendentes</dt><dd>@ViewModel.FichasPendentes.Count() aguardando avaliação</dd></div>
                        </dl>
                        <div style="display:flex; gap:12px; flex-wrap:wrap;">
                            <a class="action-primary" href="/saladojogo">Abrir Sala de Jogo <span aria-hidden="true">→</span></a>
                            @if (ViewModel.FichasPendentes.Any())
                            {
                                <button type="button" class="action-primary" style="background:#6f5296; border-color:#a28acb;" @onclick="ViewModel.AbrirFichas">
                                    Avaliar @ViewModel.FichasPendentes.Count() Ficha(s) Pendente(s)
                                </button>
                            }
                            <a class="action-primary" style="background:transparent; border-color:rgba(217,184,120,0.4);" href="/campanhas">Voltar para campanhas</a>
                        </div>
                    </section>
                }

                @if (ViewModel.AbaMenu == "config")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Preparação da mesa</p>
                            <h1>Configurações da sessão</h1>
                            <p class="page-description">Monte encontros, monstros, NPCs e itens da aventura.</p>
                        </div>
                    </header>

                    <div class="session-page-content">
                        <section class="configuration-content" aria-label="Conteúdo da sessão">
                            <div class="configuration-heading">
                                <div><p class="page-kicker">Encontro atual</p><h2>@(ViewModel.CampanhaAtual?.Nome)</h2></div>
                            </div>
                            <div class="configuration-layout">
                                <!-- LADO ESQUERDO: Navegador de Recursos -->
                                <section class="resource-browser" aria-labelledby="titulo-recursos">
                                    <h3 id="titulo-recursos">Elementos da sessão</h3>

                                    <div class="search-box">
                                        <span aria-hidden="true">⌕</span>
                                        <input id="busca-catalogo" type="search" @bind="ViewModel.TermoBusca" @bind:event="oninput" placeholder="Busque por nome ou tipo" autocomplete="off" />
                                    </div>
                                    
                                    <div class="resource-tabs" role="tablist">
                                        <button class="resource-tab @(ViewModel.CategoriaAtiva == "todos" ? "ativa" : "")" @onclick='() => ViewModel.CategoriaAtiva = "todos"'>Todos</button>
                                        <button class="resource-tab @(ViewModel.CategoriaAtiva == "npcs" ? "ativa" : "")" @onclick='() => ViewModel.CategoriaAtiva = "npcs"'>NPCs</button>
                                        <button class="resource-tab @(ViewModel.CategoriaAtiva == "monstros" ? "ativa" : "")" @onclick='() => ViewModel.CategoriaAtiva = "monstros"'>Monstros</button>
                                        <button class="resource-tab @(ViewModel.CategoriaAtiva == "itens" ? "ativa" : "")" @onclick='() => ViewModel.CategoriaAtiva = "itens"'>Itens</button>
                                    </div>

                                    <div class="link-tabs" role="tablist">
                                        <button class="link-tab @(ViewModel.ModoVisualizacao == "vinculados" ? "ativa" : "")" @onclick='() => ViewModel.ModoVisualizacao = "vinculados"'>Vinculados</button>
                                        <button class="link-tab @(ViewModel.ModoVisualizacao == "disponiveis" ? "ativa" : "")" @onclick='() => ViewModel.ModoVisualizacao = "disponiveis"'>Disponíveis (Biblioteca)</button>
                                    </div>

                                    <div class="resource-list">
                                        @if (ViewModel.ModoVisualizacao == "vinculados")
                                        {
                                            @if (ViewModel.CategoriaAtiva == "todos" || ViewModel.CategoriaAtiva == "npcs")
                                            {
                                                @foreach (var npc in ViewModel.NpcsVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[NPC]</strong> @npc.Nome <span>(@(npc.ClasseTexto ?? npc.Ocupacao))</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular NPC" aria-label="Desvincular NPC" @onclick="() => ViewModel.DesvincularNpc(npc.IdNpc)">✕</button>
                                                    </div>
                                                }
                                            }
                                            @if (ViewModel.CategoriaAtiva == "todos" || ViewModel.CategoriaAtiva == "monstros")
                                            {
                                                @foreach (var mc in ViewModel.MonstrosVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[Monstro]</strong> @mc.Monstro?.Nome <span>(ND: @mc.Monstro?.NivelDesafio)</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular Monstro" aria-label="Desvincular Monstro" @onclick="() => ViewModel.DesvincularMonstro(mc.IdMonstro)">✕</button>
                                                    </div>
                                                }
                                            }
                                            @if (ViewModel.CategoriaAtiva == "todos" || ViewModel.CategoriaAtiva == "itens")
                                            {
                                                @foreach (var ic in ViewModel.ItensVinculadosFiltrados)
                                                {
                                                    <div class="player-option resource-row">
                                                        <span class="resource-label"><strong>[Item]</strong> @ic.Item?.Nome <span>(@ic.Item?.Tipo)</span></span>
                                                        <button type="button" class="btn-vinculo btn-desvincular" title="Desvincular Item" aria-label="Desvincular Item" @onclick="() => ViewModel.DesvincularItem(ic.IdItem)">✕</button>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @if (ViewModel.CategoriaAtiva == "npcs" || ViewModel.CategoriaAtiva == "todos")
                                            {
                                                @foreach (var n in ViewModel.NpcsDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">NPC: <strong>@n.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular NPC" aria-label="Vincular NPC" @onclick="() => ViewModel.VincularNpcExistente(n.IdNpc)">+</button>
                                                    </div>
                                                }
                                            }
                                            @if (ViewModel.CategoriaAtiva == "monstros" || ViewModel.CategoriaAtiva == "todos")
                                            {
                                                @foreach (var m in ViewModel.MonstrosDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">Monstro: <strong>@m.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular Monstro" aria-label="Vincular Monstro" @onclick="() => ViewModel.VincularMonstro(m.IdMonstro)">+</button>
                                                    </div>
                                                }
                                            }
                                            @if (ViewModel.CategoriaAtiva == "itens" || ViewModel.CategoriaAtiva == "todos")
                                            {
                                                @foreach (var i in ViewModel.ItensDisponiveisFiltrados)
                                                {
                                                    <div class="player-option resource-row disponivel">
                                                        <span class="resource-label">Item: <strong>@i.Nome</strong></span>
                                                        <button type="button" class="btn-vinculo btn-vincular" title="Vincular Item" aria-label="Vincular Item" @onclick="() => ViewModel.VincularItem(i.IdItem)">+</button>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </section>

                                <!-- LADO DIREITO: Formulário Dinâmico -->
                                <form class="resource-editor" @onsubmit="ViewModel.SalvarRegistroAsync">
                                    <div class="editor-heading">
                                        <div><p class="page-kicker">Ficha do elemento</p><h3>Cadastrar e Vincular @ViewModel.CategoriaSelecionada.ToUpper()</h3></div>
                                    </div>

                                    <label class="form-field">
                                        Categoria de Cadastro
                                        <select @bind="ViewModel.CategoriaSelecionada">
                                            <option value="npc">NPC</option>
                                            <option value="monstro">Monstro</option>
                                            <option value="item">Item</option>
                                        </select>
                                    </label>

                                    @if (ViewModel.CategoriaSelecionada == "npc")
                                    {
                                        <label class="form-field">Nome do NPC<input @bind="ViewModel.NpcNome" required maxlength="60" placeholder="Ex.: Aldeão" /></label>
                                        <label class="form-field">
                                            Raça
                                            <select @bind="ViewModel.NpcRaca">
                                                <option value="Humano">Humano</option>
                                                <option value="Elfo">Elfo</option>
                                                <option value="Anão">Anão</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Classe
                                            <select @bind="ViewModel.NpcClasse">
                                                <option value="Guerreiro">Guerreiro</option>
                                                <option value="Mago">Mago</option>
                                                <option value="Bardo">Bardo</option>
                                                <option value="Outra">Outra</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Nível<input @bind="ViewModel.NpcNivel" type="number" min="1" max="20" /></label>
                                        <label class="form-field">Antecedente<input @bind="ViewModel.NpcAntecedente" maxlength="50" placeholder="Ex.: Batedor" /></label>
                                        <label class="form-field">
                                            Tendência
                                            <select @bind="ViewModel.NpcTendencia">
                                                <option value="Neutra">Neutra</option>
                                                <option value="Leal e boa">Leal e boa</option>
                                                <option value="Caótica e má">Caótica e má</option>
                                            </select>
                                        </label>

                                        <div class="form-divider" style="margin: 10px 0 5px 0; font-size: 0.85rem; color: #d4af37;">Atributos</div>
                                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
                                            <label class="form-field" style="font-size:0.8rem;">FOR<input @bind="ViewModel.NpcForca" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">DES<input @bind="ViewModel.NpcDestreza" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CON<input @bind="ViewModel.NpcConstituicao" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">INT<input @bind="ViewModel.NpcInteligencia" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">SAB<input @bind="ViewModel.NpcSabedoria" type="number" min="1" max="30" style="padding:4px;" /></label>
                                            <label class="form-field" style="font-size:0.8rem;">CAR<input @bind="ViewModel.NpcCarisma" type="number" min="1" max="30" style="padding:4px;" /></label>
                                        </div>

                                        <label class="form-field" style="margin-top: 8px;">História e anotações<textarea @bind="ViewModel.NpcHistoria" rows="2" placeholder="Detalhes do NPC..."></textarea></label>
                                    }
                                    else if (ViewModel.CategoriaSelecionada == "monstro")
                                    {
                                        <label class="form-field">Nome da criatura<input @bind="ViewModel.MonstroNome" required maxlength="60" placeholder="Ex.: Guardião" /></label>
                                        <label class="form-field">
                                            Tipo
                                            <select @bind="ViewModel.MonstroTipo" style="color: white;">
                                                <option value="Outro">Outro</option>
                                                <option value="Dragao">Dragão</option>
                                                <option value="Fera">Fera</option>
                                                <option value="Morto-vivo">Morto-vivo</option>
                                            </select>
                                        </label>
                                        <label class="form-field">
                                            Tamanho
                                            <select @bind="ViewModel.MonstroTamanho" style="color: white;">
                                                <option value="Médio">Médio</option>
                                                <option value="Grande">Grande</option>
                                                <option value="Pequeno">Pequeno</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Alinhamento<input @bind="ViewModel.MonstroAlinhamento" maxlength="40" placeholder="Ex.: Caótico e mau" /></label>
                                        <label class="form-field">Nível de desafio<input @bind="ViewModel.MonstroNd" type="number" min="0" max="30" step="0.125" /></label>
                                        <label class="form-field">Classe de armadura<input @bind="ViewModel.MonstroDefesa" type="number" min="0" max="40" /></label>
                                        <label class="form-field">Pontos de vida<input @bind="ViewModel.MonstroVida" type="number" min="1" max="9999" /></label>
                                        <label class="form-field">Deslocamento<input @bind="ViewModel.MonstroDeslocamento" maxlength="50" placeholder="9 m" /></label>
                                        <label class="form-field">Sentidos<input @bind="ViewModel.MonstroSentidos" maxlength="80" placeholder="Visão no escuro 18 m" /></label>
                                        <label class="form-field full-width">Resistências e imunidades<input @bind="ViewModel.MonstroResistencias" maxlength="120" placeholder="Ex.: frio, veneno" /></label>
                                        <label class="form-field full-width">Habilidades especiais<input @bind="ViewModel.MonstroHabilidades" maxlength="160" placeholder="Ex.: Ataque múltiplo" /></label>
                                        <label class="form-field full-width">Descrição<textarea @bind="ViewModel.MonstroDescricao" rows="2" placeholder="Táticas e anotações..."></textarea></label>
                                    }
                                    else
                                    {
                                        <label class="form-field">Nome do Item<input @bind="ViewModel.ItemNome" required maxlength="100" placeholder="Ex.: Espada Longa" /></label>
                                        <label class="form-field">
                                            Tipo
                                            <select @bind="ViewModel.ItemTipo" style="color: white;">
                                                <option value="">Selecionar...</option>
                                                <option value="Anéis">Anéis</option>
                                                <option value="Armadura">Armadura</option>
                                                <option value="armas">armas</option>
                                                <option value="Bastões">Bastões</option>
                                                <option value="cajados">cajados</option>
                                                <option value="itens maravilhosos">itens maravilhosos</option>
                                                <option value="pergaminhos">pergaminhos</option>
                                                <option value="poções">poções</option>
                                                <option value="varinhas">varinhas</option>
                                            </select>
                                        </label>
                                        <label class="form-field">Peso (kg)<input @bind="ViewModel.ItemPeso" type="number" step="0.1" min="0" /></label>
                                        <label class="form-field">Preço (PO)<input @bind="ViewModel.ItemPreco" type="number" step="0.01" min="0" /></label>
                                        <label class="form-field">Dano<input @bind="ViewModel.ItemDano" maxlength="20" placeholder="Ex.: 1d8" /></label>
                                        <label class="form-field">Tipo de Dano<input @bind="ViewModel.ItemTipoDano" maxlength="30" placeholder="Ex.: Cortante" /></label>
                                        <label class="form-field">Propriedades<input @bind="ViewModel.ItemPropriedades" maxlength="100" placeholder="Ex.: Versátil, acuidade" /></label>
                                        <label class="form-field">Bônus de CA<input @bind="ViewModel.ItemCaBonus" type="number" min="0" max="10" /></label>
                                        
                                        <label class="form-field">
                                            Raridade
                                            <select @bind="ViewModel.ItemRaridade">
                                                <option value="">Sem raridade</option>
                                                <option value="Comum">Comum</option>
                                                <option value="Incomum">Incomum</option>
                                                <option value="Raro">Raro</option>
                                                <option value="Muito Raro">Muito Raro</option>
                                                <option value="Lendário">Lendário</option>
                                            </select>
                                        </label>

                                        <label class="form-field">
                                            Sintonização
                                            <select @bind="ViewModel.ItemSintonizacao">
                                                <option value="Não">Não</option>
                                                <option value="Sim">Sim</option>
                                            </select>
                                        </label>

                                        <label class="form-field full-width">Descrição<textarea @bind="ViewModel.ItemDescricao" rows="2" placeholder="Efeito mágico ou história do item..."></textarea></label>
                                    }

                                    <div class="editor-actions">
                                        <button class="save-button" type="submit">Cadastrar e Vincular</button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedback))
                                    {
                                        <p class="save-status" role="status" style="margin-top: 10px; color: #d4af37;">@ViewModel.MensagemFeedback</p>
                                    }
                                </form>
                            </div>
                        </section>
                    </div>
                }

                @* =========================================================================
                   ABA DO MESTRE: FICHAS DOS JOGADORES E VALIDAÇÃO DE INVENTÁRIO DA CAMPANHA
                   ========================================================================= *@
                @if (ViewModel.AbaMenu == "fichas")
                {
                    <header class="page-heading">
                        <div>
                            <p class="page-kicker">Controle do Mestre</p>
                            <h1>Fichas e Equipamentos dos Jogadores</h1>
                            <p class="page-description">Inspecione as fichas e os itens da campanha escolhidos pelos jogadores antes de aceitar na mesa.</p>
                        </div>
                    </header>

                    <div class="session-page-content">
                        <div class="link-tabs" role="tablist" style="max-width: 480px; margin-bottom: 16px;">
                            <button class="link-tab @(ViewModel.FiltroFichasMestre == "pendentes" ? "ativa" : "")" @onclick='() => ViewModel.FiltroFichasMestre = "pendentes"'>
                                Fichas para Validar <span>@ViewModel.FichasPendentes.Count()</span>
                            </button>
                            <button class="link-tab @(ViewModel.FiltroFichasMestre == "aceitas" ? "ativa" : "")" @onclick='() => ViewModel.FiltroFichasMestre = "aceitas"'>
                                Fichas Aceitas <span>@ViewModel.FichasAceitas.Count()</span>
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(ViewModel.MensagemFeedbackFichas))
                        {
                            <p class="save-status" style="margin-bottom: 14px; font-size: 12px; color: #d4af37; font-weight: bold;">@ViewModel.MensagemFeedbackFichas</p>
                        }

                        <div class="fichas-mestre-lista">
                            @if (ViewModel.FiltroFichasMestre == "pendentes")
                            {
                                @if (ViewModel.FichasPendentes.Any())
                                {
                                    @foreach (var pc in ViewModel.FichasPendentes)
                                    {
                                        var p = pc.Personagem!;
                                        int qtdItens = p.Inventario?.Itens?.Sum(i => i.Quantidade) ?? 0;
                                        <div class="ficha-mestre-card @(ViewModel.FichaInspecionada?.IdPersonagem == p.IdPersonagem ? "selecionada" : "")">
                                            <div class="ficha-mestre-info">
                                                <strong>@p.Nome</strong>
                                                <span>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</span>
                                                <small>Jogador: @(p.Usuario?.UsarName ?? $"Conta #{p.IdAccount}") · 🎒 @qtdItens item(ns) selecionado(s) na campanha</small>
                                            </div>
                                            <div class="ficha-mestre-acoes">
                                                <button type="button" class="btn-inspecionar" @onclick="() => ViewModel.CarregarFichaParaInspecaoAsync(p.IdPersonagem)">
                                                    @(ViewModel.FichaInspecionada?.IdPersonagem == p.IdPersonagem ? "▼ Ficha e Itens Abertos Abaixo" : "👁 Inspecionar Ficha e Itens")
                                                </button>
                                                <button type="button" class="btn-aprovar-ficha" @onclick="() => ViewModel.AprovarFichaJogadorAsync(p.IdPersonagem)">✓ Aceitar</button>
                                                <button type="button" class="btn-recusar-ficha" @onclick="() => ViewModel.AbrirModalRecusa(p.IdPersonagem)">✕ Recusar</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="empty-message">Nenhuma ficha pendente de validação no momento.</p>
                                }
                            }
                            else
                            {
                                @if (ViewModel.FichasAceitas.Any())
                                {
                                    @foreach (var pc in ViewModel.FichasAceitas)
                                    {
                                        var p = pc.Personagem!;
                                        int qtdItens = p.Inventario?.Itens?.Sum(i => i.Quantidade) ?? 0;
                                        <div class="ficha-mestre-card @(ViewModel.FichaInspecionada?.IdPersonagem == p.IdPersonagem ? "selecionada" : "")">
                                            <div class="ficha-mestre-info">
                                                <strong>@p.Nome <span class="tag-aceita">✓ Aceita</span></strong>
                                                <span>@(p.RacaTexto ?? "Raça") · @(p.ClasseTexto ?? "Classe") · Nível @p.Nivel</span>
                                                <small>Jogador: @(p.Usuario?.UsarName ?? $"Conta #{p.IdAccount}") · 🎒 @qtdItens item(ns) equipado(s)</small>
                                            </div>
                                            <div class="ficha-mestre-acoes">
                                                <button type="button" class="btn-inspecionar" @onclick="() => ViewModel.CarregarFichaParaInspecaoAsync(p.IdPersonagem)">
                                                    @(ViewModel.FichaInspecionada?.IdPersonagem == p.IdPersonagem ? "▼ Ficha e Itens Abertos Abaixo" : "👁 Visualizar Ficha e Itens")
                                                </button>
                                                <button type="button" class="btn-recusar-ficha" title="Revogar aprovação da ficha" @onclick="() => ViewModel.AbrirModalRecusa(p.IdPersonagem)">Revogar</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="empty-message">Nenhuma ficha aceita nesta campanha ainda.</p>
                                }
                            }
                        </div>

                        <!-- MODAL DE MOTIVO DE RECUSA -->
                        @if (ViewModel.IdPersonagemParaRecusar > 0)
                        {
                            <div class="confirm-overlay" role="presentation" @onclick="() => ViewModel.IdPersonagemParaRecusar = 0">
                                <section class="confirm-dialog" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true">
                                    <h2>Motivo da Recusa</h2>
                                    <p>Escreva o motivo pelo qual esta ficha/inventário está sendo recusada. O jogador visualizará essa mensagem na tela dele.</p>
                                    <textarea @bind="ViewModel.TextoMotivoRecusa" rows="3" placeholder="Ex.: Ajuste os itens iniciais ou o valor de HP..." style="width:100%; padding:8px; margin:10px 0; background:#18110c; color:#fff; border:1px solid #9c783d; border-radius:4px;"></textarea>
                                    <div class="confirm-actions">
                                        <button class="confirm-exit" type="button" @onclick="ViewModel.ConfirmarRecusaComMotivoAsync">Confirmar Recusa</button>
                                        <button class="confirm-cancel" type="button" @onclick="() => ViewModel.IdPersonagemParaRecusar = 0">Cancelar</button>
                                    </div>
                                </section>
                            </div>
                        }

                        <!-- =========================================================================
                             PAINEL DE INSPEÇÃO COMPLETA DA FICHA + ITENS DA CAMPANHA LOGO ABAIXO
                             ========================================================================= -->
                        @if (ViewModel.FichaInspecionada != null)
                        {
                            var fichaInspecionada = ViewModel.FichaInspecionada;
                            <section class="ficha-pergaminho-inspecao" aria-label="Inspeção completa da ficha">
                                <div class="inspecao-top-bar">
                                    <span>Inspecionando ficha e equipamentos de <strong>@fichaInspecionada.Nome</strong></span>
                                    <div style="display:flex; gap:8px;">
                                        @if (ViewModel.StatusDaFichaInspecionada == "Pendente")
                                        {
                                            <button type="button" class="btn-aprovar-ficha" @onclick="() => ViewModel.AprovarFichaJogadorAsync(fichaInspecionada.IdPersonagem)">✓ Aceitar Ficha e Itens</button>
                                            <button type="button" class="btn-recusar-ficha" @onclick="() => ViewModel.AbrirModalRecusa(fichaInspecionada.IdPersonagem)">✕ Recusar Ficha</button>
                                        }
                                        <button type="button" class="btn-fechar-inspecao" @onclick="() => ViewModel.CarregarFichaParaInspecaoAsync(0)">Fechar ✕</button>
                                    </div>
                                </div>

                                <div class="ficha-cabecalho-inspecao">
                                    <div class="retrato-inspecao">
                                        <img src="@(string.IsNullOrEmpty(fichaInspecionada.Imagem) ? "img/armaduraprata.png" : fichaInspecionada.Imagem)" alt="Retrato do personagem" />
                                    </div>
                                    <div class="identidade-inspecao">
                                        <p class="sobretitulo-inspecao">Ficha de Personagem (@ViewModel.StatusDaFichaInspecionada)</p>
                                        <h2>@fichaInspecionada.Nome</h2>
                                        <p class="descricao-inspecao">@(fichaInspecionada.RacaTexto ?? "Raça") • @(fichaInspecionada.ClasseTexto ?? "Classe") • Nível Total @fichaInspecionada.Nivel</p>
                                        <div class="dados-inspecao">
                                            <span><b>Raça:</b> @(fichaInspecionada.RacaTexto ?? "Não informada")</span>
                                            <span><b>Tendência:</b> @(fichaInspecionada.Tendencia ?? "Neutra")</span>
                                            <span><b>Antecedente:</b> @(fichaInspecionada.AntecedenteTexto ?? "Não informado")</span>
                                            <span><b>Experiência:</b> @fichaInspecionada.ExperienciaXp.ToString("N0") XP</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="troca-ficha-inspecao" role="tablist">
                                    <button type="button" class="aba-inspecao @(ViewModel.AbaInspecao == "atributos" ? "ativa" : "")" @onclick='() => ViewModel.AbaInspecao = "atributos"'>Atributos & Diário</button>
                                    <button type="button" class="aba-inspecao @(ViewModel.AbaInspecao == "personagem" ? "ativa" : "")" @onclick='() => ViewModel.AbaInspecao = "personagem"'>Personagem & Classes</button>
                                    <button type="button" class="aba-inspecao @(ViewModel.AbaInspecao == "grimorio" ? "ativa" : "")" @onclick='() => ViewModel.AbaInspecao = "grimorio"'>Grimório</button>
                                </div>

                                @if (ViewModel.AbaInspecao == "atributos")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="atributos-grid-inspecao">
                                            <div class="box-attr-inspecao"><span>Força</span><strong>@fichaInspecionada.Forca</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Forca)</small></div>
                                            <div class="box-attr-inspecao"><span>Destreza</span><strong>@fichaInspecionada.Destreza</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Destreza)</small></div>
                                            <div class="box-attr-inspecao"><span>Constituição</span><strong>@fichaInspecionada.Constituicao</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Constituicao)</small></div>
                                            <div class="box-attr-inspecao"><span>Inteligência</span><strong>@fichaInspecionada.Inteligencia</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Inteligencia)</small></div>
                                            <div class="box-attr-inspecao"><span>Sabedoria</span><strong>@fichaInspecionada.Sabedoria</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Sabedoria)</small></div>
                                            <div class="box-attr-inspecao"><span>Carisma</span><strong>@fichaInspecionada.Carisma</strong><small>@SessaoIniciarViewModel.ObterModificador(fichaInspecionada.Carisma)</small></div>
                                        </div>

                                        <div class="grid-2-inspecao">
                                            <div class="painel-escuro-inspecao">
                                                <h4>Salvaguardas Marcadas</h4>
                                                <p>@(fichaInspecionada.Salvaguardas.Any() ? string.Join(", ", fichaInspecionada.Salvaguardas.Select(s => s.Atributo)) : "Nenhuma salvaguarda marcada.")</p>
                                            </div>
                                            <div class="painel-escuro-inspecao">
                                                <h4>Perícias Treinadas</h4>
                                                <p>@(fichaInspecionada.Pericias.Any() ? string.Join(", ", fichaInspecionada.Pericias.Select(p => p.NomePericia)) : "Nenhuma perícia marcada.")</p>
                                            </div>
                                        </div>

                                        <div class="grid-2-inspecao">
                                            <div class="painel-marrom-inspecao">
                                                <h4>Traços de Personalidade</h4>
                                                <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.TracosPersonalidade) ? "Não informado." : fichaInspecionada.TracosPersonalidade)</p>
                                            </div>
                                            <div class="painel-marrom-inspecao">
                                                <h4>Ponto de Vista Atual</h4>
                                                <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.PontoDeVista) ? "Não informado." : fichaInspecionada.PontoDeVista)</p>
                                            </div>
                                        </div>

                                        <div class="diario-inspecao-switch">
                                            <div class="diario-inspecao-tabs">
                                                <button type="button" class="@(ViewModel.SecaoDiarioInspecao == "ideais" ? "ativa" : "")" @onclick='() => ViewModel.SecaoDiarioInspecao = "ideais"'>Ideais</button>
                                                <button type="button" class="@(ViewModel.SecaoDiarioInspecao == "ligacoes" ? "ativa" : "")" @onclick='() => ViewModel.SecaoDiarioInspecao = "ligacoes"'>Ligações</button>
                                                <button type="button" class="@(ViewModel.SecaoDiarioInspecao == "defeitos" ? "ativa" : "")" @onclick='() => ViewModel.SecaoDiarioInspecao = "defeitos"'>Defeitos</button>
                                                <button type="button" class="@(ViewModel.SecaoDiarioInspecao == "idiomas" ? "ativa" : "")" @onclick='() => ViewModel.SecaoDiarioInspecao = "idiomas"'>Idiomas</button>
                                            </div>
                                            <div class="painel-marrom-inspecao">
                                                @if (ViewModel.SecaoDiarioInspecao == "ideais")
                                                {
                                                    <h4>Ideais</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Ideais) ? "Não informado." : fichaInspecionada.Ideais)</p>
                                                }
                                                else if (ViewModel.SecaoDiarioInspecao == "ligacoes")
                                                {
                                                    <h4>Ligações</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Ligacoes) ? "Não informado." : fichaInspecionada.Ligacoes)</p>
                                                }
                                                else if (ViewModel.SecaoDiarioInspecao == "defeitos")
                                                {
                                                    <h4>Defeitos</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Defeitos) ? "Não informado." : fichaInspecionada.Defeitos)</p>
                                                }
                                                else
                                                {
                                                    <h4>Idiomas Conhecidos</h4>
                                                    <p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Idiomas) ? "Não informado." : fichaInspecionada.Idiomas)</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (ViewModel.AbaInspecao == "personagem")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="grid-4-inspecao">
                                            <div class="campo-leitura-inspecao"><span>Idade</span><strong>@(fichaInspecionada.Idade ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Gênero</span><strong>@(fichaInspecionada.Genero ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Altura</span><strong>@(fichaInspecionada.Altura ?? "—")</strong></div>
                                            <div class="campo-leitura-inspecao"><span>Peso</span><strong>@(fichaInspecionada.Peso ?? "—")</strong></div>
                                        </div>

                                        @if (fichaInspecionada.PersonagemClasses != null && fichaInspecionada.PersonagemClasses.Any())
                                        {
                                            <div class="painel-marrom-inspecao">
                                                <h4>Classes (Multiclasse)</h4>
                                                <p>@string.Join(" / ", fichaInspecionada.PersonagemClasses.Where(c => c.Classe != null).Select(c => $"{c.Classe!.Nome} (Nível {c.NivelNaClasse})"))</p>
                                            </div>
                                        }

                                        <div class="grid-2-inspecao">
                                            <div class="painel-marrom-inspecao"><h4>Aparência</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Aparencia) ? "—" : fichaInspecionada.Aparencia)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Aliados e Organizações</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Aliados) ? "—" : fichaInspecionada.Aliados)</p></div>
                                            <div class="painel-marrom-inspecao full-col"><h4>História do Personagem</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Historia) ? "—" : fichaInspecionada.Historia)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Características e Habilidades</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Caracteristicas) ? "—" : fichaInspecionada.Caracteristicas)</p></div>
                                            <div class="painel-marrom-inspecao"><h4>Tesouro Pessoal</h4><p>@(string.IsNullOrWhiteSpace(fichaInspecionada.Tesouro) ? "—" : fichaInspecionada.Tesouro)</p></div>
                                        </div>
                                    </div>
                                }
                                else if (ViewModel.AbaInspecao == "grimorio")
                                {
                                    <div class="inspecao-corpo">
                                        <div class="painel-marrom-inspecao">
                                            <h4>Magias Conhecidas / Preparadas</h4>
                                            @if (fichaInspecionada.PersonagemMagias != null && fichaInspecionada.PersonagemMagias.Any())
                                            {
                                                <ul style="margin: 0; padding-left: 18px;">
                                                    @foreach (var pm in fichaInspecionada.PersonagemMagias)
                                                    {
                                                        if (pm.Magia != null)
                                                        {
                                                            <li><strong>@pm.Magia.Nome</strong> — Círculo @pm.Magia.CirculoNivel | Efeito: @(pm.Magia.DanoEfeito ?? "—") | Alcance: @(pm.Magia.Alcance ?? "—")</li>
                                                        }
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p>Nenhuma magia registrada no grimório.</p>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- =========================================================================
                                     SEÇÃO FIXA ABAIXO DA FICHA: ITENS DA CAMPANHA ENVIADOS PELO JOGADOR
                                     ========================================================================= -->
                                <div style="margin-top: 22px; padding-top: 18px; border-top: 2px dashed rgba(126, 87, 31, 0.45);">
                                    <h3 style="margin: 0 0 12px; color: #392819; font-size: 18px;">
                                        🎒 Itens da Campanha e Moedas Selecionados pelo Jogador
                                    </h3>

                                    @if (fichaInspecionada.Inventario != null)
                                    {
                                        <div class="grid-4-inspecao" style="grid-template-columns: repeat(5, 1fr); margin-bottom: 12px;">
                                            <div class="campo-leitura-inspecao"><span>PC</span><strong>@fichaInspecionada.Inventario.MoedasPC</strong></div>
                                            <div class="campo-leitura-inspecao"><span>PP</span><strong>@fichaInspecionada.Inventario.MoedasPP</strong></div>
                                            <div class="campo-leitura-inspecao"><span>PE</span><strong>@fichaInspecionada.Inventario.MoedasPE</strong></div>
                                            <div class="campo-leitura-inspecao"><span>PO</span><strong>@fichaInspecionada.Inventario.MoedasPO</strong></div>
                                            <div class="campo-leitura-inspecao"><span>PL</span><strong>@fichaInspecionada.Inventario.MoedasPL</strong></div>
                                        </div>

                                        <div class="painel-marrom-inspecao">
                                            <h4>Equipamentos Vinculados (Carga Total: @(fichaInspecionada.Inventario.PesoAtual ?? 0) kg / @(fichaInspecionada.Inventario.CapacidadeCarga ?? 0) kg)</h4>
                                            @if (fichaInspecionada.Inventario.Itens != null && fichaInspecionada.Inventario.Itens.Any())
                                            {
                                                <ul style="margin: 0; padding-left: 18px;">
                                                    @foreach (var ii in fichaInspecionada.Inventario.Itens)
                                                    {
                                                        <li>
                                                            <strong>@(ii.Quantidade)x @(ii.Item?.Nome ?? "Item")</strong>
                                                            — @(ii.Item?.Tipo ?? "Geral")
                                                            (Peso unit.: @(ii.Item?.Peso ?? 0) kg | Valor unit.: @(ii.Item?.Preco ?? 0) po)
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <p>O jogador não selecionou nenhum item da campanha.</p>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(fichaInspecionada.Inventario.Notas))
                                        {
                                            <div class="painel-marrom-inspecao" style="margin-top: 10px;">
                                                <h4>Notas do Inventário do Jogador</h4>
                                                <p>@fichaInspecionada.Inventario.Notas</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="painel-marrom-inspecao">
                                            <p>Nenhum inventário enviado para esta ficha.</p>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }

                @if (ViewModel.AbaMenu == "hist")
                {
                    <header class="page-heading">
                        <div><p class="page-kicker">Memória da campanha</p><h1>Histórico das sessões</h1><p class="page-description">Acompanhe os registros desta mesa.</p></div>
                    </header>
                    <div class="session-page-content">
                        <p class="aviso-vazio">Diário de bordo ativo para <strong>@(ViewModel.CampanhaAtual?.Nome)</strong>.</p>
                    </div>
                }
            </section>
        </div>
    </main>
</div>

@code {
    [Parameter] public int IdCampanha { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        ViewModel.OnChange += StateHasChanged;
        await ViewModel.CarregarDadosCampanhaAsync(IdCampanha);
    }

    public void Dispose()
    {
        ViewModel.OnChange -= StateHasChanged;
    }
}