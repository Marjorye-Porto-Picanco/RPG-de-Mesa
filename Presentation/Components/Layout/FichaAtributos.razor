
<div class="ficha-corpo visao-ficha" id="visao-atributos" role="tabpanel" aria-labelledby="aba-atributos">
    <aside class="atributos" aria-label="Atributos">
        <h2>Atributos</h2>
        <label class="atributo"><span>Força</span><input type="number" min="1" max="30" @bind="Personagem.Forca" aria-label="Força" /><small>@ObterModificador(Personagem.Forca)</small></label>
        <label class="atributo destaque"><span>Destreza</span><input type="number" min="1" max="30" @bind="Personagem.Destreza" aria-label="Destreza" /><small>@ObterModificador(Personagem.Destreza)</small></label>
        <label class="atributo"><span>Constituição</span><input type="number" min="1" max="30" @bind="Personagem.Constituicao" aria-label="Constituição" /><small>@ObterModificador(Personagem.Constituicao)</small></label>
        <label class="atributo"><span>Inteligência</span><input type="number" min="1" max="30" @bind="Personagem.Inteligencia" aria-label="Inteligência" /><small>@ObterModificador(Personagem.Inteligencia)</small></label>
        <label class="atributo"><span>Sabedoria</span><input type="number" min="1" max="30" @bind="Personagem.Sabedoria" aria-label="Sabedoria" /><small>@ObterModificador(Personagem.Sabedoria)</small></label>
        <label class="atributo"><span>Carisma</span><input type="number" min="1" max="30" @bind="Personagem.Carisma" aria-label="Carisma" /><small>@ObterModificador(Personagem.Carisma)</small></label>
    </aside>

    <div class="anotacoes">
        <section class="bloco-anotacao">
            <h2>Traços de personalidade</h2>
            <p>Observo tudo antes de agir. A floresta sempre avisa.</p>
        </section>
        <section class="bloco-anotacao">
            <h2>Ponto de vista atual</h2>
            <p>Nem toda trilha segura leva ao destino certo.</p>
        </section>
        <section class="bloco-anotacao">
            <h2>Pontos de vida</h2>
            <p class="valor-destaque">@Personagem.PvAtual / @Personagem.PvMaximo <span>PV</span></p>
        </section>
        <section class="diario">
            <div class="diario-abas" aria-label="Seções do diário">
                <span class="aba-selecionada">Ideais</span>
                <span>Ligações</span>
                <span>Defeitos</span>
                <span>Idiomas</span>
            </div>
            <p>Proteger os caminhos antigos é proteger quem ainda virá.</p>
        </section>
    </div>

    <aside class="pericias" aria-label="Perícias e proficiências">
        <div class="pericias-grupo">
            <h2>Salvaguardas</h2>
            <ul>
                <li class="treinada">Força</li>
                <li>Destreza</li>
                <li>Constituição</li>
                <li>Inteligência</li>
                <li class="treinada">Sabedoria</li>
                <li>Carisma</li>
            </ul>
        </div>
        <div class="pericias-grupo pericias-lista">
            <h2>Perícias</h2>
            <ul>
                <li class="treinada">Acrobacia</li>
                <li>Arcanismo</li>
                <li class="treinada">Atletismo</li>
                <li>Atuação</li>
                <li>Enganação</li>
                <li>Furtividade</li>
                <li class="treinada">Natureza</li>
                <li class="treinada">Percepção</li>
                <li>Persuasão</li>
                <li>Prestidigitação</li>
                <li class="treinada">Sobrevivência</li>
            </ul>
        </div>
    </aside>
</div>

@code {
    [Parameter]
    public Personagem Personagem { get; set; } = new();

    private string ObterModificador(int valor)
    {
        int mod = (valor - 10) / 2;
        return mod >= 0 ? $"+{mod}" : $"{mod}";
    }
}
