<BotaoAcaoIcone Tipo="excluir"
                Texto="@Texto"
                Titulo="@Titulo"
                Inline="@Inline"
                Class="botao-excluir"
                OnClick="@OnClick" />

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Texto { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
