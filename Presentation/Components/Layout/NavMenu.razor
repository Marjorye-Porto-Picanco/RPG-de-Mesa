@using RPGdeMesa.Application.Services
@using RPGdeMesa.Presentation.Services
@inject SessaoUsuarioService SessaoUsuario
@inject UsuarioService UsuarioService
@inject AppCacheService AppCache
@inject HomeCacheService HomeCache
@inject NavigationManager Navigation
@implements IDisposable

<header class="barra-rpg">
    <NavLink class="marca-rpg" href="/home" Match="NavLinkMatch.All" aria-label="Salão da Mesa, início">
        <span class="marca-icone" aria-hidden="true">⚔</span>
        <span>Salão da Mesa</span>
    </NavLink>

    <nav id="navegacao-principal" class="nav-rpg" aria-label="Navegação principal">
        <NavLink class="nav-link-rpg" href="/campanhas">
            Campanhas
        </NavLink>
        <NavLink class="nav-link-rpg" href="/personagem-lib">
            Personagens
        </NavLink>
        <NavLink class="nav-link-rpg" href="/BibliotecaGeral">
            Biblioteca
        </NavLink>
    </nav>

    <div class="perfil-dropdown-wrap" @onkeydown="AoPressionarTeclaPerfilAsync">
        <button type="button"
                @ref="_botaoPerfil"
                class="perfil-rpg @(MenuAberto || NavegacaoAberta ? "aberto" : "")"
                @onclick="AlternarMenu"
                aria-expanded="@(MenuAberto ? "true" : "false")"
                aria-controls="@(MenuAberto ? "menu-conta menu-mobile" : null)"
                aria-label="@(MenuAberto ? "Fechar menu da conta" : $"Abrir menu da conta de {NomeUsuarioExibido}")">
            <span class="perfil-retrato">
                <RetratoComIniciais Nome="@NomeUsuarioExibido" Imagem="@SessaoUsuario.AvatarUrl"
                                     AceitarBase64="true" CarregarSobDemanda="false" />
            </span>
            <span class="perfil-nome">@NomeUsuarioExibido</span>
            <span class="perfil-seta" aria-hidden="true"></span>
        </button>

        @if (MenuAberto)
        {
            <div class="perfil-backdrop" aria-hidden="true" @onclick="FecharTudo"></div>
            <div id="menu-conta" class="perfil-menu" role="group" aria-label="Ações da conta">
                <button type="button" class="perfil-menu-item" @onclick="IrParaPerfil">
                    <span class="perfil-menu-icone perfil-icone-pessoa" aria-hidden="true"></span>
                    <span>Meu perfil</span>
                </button>
                <button type="button" class="perfil-menu-item sair" @onclick="Sair">
                    <span class="perfil-menu-icone perfil-icone-saida" aria-hidden="true">
                        <img src="@BotaoAcaoIcone.ImagemSair" alt="" width="22" height="22" />
                    </span>
                    <span>Sair da conta</span>
                </button>
            </div>
        }
    </div>
</header>

@if (NavegacaoAberta)
{
    <div class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-label="Menu principal">
        <button type="button" class="mobile-menu-scrim" tabindex="-1" aria-label="Fechar menu" @onclick="FecharTudo"></button>
        <nav class="mobile-menu-drawer" aria-label="Menu principal" id="menu-mobile">
            <div class="mobile-menu-topo">
                <div class="mobile-menu-identidade">
                    <span class="perfil-retrato">
                        <RetratoComIniciais Nome="@NomeUsuarioExibido" Imagem="@SessaoUsuario.AvatarUrl"
                                             AceitarBase64="true" CarregarSobDemanda="false" />
                    </span>
                    <strong class="mobile-menu-nome">@NomeUsuarioExibido</strong>
                </div>
                <button type="button" class="mobile-menu-fechar" data-dialog-initial aria-label="Fechar menu" @onclick="FecharTudo">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="mobile-menu-opcoes">
                <button type="button"
                        class="mobile-menu-opcao @(PerfilAtivo ? "active" : "")"
                        aria-current="@(PerfilAtivo ? "page" : null)"
                        @onclick="IrParaPerfil">
                    <span class="perfil-menu-icone perfil-icone-pessoa" aria-hidden="true"></span>
                    <span class="mobile-menu-label">Meu perfil</span>
                    <b aria-hidden="true">›</b>
                </button>
                <NavLink class="mobile-menu-opcao" href="/campanhas" @onclick="FecharTudo">
                    <span class="mobile-menu-icone" aria-hidden="true">⚑</span>
                    <span class="mobile-menu-label">Campanhas</span>
                    <b aria-hidden="true">›</b>
                </NavLink>
                <NavLink class="mobile-menu-opcao" href="/personagem-lib" @onclick="FecharTudo">
                    <span class="mobile-menu-icone" aria-hidden="true">♙</span>
                    <span class="mobile-menu-label">Personagens</span>
                    <b aria-hidden="true">›</b>
                </NavLink>
                <NavLink class="mobile-menu-opcao" href="/BibliotecaGeral" @onclick="FecharTudo">
                    <span class="mobile-menu-icone" aria-hidden="true">▤</span>
                    <span class="mobile-menu-label">Biblioteca</span>
                    <b aria-hidden="true">›</b>
                </NavLink>
            </div>

            <div class="mobile-menu-rodape">
                <button type="button" class="mobile-menu-opcao mobile-menu-sair" @onclick="Sair">
                    <span class="perfil-menu-icone perfil-icone-saida" aria-hidden="true">
                        <img src="@BotaoAcaoIcone.ImagemSair" alt="" width="22" height="22" />
                    </span>
                    <span class="mobile-menu-label">Sair da conta</span>
                </button>
            </div>
        </nav>
    </div>
}

@code {
    private ElementReference _botaoPerfil;
    private bool MenuAberto { get; set; }
    private bool NavegacaoAberta { get; set; }

    private string NomeUsuarioExibido =>
        string.IsNullOrWhiteSpace(SessaoUsuario.NomeUsuario)
            ? "Mestre da mesa"
            : SessaoUsuario.NomeUsuario.Trim();

    private bool PerfilAtivo => Navigation.ToBaseRelativePath(Navigation.Uri)
        .TrimEnd('/')
        .Equals("perfil", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        SessaoUsuario.OnChange += AtualizarUi;

        if (!SessaoUsuario.EstaLogado || SessaoUsuario.AvatarCarregado)
            return;

        var perfilCache = AppCache.ObterPerfil(SessaoUsuario.IdUsuarioLogado);
        if (!string.IsNullOrWhiteSpace(perfilCache?.AvatarUrl))
        {
            SessaoUsuario.AtualizarAvatar(perfilCache.AvatarUrl);
            return;
        }

        try
        {
            var usuario = await UsuarioService.ObterPorIdAsync(SessaoUsuario.IdUsuarioLogado);
            SessaoUsuario.AtualizarAvatar(usuario?.Perfil?.AvatarUrl);
        }
        catch
        {
            SessaoUsuario.AtualizarAvatar(null);
        }
    }

    private void AtualizarUi() => _ = InvokeAsync(StateHasChanged);

    private async Task AoPressionarTeclaPerfilAsync(KeyboardEventArgs evento)
    {
        if (evento.Key == "Escape" && MenuAberto)
        {
            FecharTudo();
            await _botaoPerfil.FocusAsync();
        }
    }

    private void AlternarMenu()
    {
        bool vaiAbrir = !(MenuAberto || NavegacaoAberta);
        MenuAberto = vaiAbrir;
        NavegacaoAberta = vaiAbrir;
    }

    private void FecharTudo()
    {
        MenuAberto = false;
        NavegacaoAberta = false;
    }

    private void IrParaPerfil()
    {
        FecharTudo();
        Navigation.NavigateTo("/perfil");
    }

    private void Sair()
    {
        FecharTudo();
        AppCache.LimparTudo();
        HomeCache.Limpar();
        SessaoUsuario.FazerLogout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        SessaoUsuario.OnChange -= AtualizarUi;
    }
}
