@if (Visivel)
{
    <div class="confirmacao-overlay" role="dialog" aria-modal="true" aria-labelledby="confirmacao-titulo" @onclick="Cancelar">
        <section class="confirmacao-dialog" @onclick:stopPropagation="true">
            <h2 id="confirmacao-titulo">@(Titulo ?? "Confirmar ação")</h2>
            @if (!string.IsNullOrWhiteSpace(Mensagem))
            {
                <p>@Mensagem</p>
            }
            @if (!string.IsNullOrWhiteSpace(Erro))
            {
                <p class="confirmacao-erro" role="alert">@Erro</p>
            }
            <footer>
                <button type="button" class="confirmacao-cancelar" disabled="@Processando" @onclick="OnCancelar">Cancelar</button>
                <button type="button" class="confirmacao-confirmar" disabled="@Processando" @onclick="OnConfirmar">
                    @(Processando ? "Aguarde..." : "Confirmar")
                </button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Visivel { get; set; }
    [Parameter] public bool Processando { get; set; }
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Mensagem { get; set; }
    [Parameter] public string? Erro { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private Task Cancelar() => Processando ? Task.CompletedTask : OnCancelar.InvokeAsync();
}
