@page "/dadopopup"
@using RPGdeMesa.Application.Services

<div class="modal-backdrop" @onclick="FecharModal"></div>

<main class="dice-popup" aria-labelledby="titulo-dados" @onclick:stopPropagation="true">
    <header class="dice-popup-header">
        <div>
            <p id="contexto-dado">@Contexto</p>
            <h1 id="titulo-dados">Rolar dados</h1>
        </div>
        <button class="dice-close" id="fechar-popup" type="button" aria-label="Fechar rolagem" @onclick="FecharModal">×</button>
    </header>

    <form id="form-rolagem" @onsubmit="RolarDadosAsync" @onsubmit:preventDefault="true">
        <section class="dice-selection" aria-labelledby="rotulo-dado">
            <p class="dice-section-label" id="rotulo-dado">Escolha o dado</p>
            <div class="dice-faces" role="group" aria-label="Tipo de dado">
                @foreach (var face in _facesPadrao)
                {
                    bool selecionado = _facesSelecionadas == face;
                    <button class="dice-face @(selecionado ? "selecionado" : "")"
                            type="button"
                            aria-pressed="@selecionado.ToString().ToLowerInvariant()"
                            @onclick="() => SelecionarDado(face)">
                        @($"d{face}")
                    </button>
                }
            </div>
        </section>

        <div class="dice-options">
            <label class="dice-field">
                Quantidade
                <input id="quantidade-dados" type="number" min="1" max="20" @bind="_quantidade" />
            </label>
            <label class="dice-field">
                Modificador
                <input id="modificador-dado" type="number" min="-100" max="100" @bind="_modificador" />
            </label>
        </div>

        <button class="dice-roll" type="submit">
            <span aria-hidden="true">⚄</span> Rolar
        </button>
    </form>

    @if (_ultimoResultado != null)
    {
        <section class="dice-result" id="resultado-dado" aria-live="polite">
            <p class="dice-result-label">Resultado total</p>
            <strong class="dice-total" id="total-dado">@_ultimoResultado.Total</strong>
            <p class="dice-expression" id="expressao-dado">@_descricaoDetalhada</p>
            <div class="dice-breakdown" id="detalhe-dados" aria-label="Resultados individuais">
                @foreach (var valor in _ultimoResultado.ResultadosIndividuais)
                {
                    <span>@valor</span>
                }
                @if (_ultimoResultado.Modificador != 0)
                {
                    <span class="modifier-result">
                        @(_ultimoResultado.Modificador > 0 ? $"+{_ultimoResultado.Modificador}" : $"−{Math.Abs(_ultimoResultado.Modificador)}")
                    </span>
                }
            </div>
        </section>
    }

    <p class="dice-popup-footer">Os resultados são compartilhados com o registro da sessão.</p>
</main>

@code {
    [Parameter]
    public EventCallback FecharModal { get; set; }

    [Parameter]
    public EventCallback<ResultadoRolagemDto> OnRolagemRealizada { get; set; }

    [Parameter]
    public string Contexto { get; set; } = "Rolagem da mesa";

    private readonly int[] _facesPadrao = [4, 6, 8, 10, 12, 20, 100];
    private int _facesSelecionadas = 20;
    private int _quantidade = 1;
    private int _modificador = 0;

    private ResultadoRolagemDto? _ultimoResultado;
    private string _descricaoDetalhada = string.Empty;

    private void SelecionarDado(int faces)
    {
        _facesSelecionadas = faces;
    }

    private async Task RolarDadosAsync()
    {
        int qtd = Math.Clamp(_quantidade, 1, 20);
        int mod = Math.Clamp(_modificador, -100, 100);
        _quantidade = qtd;
        _modificador = mod;

        var rolagens = new List<int>(qtd);
        for (int i = 0; i < qtd; i++)
        {
            rolagens.Add(Random.Shared.Next(1, _facesSelecionadas + 1));
        }

        int subtotal = rolagens.Sum();
        int total = subtotal + mod;

        string modExpressao = mod > 0 ? $" + {mod}" : mod < 0 ? $" - {Math.Abs(mod)}" : string.Empty;
        string expressao = $"{qtd}d{_facesSelecionadas}{modExpressao}";
        string modDetalhe = mod > 0 ? $" + {mod}" : mod < 0 ? $" − {Math.Abs(mod)}" : string.Empty;

        _ultimoResultado = new ResultadoRolagemDto
        {
            Contexto = Contexto,
            Faces = _facesSelecionadas,
            Quantidade = qtd,
            Modificador = mod,
            ResultadosIndividuais = rolagens,
            Total = total,
            Expressao = expressao
        };

        _descricaoDetalhada = $"{expressao} · {string.Join(" + ", rolagens)}{modDetalhe}";

        if (OnRolagemRealizada.HasDelegate)
        {
            await OnRolagemRealizada.InvokeAsync(_ultimoResultado);
        }
    }
}