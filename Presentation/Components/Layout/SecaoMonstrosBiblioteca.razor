@using RPGdeMesa.Domain.Bestiario

<div class="monster-grid" aria-live="polite">
    @if (Carregando)
    {
        <p class="empty-state library-empty">Carregando monstros...</p>
    }
    else if (Monstros.Any())
    {
        @foreach (var monstro in Monstros)
        {
            <div class="monster-card">
                @if (monstro.IdAccount == IdUsuarioLogado)
                {
                    <BotaoAcaoIcone Class="library-card-delete"
                                    Titulo="@($"Excluir {monstro.Nome}")"
                                    OnClick="() => OnPedirExclusao.InvokeAsync((monstro.IdMonstro, monstro.Nome))" />
                }
                <div class="monster-art">
                    <RetratoComIniciais Nome="@monstro.Nome" Imagem="@monstro.Imagem" />
                    <span class="monster-cr">ND @(monstro.Nd)</span>
                </div>
                <div class="monster-info">
                    <h2><button class="monster-card-open" type="button" @onclick="() => OnSelecionar.InvokeAsync(monstro)">@monstro.Nome</button></h2>
                    <p>@(monstro.Tipo ?? "Criatura") @(monstro.Tamanho?.ToLower() ?? "médio") · @(monstro.Tendencia ?? "Neutro")</p>
                    @if (!string.IsNullOrEmpty(monstro.Habilidades))
                    {
                        <div class="monster-tags">
                            @foreach (var hab in monstro.Habilidades.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span>@hab.Trim()</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p class="empty-state library-empty">Nenhum monstro encontrado.</p>
    }
</div>

@if (ExibirModal && MonstroSelecionado is not null)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="titulo-monstro-biblioteca" @onclick="OnFecharModal">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <button class="modal-close-btn" type="button" aria-label="Fechar" @onclick="OnFecharModal">×</button>

            <div class="page-heading cabecalho-modal">
                <div>
                    <p class="page-kicker">Visualizar criatura</p>
                    <h2 class="page-title titulo-modal" id="titulo-monstro-biblioteca">@MonstroSelecionado.Nome</h2>
                    <p class="page-description">ND @MonstroSelecionado.Nd · @(MonstroSelecionado.Tipo ?? "Criatura")</p>
                </div>
            </div>

            <div class="form-layout">
                <section class="form-panel">
                    <div class="form-grid">
                        <div class="form-field">
                            <span class="field-label-title">Classe de armadura</span>
                            <div class="field-value-box">@MonstroSelecionado.Defesa</div>
                        </div>
                        <div class="form-field">
                            <span class="field-label-title">Pontos de vida</span>
                            <div class="field-value-box">@MonstroSelecionado.Vida</div>
                        </div>
                        <div class="form-field">
                            <span class="field-label-title">Deslocamento</span>
                            <div class="field-value-box">@(MonstroSelecionado.Deslocamento ?? "Não informado")</div>
                        </div>
                        <div class="form-field">
                            <span class="field-label-title">Sentidos</span>
                            <div class="field-value-box">@(MonstroSelecionado.Sentidos ?? "Não informado")</div>
                        </div>
                        <div class="form-field full-width">
                            <span class="field-label-title">Resistências</span>
                            <div class="field-value-box">@(MonstroSelecionado.Resistencias ?? "Nenhuma")</div>
                        </div>
                        <div class="form-field full-width">
                            <span class="field-label-title">Habilidades especiais</span>
                            <div class="field-value-box">@(MonstroSelecionado.Habilidades ?? "Nenhuma")</div>
                        </div>
                        <div class="form-field full-width">
                            <span class="field-label-title">Ataques</span>
                            @if (MonstroSelecionado.Ataques?.Any() == true)
                            {
                                <div class="field-value-box">
                                    @foreach (var ataque in MonstroSelecionado.Ataques)
                                    {
                                        <p><b>@ataque.Nome</b> · @(ataque.BonusAtaque.HasValue ? $"+{ataque.BonusAtaque}" : "Bônus não informado") · @(ataque.Dano ?? "Dano não informado") @(ataque.TipoDano ?? "") · @(ataque.Alcance ?? "Alcance não informado")</p>
                                        @if (!string.IsNullOrWhiteSpace(ataque.Descricao)) { <small>@ataque.Descricao</small> }
                                    }
                                </div>
                            }
                            else { <div class="field-value-box">Nenhum ataque cadastrado.</div> }
                        </div>
                        <div class="form-field full-width">
                            <span class="field-label-title">Descrição</span>
                            <div class="field-value-box caixa-descricao">@(MonstroSelecionado.Descricao ?? "Sem descrição.")</div>
                        </div>
                    </div>
                    <div class="form-footer rodape-modal">
                        @if (MonstroSelecionado.IdAccount == IdUsuarioLogado)
                        {
                            <a class="action-secondary" href="@($"/monstro-editar/{MonstroSelecionado.IdMonstro}")">Editar monstro</a>
                            <BotaoExcluir Inline="true" Texto="Excluir monstro" Titulo="Excluir monstro"
                                          OnClick="() => OnPedirExclusao.InvokeAsync((MonstroSelecionado.IdMonstro, MonstroSelecionado.Nome))" />
                        }
                        <button type="button" class="action-secondary" @onclick="OnFecharModal">Fechar</button>
                    </div>
                </section>
                <aside class="form-aside">
                    <div class="aside-portrait">
                        <RetratoComIniciais Nome="@MonstroSelecionado.Nome" Imagem="@MonstroSelecionado.Imagem" CarregarSobDemanda="false" />
                    </div>
                </aside>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<Monstro> Monstros { get; set; } = Enumerable.Empty<Monstro>();
    [Parameter] public bool Carregando { get; set; }
    [Parameter] public int IdUsuarioLogado { get; set; }
    [Parameter] public Monstro? MonstroSelecionado { get; set; }
    [Parameter] public bool ExibirModal { get; set; }

    [Parameter] public EventCallback<Monstro> OnSelecionar { get; set; }
    [Parameter] public EventCallback OnFecharModal { get; set; }
    [Parameter] public EventCallback<(int Id, string Nome)> OnPedirExclusao { get; set; }
}
