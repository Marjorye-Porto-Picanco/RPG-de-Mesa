@using RPGdeMesa.Domain.Sessoes
@using RPGdeMesa.Presentation.ViewModel

<div class="chat-panel">
    <div class="chat-tabs" role="tablist" aria-label="Canais da mesa">
        <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Chat ? "ativa" : "")"
                type="button"
                role="tab"
                aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Chat)"
                @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Chat)">
            Chat
        </button>
        <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Registro ? "ativa" : "")"
                type="button"
                role="tab"
                aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Registro)"
                @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Registro)">
            Registro
        </button>
        <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Npc ? "ativa" : "")"
                type="button"
                role="tab"
                aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Npc)"
                @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Npc)">
            NPCs
        </button>
        <button class="chat-tab @(ViewModel.AbaChatAtiva == CanaisSessao.Combate ? "ativa" : "")"
                type="button"
                role="tab"
                aria-selected="@(ViewModel.AbaChatAtiva == CanaisSessao.Combate)"
                @onclick="() => ViewModel.MudarAbaChat(CanaisSessao.Combate)">
            Combate
        </button>
    </div>

    @if (ViewModel.AbaChatAtiva == CanaisSessao.Combate && ViewModel.Estado.Encontro.Rodada > 0)
    {
        var encontro = ViewModel.Estado.Encontro;
        var ativo = ViewModel.PinosVisiveisNoMapa.FirstOrDefault(p => p.IdPino == encontro.IdPinoAtual);
        <p class="chat-combat-turn">Rodada @encontro.Rodada · @(encontro.IdPinoAtual == Encontro2014.TurnoCovil ? "Ação de covil" : ativo?.Nome ?? "Turno do mestre")</p>
    }

    @if (!ViewModel.Estado.EhMestre && (ViewModel.Estado.PedidosTeste.Any(p => !p.Total.HasValue) ||
        ViewModel.Estado.Encontro.Fichas.TryGetValue(ViewModel.Estado.Encontro.IdPinoAtual, out var fichaAtual) &&
        fichaAtual is { Morto: false, Estavel: false }))
    {
        <div class="chat-combat-tools">
            @foreach (var pedido in ViewModel.Estado.PedidosTeste.Where(p => !p.Total.HasValue).Take(3))
            {
                <button type="button" class="chat-combat-action" disabled="@ViewModel.ExecutandoAtaqueEntidade"
                        @onclick="() => ViewModel.ResponderTeste2014Async(pedido.Id)">@pedido.Nome @(pedido.Cd.HasValue ? $"(CD {pedido.Cd})" : "")</button>
            }
            @if (ViewModel.EhMeuTurno && ViewModel.PinosVisiveisNoMapa.FirstOrDefault(p => p.IdPino == ViewModel.Estado.Encontro.IdPinoAtual &&
                    p.TipoEntidade == TiposPinoSessao.Personagem && p.IdEntidade == ViewModel.Estado.IdPersonagemLogado && p.PvAtual == 0) is { } caido &&
                ViewModel.Estado.Encontro.Fichas.GetValueOrDefault(caido.IdPino) is { Morto: false, Estavel: false } ficha &&
                ficha.RodadaUltimoTesteMorte != ViewModel.Estado.Encontro.Rodada)
            {
                <button type="button" class="chat-combat-action" disabled="@ViewModel.ExecutandoAtaqueEntidade"
                        @onclick="() => ViewModel.RolarMorteJogador2014Async(caido.IdPino)">Rolar teste contra a morte</button>
            }
        </div>
    }
    @if (!ViewModel.Estado.EhMestre && !string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade))
    {
        <p class="chat-combat-turn" role="status">@ViewModel.FeedbackAtaqueEntidade</p>
    }
    @if (!ViewModel.Estado.EhMestre && ViewModel.AbaChatAtiva == CanaisSessao.Combate)
    {
        @foreach (var pedido in ViewModel.Estado.PedidosTeste.Where(p => p.Total.HasValue).TakeLast(2))
        {
            <p class="chat-combat-turn">@pedido.Nome · resultado @pedido.Total @(pedido.Cd is int cd ? $"contra CD {cd}" : "")</p>
        }
    }

    <div class="chat-feed" aria-live="polite" @key="ViewModel.AbaChatAtiva">
        <div class="chat-feed-content">
            @if (ViewModel.AbaChatAtiva == CanaisSessao.Npc)
            {
                <p class="chat-placeholder">Canal de NPCs reservado para próximas atualizações.</p>
            }
            else if (!ViewModel.MensagensAbaAtiva.Any())
            {
                <p class="chat-placeholder">
                    @(ViewModel.AbaChatAtiva switch
                    {
                        CanaisSessao.Registro => "Nenhuma rolagem registrada ainda.",
                        CanaisSessao.Combate => "Nenhum ataque ou dano registrado ainda.",
                        _ => "Nenhuma mensagem enviada ainda."
                    })
                </p>
            }
            else
            {
                @foreach (var msg in ViewModel.MensagensAbaAtiva)
                {
                    <p @key="msg.IdMensagem" class="chat-line @(msg.EhSistema ? "dice-line" : "")">
                        <strong class="chat-name @(msg.EhSistema ? "sistema" : (msg.Autor == ViewModel.Estado.Mestre.Username ? "mestre" : ""))">
                            @(msg.EhSistema ? "Sistema" : msg.Autor)
                        </strong>
                        <span>@msg.Conteudo</span>
                        <time>@msg.DataEnvioLocal.ToString("HH:mm")</time>
                    </p>
                }
            }
        </div>
    </div>

    @if (ViewModel.AbaChatAtiva == CanaisSessao.Chat)
    {
        <p class="chat-compose-status" role="status">@ViewModel.FeedbackChat</p>
        <form class="chat-compose" @onsubmit="ViewModel.EnviarMensagemChatAsync" @onsubmit:preventDefault="true">
            <input type="text"
                   maxlength="240"
                   placeholder="Escreva para a mesa..."
                   aria-label="Mensagem para a mesa"
                   autocomplete="off"
                   @bind="ViewModel.TextoMensagem"
                   @bind:event="oninput"
                   disabled="@ViewModel.EnviandoMensagem" />
            <button type="submit"
                    aria-label="Enviar mensagem"
                    title="Enviar mensagem"
                    disabled="@(ViewModel.EnviandoMensagem || string.IsNullOrWhiteSpace(ViewModel.TextoMensagem))">
                ↑
            </button>
        </form>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public SessaoViewModel ViewModel { get; set; } = default!;
}
