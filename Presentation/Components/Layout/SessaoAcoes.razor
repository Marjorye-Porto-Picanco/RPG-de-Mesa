@using RPGdeMesa.Domain.Combate
@using RPGdeMesa.Domain.Sessoes
@using RPGdeMesa.Application.Services
@using RPGdeMesa.Presentation.ViewModel

@{
    var pinoSelecionado = ViewModel.PinoAcoesMestre;
}

<div class="action-panel">
    <div class="action-heading">
        <span>Ações rápidas</span>
        @if (ViewModel.ConjuracaoEmCarregamento)
        {
            <small class="turno-liberado-txt">
                @(ViewModel.ConjuracaoPronta ? "Conjuração pronta" : $"Magia carregando · {ViewModel.TurnosRestantesConjuracao} turno(s)")
            </small>
            <button class="action-slot" type="button" @onclick="ViewModel.CancelarConjuracaoAtual">Cancelar magia</button>
        }
        @if (pinoSelecionado is not null)
        {
            <small class="turno-liberado-txt action-target" aria-live="polite" title="@pinoSelecionado.Nome">
                @pinoSelecionado.Nome · @pinoSelecionado.CoordenadaTexto
            </small>
        }
        else if (ViewModel.Estado.EhMestre)
        {
            <small class="@(ViewModel.Estado.IdAccountTurno.HasValue ? "turno-liberado-txt" : "")">
                @(string.IsNullOrWhiteSpace(ViewModel.Estado.NomeJogadorTurno)
                    ? "Selecione um pino no mapa"
                    : $"⏳ Turno: {ViewModel.Estado.NomeJogadorTurno}")
            </small>
        }
        else
        {
            <small class="@(ViewModel.EhMeuTurno ? "turno-liberado-txt" : "turno-bloqueado-txt")">
                @(ViewModel.EhMeuTurno
                    ? "✓ Seu turno liberado!"
                    : (!string.IsNullOrWhiteSpace(ViewModel.Estado.NomeJogadorTurno)
                        ? $"⏳ Turno de {ViewModel.Estado.NomeJogadorTurno}"
                        : "🔒 Aguardando Mestre liberar turno"))
            </small>
        }
    </div>

    @if (pinoSelecionado is { } pino)
    {
        var ficha = ViewModel.Estado.Encontro.Fichas.GetValueOrDefault(pino.IdPino);
        bool podeAgir = (pino.PvAtual ?? pino.PvMaximo ?? 0) > 0 && !RegrasCombate2014.Incapacitado(ficha);
        bool ocupado = ViewModel.ExecutandoAtaqueEntidade;
        @if (ViewModel.Estado.Encontro.MovimentoPendente?.ReacoesPendentes.Contains(pino.IdPino) == true)
        {
            <div class="action-reactions" role="group" aria-label="Ataque de oportunidade">
                <button class="action-slot" type="button" disabled="@ocupado" @onclick="() => ViewModel.AbrirAtaqueOportunidade2014(pino.IdPino)">Usar reação</button>
                <button class="action-slot" type="button" disabled="@ocupado" @onclick="() => ViewModel.DispensarOportunidade2014Async(pino.IdPino)">Deixar passar</button>
            </div>
        }
        <div class="action-slots">
            <button class="action-slot @(ViewModel.PinoParaMover?.IdPino == pino.IdPino ? "ativa" : "")"
                    type="button"
                    disabled="@(ocupado || ViewModel.GravandoMovimentoPino)"
                    title="@(ViewModel.PinoParaMover?.IdPino == pino.IdPino ? "Cancelar movimento por toque" : "Mover este pino tocando na casa de destino")"
                    @onclick="() => AlternarMoverPinoMestre(pino)">
                <img class="slot-icon-image" src="@IconeMover" width="24" height="24" alt="" />
                <span>@(ViewModel.PinoParaMover?.IdPino == pino.IdPino ? "Cancelar" : "Mover pino")</span>
                <small>Mapa</small>
            </button>
            <button class="action-slot @(ViewModel.ExibirCombateMestre ? "ativa" : "")" type="button"
                    disabled="@(ocupado || !podeAgir || pino.TipoEntidade == TiposPinoSessao.Personagem)"
                    @onclick="ViewModel.AbrirAtaquePinoAcoesMestre">
                <img class="slot-icon-image" src="@IconeAtaque" width="24" height="24" alt="" />
                <span>Ataque</span><small>Ação</small>
            </button>
            <button class="action-slot @(_exibirHabilidadeMestre ? "ativa" : "")" type="button"
                    disabled="@(ocupado || !podeAgir)" @onclick="AbrirHabilidadeMestre">
                <img class="slot-icon-image" src="@IconeMagia" width="24" height="24" alt="" />
                <span>Habilidades</span><small>Ação</small>
            </button>
            @foreach (var (acao, categoria, imagem, simbolo) in AcoesBasicasMestre)
            {
                <button class="action-slot @(_acaoBasicaMestre == acao ? "ativa" : "")" type="button"
                        disabled="@(ocupado || !podeAgir || (acao == AcaoBasica2014.Esconder && !pino.Visivel))"
                        title="@(acao == AcaoBasica2014.Esconder && !pino.Visivel ? "O pino já está oculto para os jogadores" : null)"
                        @onclick="() => AbrirAcaoBasicaMestre(acao)">
                    @if (imagem is not null)
                    {
                        <img class="slot-icon-image" src="@imagem" width="24" height="24" alt="" />
                    }
                    else
                    {
                        <span class="slot-icon" aria-hidden="true">@simbolo</span>
                    }
                    <span>@acao</span><small>@categoria</small>
                </button>
            }
        </div>
        @if (_acaoBasicaMestre is null && !_exibirHabilidadeMestre && !ViewModel.ExibirCombateMestre && !ViewModel.ExibirPainel2014 &&
            !string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade))
        {
            <p class="action-pin-feedback" role="status">@ViewModel.FeedbackAtaqueEntidade</p>
        }
    }
    else
    {
        @if (ViewModel.EhMeuTurno)
        {
            <div class="turn-action-status">Ações restantes: @ViewModel.AcoesDisponiveisNoTurno</div>
        }
        <div class="action-slots">
            <button class="action-slot @(ViewModel.ModoMovimentoLivreAtivo ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.ExecutandoDisparada)"
                    title="Movimente seu pino até o deslocamento da raça; não consome ação"
                    @onclick="ViewModel.AlternarModoMovimentoLivreAsync">
                <img class="slot-icon-image" src="@IconeMover" width="24" height="24" alt="" />
                <span>@(ViewModel.ModoMovimentoLivreAtivo ? "Cancelar movimento" : "Mover")</span><small>Deslocamento</small>
            </button>
            <button class="action-slot @(ViewModel.ExibirModalAtaque || ViewModel.ExibirCombateMestre ? "ativa" : "")"
                    type="button"
                    disabled="@(ViewModel.Estado.EhMestre
                                        ? ViewModel.ExecutandoAtaqueEntidade
                                        : !ViewModel.EhMeuTurno || ViewModel.AcoesDisponiveisNoTurno <= 0 || ViewModel.BloquearAtaquePorConjuracao)"
                    title="@(ViewModel.Estado.EhMestre ? "Atacar com monstro ou NPC" : ViewModel.EhMeuTurno ? "Realizar ataque" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AbrirModalAtaqueAsync">
                <img class="slot-icon-image" src="@IconeAtaque" width="24" height="24" alt="" />
                <span>Ataque</span><small>Ação</small>
            </button>
            <button class="action-slot @(ViewModel.ExibirModalMagia ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.AcoesDisponiveisNoTurno <= 0 || ViewModel.BloquearAtaquePorConjuracao)"
                    title="@(ViewModel.EhMeuTurno ? "Conjurar magia da sua ficha" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AbrirModalMagiaAsync">
                <img class="slot-icon-image" src="@IconeMagia" width="24" height="24" alt="" />
                <span>Conjurar Magia</span><small>Ação</small>
            </button>
            <button class="action-slot @(ViewModel.ModoDisparadaAtivo ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.ExecutandoDisparada || ViewModel.AcoesDisponiveisNoTurno <= 0)"
                    title="@(ViewModel.EhMeuTurno ? "Dobra seu deslocamento neste turno — clique e escolha a casa no mapa" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AlternarModoDisparadaAsync">
                <img class="slot-icon-image" src="@IconeDisparada" width="24" height="24" alt="" />
                <span>@(ViewModel.ModoDisparadaAtivo ? "Cancelar" : "Disparada")</span>
                <small>Ação</small>
            </button>
            <button class="action-slot @(ViewModel.ModoDesengajarAtivo ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.ExecutandoDisparada || ViewModel.AcoesDisponiveisNoTurno <= 0)"
                    title="@(ViewModel.EhMeuTurno ? "Afaste-se de inimigos sem provocar Ataques de Oportunidade" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AlternarModoDesengajarAsync">
                <img class="slot-icon-image" src="@IconeDesengajar" width="24" height="24" alt="" />
                <span>@(ViewModel.ModoDesengajarAtivo ? "Cancelar" : "Desengajar")</span>
                <small>Ação</small>
            </button>
            <button class="action-slot @(ViewModel.ExibirModalEsquivar ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.AcoesDisponiveisNoTurno <= 0)"
                    title="@(ViewModel.EhMeuTurno ? "Ataques contra você terão desvantagem (2d20, menor valor) até seu próximo turno" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AbrirModalEsquivar">
                <img class="slot-icon-image" src="@IconeEsquivar" width="24" height="24" alt="" />
                <span>Esquivar</span><small>Defesa</small>
            </button>
            <button class="action-slot @(ViewModel.ExibirModalEsconder ? "ativa" : "")"
                    type="button"
                    disabled="@(!ViewModel.EhMeuTurno || ViewModel.AcoesDisponiveisNoTurno <= 0)"
                    title="@(ViewModel.EhMeuTurno ? "Teste de Destreza (Furtividade) para ficar oculto no mapa" : "Aguarde o Mestre liberar seu turno")"
                    @onclick="ViewModel.AbrirModalEsconderAsync">
                <img class="slot-icon-image" src="@IconeEsconder" width="24" height="24" alt="" />
                <span>Esconder</span><small>Furtividade</small>
            </button>
            @if (ViewModel.EhMeuTurno)
            {
                <button class="action-slot" type="button" @onclick="ViewModel.PassarMeuTurnoAsync">
                    <span class="slot-icon">↪</span><span>Passar turno</span><small>Encerrar</small>
                </button>
            }
        </div>
    }
</div>

@if (ViewModel.PinoAcoesMestre is { } pinoEmAcao)
{
    @if (_acaoBasicaMestre is { } acaoBasica)
    {
        var ficha = ViewModel.Estado.Encontro.Fichas.GetValueOrDefault(pinoEmAcao.IdPino);
        var alvosAdjacentes = acaoBasica == AcaoBasica2014.Ajudar
            ? ObterAlvosAdjacentesAjuda(pinoEmAcao)
            : [];
        bool alvoAjudaValido = acaoBasica != AcaoBasica2014.Ajudar ||
            alvosAdjacentes.Any(a => a.IdPino == _idAlvoAjudaMestre);
        bool gatilhoPrepararValido = acaoBasica != AcaoBasica2014.Preparar ||
            !string.IsNullOrWhiteSpace(_gatilhoAcaoMestre);
        bool podeConfirmarAcaoBasica = !ViewModel.ExecutandoAtaqueEntidade && alvoAjudaValido && gatilhoPrepararValido;

        <div class="attack-backdrop" @onclick="FecharAcaoPinoMestre"></div>
        <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-acao-pino" @onclick:stopPropagation="true">
            <header class="attack-header">
                <div>
                    <p>@pinoEmAcao.Nome · @pinoEmAcao.CoordenadaTexto</p>
                    <h2 id="titulo-acao-pino">@acaoBasica</h2>
                </div>
                <button class="attack-close" type="button" aria-label="Fechar ação" data-dialog-close
                        disabled="@ViewModel.ExecutandoAtaqueEntidade" @onclick="FecharAcaoPinoMestre">
                    ×
                </button>
            </header>
            <fieldset class="quick-action-form" disabled="@ViewModel.ExecutandoAtaqueEntidade">
                <label class="attack-field">
                    Uso
                    <select @bind="_tipoAcaoBasicaMestre">
                        <option value="@TipoAcao2014.Acao">Ação</option>
                        <option value="@TipoAcao2014.Bonus">Ação bônus da ficha</option>
                    </select>
                </label>
                @if (acaoBasica == AcaoBasica2014.Ajudar)
                {
                    if (alvosAdjacentes.Count == 0)
                    {
                        <p class="attack-empty">Nenhum pino adjacente (até 1,5 m) para Ajudar.</p>
                    }
                    else
                    {
                        <label class="attack-field">
                            Alvo adjacente
                            <select @bind="_idAlvoAjudaMestre">
                                <option value="0">Selecione um pino</option>
                                @foreach (var alvo in alvosAdjacentes)
                                {
                                    <option @key="alvo.IdPino" value="@alvo.IdPino">@alvo.Nome · @alvo.CoordenadaTexto</option>
                                }
                            </select>
                        </label>
                    }
                }
                @if (acaoBasica == AcaoBasica2014.Preparar)
                {
                    <label class="attack-field">
                        Gatilho
                        <input maxlength="180"
                               placeholder="Ex.: Quando um herói se aproximar a 1,5 m"
                               @bind="_gatilhoAcaoMestre"
                               @bind:event="oninput" />
                    </label>
                }
                @if (acaoBasica == AcaoBasica2014.Esconder)
                {
                    <label class="attack-field">
                        CD do teste
                        <input type="number" min="1" max="40" @bind="_cdEsconderMestre" />
                    </label>
                    <label class="attack-field">
                        Modificador de Furtividade
                        <input type="number" min="-50" max="50" @bind="_modificadorEsconderMestre" />
                    </label>
                    <p class="attack-empty">Se o teste passar, o pino fica oculto para os outros jogadores.</p>
                }
                @if (ficha is not null)
                {
                    <p class="attack-empty">Ação @(ficha.AcaoUsada ? "usada" : "livre") · Bônus @(ficha.BonusUsado ? "usado" : "livre") · Reação @(ficha.ReacaoUsada ? "usada" : "livre")</p>
                    @if (ficha.GatilhoPreparado is { } gatilho)
                    {
                        <p class="attack-empty">Ação preparada · @gatilho</p>
                    }
                }
                <button class="attack-roll" type="button" disabled="@(!podeConfirmarAcaoBasica)"
                        @onclick="() => UsarAcaoBasicaMestreAsync(pinoEmAcao.IdPino, acaoBasica)">
                    @(ViewModel.ExecutandoAtaqueEntidade
                        ? "Registrando..."
                        : acaoBasica == AcaoBasica2014.Esconder
                            ? "Rolar Furtividade (1d20)"
                            : "Usar ação")
                </button>
            </fieldset>
            @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade))
            {
                <p class="attack-master-feedback @(ViewModel.FeedbackCombateEhErro ? "attack-error" : null)"
                   role="@(ViewModel.FeedbackCombateEhErro ? "alert" : "status")">@ViewModel.FeedbackAtaqueEntidade</p>
            }
        </section>
    }
    else if (_exibirHabilidadeMestre)
    {
        <div class="attack-backdrop" @onclick="FecharAcaoPinoMestre"></div>
        <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-habilidade-pino" @onclick:stopPropagation="true">
            <header class="attack-header">
                <div>
                    <p>@pinoEmAcao.Nome · @pinoEmAcao.CoordenadaTexto</p>
                    <h2 id="titulo-habilidade-pino">Habilidades</h2>
                </div>
                <button class="attack-close" type="button" aria-label="Fechar habilidades" data-dialog-close
                        disabled="@ViewModel.ExecutandoAtaqueEntidade" @onclick="FecharAcaoPinoMestre">
                    ×
                </button>
            </header>
            <fieldset class="combate2014-form quick-action-form" disabled="@ViewModel.ExecutandoAtaqueEntidade">
                <SessaoHabilidade2014 @key="pinoEmAcao.IdPino" ViewModel="ViewModel" IdOrigem="pinoEmAcao.IdPino" />
            </fieldset>
            @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade))
            {
                <p class="attack-master-feedback @(ViewModel.FeedbackCombateEhErro ? "attack-error" : null)"
                   role="@(ViewModel.FeedbackCombateEhErro ? "alert" : "status")">@ViewModel.FeedbackAtaqueEntidade</p>
            }
        </section>
    }
}

@if (ViewModel.ExibirModalConfirmarDisparada && ViewModel.PinoJogadorDisparada != null && ViewModel.DestinoDisparada != null)
{
    <div class="attack-backdrop" @onclick="ViewModel.VoltarEscolhaCasaDisparada"></div>

    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-disparada" @onclick:stopPropagation="true">
        <header class="attack-header">
            <div>
                <p>Confirmar Disparada</p>
                <h2 id="titulo-disparada">◷ Confirmar movimento</h2>
            </div>
            <button class="attack-close" type="button" aria-label="Fechar disparada" @onclick="ViewModel.VoltarEscolhaCasaDisparada">×</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(ViewModel.ErroDisparada))
        {
            <div class="attack-error">@ViewModel.ErroDisparada</div>
        }

        <div class="attack-result-box acertou">
            <span class="attack-badge acertou">ALCANCE VÁLIDO (MÁX. @ViewModel.AlcanceMovimentoAtualTexto)</span>
            <strong>@ViewModel.PinoJogadorDisparada.CoordenadaTexto → @ViewModel.DestinoDisparadaTexto</strong>
            <p>
                Distância percorrida: <b>@ViewModel.DistanciaDestinoTexto</b>
                Deslocamento normal: @ViewModel.DeslocamentoNormalTexto.
            </p>
            <p class="attack-hp-summary">
                <text>Ao confirmar, seu pino será movido. Você ainda poderá realizar sua ação e passar o turno quando desejar.</text>
            </p>
        </div>

        <div class="attack-footer-actions">
            <button type="button"
                    class="attack-btn-sec"
                    disabled="@ViewModel.ExecutandoDisparada"
                    @onclick="ViewModel.VoltarEscolhaCasaDisparada">
                Escolher outra casa
            </button>
            <button type="button"
                    class="attack-btn-prim"
                    disabled="@ViewModel.ExecutandoDisparada"
                    @onclick="ViewModel.ConfirmarDisparadaAsync">
                @(ViewModel.ExecutandoDisparada ? "Movendo..." : "Confirmar movimento")
            </button>
        </div>
    </section>
}

@if (ViewModel.ExibirModalEsquivar)
{
    <div class="attack-backdrop" @onclick="ViewModel.FecharModalEsquivar"></div>

    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-esquivar" @onclick:stopPropagation="true">
        <header class="attack-header">
            <div>
                <p>Ação de Defesa</p>
                <h2 id="titulo-esquivar">◈ Esquivar</h2>
            </div>
            <button class="attack-close" type="button" aria-label="Fechar esquiva" @onclick="ViewModel.FecharModalEsquivar">×</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(ViewModel.ErroEsquivar))
        {
            <div class="attack-error">@ViewModel.ErroEsquivar</div>
        }

        <div class="attack-result-box acertou">
            <span class="attack-badge acertou">POSTURA DEFENSIVA</span>
            <p>
                Qualquer inimigo, NPC ou jogador que atacar você rolará <b>2d20</b> e ficará com o <b>menor valor</b>.
                O efeito dura até o início do seu próximo turno (quando o turno retornar para você).
            </p>
            <p class="attack-hp-summary">A Esquiva ficará ativa até seu próximo turno. Você ainda poderá se mover; passe o turno quando terminar.</p>
        </div>

        <div class="attack-footer-actions">
            <button type="button"
                    class="attack-btn-sec"
                    disabled="@ViewModel.ExecutandoEsquivar"
                    @onclick="ViewModel.FecharModalEsquivar">
                Cancelar
            </button>
            <button type="button"
                    class="attack-btn-prim"
                    disabled="@ViewModel.ExecutandoEsquivar"
                    @onclick="ViewModel.ConfirmarEsquivarAsync">
                @(ViewModel.ExecutandoEsquivar ? "Ativando..." : "Confirmar Esquiva")
            </button>
        </div>
    </section>
}

@if (ViewModel.ExibirModalEsconder)
{
    <div class="attack-backdrop" @onclick="ViewModel.FecharModalEsconder"></div>

    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-esconder" @onclick:stopPropagation="true">
        <header class="attack-header">
            <div>
                <p>Teste de Destreza (Furtividade)</p>
                <h2 id="titulo-esconder">⌕ Esconder</h2>
            </div>
            <button class="attack-close" type="button" aria-label="Fechar esconder" @onclick="ViewModel.FecharModalEsconder">×</button>
        </header>

        @if (ViewModel.CarregandoEsconder)
        {
            <p class="attack-empty">Carregando atributos e perícias da sua ficha...</p>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ViewModel.ErroEsconder))
            {
                <div class="attack-error">@ViewModel.ErroEsconder</div>
            }

            @if (ViewModel.EtapaEsconder == 1)
            {
                int bonusTotal = ViewModel.ModDestrezaEsconder + ViewModel.BonusProficienciaEsconder + ViewModel.BonusExtraEsconder;

                <div class="stealth-summary">
                    <div>
                        <span>Mod. Destreza</span>
                        <strong>@(ViewModel.ModDestrezaEsconder >= 0 ? $"+{ViewModel.ModDestrezaEsconder}" : ViewModel.ModDestrezaEsconder.ToString())</strong>
                    </div>
                    <div>
                        <span>Proficiência (Furtividade)</span>
                        <strong>@(ViewModel.TemProficienciaFurtividade ? $"+{ViewModel.BonusProficienciaEsconder}" : "Sem prof.")</strong>
                    </div>
                    <div>
                        <span>Bônus Total</span>
                        <strong>@(bonusTotal >= 0 ? $"+{bonusTotal}" : bonusTotal.ToString())</strong>
                    </div>
                </div>

                <div class="attack-options">
                    <label class="attack-field">
                        CD do Teste (Mestre)
                        <input type="number" min="1" max="40" @bind="ViewModel.CdEsconder" />
                    </label>
                    <label class="attack-field">
                        Bônus Extra (opcional)
                        <input type="number" min="-50" max="50" @bind="ViewModel.BonusExtraEsconder" />
                    </label>
                </div>

                <button type="button"
                        class="attack-roll"
                        disabled="@ViewModel.ExecutandoEsconder"
                        @onclick="ViewModel.RolarTesteEsconderAsync">
                    @(ViewModel.ExecutandoEsconder ? "Rolando Furtividade..." : "🎲 Rolar Teste de Furtividade (1d20)")
                </button>
            }
            else if (ViewModel.EtapaEsconder == 2 && ViewModel.ResultadoEsconderAtual != null)
            {
                var r = ViewModel.ResultadoEsconderAtual;
                <div class="attack-result-box @(r.Passou ? "acertou" : "falhou")">
                    <span class="attack-badge @(r.Passou ? "acertou" : "falhou")">
                        @(r.Passou ? "🥷 SUCESSO — VOCÊ ESTÁ ESCONDIDO!" : "FALHOU NA FURTIVIDADE")
                    </span>
                    <strong>@r.Total</strong>
                    <p>
                        d20 (@r.DadoD20)
                        @(r.ModificadorDestreza >= 0 ? $"+ {r.ModificadorDestreza}" : $"− {Math.Abs(r.ModificadorDestreza)}") (DES)
                        @(r.BonusProficiencia > 0 ? $" + {r.BonusProficiencia} (Prof.)" : "")
                        @(r.BonusExtra != 0 ? (r.BonusExtra > 0 ? $" + {r.BonusExtra}" : $" − {Math.Abs(r.BonusExtra)}") : "")
                        @(r.Passou ? " ≥ " : " < ") CD @r.CdAlvo
                    </p>
                    <p class="attack-hp-summary">
                        @(r.Passou
                            ? "Seu pino agora está invisível para os outros jogadores. Apenas você e o Mestre conseguem vê-lo."
                            : "Você não conseguiu se ocultar dos inimigos. Seu pino continua visível.")
                    </p>
                </div>

                <div class="attack-footer-actions">
                    <button type="button" class="attack-btn-prim" @onclick="ViewModel.FecharModalEsconder">Fechar</button>
                </div>
            }
        }
    </section>
}

@if (ViewModel.ExibirPainel2014)
{
    <SessaoPainelCombate2014 ViewModel="ViewModel" />
}

@if (ViewModel.ExibirCombateMestre)
{
    var atacantes = ViewModel.AtacantesMestre.ToList();
    var ataques = ViewModel.AtaquesMestre.ToList();
    var alvos = ViewModel.AlvosMestre.ToList();
    var filaGolpes = ViewModel.GolpesMestre;

    <div class="attack-backdrop" @onclick="ViewModel.FecharCombateMestre"></div>
    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-ataque-mestre" @onclick:stopPropagation="true">
        <header class="attack-header">
            <h2 id="titulo-ataque-mestre">Ataque do mestre</h2>
            <button class="attack-close" type="button" aria-label="Fechar ataque" data-dialog-close
                    disabled="@ViewModel.ExecutandoAtaqueEntidade" @onclick="ViewModel.FecharCombateMestre">
                ×
            </button>
        </header>

        @if (atacantes.Count == 0)
        {
            <p class="attack-empty">Coloque um monstro ou NPC vivo no mapa ativo para atacar.</p>
        }
        else
        {
            @if (ViewModel.AtaqueMestreComAtacanteFixo)
            {
                <p class="attack-master-distance">Atacante · @atacantes[0].Nome · @atacantes[0].CoordenadaTexto</p>
            }
            else
            {
                <SeletorPinosCombate Titulo="Atacante" NomeGrupo="atacante-mestre" Pinos="atacantes"
                                     IdSelecionado="ViewModel.IdPinoAtacanteMestre" AoSelecionar="ViewModel.SelecionarAtacanteMestre"
                                     Desabilitado="ViewModel.ExecutandoAtaqueEntidade" FocoInicial="true" />
            }

            @if (ViewModel.IdPinoAtacanteMestre > 0)
            {
                <label class="attack-field">
                    Ataque
                    <select @bind="ViewModel.IdAtaqueMestre" @bind:after="ViewModel.LimparFeedbackCombateMestre"
                            disabled="@(ViewModel.ExecutandoAtaqueEntidade || ataques.Count == 0)">
                        <option value="0">@(ataques.Count == 0 ? "Nenhum ataque vinculado" : "Escolha um ataque")</option>
                        @foreach (var ataque in ataques)
                        {
                            <option @key="ataque.Id" value="@ataque.Id" disabled="@(!ataque.TemFormulaDano)">
                                @ataque.Nome · @(ataque.TemFormulaDano ? ataque.Dano : string.IsNullOrWhiteSpace(ataque.Dano) ? "sem dano cadastrado" : "fórmula inválida")
                            </option>
                        }
                    </select>
                </label>
                @if (ataques.Count > 0 && ataques.All(a => !a.TemFormulaDano))
                {
                    <p class="attack-empty">Preencha o campo Dano na ficha para rolar um golpe. Para efeitos sem dano, selecione o pino no mapa e abra Habilidades em Ações rápidas.</p>
                }
                <SeletorPinosCombate Titulo="Alvo" NomeGrupo="alvo-mestre" Pinos="alvos"
                                     IdSelecionado="ViewModel.IdPinoAlvoMestre" AoSelecionar="ViewModel.SelecionarAlvoMestre"
                                     Desabilitado="ViewModel.ExecutandoAtaqueEntidade" />

                @if (ViewModel.DistanciaAtaqueMestre is decimal distancia)
                {
                    <p class="attack-master-distance">Distância até o alvo @distancia.ToString("0.#") m</p>
                }
                <details class="attack-master-options">
                    <summary>Opções do golpe</summary>
                    <OpcoesGolpeMestre2014 ViewModel="ViewModel" />
                </details>
                @if (!ViewModel.AtaqueOportunidade2014)
                {
                    <div class="attack-footer-actions">
                        <button class="attack-btn-sec" type="button" disabled="@(!ViewModel.PodeAdicionarGolpeMestre || filaGolpes.Count >= 12)"
                                @onclick="ViewModel.AdicionarGolpeMestre">
                            Adicionar ao multiataque
                        </button>
                    </div>
                }
                @if (filaGolpes.Count > 0)
                {
                    <ol class="attack-master-queue">
                        @for (int i = 0; i < filaGolpes.Count; i++)
                        {
                            int indice = i;
                            var golpe = filaGolpes[indice];
                            string nomeAtaque = ataques.FirstOrDefault(a => a.Id == golpe.IdAtaque)?.Nome ?? $"Ataque #{golpe.IdAtaque}";
                            string nomeAlvo = alvos.FirstOrDefault(a => a.IdPino == golpe.IdAlvo)?.Nome ?? $"Pino #{golpe.IdAlvo}";
                            <li @key="indice">
                                <span class="attack-queue-row">
                                    <span>@nomeAtaque → @nomeAlvo</span>
                                    <button type="button" class="attack-btn-sec attack-queue-remove" aria-label="Remover golpe @(indice + 1)"
                                            disabled="@ViewModel.ExecutandoAtaqueEntidade"
                                            @onclick="() => ViewModel.RemoverGolpeMestre(indice)">
                                        ×
                                    </button>
                                </span>
                            </li>
                        }
                    </ol>
                    <button class="attack-btn-sec" type="button" disabled="@ViewModel.ExecutandoAtaqueEntidade"
                            @onclick="ViewModel.LimparGolpesMestre">
                        Limpar sequência
                    </button>
                }
            }

            <button class="attack-roll" type="button" disabled="@(!ViewModel.PodeAtacarComoMestre)" @onclick="ViewModel.ConfirmarAtaqueMestreAsync">
                @(ViewModel.ExecutandoAtaqueEntidade
                    ? "Resolvendo ataque…"
                    : filaGolpes.Count > 0
                        ? $"Rolar multiataque ({filaGolpes.Count})"
                        : "Rolar ataque")
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade))
        {
            <p class="attack-master-feedback" role="status">@ViewModel.FeedbackAtaqueEntidade</p>
        }
    </section>
}

@if (ViewModel.ExibirModalAtaque)
{
    <div class="attack-backdrop" @onclick="ViewModel.FecharModalAtaque"></div>

    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-ataque" @onclick:stopPropagation="true">
        <header class="attack-header">
            <div>
                <p>Ação de Combate</p>
                <h2 id="titulo-ataque">⚔ Realizar Ataque</h2>
            </div>
            <button class="attack-close" type="button" aria-label="Fechar ataque" @onclick="ViewModel.FecharModalAtaque">×</button>
        </header>

        @if (ViewModel.CarregandoAtaque)
        {
            <p class="attack-empty">Carregando armas do seu inventário...</p>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ViewModel.ErroModalAtaque))
            {
                <div class="attack-error">@ViewModel.ErroModalAtaque</div>
            }

            @if (ViewModel.EtapaAtaque == 1)
            {
                decimal alcanceArma = ViewModel.ObterAlcanceArmaMetros(ViewModel.ArmaSelecionada);

                <div class="attack-section">
                    <p class="attack-section-label">1. Escolha a arma do inventário (Alcance: @SessaoViewModel.FormatarMetros(alcanceArma))</p>
                    @if (!ViewModel.ArmasDisponiveisAtaque.Any())
                    {
                        <p class="attack-empty">Nenhuma arma encontrada no seu inventário. Adicione uma arma na aba Inventário da sua ficha.</p>
                    }
                    else
                    {
                        <div class="attack-choice-list">
                            @foreach (var arma in ViewModel.ArmasDisponiveisAtaque)
                            {
                                bool sel = ViewModel.IdArmaSelecionada == arma.IdItem;
                                <button type="button"
                                        class="attack-choice-card @(sel ? "selecionado" : "")"
                                        @onclick="() => ViewModel.SelecionarArmaAtaque(arma.IdItem)">
                                    <strong>@arma.Nome</strong>
                                    <small>Dano: @(string.IsNullOrWhiteSpace(arma.Dano) ? "1d4" : arma.Dano) @arma.TipoDano · @SessaoViewModel.FormatarMetros(ViewModel.ObterAlcanceArmaMetros(arma))</small>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="attack-section">
                    <p class="attack-section-label">2. Escolha o alvo no mapa (Monstro, NPC ou Jogador)</p>
                    @if (!ViewModel.AlvosNoMapa.Any())
                    {
                        <p class="attack-empty">Nenhum alvo visível no mapa atual.</p>
                    }
                    else
                    {
                        <div class="attack-choice-list">
                            @foreach (var alvo in ViewModel.AlvosNoMapa)
                            {
                                int pvAt = alvo.PvAtual ?? alvo.PvMaximo ?? 0;
                                int pvMx = alvo.PvMaximo ?? 0;
                                bool derrotado = pvAt <= 0;
                                var dist = ViewModel.ObterDistanciaAlvoMetros(alvo);
                                bool foraAlcance = !ViewModel.AlvoDentroAlcanceArma(alvo);
                                bool bloqueado = derrotado || foraAlcance;
                                bool sel = !bloqueado
                                    && ViewModel.TipoAlvoSelecionado == alvo.TipoEntidade
                                    && ViewModel.IdAlvoSelecionado == alvo.IdPino;

                                string tagClasse = alvo.TipoEntidade switch
                                {
                                    TiposPinoSessao.Monstro => "alvo-tag-monstro",
                                    TiposPinoSessao.Npc => "alvo-tag-npc",
                                    _ => "alvo-tag-jogador"
                                };

                                string tagLabel = alvo.TipoEntidade switch
                                {
                                    TiposPinoSessao.Monstro => "Monstro",
                                    TiposPinoSessao.Npc => "NPC",
                                    _ => "Jogador"
                                };

                                <button type="button"
                                        disabled="@bloqueado"
                                        class="attack-choice-card @(sel ? "selecionado" : "") @(bloqueado ? "derrotado" : "")"
                                        @onclick="() => ViewModel.SelecionarAlvoAtaque(alvo.TipoEntidade, alvo.IdPino)">
                                    <div class="attack-choice-topo">
                                        <strong>@alvo.Nome (@alvo.CoordenadaTexto)</strong>
                                        <span class="alvo-tag @tagClasse">@tagLabel</span>
                                    </div>
                                    @if (foraAlcance && dist.HasValue && !derrotado)
                                    {
                                        <small class="alvo-alcance-aviso">Fora do alcance (@SessaoViewModel.FormatarMetros(dist.Value) / máx. @SessaoViewModel.FormatarMetros(alcanceArma))</small>
                                    }
                                    @if (alvo.Esquivando && !bloqueado)
                                    {
                                        <small class="alvo-esquiva-aviso">◈ Esquivando (Desvantagem: 2d20, menor)</small>
                                    }
                                    <small>
                                        @if (derrotado)
                                        {
                                            <text>☠️ @(alvo.TipoEntidade == TiposPinoSessao.Personagem ? "Inconsciente" : "Derrotado") (0 / @pvMx PV)</text>
                                        }
                                        else
                                        {
                                            <text>PV: @pvAt / @pvMx · CA: @(alvo.ClasseArmadura ?? 10)@(dist.HasValue ? $" · {SessaoViewModel.FormatarMetros(dist.Value)}" : "")</text>
                                        }
                                    </small>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="attack-options">
                    <label class="attack-field">
                        Bônus de Ataque (Mod + Prof.)
                        <input type="number" min="-50" max="50" @bind="ViewModel.ModificadorAtaque" />
                    </label>
                    <label class="attack-field">
                        Bônus de Dano
                        <input type="number" min="-50" max="50" @bind="ViewModel.ModificadorDano" />
                    </label>
                </div>

                <button type="button"
                        class="attack-roll"
                        disabled="@(ViewModel.ExecutandoAtaque || ViewModel.ArmaSelecionada == null || !ViewModel.AlvoSelecionadoVivo || !ViewModel.AlvoSelecionadoNoAlcance)"
                        @onclick="ViewModel.RolarDadoAtaqueAsync">
                    @(ViewModel.ExecutandoAtaque
                        ? "Rolando..."
                        : (ViewModel.AlvoSelecionado?.Esquivando == true
                            ? "🎲 3. Rolar Ataque com Desvantagem (2d20, menor)"
                            : "🎲 3. Rolar Dado de Ataque (1d20)"))
                </button>
            }
            else if (ViewModel.EtapaAtaque == 2 && ViewModel.ResultadoAtaqueAtual != null)
            {
                var r = ViewModel.ResultadoAtaqueAtual;
                <div class="attack-result-box @(r.EhCritico ? "critico" : "acertou")">
                    <span class="attack-badge @(r.EhCritico ? "critico" : "acertou")">
                        @(r.EhCritico ? "💥 ACERTO CRÍTICO! (20 NATURAL)" : "ACERTOU!")
                    </span>
                    <strong>@(r.EhCritico ? "20!" : r.TotalAtaque.ToString())</strong>
                    <p>
                        @if (r.EhCritico)
                        {
                            <text>20 natural acerta <b>@r.NomeAlvo</b> (CA @r.CaAlvo) automaticamente e dobra os dados da arma!</text>
                        }
                        else if (r.AlvoEsquivando)
                        {
                            <text>
                                2d20 Desvantagem [@r.DadoAtaque1, @r.DadoAtaque2] → @r.DadoAtaque @(r.ModificadorAtaque >= 0 ? $"+ {r.ModificadorAtaque}" : $"− {Math.Abs(r.ModificadorAtaque)}")
                                ≥ CA @r.CaAlvo de <b>@r.NomeAlvo</b>
                            </text>
                        }
                        else
                        {
                            <text>
                                d20 (@r.DadoAtaque) @(r.ModificadorAtaque >= 0 ? $"+ {r.ModificadorAtaque}" : $"− {Math.Abs(r.ModificadorAtaque)}")
                                ≥ CA @r.CaAlvo de <b>@r.NomeAlvo</b>
                            </text>
                        }
                    </p>
                </div>

                <button type="button"
                        class="attack-roll @(r.EhCritico ? "attack-crit-btn" : "attack-damage-btn")"
                        disabled="@ViewModel.ExecutandoAtaque"
                        @onclick="ViewModel.RolarDanoEAplicarAsync">
                    @(ViewModel.ExecutandoAtaque
                        ? "Aplicando dano..."
                        : r.EhCritico
                            ? $"💥 Rolar Dano Crítico (2× dados de {r.ExpressaoDano})"
                            : $"💥 Rolar Dano da Arma ({r.ExpressaoDano})")
                </button>
            }
            else if (ViewModel.EtapaAtaque == 3 && ViewModel.ResultadoAtaqueAtual != null)
            {
                var r = ViewModel.ResultadoAtaqueAtual;
                string classeBox = r.Acertou ? (r.EhCritico ? "critico" : "acertou") : "falhou";

                <div class="attack-result-box @classeBox">
                    <span class="attack-badge @classeBox">
                        @(r.Acertou
                            ? (r.EhCritico ? "💥 DANO CRÍTICO APLICADO" : "DANO APLICADO")
                            : (r.DadoAtaque == 1 ? "FALHA CRÍTICA (1 NATURAL)" : "ATAQUE FALHOU"))
                    </span>

                    @if (r.Acertou)
                    {
                        <strong>-@r.DanoTotal PV</strong>
                        <p>
                            Arma: <b>@r.NomeArma</b> (@(r.EhCritico ? $"2× {r.ExpressaoDano}" : r.ExpressaoDano)) · Dados: [@string.Join(" + ", r.ResultadosDano)]
                            @(r.ModificadorDano != 0 ? (r.ModificadorDano > 0 ? $" + {r.ModificadorDano}" : $" − {Math.Abs(r.ModificadorDano)}") : "")
                        </p>
                        <p class="attack-hp-summary">
                            PV de <b>@r.NomeAlvo</b>: @r.PvAnterior → <b>@r.PvNovo / @r.PvMaximo</b>
                            @(r.PvNovo <= 0 ? (r.TipoAlvo == TiposPinoSessao.Personagem ? " (Inconsciente!)" : " (Derrotado!)") : "")
                        </p>
                    }
                    else
                    {
                        <strong>@(r.DadoAtaque == 1 ? "1!" : r.TotalAtaque.ToString())</strong>
                        <p>
                            @if (r.DadoAtaque == 1)
                            {
                                <text>1 natural sempre erra o ataque contra <b>@r.NomeAlvo</b> (CA @r.CaAlvo).</text>
                            }
                            else
                            {
                                @if (r.AlvoEsquivando)
                                {
                                    <text>2d20 Desvantagem [@r.DadoAtaque1, @r.DadoAtaque2] → @r.DadoAtaque</text>
                                }
                                else
                                {
                                    <text>d20 (@r.DadoAtaque)</text>
                                }
                                @(r.ModificadorAtaque >= 0 ? $" + {r.ModificadorAtaque}" : $" − {Math.Abs(r.ModificadorAtaque)}")
                                @(" < ") @($"CA {r.CaAlvo} de ")
                                <b>@r.NomeAlvo</b>
                            }
                        </p>
                    }
                </div>

                <div class="attack-footer-actions">
                    <button type="button" class="attack-btn-sec" @onclick="ViewModel.NovoAtaque">Atacar novamente</button>
                    <button type="button" class="attack-btn-prim" @onclick="ViewModel.FecharModalAtaque">Fechar</button>
                </div>
            }
        }
    </section>
}

@if (ViewModel.ExibirModalMagia)
{
    <div class="attack-backdrop" @onclick="ViewModel.FecharModalMagia"></div>

    <section class="attack-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-magia" @onclick:stopPropagation="true">
        <header class="attack-header">
            <div>
                <p>Conjurador · @ViewModel.AtributoConjuracao (Atk @(ViewModel.BonusAtaqueMagico >= 0 ? $"+{ViewModel.BonusAtaqueMagico}" : ViewModel.BonusAtaqueMagico.ToString()) · CD @ViewModel.CdResistenciaMagia)</p>
                <h2 id="titulo-magia">✧ Conjurar Magia</h2>
            </div>
            <button class="attack-close" type="button" aria-label="Fechar magia" @onclick="ViewModel.FecharModalMagia">×</button>
        </header>

        @if (ViewModel.PersonagemConjurador is not null)
        {
            <ResumoCirculosMagicos Personagem="ViewModel.PersonagemConjurador" MostrarBarras="true" />
        }

        @if (ViewModel.CarregandoMagia)
        {
            <p class="attack-empty">Carregando magias da sua ficha...</p>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ViewModel.ErroModalMagia))
            {
                <div class="attack-error">@ViewModel.ErroModalMagia</div>
            }

            @if (ViewModel.EtapaMagia == 1)
            {
                <div class="attack-section">
                    <div class="attack-choice-topo">
                        <p class="attack-section-label">1. Escolha a magia da ficha</p>
                    </div>

                    @if (!ViewModel.MagiasDisponiveisSessao.Any())
                    {
                        <p class="attack-empty">Nenhuma magia vinculada à sua ficha. Adicione magias na aba Magias da ficha.</p>
                    }
                    else
                    {
                        <div class="attack-choice-list">
                            @foreach (var magia in ViewModel.MagiasDisponiveisSessao)
                            {
                                bool sel = ViewModel.IdMagiaSelecionada == magia.IdMagia;
                                <button type="button"
                                        class="attack-choice-card @(sel ? "selecionado" : "")"
                                        @onclick="() => ViewModel.SelecionarMagiaSessao(magia.IdMagia)">
                                    <div class="attack-choice-topo">
                                        <strong>@magia.Nome</strong>
                                        <span class="alvo-tag alvo-tag-jogador">@(magia.CirculoNivel == 0 ? "Truque" : $"{magia.CirculoNivel}º")</span>
                                    </div>
                                    <small>@magia.TempoInfo.RotuloPtBr · @magia.AlcanceInfo.RotuloPtBr · @magia.DuracaoInfo.RotuloPtBr</small>
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (ViewModel.MagiaSelecionada != null)
                {
                    var m = ViewModel.MagiaSelecionada;

                    <div class="spell-meta-bar">
                        <span><b>Tempo:</b> @m.TempoInfo.RotuloPtBr</span>
                        <span><b>Alcance:</b> @m.AlcanceInfo.RotuloPtBr</span>
                        <span><b>Duração:</b> @m.DuracaoInfo.RotuloPtBr@(m.DuracaoInfo.SugereConcentracao ? " (Conc.)" : "")</span>
                        @if (!string.IsNullOrWhiteSpace(m.Componentes))
                        {
                            <span><b>Comp.:</b> @m.Componentes</span>
                        }
                    </div>

                    @if (!m.TempoInfo.PermitidaEmCombate)
                    {
                        <div class="spell-warning">
                            ⚠️ Tempo de conjuração longo (@m.TempoInfo.RotuloPtBr). Em combate (1 rodada = 6s), confirme com o Mestre antes de conjurar.
                        </div>
                    }

                    @if (m.CirculoNivel > 0)
                    {
                        <div class="attack-section">
                            <p class="attack-section-label">2. Círculo do espaço de magia</p>
                            @if (!ViewModel.CirculosDisponiveisParaMagiaSelecionada.Any())
                            {
                                <div class="attack-error">Sua classe/nível atual não possui espaços disponíveis para o @(m.CirculoNivel)º círculo.</div>
                            }
                            else
                            {
                                <div class="spell-circle-pills">
                                    @foreach (int circulo in ViewModel.CirculosDisponiveisParaMagiaSelecionada)
                                    {
                                        int rest = ViewModel.ObterEspacosRestantesCirculo(circulo);
                                        int max = ViewModel.ObterEspacosMaximosCirculo(circulo);
                                        bool ativo = ViewModel.CirculoConjuracaoSelecionado == circulo;
                                        <button type="button"
                                                class="spell-pill @(ativo ? "ativo" : "")"
                                                disabled="@(rest <= 0)"
                                                @onclick="() => ViewModel.SelecionarCirculoConjuracao(circulo)">
                                            @(circulo)º <small>(@rest/@max)</small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="attack-section">
                        <p class="attack-section-label">Resolução da magia</p>
                        <p class="spell-resolution-readonly">
                            @(ViewModel.ResolucaoMagiaAtual switch
                            {
                                ModoResolucaoMagia.AtaqueMagico => "Ataque (vs CA)",
                                ModoResolucaoMagia.Salvaguarda => "Salvaguarda",
                                ModoResolucaoMagia.Cura => "Cura",
                                _ => "Efeito / Buff"
                            })
                        </p>
                    </div>

                    @if (ViewModel.ResolucaoMagiaAtual != ModoResolucaoMagia.Efeito)
                    {
                        <div class="attack-options">
                            <label class="attack-field">
                                @(ViewModel.ResolucaoMagiaAtual == ModoResolucaoMagia.Cura ? "Dado de Cura (ex: 1d8)" : "Dado de Dano (ex: 4d4)")
                                <input type="text" placeholder="1d8" @bind="ViewModel.ExpressaoDadoMagia" />
                            </label>
                            <label class="attack-field">
                                Bônus Extra (opcional)
                                <input type="number" min="-50" max="50" @bind="ViewModel.BonusExtraMagia" />
                            </label>
                        </div>
                    }

                    @if (ViewModel.ResolucaoMagiaAtual == ModoResolucaoMagia.Salvaguarda)
                    {
                        <div class="attack-options">
                            <label class="attack-field">
                                Atributo da Salvaguarda (CD @ViewModel.CdResistenciaMagia)
                                <select class="spell-field-select" @bind="ViewModel.AtributoSalvaguardaMagia">
                                    <option value="Destreza">Destreza</option>
                                    <option value="Constituição">Constituição</option>
                                    <option value="Sabedoria">Sabedoria</option>
                                    <option value="Força">Força</option>
                                    <option value="Inteligência">Inteligência</option>
                                    <option value="Carisma">Carisma</option>
                                </select>
                            </label>
                            <label class="spell-check-row">
                                <input type="checkbox" @bind="ViewModel.MeioDanoSePassarSalvaguarda" />
                                <span>Metade do dano se o alvo passar</span>
                            </label>
                        </div>
                    }

                    @if (m.AlcanceInfo.Categoria != CategoriaAlcanceMagia.Pessoal)
                    {
                        <div class="attack-section">
                            <p class="attack-section-label">Escolha o alvo (Alcance: @m.AlcanceInfo.RotuloPtBr)</p>
                            @if (!ViewModel.AlvosParaMagia.Any())
                            {
                                <p class="attack-empty">Nenhum alvo visível no mapa atual.</p>
                            }
                            else
                            {
                                <div class="attack-choice-list">
                                    @foreach (var alvo in ViewModel.AlvosParaMagia)
                                    {
                                        int pvAt = alvo.PvAtual ?? alvo.PvMaximo ?? 0;
                                        int pvMx = alvo.PvMaximo ?? 0;
                                        bool derrotado = pvAt <= 0 && ViewModel.ResolucaoMagiaAtual is ModoResolucaoMagia.AtaqueMagico or ModoResolucaoMagia.Salvaguarda;
                                        var dist = ViewModel.ObterDistanciaAlvoMetros(alvo);
                                        bool foraAlcance = !ViewModel.AlvoDentroAlcanceMagia(alvo);
                                        bool bloqueado = derrotado || foraAlcance;
                                        bool sel = !bloqueado
                                            && ViewModel.TipoAlvoMagiaSelecionado == alvo.TipoEntidade
                                            && ViewModel.IdAlvoMagiaSelecionado == alvo.IdPino;

                                        string tagClasse = alvo.TipoEntidade switch
                                        {
                                            TiposPinoSessao.Monstro => "alvo-tag-monstro",
                                            TiposPinoSessao.Npc => "alvo-tag-npc",
                                            _ => "alvo-tag-jogador"
                                        };

                                        string tagLabel = alvo.TipoEntidade switch
                                        {
                                            TiposPinoSessao.Monstro => "Monstro",
                                            TiposPinoSessao.Npc => "NPC",
                                            _ => "Jogador"
                                        };

                                        <button type="button"
                                                disabled="@bloqueado"
                                                class="attack-choice-card @(sel ? "selecionado" : "") @(bloqueado ? "derrotado" : "")"
                                                @onclick="() => ViewModel.SelecionarAlvoMagia(alvo.TipoEntidade, alvo.IdPino)">
                                            <div class="attack-choice-topo">
                                                <strong>@alvo.Nome (@alvo.CoordenadaTexto)</strong>
                                                <span class="alvo-tag @tagClasse">@tagLabel</span>
                                            </div>
                                            @if (foraAlcance && dist.HasValue && !derrotado)
                                            {
                                                <small class="alvo-alcance-aviso">Fora do alcance (@SessaoViewModel.FormatarMetros(dist.Value) / máx. @m.AlcanceInfo.RotuloPtBr)</small>
                                            }
                                            @if (alvo.Esquivando && !bloqueado && ViewModel.ResolucaoMagiaAtual == ModoResolucaoMagia.AtaqueMagico)
                                            {
                                                <small class="alvo-esquiva-aviso">◈ Esquivando (Desvantagem: 2d20, menor)</small>
                                            }
                                            <small>
                                                PV: @pvAt / @pvMx · CA: @(alvo.ClasseArmadura ?? 10)@(dist.HasValue ? $" · {SessaoViewModel.FormatarMetros(dist.Value)}" : "")
                                            </small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <button type="button"
                            class="attack-roll"
                            disabled="@(!ViewModel.PodeExecutarMagia || (ViewModel.ConjuracaoEmCarregamento && !ViewModel.ConjuracaoPronta))"
                            @onclick="ViewModel.ExecutarEtapa1MagiaAsync">
                        @(ViewModel.ConjuracaoPronta
                            ? $"Concluir conjuração de {m.Nome}"
                            : ViewModel.ConjuracaoEmCarregamento
                                ? $"Carregando · {ViewModel.TurnosRestantesConjuracao} turno(s)"
                                : ViewModel.ExecutandoMagia
                            ? "Conjurando..."
                            : ViewModel.ResolucaoMagiaAtual switch
                            {
                                ModoResolucaoMagia.AtaqueMagico => ViewModel.AlvoMagiaSelecionado?.Esquivando == true
                                    ? "✧ Rolar Ataque Mágico com Desvantagem (2d20)"
                                    : "✧ Rolar Ataque Mágico (1d20)",
                                ModoResolucaoMagia.Salvaguarda => $"✧ Conjurar (Salvaguarda de {ViewModel.AtributoSalvaguardaMagia} CD {ViewModel.CdResistenciaMagia})",
                                ModoResolucaoMagia.Cura => $"💚 Conjurar Cura ({ViewModel.ExpressaoDadoMagia})",
                                _ => $"✧ Conjurar {m.Nome}"
                            })
                    </button>
                }
            }
            else if (ViewModel.EtapaMagia == 2 && ViewModel.ResultadoMagiaAtual != null)
            {
                var r = ViewModel.ResultadoMagiaAtual;
                <div class="attack-result-box @(r.EhCritico ? "critico" : "acertou")">
                    <span class="attack-badge @(r.EhCritico ? "critico" : "acertou")">
                        @(r.EhCritico ? "💥 CRÍTICO MÁGICO! (20 NATURAL)" : "ATAQUE MÁGICO ACERTOU!")
                    </span>
                    <strong>@(r.EhCritico ? "20!" : r.TotalRolagem.ToString())</strong>
                    <p>
                        @if (r.EhCritico)
                        {
                            <text>20 natural acerta <b>@r.NomeAlvo</b> (CA @r.CaAlvo) e dobra os dados de <b>@r.NomeMagia</b>!</text>
                        }
                        else if (r.AlvoEsquivando)
                        {
                            <text>2d20 Desvantagem [@r.DadoD201, @r.DadoD202] → @r.DadoD20 @(r.ModificadorRolagem >= 0 ? $"+ {r.ModificadorRolagem}" : $"− {Math.Abs(r.ModificadorRolagem)}") ≥ CA @r.CaAlvo de <b>@r.NomeAlvo</b></text>
                        }
                        else
                        {
                            <text>d20 (@r.DadoD20) @(r.ModificadorRolagem >= 0 ? $"+ {r.ModificadorRolagem}" : $"− {Math.Abs(r.ModificadorRolagem)}") ≥ CA @r.CaAlvo de <b>@r.NomeAlvo</b></text>
                        }
                    </p>
                </div>

                <button type="button"
                        class="attack-roll @(r.EhCritico ? "attack-crit-btn" : "attack-damage-btn")"
                        disabled="@ViewModel.ExecutandoMagia"
                        @onclick="ViewModel.RolarDanoMagiaEAplicarAsync">
                    @(ViewModel.ExecutandoMagia
                        ? "Aplicando dano..."
                        : r.EhCritico
                            ? $"💥 Rolar Dano Crítico (2× dados de {r.ExpressaoDado})"
                            : $"💥 Rolar Dano da Magia ({r.ExpressaoDado})")
                </button>
            }
            else if (ViewModel.EtapaMagia == 3 && ViewModel.ResultadoMagiaAtual != null)
            {
                var r = ViewModel.ResultadoMagiaAtual;
                string classeBox = r.Modo == ModoResolucaoMagia.AtaqueMagico && !r.Acertou
                    ? "falhou"
                    : (r.EhCritico ? "critico" : "acertou");

                <div class="attack-result-box @classeBox">
                    @if (r.Modo == ModoResolucaoMagia.AtaqueMagico)
                    {
                        <span class="attack-badge @classeBox">
                            @(r.Acertou
                                ? (r.EhCritico ? "💥 DANO CRÍTICO APLICADO" : "DANO MÁGICO APLICADO")
                                : (r.EhFalhaCritica ? "FALHA CRÍTICA (1 NATURAL)" : "MAGIA ERROU O ALVO"))
                        </span>

                        @if (r.Acertou)
                        {
                            <strong>-@r.ValorTotal PV</strong>
                            <p>
                                <b>@r.NomeMagia</b> (@(r.EhCritico ? $"2× {r.ExpressaoDado}" : r.ExpressaoDado)) · Dados: [@string.Join(" + ", r.ResultadosDado)]
                                @(r.BonusExtra != 0 ? (r.BonusExtra > 0 ? $" + {r.BonusExtra}" : $" − {Math.Abs(r.BonusExtra)}") : "")
                            </p>
                            <p class="attack-hp-summary">
                                PV de <b>@r.NomeAlvo</b>: @r.PvAnterior → <b>@r.PvNovo / @r.PvMaximo</b>
                            </p>
                        }
                        else
                        {
                            <strong>@(r.EhFalhaCritica ? "1!" : r.TotalRolagem.ToString())</strong>
                            <p>
                                @(r.EhFalhaCritica
                                    ? $"1 natural sempre erra o ataque mágico contra {r.NomeAlvo}."
                                    : $"d20 ({r.DadoD20}) {(r.ModificadorRolagem >= 0 ? $"+ {r.ModificadorRolagem}" : $"− {Math.Abs(r.ModificadorRolagem)}")} < CA {r.CaAlvo} de {r.NomeAlvo}.")
                            </p>
                        }
                    }
                    else if (r.Modo == ModoResolucaoMagia.Salvaguarda)
                    {
                        <span class="attack-badge @(r.AlvoPassouSalvaguarda ? "falhou" : "acertou")">
                            @(r.AlvoPassouSalvaguarda ? "ALVO PASSOU NA SALVAGUARDA" : "ALVO FALHOU NA SALVAGUARDA")
                        </span>
                        <strong>-@r.ValorTotal PV</strong>
                        <p>
                            <b>@r.NomeAlvo</b> rolou d20 (@r.DadoD20) em @r.AtributoSalvaguarda vs CD @r.CdAlvo · Dados: [@string.Join(" + ", r.ResultadosDado)]
                        </p>
                        <p class="attack-hp-summary">
                            PV de <b>@r.NomeAlvo</b>: @r.PvAnterior → <b>@r.PvNovo / @r.PvMaximo</b>
                        </p>
                    }
                    else if (r.Modo == ModoResolucaoMagia.Cura)
                    {
                        <span class="attack-badge acertou">💚 CURA CONJURADA</span>
                        <strong>+@r.ValorTotal PV</strong>
                        <p>
                            <b>@r.NomeMagia</b> em <b>@r.NomeAlvo</b> · Dados: [@string.Join(" + ", r.ResultadosDado)]
                            @(r.BonusExtra != 0 ? (r.BonusExtra > 0 ? $" + {r.BonusExtra}" : $" − {Math.Abs(r.BonusExtra)}") : "")
                        </p>
                    }
                    else
                    {
                        <span class="attack-badge acertou">✧ MAGIA ATIVADA</span>
                        <strong>@r.NomeMagia</strong>
                        <p>
                            Alvo: <b>@r.NomeAlvo</b> · Duração: <b>@r.DuracaoTexto</b>@(r.Concentracao ? " (Concentração)" : "")
                        </p>
                    }
                </div>

                <div class="attack-footer-actions">
                    <button type="button" class="attack-btn-sec" @onclick="ViewModel.NovaConjuracao">Conjurar outra</button>
                    <button type="button" class="attack-btn-prim" @onclick="ViewModel.FecharModalMagia">Fechar</button>
                </div>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public SessaoViewModel ViewModel { get; set; } = default!;

    private const string IconeMover = "/img/acoes/mover.png";
    private const string IconeAtaque = "/img/acoes/ataque.png";
    private const string IconeMagia = "/img/acoes/conjurar-magia.png";
    private const string IconeDisparada = "/img/acoes/disparada.png";
    private const string IconeDesengajar = "/img/acoes/desengajar.png";
    private const string IconeEsquivar = "/img/acoes/esquivar.png";
    private const string IconeEsconder = "/img/acoes/esconder.png";

    private static readonly (AcaoBasica2014 Acao, string Categoria, string? Imagem, string? Simbolo)[] AcoesBasicasMestre =
    [
        (AcaoBasica2014.Disparada, "Movimento", IconeDisparada, null),
        (AcaoBasica2014.Desengajar, "Ação", IconeDesengajar, null),
        (AcaoBasica2014.Esquivar, "Defesa", IconeEsquivar, null),
        (AcaoBasica2014.Ajudar, "Ação", null, "+"),
        (AcaoBasica2014.Preparar, "Ação", null, "⚑"),
        (AcaoBasica2014.Esconder, "Furtividade", IconeEsconder, null)
    ];

    private int? _idPinoAcoesMestre;
    private AcaoBasica2014? _acaoBasicaMestre;
    private TipoAcao2014 _tipoAcaoBasicaMestre = TipoAcao2014.Acao;
    private int _idAlvoAjudaMestre;
    private string _gatilhoAcaoMestre = string.Empty;
    private int _cdEsconderMestre = 12;
    private int _modificadorEsconderMestre;
    private bool _exibirHabilidadeMestre;

    protected override void OnParametersSet()
    {
        int? idPino = ViewModel.PinoAcoesMestre?.IdPino;
        if (_idPinoAcoesMestre == idPino) return;

        _idPinoAcoesMestre = idPino;
        _acaoBasicaMestre = null;
        _exibirHabilidadeMestre = false;
    }

    private List<PinoMapaDto> ObterAlvosAdjacentesAjuda(PinoMapaDto origem) =>
        ViewModel.PinosVisiveisNoMapa
            .Where(p => p.IdPino != origem.IdPino &&
                        ViewModel.Estado.Encontro.Fichas.GetValueOrDefault(p.IdPino)?.Morto != true &&
                        SessaoService.DistanciaPinos(origem, p) <= 1.5m)
            .OrderBy(p => p.Nome)
            .ToList();

    private void AlternarMoverPinoMestre(PinoMapaDto pino)
    {
        _acaoBasicaMestre = null;
        _exibirHabilidadeMestre = false;
        ViewModel.AlternarMovimentoPinoPorToque(pino);
    }

    private void AbrirAcaoBasicaMestre(AcaoBasica2014 acao)
    {
        ViewModel.CancelarMovimentoPinoPorToque();
        ViewModel.LimparFeedbackCombateMestre();
        _exibirHabilidadeMestre = false;
        _tipoAcaoBasicaMestre = TipoAcao2014.Acao;
        _gatilhoAcaoMestre = string.Empty;
        _idAlvoAjudaMestre = acao == AcaoBasica2014.Ajudar && ViewModel.PinoAcoesMestre is { } pinoAtual
            ? ObterAlvosAdjacentesAjuda(pinoAtual).FirstOrDefault()?.IdPino ?? 0
            : 0;

        if (acao == AcaoBasica2014.Esconder)
        {
            _cdEsconderMestre = 12;
            _modificadorEsconderMestre = ViewModel.PinoAcoesMestre?.Modificador(Atributo2014.Destreza) ?? 0;
        }

        _acaoBasicaMestre = acao;
    }

    private void AbrirHabilidadeMestre()
    {
        ViewModel.CancelarMovimentoPinoPorToque();
        ViewModel.LimparFeedbackCombateMestre();
        _acaoBasicaMestre = null;
        _exibirHabilidadeMestre = true;
    }

    private void FecharAcaoPinoMestre()
    {
        if (ViewModel.ExecutandoAtaqueEntidade) return;

        _acaoBasicaMestre = null;
        _exibirHabilidadeMestre = false;
    }

    private async Task UsarAcaoBasicaMestreAsync(int idPino, AcaoBasica2014 acao)
    {
        if (ViewModel.ExecutandoAtaqueEntidade) return;

        var (alvo, gatilho, tipo) = (_idAlvoAjudaMestre, _gatilhoAcaoMestre, _tipoAcaoBasicaMestre);
        var (cd, modificador) = (_cdEsconderMestre, _modificadorEsconderMestre);

        bool sucesso = await ViewModel.UsarControle2014Async((s, e, conta) => acao == AcaoBasica2014.Esconder
            ? s.EsconderPino2014Async(e, conta, idPino, tipo, cd, modificador)
            : s.UsarAcaoBasica2014Async(e, conta, idPino, acao, alvo, gatilho, tipo));

        if (sucesso)
            FecharAcaoPinoMestre();
    }
}