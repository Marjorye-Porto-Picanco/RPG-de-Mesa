@using RPGdeMesa.Application.Services
@using RPGdeMesa.Domain.ValueObjects
@using RPGdeMesa.Domain.Sessoes
@using RPGdeMesa.Presentation.ViewModel

@if (ViewModel.MonstroEmVisualizacao != null)
{
    var m = ViewModel.MonstroEmVisualizacao;
    var ataquesRolaveis = m.Ataques.Where(a => RegrasCombate2014.DanoValido(a.Dano)).ToList();
    int pvAtualMonstro = ViewModel.PinoMonstroEmVisualizacao?.PvAtual ?? m.PvMaximo;
    var (magiaRestante, magiaMaxima) = ObterEspacosDoPino(ViewModel.PinoMonstroEmVisualizacao?.IdPino);

    <div class="sessao-ficha-backdrop" @onclick="ViewModel.FecharModalEntidade"></div>

    <section class="sessao-ficha-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-monstro-modal" @onclick:stopPropagation="true">
        <SessaoCabecalhoFicha IdTitulo="titulo-monstro-modal" Titulo="@(ViewModel.PinoMonstroEmVisualizacao?.Nome ?? m.Nome)"
                              Imagem="@m.Imagem" Subtitulo="Bestiário da Campanha"
                              Descricao="@($"{m.TipoMonstro ?? "Criatura"} · {m.Tamanho ?? "Médio"} · {m.Tendencia ?? "Neutra"}")"
                              OnFechar="ViewModel.FecharModalEntidade">
            <BarraRecursoFicha Atual="pvAtualMonstro" Maximo="m.PvMaximo" Rotulo="Pontos de vida" MostrarValor="true" Legenda="Vida" />
            @if (magiaMaxima > 0)
            {
                <BarraRecursoFicha Atual="magiaRestante" Maximo="magiaMaxima" Magia="true" MostrarValor="true"
                                   Legenda="Magia" Rotulo="Espaços de magia restantes" />
            }
        </SessaoCabecalhoFicha>

        <div class="sessao-ficha-corpo">
            <dl class="em-dados-pessoais em-dados-monstro">
                <div><dt><abbr title="Classe de armadura">CA</abbr></dt><dd>@m.ClasseArmadura</dd></div>
                <div><dt><abbr title="Nível de desafio">ND</abbr></dt><dd>@(m.NivelDesafio?.ToString("0.##") ?? "—")</dd></div>
                <div><dt>Deslocamento</dt><dd>@(string.IsNullOrWhiteSpace(m.Deslocamento) ? "—" : m.Deslocamento)</dd></div>
            </dl>
            @if (ViewModel.PinoMonstroEmVisualizacao?.IdPino is int idPino)
            {
                <SessaoAcoesPinoFicha @key="idPino" ViewModel="ViewModel" IdPino="idPino" />
            }
            @if (ViewModel.Estado.EhMestre)
            {
                <div class="em-pv-edit" role="group" aria-label="Editar vida do monstro">
                    <label>Editar PV <input type="number" min="0" max="@m.PvMaximo" @bind="ViewModel.PvAtualMonstroEdicao" /></label>
                    <button type="button" disabled="@ViewModel.SalvandoPvEntidade"
                            @onclick="ViewModel.SalvarPvAtualMonstroAsync">Salvar PV</button>
                    <button type="button" class="em-btn-pv-max" disabled="@ViewModel.SalvandoPvEntidade"
                            @onclick="ViewModel.RestaurarPvMaximoMonstroAsync">Restaurar PV</button>
                </div>
            }
            @if (ViewModel.Estado.EhMestre && ataquesRolaveis.Count > 0)
            {
                var alvos = ViewModel.AlvosAtaqueMonstro.ToList();
                <div class="quick-attack-master">
                    <h3>Ação rápida do Mestre</h3>
                    <label>Ataque<select @bind="ViewModel.IdAtaqueMonstroSelecionado">
                        @foreach (var ataque in ataquesRolaveis) { <option value="@ataque.IdMonstroAtaque">@ataque.Nome · @ataque.Dano</option> }
                    </select></label>
                    <label>Alvo<select disabled="@(alvos.Count == 0)" @bind="ViewModel.AlvoAtaqueMonstroSelecionado">
                        @if (alvos.Count == 0)
                        {
                            <option value="">Sem alvos</option>
                        }
                        @foreach (var alvo in alvos) { <option value="@alvo.IdPino">@alvo.Nome · CA @(alvo.ClasseArmadura ?? 10)</option> }
                    </select></label>
                    <button type="button" disabled="@(ViewModel.ExecutandoAtaqueEntidade || string.IsNullOrEmpty(ViewModel.AlvoAtaqueMonstroSelecionado))" @onclick="ViewModel.AtacarComMonstroSelecionadoAsync">@(ViewModel.ExecutandoAtaqueEntidade ? "Resolvendo…" : "Atacar alvo")</button>
                    @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade)) { <p role="status">@ViewModel.FeedbackAtaqueEntidade</p> }
                </div>
            }
            <div class="em-grid-2">
                <div class="em-bloco-pergaminho">
                    <h3>Sentidos</h3>
                    <p>@(string.IsNullOrWhiteSpace(m.Sentidos) ? "—" : m.Sentidos)</p>
                </div>
                <div class="em-bloco-pergaminho">
                    <h3>Resistências</h3>
                    <p>@(string.IsNullOrWhiteSpace(m.Resistencias) ? "—" : m.Resistencias)</p>
                </div>
                <div class="em-bloco-pergaminho em-span-2">
                    <h3>Habilidades</h3>
                    <p>@(string.IsNullOrWhiteSpace(m.Habilidades) ? "—" : m.Habilidades)</p>
                </div>
                <div class="em-bloco-pergaminho em-span-2">
                    <h3>Ataques</h3>
                    @if (m.Ataques?.Any() == true)
                    {
                        @if (ViewModel.Estado.EhMestre && ataquesRolaveis.Count == 0)
                        {
                            <p>Esta ficha não tem um golpe com fórmula de dano válida. Use Ações rápidas → Habilidades para efeitos sem dano.</p>
                        }
                        @foreach (var ataque in m.Ataques)
                        {
                            <p><b>@ataque.Nome</b> · @(ataque.BonusAtaque.HasValue ? $"+{ataque.BonusAtaque}" : "bônus —") · @(ataque.Dano ?? "dano —") @(ataque.TipoDano ?? "") · @(ataque.Alcance ?? "alcance —")</p>
                            @if (!string.IsNullOrWhiteSpace(ataque.Descricao)) { <small>@ataque.Descricao</small> }
                        }
                    }
                    else { <p>Nenhum ataque estruturado cadastrado.</p> }
                </div>
                <div class="em-bloco-pergaminho em-span-2">
                    <h3>Descrição</h3>
                    <p>@(string.IsNullOrWhiteSpace(m.Descricao) ? "Sem descrição registrada." : m.Descricao)</p>
                </div>
            </div>
        </div>
    </section>
}

@if (ViewModel.NpcEmVisualizacao != null)
{
    var n = ViewModel.NpcEmVisualizacao;
    var armasRolaveis = n.Itens.Where(x => RegrasCombate2014.DanoValido(x.Item?.Dano)).ToList();
    int pvMaxNpc = SessaoService.CalcularPvMaximoNpc(n);
    int pvAtualNpc = ViewModel.PinoNpcEmVisualizacao?.PvAtual ?? pvMaxNpc;
    int caNpc = n.ClasseArmadura;
    var (magiaRestante, magiaMaxima) = ObterEspacosDoPino(ViewModel.PinoNpcEmVisualizacao?.IdPino);

    <div class="sessao-ficha-backdrop" @onclick="ViewModel.FecharModalEntidade"></div>

    <section class="sessao-ficha-popup" role="dialog" aria-modal="true" aria-labelledby="titulo-npc-modal" @onclick:stopPropagation="true">
        <SessaoCabecalhoFicha IdTitulo="titulo-npc-modal" Titulo="@(ViewModel.PinoNpcEmVisualizacao?.Nome ?? n.Nome)"
                              Imagem="@n.Imagem" Subtitulo="NPC da Campanha"
                              Descricao="@($"{n.RacaTexto ?? "Raça"} · {n.ClasseTexto ?? "NPC"} · Nível {n.Nivel}")"
                              OnFechar="ViewModel.FecharModalEntidade">
            <BarraRecursoFicha Atual="pvAtualNpc" Maximo="pvMaxNpc" Rotulo="Pontos de vida" MostrarValor="true" Legenda="Vida" />
            @if (magiaMaxima > 0)
            {
                <BarraRecursoFicha Atual="magiaRestante" Maximo="magiaMaxima" Magia="true" MostrarValor="true"
                                   Legenda="Magia" Rotulo="Espaços de magia restantes" />
            }
        </SessaoCabecalhoFicha>

        <div class="sessao-ficha-corpo">
            <dl class="em-dados-pessoais">
                <div><dt><abbr title="Classe de armadura">CA</abbr></dt><dd>@caNpc</dd></div>
                <div><dt>Tendência</dt><dd>@(string.IsNullOrWhiteSpace(n.Tendencia) ? "Neutra" : n.Tendencia)</dd></div>
                <div><dt>Antecedente</dt><dd>@(string.IsNullOrWhiteSpace(n.AntecedenteTexto) ? "—" : n.AntecedenteTexto)</dd></div>
            </dl>
            @if (ViewModel.PinoNpcEmVisualizacao?.IdPino is int idPino)
            {
                <SessaoAcoesPinoFicha @key="idPino" ViewModel="ViewModel" IdPino="idPino" />
            }
            @if (ViewModel.Estado.EhMestre)
            {
                <div class="em-pv-edit" role="group" aria-label="Editar vida do NPC">
                    <label>Editar PV <input type="number" min="0" max="@pvMaxNpc" @bind="ViewModel.PvAtualNpcEdicao" /></label>
                    <button type="button" disabled="@ViewModel.SalvandoPvEntidade"
                            @onclick="ViewModel.SalvarPvAtualNpcAsync">Salvar PV</button>
                    <button type="button" class="em-btn-pv-max" disabled="@ViewModel.SalvandoPvEntidade"
                            @onclick="ViewModel.RestaurarPvMaximoNpcAsync">Restaurar PV</button>
                </div>
            }
            <div class="em-grid-atributos">
                <div class="em-attr-card"><span>FOR</span><strong>@n.Forca</strong><small>@FormatarMod(n.Forca)</small></div>
                <div class="em-attr-card"><span>DES</span><strong>@n.Destreza</strong><small>@FormatarMod(n.Destreza)</small></div>
                <div class="em-attr-card"><span>CON</span><strong>@n.Constituicao</strong><small>@FormatarMod(n.Constituicao)</small></div>
                <div class="em-attr-card"><span>INT</span><strong>@n.Inteligencia</strong><small>@FormatarMod(n.Inteligencia)</small></div>
                <div class="em-attr-card"><span>SAB</span><strong>@n.Sabedoria</strong><small>@FormatarMod(n.Sabedoria)</small></div>
                <div class="em-attr-card"><span>CAR</span><strong>@n.Carisma</strong><small>@FormatarMod(n.Carisma)</small></div>
            </div>

            <div class="em-grid-2">
                <div class="em-bloco-pergaminho em-span-2"><h3>Ataques e itens equipados</h3>
                    @* Ataques personalizados de NPC aguardam suporte de persistência.
                    @foreach (var ataque in n.Ataques)
                    {
                        <p><b>@ataque.Nome</b> · @(ataque.BonusAtaque?.ToString("+0;-0;0") ?? "bônus —") · @(ataque.Dano ?? "dano —") @ataque.TipoDano · @(ataque.Alcance ?? "alcance —")</p>
                        @if (!string.IsNullOrWhiteSpace(ataque.Descricao)) { <small>@ataque.Descricao</small> }
                    }
                    *@
                    @if (n.Itens?.Any() == true)
                    {
                        @foreach (var itemNpc in n.Itens)
                        {
                            <p><b>@itemNpc.Item?.Nome</b> × @itemNpc.Quantidade · @(itemNpc.Item?.Dano ?? "sem dano") @(itemNpc.Item?.TipoDano ?? "")</p>
                        }
                        @if (ViewModel.Estado.EhMestre && armasRolaveis.Count > 0)
                        {
                            <div class="quick-attack-master">
                                <label>Arma<select @bind="ViewModel.IdItemNpcAtaqueSelecionado">
                                    @foreach (var itemNpc in armasRolaveis) { <option value="@itemNpc.IdItem">@itemNpc.Item!.Nome · @itemNpc.Item.Dano</option> }
                                </select></label>
                                <label>Alvo<select @bind="ViewModel.AlvoAtaqueNpcSelecionado">
                                    @foreach (var alvo in ViewModel.AlvosNpc) { <option value="@alvo.IdPino">@alvo.Nome · CA @(alvo.ClasseArmadura ?? 10)</option> }
                                </select></label>
                                <button type="button" disabled="@(ViewModel.ExecutandoAtaqueEntidade || string.IsNullOrEmpty(ViewModel.AlvoAtaqueNpcSelecionado))" @onclick="ViewModel.AtacarComNpcSelecionadoAsync">Atacar alvo</button>
                                @if (!string.IsNullOrWhiteSpace(ViewModel.FeedbackAtaqueEntidade)) { <p role="status">@ViewModel.FeedbackAtaqueEntidade</p> }
                            </div>
                        }
                    }
                    else { <p>Nenhum item ou ataque equipado.</p> }
                </div>
                <div class="em-bloco-pergaminho em-span-2"><h3>Magias</h3>
                    @if (n.Magias?.Any() == true)
                    {
                        @foreach (var magiaNpc in n.Magias)
                        { <p><b>@magiaNpc.Magia?.Nome</b> · @NPCirculo(magiaNpc.Magia?.CirculoNivel ?? 0) · @(magiaNpc.Magia?.DanoEfeito ?? "Efeito não informado")</p> }
                        @if (ViewModel.Estado.EhMestre)
                        {
                            <div class="quick-attack-master">
                                <label>Magia<select @bind="ViewModel.IdMagiaNpcSelecionada">
                                    @foreach (var magiaNpc in n.Magias) { <option value="@magiaNpc.IdMagia">@magiaNpc.Magia?.Nome · @NPCirculo(magiaNpc.Magia?.CirculoNivel ?? 0)</option> }
                                </select></label>
                                <label>Alvo<select @bind="ViewModel.AlvoMagiaNpcSelecionado">
                                    @foreach (var alvo in ViewModel.AlvosNpc) { <option value="@alvo.IdPino">@alvo.Nome</option> }
                                </select></label>
                                <button type="button" disabled="@ViewModel.ExecutandoAtaqueEntidade" @onclick="ViewModel.ConjurarMagiaNpcSelecionadaAsync">Conjurar magia</button>
                            </div>
                        }
                    }
                    else { <p>Nenhuma magia cadastrada.</p> }
                </div>
            </div>

            <div class="em-bloco-pergaminho">
                <h3>História & Notas</h3>
                <p>@(string.IsNullOrWhiteSpace(n.Historia) ? "Sem história registrada." : n.Historia)</p>
            </div>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public SessaoViewModel ViewModel { get; set; } = default!;

    private (int Restantes, int Total) ObterEspacosDoPino(int? idPino)
    {
        if (idPino is not int id || !ViewModel.Estado.Encontro.Fichas.TryGetValue(id, out var ficha))
            return (0, 0);

        int restantes = 0;
        int total = 0;
        for (int circulo = 1; circulo <= 9; circulo++)
        {
            if (ficha.Recursos.TryGetValue($"Círculo {circulo}", out var recurso) && recurso.Maximo > 0)
            {
                total += recurso.Maximo;
                restantes += Math.Clamp(recurso.Restantes, 0, recurso.Maximo);
            }
        }
        return (restantes, total);
    }

    private static string FormatarMod(int valor)
    {
        int mod = AtributosBase.CalcularModificador(valor);
        return mod >= 0 ? $"+{mod}" : mod.ToString();
    }

    private static string NPCirculo(int nivel) => nivel <= 0 ? "Truque" : $"{nivel}º círculo";
}
